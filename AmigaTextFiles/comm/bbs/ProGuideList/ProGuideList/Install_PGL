           "dadurch kenntlich gemacht, daß dem String noch die Angabe "
           "einer Buchstabenkombination für den Namen der Sommerzeitzone "
           "folgt!"
      )
    )
    (set TZ-Help3
      (cat "Die Zeitzone muß eine 3-stellige Buchstabenkombination "
           "sein, z.B. MES für `Mitteleuropäische Sommerzeit`"
      )
    )

    (set OldInfo
      (cat "Das Format der PGLAutoList-Konfigurationsdateien hat sich "
           "geändert!!\n\nAlte Konfigurationsdateien müssen mit "
           "PGLSysopPrefs Version 1.2 oder höher geladen und erneut "
           "gespeichert werden!")
    )

  )
)

(procedure Zeitzone
(
  (set TZ (getenv "TZ"))

  (if (= TZ "")
    (
      (set result (askbool
                    (prompt MSG_TZ)
                    (help TZ-Help)
                    (default 1)
                  )
      )
      (if (= result 1)
        (
          (set xxx (askstring
                     (prompt "Bitte geben Sie die Zeitzone ein")
                     (help TZ-Help1)
                     (default "MEZ")
                   )
          )
          (set nn (asknumber
                     (prompt MSG_TZ_Diff)
                     (help TZ-Help2)
                     (range -12 12)
                     (default -1)
                  )
          )
          (set askyyy
            (askchoice (prompt "Welche Zeit ist zur Zeit aktiv?")
                (choices "Winterzeit"
                         "Sommerzeit")
                (help @askchoice-help)
                (default 1)
            )
          )
          (if (= askyyy 1)
            (set yyy (askstring
                     (prompt "Bitte geben Sie die (Sommer-)Zeitzone ein")
                     (help TZ-Help3)
                     (default "MES")
                   )
            )
            (set yyy "")
          )
          (set TZ ("%s%ld%s" xxx nn yyy) )
          (run "SetEnv TZ=" TZ
            (prompt ("Umgebungsvariable (TZ=%s) setzen?" TZ) )
            (help "setzt die Umgebungsvariable TZ")
            (confirm)
          )
          (run "Copy ENV:TZ ENVARC:"
            (prompt ("Umgebungsvariable TZ nach ENVARC: kopieren?" TZ) )
            (help "setzt die Umgebungsvariable TZ dauerhaft")
            (confirm)
          )
        )
      )
    )
  )
)
)

(procedure Keycheck
(
  (set result (exists (tackon dest_dir "PGL.key") (noreq)))
  (if (= result 0)
  (
    (message (KeyInfo dest_dir))
  )
  )
)
)

;------------------------------------------------------------------------------

(complete 0)
(CheckSystem)
(Defaultwerte)
(Texte)

(set installed "")


; Verzeichnisse abfragen und setzen
(set default-extern "Prometheus:extern/")
(set dest_dir
   (askdir (prompt (MSG_DESTINATION @app-name))
           (help @askdir-help)
           (default default-extern)
           (newpath)
   )
)

(set @default-dir dest_dir)
(complete 1)

(set default-prefs "SYS:Prefs/")
(set prefs_dir
   (askdir (prompt (MSG_PREFS_DESTINATION @app-name))
           (help @askdir-help)
           (default default-prefs)
           (newpath)
   )
)
(complete 2)

(set default-doks "Prometheus:doks/")
(set doks_dir
   (askdir (prompt (MSG_DOKS_DESTINATION @app-name))
           (help @askdir-help)
           (default default-doks)
           (newpath)
   )
)
(complete 3)

(set Icons
   (askchoice (prompt MSG_ICONS)
              (choices "MagicWorkbench (8 Farben)"
                       "Standard-Workbench (4 Farben)")
              (help Icons-help)
              (default (- 1 magicwb))
   )
)
(complete 4)


(copyfiles
  (prompt InstPGLBins)
  (help @copyfiles-help)
  (source "bin/extern")
  (dest dest_dir)
  (pattern "*" )
  (confirm "expert")
)
(complete 40)

(copyfiles
  (prompt InstPGLPrefs)
  (help @copyfiles-help)
  (source "bin/prefs")
  (dest prefs_dir)
  (pattern "PGLSysopPrefs*" )
  (confirm "expert")
)
(complete 50)

(copyfiles
  (prompt InstPGLDoks)
  (help @copyfiles-help)
  (source "doks/")
  (dest doks_dir)
  (pattern "*" )
  (confirm "expert")
)
(complete 60)

(if (= Icons 1)
  (
    (copyfiles
      (prompt InstWBIcons)
      (help @copyfiles-help)
      (source "NOMWBIcons/prefs/PGLSysopPrefs.info")
      (dest prefs_dir)
      (confirm "expert")
    )
    (copyfiles
      (prompt InstWBIcons)
      (help @copyfiles-help)
      (source "NOMWBIcons/doks/")
      (pattern "*.info")
      (dest doks_dir)
      (confirm "expert")
    )
  )
)
(complete 70)

(message "Tooltypes für Guide-Icons setzen...")
(foreach doks_dir "PGL#?.Guide"
  (
    (set temp (tackon doks_dir @each-name))
    (tooltype
      (dest temp)
      (setdefaulttool guide_reader)
    )
  )
)
(set temp (cat doks_dir "PGLQuickinstall.doc"))
(tooltype
  (dest temp)
  (setdefaulttool guide_reader)
)
(complete 80)

(Zeitzone)
(complete 90)

(Keycheck)
(complete 95)

(set result
  (askbool
    (prompt MSG_BEFEHL)
    (help @askbool-help)
    (choices "Weiter" "Weiter")
  )
)
(complete 97)

(message (OldInfo) (all))
(complete 98)

(set installed "YES")

(complete 100)

(if (= installed "YES") 
  (exit)
)   
