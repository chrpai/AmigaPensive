(procedure CheckSystem)
  (
    (set osversion  (/ (getversion) 65536))
    (debug "OS-Version: " osversion)
    (if (< osversion 37)
      (abort "ProGuideList benötigt AmigaOS 2.04 oder höher!" )
    )
; Choose default tool for guide, depending on user's OS version
    (if (>= osversion 39)
      (set guide_reader "MultiView")
      (set guide_reader "AmigaGuide")
    )
    (if (< @installer-version 42)
      (abort "Skript benötigt Installer V42 oder höher!")
    )
    (set muiversion (/ (getversion "MUI:libs/muimaster.library") 65536))
    (debug "MUI-Version: " muiversion)
    (if ( < muiversion 14)
      (abort "ProGuideList benötigt MUI 3.3 oder höher!" )
    )

; feststellen ob, Magic-WB installiert ist
    (set magicwb (exists "MagicWB:" (noreq)))

)

(procedure Defaultwerte
  (
    (set @abort-button "Abbruch")
    (set @default-dest "Prometheus:Extern/")
    (set dest_dir "")
  )
)

(procedure Texte
  (
    (set MSG_DESTINATION
      (cat "Wo soll %s installiert werden?\n"
           "(Es wird kein eigenes Verzeichnis angelegt)"
      )
    )
    (set MSG_PREFS_DESTINATION
      "Wo soll PGLSysopPrefs installiert werden?")
    (set MSG_DOKS_DESTINATION
      "Wo soll die PGL-Dokumentation installiert werden ?")
    (set MSG_COPYING "kopiere %s nach %s.")
    (set MSG_THANKS "Danke für die Installation von %s!\n\n\n")
    (set MSG_ICONS
      (cat "Sollen die Magic-Workbench-Icons oder die 'normalen'\n"
