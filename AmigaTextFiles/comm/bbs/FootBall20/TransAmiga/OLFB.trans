/* startup for Online FootBall doorgame for transamiga V1.1x by Jerry Jordan*/
/* only get the REAL Version of Online FootBall by Matt English */
/* ATTENTION! You MUST edit line #24 to reflect the correct PATH! See docs for more info. */

options results

systeminfo 8; bbsline=result
userinfo a ; name=result
userinfo x ; colorflag=result
systeminfo m ; timeleft=result

transmit 'Loading Online Football...'
setnodelocation 'Playing Online FootBall!!!'

/* Time is in seconds for OLFB so we need to change our minutes to seconds.*/
secs = timeleft * 60

name = upper(translate(name,'_',' '))

id=time(s)

open('temp','t:'||name||'.startup','W')
writeln('temp','failat 999')
writeln('temp','BBS:games/OLFB/Online_Football C BBS:Games/ 'secs' S 'name)
writeln('temp','endcli')
close('temp')

address command 'NewShell FIFO:trshell'id'/rwkecs from t:'||name||'.startup'
address command 'BBS:Bin/TrShell -n'bbsline' -ftrshell'id
address command 'wait 2'

exit 0