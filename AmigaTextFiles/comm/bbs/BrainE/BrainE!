sn cp25||'Press \c2<\c3Enter\c2> \c3to continue! '
end
end
else;do
tr apos(14,21)||copies(' ',37)
tr apos(15,21)||' \c3ÉÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ» '
