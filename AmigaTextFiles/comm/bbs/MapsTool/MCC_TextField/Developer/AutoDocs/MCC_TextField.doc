textfield.mcc/MUIA_TextField_BackgroundPen

    NAME: MUIA_TextField_BackgroundPen  ,struct MUI_PenSpec

    SPECIAL INPUTS
        DEFAULT_BACKGROUNDPEN

    FUNCTION
        Set the background color of the textfield

    EXAMPLE
        APTR Editor1, backgroundpen1;
        struct MUI_PenSpec *backgroundpen;

        get(backgroundpen1,MUIA_Pendisplay_Spec,&backgroundpen);
        set(Editor1,MUIA_TextField_BackgroundPen,backgroundpen);

textfield.mcc/MUIA_TextField_Clipboard

    NAME: MUIA_TextField_Clipboard      , LONG

    SPECIAL INPUTS


    FUNCTION
        Set the clipboard number, default is 0

    EXAMPLE
        APTR Editor1;
        struct MUI_PenSpec *backgroundpen;

        get(backgroundpen1,MUIA_Pendisplay_Spec,&backgroundpen);
        set(Editor1,MUIA_TextField_BackgroundPen,backgroundpen);

textfield.mcc/MUIA_TextField_Contents

    NAME: MUIA_TextField_Contents        , STRPTR

    SPECIAL INPUTS


    FUNCTION
        Set or get the contents of the editor. The contents of the
        editor is copied into a buffer and the pointer that is passed
        to it is set to this buffer. This buffer is valid until object
        disposal and is only current during the call but is still valid
        until the next get.

    EXAMPLE
        APTR Editor1;

        set(Editor1,MUIA_TextField_Contents,"Hello\nMy name is Karl\n\
            This is a textfield to be used with MUI3.3 and greater.\
            If you have trouble with it or you have a bug report, mail\
            me at kbellve@umabnet.ab.umd.edu and I will get back to you.\n\n\
            Thanks\nKarl\0");

textfield.mcc/MUIA_TextField_CursorPen

    NAME: MUIA_TextField_CursorPen  ,struct MUI_PenSpec

    SPECIAL INPUTS
        DEFAULT_CURSORPEN

    FUNCTION
        Set the cursor color of the textfield.

    EXAMPLE
        APTR Editor1,cursor1;
        struct MUI_PenSpec *cursorpen;

        get(cursor1,MUIA_Pendisplay_Spec,&cursorpen);
        set(Editor1,MUIA_TextField_CursorPen,cursorpen);

