/* Createlist for SMS v0.2 */
options results;if ~show('l',"rexxsupport.library") then;if ~addlib('rexxsupport.library',0,-30) then;do;say 'Could not open rexxsupport.library!';exit 10;end;parse arg udir userlistSMS;if udir='' then udir='BBS:users/';userlistSMS='BBS:Extras/SMS/Userlist.SMS';upos=0;index=1;ulist=showdir(udir,'f','/');ulist=ulist||'/';do while length(ulist)>upos;upos=index(ulist,'/');user=left(ulist,upos-1);ulist=right(ulist,length(ulist)-upos);if (left(user,1) ~='@')&(upper(user) ~='USERS.BBS') then;do;userX.index=user;index=index+1;end;end;index2=index;index=0;do while index~=index2;index=index+1;user=userX.index;if exists(udir||user) then;do;call open file,(udir||user),'R';do n=1 to 27;call readln(file);end;usernumb.index=delstr(trim(readln(file)),1,1);call close file;end;end;index=0;do while index~=index2-1;index=index+1;user=userX.index;num=usernumb.index;userY.num=user;end;index=0;call open file,(userlistSMS),'W';do while index~=index2;index=index+1;user=userY.index;if trim(left(user,4))~='USER' then;do;writeln(file,USER);end;end;call close file;exit