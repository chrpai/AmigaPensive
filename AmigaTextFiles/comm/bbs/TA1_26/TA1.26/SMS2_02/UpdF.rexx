/* Optimized with RexxOpt 1.6 */
options results;call pragma('stack',50000);parse upper arg Sarea Sarea2;if exists('BBS:Configs/') then;do;Configpath='BBS:Configs/';end;else;do;say 'Error: BBS:Configs/ dir not exist !';say '       If you have an other name for this dir change it !';exit 10;end;Index1=0;Index2=0;if exists(configpath||'File.cfg') then;do;call open file,(configpath||'File.cfg'),'R';do while Index1~=4;counter=compress(readln(file));Index1=Index1+1;end;Index1=0;do while Index1~=counter;AreaName.Index1=trim(readln(file));Areapath.Index1=trim(readln(file));Index2=0;do while Index2~=6;nopeX=readln(file);Index2=Index2+1;end;Index1=Index1+1;end;call close file;end;Updatekompl:;if Sarea='*'|Sarea='' then;do;Sarea=1;Sarea2=counter;end;if Sarea>counter then Sarea=counter;if Sarea2='' then Sarea2=Sarea;if Sarea2>counter then Sarea2=counter;if Sarea>Sarea2 then;do;swap=Sarea;Sarea=Sarea2;Sarea2=swap;end;index1=Sarea-1;do while index1~=Sarea2;say '';say 'Area: '||AreaName.Index1;say '';address command 'trufl '||Areapath.Index1;index1=index1+1;end;exit 0;IOERR:;say '*BOOM*  Got an IO error.  PLEASE notify 'sysop;say 'Line:' SIGL;exit;ERROR:;say '*BOOM*  Got an error.  PLEASE notify 'sysop;say 'Line:' SIGL '   Severity:' RC;exit;SYNTAX:;say '*BOOM*  Got a syntax error.  PLEASE notify 'sysop;say 'Line:' SIGL '   Error Code:' RC;exit