;$HBBS
;
;                       --> DO NOT MODIFY THIS FILE! <--
;
; Append this script to your S:User-Startup! (read the entire file first..)
;
;
; Do *not* call this script from your startup, this file may be updated in the
; future.

; Change the "" below to the directory that you installed HBBS in (e.g. "DH1:HBBS")

Assign HBBS: ""

; Other assigns that are required so that HBBS can find it's stuff..

Assign fonts: hbbs:System/amiga/fonts add
Assign devs: hbbs:System/amiga/devs add
Assign libs: hbbs:System/amiga/libs add

; You only need these next two assigns if have the HydraBBS Developer SDK
; installed. (Check to see if HBBS:Developer present)  Otherwise just comment
; them out.

if exists HBBS:Developer
  Assign Include: HBBS:Developer/Include add
  Assign Lib: HBBS:Developer/Lib add
endif

; This directory MUST be present. temporary files are created here by HBBS

if not exists T:HBBS
  makedir T:HBBS
endif

Path HBBS:System/Amiga/CLI ADD

; set the TTX below to what ever editor you use, if it's not in the system
; path then specify it's location. (ie, use CED, C:ED, GED, etc...)

setenv HBBSEditor=TTX

; then specify the parameters you want to send to the editor after the
; filename has been passed to it.

setenv HBBSEditorParams=SCREEN CtrlScrn

; using the above 2 settings we'd get something like this:
; TTX <filename> SCREEN CtrlScrn

; remove this next line.
echo "**** Setup Complete ****"
