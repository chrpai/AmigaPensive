/* download.trans: calls FileMaint's download routine */

options results

systeminfo 8
line = result

rexxportname = "FILEMAINT."||line

/* look for filemaint in arexx mode */

if show(PORTS, rexxportname) then do
    address value rexxportname download
    end

/* otherwise use non-arexx mode */

else address command "bbs:bin/filemaint -l"line" d"

