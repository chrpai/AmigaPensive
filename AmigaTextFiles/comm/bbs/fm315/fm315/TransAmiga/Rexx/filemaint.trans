/* filemaint.trans : run filemaint in interactive mode with bbs io enabled */

options results

systeminfo 8
line = result

userinfo o
access = result

userinfo g
flags = result

/* give the user whatever flags and access level you wish       */
/* especially handiy for allowing co-sysops access to file areas */ 

setflags 'xxxxxxxx'
setaccess 255

address command "fm:filemaint -g -l"line

setflags flags
setaccess access

