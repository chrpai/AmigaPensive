; $VER:   Version 1.0 (09.01.97)
; Installationsscript zum Installieren des WerbeMakers auf Festplatte
;
;============================
;=== Deutsche Erklärungen ===
;============================


(set #introduction (cat "\nMit diesem Installationsprogramm können Sie den\n\n"
     "--==»» Werbe-Maker ««==--\n\n"
     "auf Ihrem System installieren.\n\n"
     "Drücken Sie \"Weiter\", um mit der Installation fortzufahren.\n\n"
     "Drücken Sie \"Installation Abbrechen\", um die Installation abzubrechen."))

(set #Help "\n\n\nFagen ? Problme ?\nCall Deep Space Nine\n+49-2522-961874 Modem 28.8k\n+49-2522-961504 ISDN X75\nOder Mail an\nmichael@ds9.prometheus.de")

(message #introduction
 (all)
 )
(set @default-dest "prometheus:")

(complete 5)

(if (<> (exists "Prometheus:" (noreq)) 2)
        (message "\n\n\nEs Besteht kein Assign Auf Prometheus !\n\nHaben Sie PMBS richtig Installiert ?\n\nEs wird Emfohlen die Instalation Abzubrechen !")
)



(complete 7)
(set @default-web "prometheus:tools/")
(set @default-web
 (askdir (prompt "Bitte wählen Sie das Verzeichnis für den Werbemaker aus")
  (help @Help)

     (default @default-web)
)

)

        (copyfiles
                (optional "nofail" "askuser")
                (prompt "Es wird jetzt der WerbeMaker installiert !")
                (help #Help)
                (source "werbemaker_install/")
                (choices "werbemaker")
                (dest @default-web)
        )



(complete 25)
(set @default-prfs "sys:prefs/")
(set @default-prfs
 (askdir (prompt "Bitte wählen Sie das Verzeichnis für die Prefs aus")
  (help @Help)

     (default @default-prfs)
)

)

        (copyfiles
                (optional "nofail" "askuser")
                (prompt "Es wird jetzt der WerbeMaker installiert !")
                (help #Help)
                (source "werbemaker_install/")
                (choices "werbemakerprefs" "WerbemakerPrefs.info")
                (dest @default-prfs)
        )

(complete 35)




(set @Default-anl "prometheus:")
(set @default-anl
 (askdir (prompt "Bitte wählen Sie das Verzeichnis für die Anleitung aus.")
  (help @Help)

     (default @default-anl)
)

)


         (copyfiles
                   (optional "nofail" "askuser")
                   (prompt "Es wird jetzt die \"Werbe-Maker.Guide\" Anleitung kopiert.")
                   (help #Help)
                   (source "werbemaker_install/")
                   (choices "Werbemaker.Guide" "Werbemaker.Guide.info")
                   (dest @default-anl)
                   ;(confirm average)
                )


(complete 50)

(if (exists "Werbemaker_install/libs/triton.library" )
                (copylib
                        (prompt "Kopiere Triton.libray nach Libs:")
                        (help #Help)
                        (source "werbemaker_install/libs/triton.library")
                        (dest "Libs:")
                        (confirm)

)               )

(message "\n\n\n\nAlle Files sind nun an ihrem richtigen Platz. Sie sollten nun das GUIDE lesen. Dann steht ihnen nichts mehr im Weg, Ihre Werbung mit dem Werbemaker zu verschicken."
 (all)
   )
(complete 70)
(message "\n\n\n\nUm Den Werbemaker Richtig zu nutzen sollten Sie nun die WerbemakerPrefs per Icon Starten und ihn Konfigurieren."
  (all)
  )
(complete 85)
(message "\n\n\n\nAusserdem sollten Sie im Zeitplan von Prometheus folgenden Eintrag tätigen :\n\n\"DOSC run "@default-web"werbemaker\"\n\nDamit der Werbemaker seine Aufgabe richtig ausführt."

(all)
)
(complete 100)
(Message "\n\n\n\nDies ist die Demoversion des \"WerbeMakers\". Er verschickt nur alle 21 tage die werbung.\nDie Vollversion kann die Werbung im Abstand von minimal 3 Tagen Versenden.\nIntresse ?\nEinfach eine Mail an\nmichael@ds9.prometheus.de"
(all)
)
