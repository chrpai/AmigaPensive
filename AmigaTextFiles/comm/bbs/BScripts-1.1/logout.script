LogOut:
     converse "Command" "F GET\n"
     timeout 0
     converse "Command" "U A\n\n"
     converse "postal code" "^x\w23100 Mynämäki\n\n\n" ; Change that!
     converse "Command" "X Junior\n"                     
     converse "Command" "U L 24 G Y\n"
     timeout 60 gosub TryAgain
     dwhens

