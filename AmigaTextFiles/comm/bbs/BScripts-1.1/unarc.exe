failat 100

delete >NIL: "%GRABPATH?"                
delete >NIL: "%GRABPATH??"
delete >NIL: "%GRABPATH.script"          
delete >NIL: "%GRABPATH.orders"          

cd "%GRABDIR"                            

if exists "%ARCDIR%GRABNAME.ARC"
   delete >NIL: "%ARCDIR%GRABNAME"
   pkax >NIL: -e "%ARCDIR%GRABNAME.ARC"
   delete >NIL: "%ARCDIR%GRABNAME.ARC"
      skip end
endif

if exists "%ARCDIR%GRABNAME.ARJ"              
   delete >NIL: "%ARCDIR%GRABNAME"            
   unarj >NIL: e -i -y "%ARCDIR%GRABNAME.ARJ"
   delete >NIL: "%ARCDIR%GRABNAME.ARJ"   
      skip end
endif

echo " "
echo "                        Error in Decompress!"
echo " "
quit

lab end
echo " "
echo "                       Decompress completed!"
echo " "
quit
