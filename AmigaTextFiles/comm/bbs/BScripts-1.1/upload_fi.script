     converse "Command" "F UP\n"
     converse "File name" "\w%FILENAME\n"
     converse "description" "\w%DESC\n"
     wait "B01"
     upload "%FILEPATH",Z
     timeout 0
     converse "Enter detailed" "Y\n"
     timeout 60 gosub TryAgain
     wait "+----7-"
     ascsend "%GRABDIR%FILENAME.fileinfo"
     cli "delete %GRABDIR%FILENAME.fileinfo"
     send "^z"

