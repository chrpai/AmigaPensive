Stack 150000
IF EXISTS Ram:DoorStart
    Box:bin/Echo "\n\nAnsi-Shell RUN\n\n"
    Execute Ram:Door
    Box:bin/Echo "\n\nAnsi-Shell EXIT\n\n"
    Delete Ram:DoorStart
    EndCli
EndIf
;END Gateway5-DOORS

Prompt "%N.%S> "
Alias Clear "Echo *"*E[0;0H*E[J*" "
Alias XCopy "Copy CLONE "
