.key Release/K
.bra [
.ket ]

copy dh0:hbbs#? dh2:dist all
echo Deleting object and temporary files..
list dh2:dist/hbbs/source p=#?.o|#?.00|#?.tmp all lformat "delete %p%s" >t:dellist
failat 21
execute t:dellist
failat 10
ask "Ready To Archive ?"
if not warn
  lha a -e -r -V710 DH2:dist/HBBS-A[Release] DH2:dist/HBBS DH2:dist/HBBS.info
  if not warn
    ask "Remove DH2:Dist/HBBS#? ?"
    if not warn
      delete dh2:dist/hbbs all
      delete dh2:dist/hbbs.info all
    endif
    echo Archives stored as DH2:dist/HBBS-A[Release].L??
  endif
endif
