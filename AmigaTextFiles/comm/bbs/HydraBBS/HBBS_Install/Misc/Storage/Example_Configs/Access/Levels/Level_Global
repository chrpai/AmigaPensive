; File: BBS:Access/Users/Level_Global
; Purpose: Sets Global Access Details
;
; the settings are set for each access level availiable (defined in Level_List)
; then are overridden by access settings in the BBS:Access/Users/Level_xxx files
; (where xxx is a number upto 255)

; this file is used in the same way as /X uses it's BBS:Access/ACS.XXX.info files

; Access Commands

DownloadFiles=ON
UploadFiles=ON
SysopComment=ON
ReadMail=ON
WriteMail=ON
ScanMail=ON
AllowEdit=ON
AllowStatus=ON
ScanFiles=ON
AllowView=ON

; W commands

EditHandle=OFF
EditRealName=OFF
EditPassword=ON
EditGroup=ON
EditLocation=ON
EditCountry=ON
EditComputer=ON
EditPhoneNumber=OFF
EditLines=ON
EditScreenType=ON
EditEditor=OFF ; *C* Not Implemented yet
EditProtocol=ON

; Message Options

DeleteMail=ON
DeleteGroup=OFF
DeleteAnyone=OFF
AllowANSI=OFF    ; allows user to use ansi in messages if enabled
                             ; great for posting bbs adds! :-)
AllowPrivate=OFF   ; allows user to write private mail to another user
                             ; (disables/enables the Private (Y/N) prompt!)
AllowMultiple=OFF  ; this setting when enabled allows users
                             ; to select more than one person to send mail to
                             ; by seperating the names with commas
                             ; e.g, To: HYDRA,cRUISe,Oedipus
                             ; this will duplicate the message for each user
                             ; so they can reply/delete accoringly...

AllowGROUP=OFF
AllowALL=ON ; allow user to write messages to all users
                         ; messages with ALL status are skipped by mailscans
                         ; unless the user has specified otherwise in thier
                         ; config options
AllowEVERYBODY=OFF ; same as EALL in /X

AttachFiles=ON         ; allowed to attach any file at all ?
AllowPrivateFiles=ON   ; Allows user to attach files to private messages
AllowGroupFiles=ON     ; allows user to attach files to "group" messages
AllowALLFiles=OFF      ; allows user to attach files to "ALL" messages
AllowEVERYONEFiles=OFF ; allows user to attach files to "everybody" messages
AllowMultiFiles=OFF

AutoExpireMsg=ON

; Transfer Options

;sysop commands

AccountEditing=OFF  ; *I* Not Implemented
BreakChat=OFF       ; *I* Not Implemented

UnlimitedTime=OFF
UnlimitedCalls=OFF
UnlimitedBytes=OFF
UnlimitedChat=OFF
