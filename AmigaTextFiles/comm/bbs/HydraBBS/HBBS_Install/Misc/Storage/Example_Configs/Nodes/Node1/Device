;$HBBS
; Filename: Device
: Location: Nodes/NodeX/
; Purpose: settings for modem

DeviceName=TelnetD
SerialDevice=telnetd.device
SerialUnit=0
SerialBaud=38400
NullModemCable=FALSE

ModemDebug=ON
ModemLog=OFF
DumpModem=NO
MaxCommandWait=5 ; value is in seconds...
CommandRetries=3
EchoRetries=4
ReOpenRetries=2
ReOpenDelay=30 ; 60 per second
LockUpScript=HBBS:Scripts/Lockup.scr
DelayBetweenCommands=5 ; 60 per second...
TildeDelay=60
TurnOnEcho_1=ATE1

; Note: if the init sting for telnetd.device does NOT have H0 in it, the node
; cannot accept any more incoming connections! (due to a bug in telnetd.device)

ModemInit_1=ATS0=1H0


StrictConnect=OFF
StrictConnectStr_1=CONNECT 9600
RelaxedConnectStr_1=CONNECT
CommandModeString_1=~~~+++~~~
HangUpString=ATH0M0
OffHookString=ATH1M0
DropDTRHangup=TRUE
Incoming=RING
ImmediateAnswer=ATA
TurnOnEchoDelay=10
UseCRLF=NO
