;$HBBS
; Filename: Device
: Location: Nodes/NodeX/
; Purpose: settings for modem

DeviceName=USR Courier V34+
SerialDevice=serial.device  ; or... ibmser.device;BaudBandit.device;8n1.device;etc...
SerialUnit=1
SerialBaud=57600
NullModemCable=NO

ModemDebug=ON
ModemLog=ON
DumpModem=NO
MaxCommandWait=5 ; value is in seconds...
CommandRetries=3
EchoRetries=4
ReOpenRetries=2
ReOpenDelay=30 ; 60 per second
LockUpScript=HBBS:Scripts/Lockup.scr
DelayBetweenCommands=5 ; 60 per second...
TildeDelay=60

; USR Courier V.Everything
;
TurnOnEcho_1=AT&B2E1Q0V1
ModemInit_1=AT&F
ModemInit_2=AT b0 c1 e1 f1 m1 q0 v1 x6 &a3 &b1 &c1 &d2
ModemInit_3=AT &h1 &i0 &k3 &l0 &m4 &n0 &r2 &s0 &t5 &x1
ModemInit_4=AT &y1 %N6 s8=2 S10=7 S32=8 S56=16 H0 S0=1

; USR Sportster Voice V34+, not upgraded to x2
;
;TurnOnEcho_1=AT&B2E1Q0V1
;ModemInit_1=AT&F
;ModemInit_2=ATb0e1f1m1q0v1x6&a3&b1&c1&d2
;ModemInit_3=AT&h1&i0&k3&m4&n0&r2&s0&t5
;ModemInit_4=AT&y1s8=2S10=7S32=8H0S0=1

StrictConnect=OFF
StrictConnectStr_1=CONNECT 9600

; for a list of connect strings for USRobotics modems take a look at the files called MDMUSR*.INF
; on US Robotics/3Com's web site or BBS.

; For other modems (and USRobotics/3Com modems) you can take a look at the MDM*.INF files on a
; windows 95 or better PC in the C:\WINDOWS\INF directory (which is normall hidden)

RelaxedConnectStr_1=CONNECT
CommandModeString_1=~~~+++~~~
HangUpString=ATH0M0
OffHookString=ATH1M0
DropDTRHangup=TRUE
Incoming=RING
ImmediateAnswer=ATA
TurnOnEchoDelay=10
UseCRLF=NO
