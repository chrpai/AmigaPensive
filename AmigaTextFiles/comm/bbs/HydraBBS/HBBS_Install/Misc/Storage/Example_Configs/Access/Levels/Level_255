;$HBBS

; Sysop Access Level, enable everything!

DownloadFiles=ON
UploadFiles=ON
SysopComment=ON
ReadMail=ON
WriteMail=ON
ScanMail=ON
AllowEdit=ON
AllowStatus=ON
ScanFiles=ON
AllowView=ON

; W commands

EditHandle=ON
EditRealName=ON
EditPassword=ON
EditGroup=ON
EditLocation=ON
EditCountry=ON
EditComputer=ON
EditPhoneNumber=ON
EditLines=ON
EditScreenType=ON
EditEditor=ON ; *C* Not Implemented yet
EditProtocol=ON

; Message Options

DeleteMail=ON
DeleteGroup=ON
DeleteAnyone=ON
AllowANSI=ON    ; allows user to use ansi in messages if enabled
                             ; great for posting bbs adds! :-)
AllowPrivate=ON   ; allows user to write private mail to another user
                             ; (disables/enables the Private (Y/N) prompt!)
AllowMultiple=ON  ; this setting when enabled allows users
                             ; to select more than one person to send mail to
                             ; by seperating the names with commas
                             ; e.g, To: HYDRA,cRUISe,Oedipus
                             ; this will duplicate the message for each user
                             ; so they can reply/delete accoringly...

AllowGROUP=ON
AllowALL=ON ; allow user to write messages to all users
                         ; messages with ALL status are skipped by mailscans
                         ; unless the user has specified otherwise in thier
                         ; config options
AllowEVERYBODY=ON ; same as EALL in /X

AttachFiles=ON         ; allowed to attach any file at all ?
AllowPrivateFiles=ON   ; Allows user to attach files to private messages
AllowGroupFiles=ON     ; allows user to attach files to "group" messages
AllowALLFiles=ON      ; allows user to attach files to "ALL" messages
AllowEVERYONEFiles=ON ; allows user to attach files to "everybody" messages
AllowMultiFiles=ON

AutoExpireMsg=OFF

; Transfer Options

;sysop commands

AccountEditing=ON  ; *I* Not Implemented
BreakChat=ON       ; *I* Not Implemented

UnlimitedTime=ON
UnlimitedCalls=ON
UnlimitedBytes=ON
UnlimitedChat=ON
