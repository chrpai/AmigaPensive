;$HBBS
; files in this directory (HBBS:Access/Users) that are named the same as a users
; handle override thier access level settings.
; note that the users access level stored in the userdata is checked first then the
; bbs loads the setting for that access level from the HBBS:Access/Levels/Level_XX
; then it overrides the settings read in from that file with the settings in THIS
; file.  So it's best to keep the list of changed items in this file fairly
; small rather than copying the access/levels/level_xx and renaming it.
; but you can if you a) know what you are doing or b) if you feel like it!


; this file is used in the same way as /X uses it's BBS:Access/ACS.XXX.info files


; Grant user EALL type access
AllowEVERYBODY=TRUE

; User can have as many bytes as he likes
UnlimitedBytes=FALSE
