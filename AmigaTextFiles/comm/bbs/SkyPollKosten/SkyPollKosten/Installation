;Installationsscript für Commodore Installer

(set @default-dest (cat "prometheus:SkyTools/SkyPollKosten/"))
(transcript "Installation von SkyPollKosten V1.3")

(set #source (cat "install/"))
(set #dest (cat "prometheus:SkyTools/SkyPollKosten/"))

(message
  "\n\n\n\nWillkommen bei der SkyPollKosten V1.0 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)  

(working)
(complete 0)

(makedir "prometheus:SkyTools"
  (infos)
)

(makedir "prometheus:SkyTools/SkyPollKosten"
  (infos)
)

(complete 10)

(copyfiles
  (prompt "Kopiere Files...")
  (choices "SkyPollKosten" "SkyPollKosten.cfg" "SkyPollKosten.guide" "NetzAntrag.txt")
  (source #source)
  (dest #dest)
  (help @copyfiles-help)
  (infos) (confirm)
)

(complete 100)
