.key INAME/A,SEL/A,MSEL1,MSEL2,MSEL3,MSEL4
.bra {
.ket }

Echo "Generiere {INAME} mit Selektion {SEL}"

LIST FILES {SEL} LFORMAT="Execute G5_Bat:vtsuche/AddText %s%s {INAME}" >Ram:MakeIndexWORK
If {MSEL1} EQ "CD"
	Echo "Addiere Text {MSEL3}, Verzeichnis {MSEL2} zu {INAME}"
	Cd {MSEL2}
	LIST FILES {MSEL3} LFORMAT="Execute G5_Bat:vtsuche/AddText %s%s {INAME}" >Ram:MakeIndexWORK
Else
	If {MSEL1} GT ""
		Echo "Addire zu {INAME} noch {MSEL1}"
		LIST FILES {MSEL1} LFORMAT="Execute G5_Bat:vtsuche/AddText %s%s {INAME}" >>Ram:MakeIndexWORK
	EndIf
	If {MSEL2} GT ""
		Echo "Addire zu {INAME} noch {MSEL2}"
		LIST FILES {MSEL2} LFORMAT="Execute G5_Bat:vtsuche/AddText %s%s {INAME}" >>Ram:MakeIndexWORK
	EndIf
	If {MSEL3} GT ""
		Echo "Addire zu {INAME} noch {MSEL3}"
		LIST FILES {MSEL3} LFORMAT="Execute G5_Bat:vtsuche/AddText %s%s {INAME}" >>Ram:MakeIndexWORK
	EndIf
	If {MSEL4} GT ""
		Echo "Addire zu {INAME} noch {MSEL4}"
		LIST FILES {MSEL4} LFORMAT="Execute G5_Bat:vtsuche/AddText %s%s {INAME}" >>Ram:MakeIndexWORK
	EndIf
EndIf

Execute G5_Bat:vtsuche/BuildIndex {INAME}
