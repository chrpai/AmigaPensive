.key GAMEDIR,PROGRAMM,DEVPORT,INDEV,OUTDEV,USERNAME,LEVEL,GAMENUM,PORTNR,ZEILEN
.bra {
.ket }

; $VER: Gateway-5-CLI-DoorRunner V1.3 (27.08.1998) / (c) Michaela Prüß

; CLI-Door-Startscript für die Gateway-BBS (c) by Michaela Prüß
; Erstinstallation CLI-Doors 17.8.98

Date >Ram:DOORSTART

Date >Env:GameZeit

G5_Bin:WriteProt Doors:Protokoll $GameZeit {GAMEDIR}/{PROGRAMM} {DEVPORT} {USERNAME} {LEVEL} {GAMENUM} {PORTNR} 

Cd {GAMEDIR}

If "{GAMENUM}" EQ "101"                ; Programmstart GW-II
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} ACCESS {LEVEL} PAGELENGHT {ZEILEN} TIMELEFT 1440
    Skip Ready
EndIf

If "{GAMENUM}" EQ "103"                ; GORE (Adventrue)
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} user={USERNAME} port={PORTNR} edit_pw="ALOHA" 
    Skip Ready
EndIf

If "{GAMENUM}" EQ "105"                ; Programmstart Eliza
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} Eliza.Script 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "107"                ; IronGate
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} USERNAME={USERNAME} MAXMOVES=5000 SYSPW="ALOHA" ANSI=COLOR
	Skip Ready
EndIf

If "{GAMENUM}" EQ "108"                ; IronGate
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} COLOR {LEVEL}
	Skip Ready
EndIf

If "{GAMENUM}" EQ "110"                ; Programmstart Convolution 5
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} 5 {USERNAME} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "111"                ; Programmstart Convolution 25
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} 25 {USERNAME} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "112"                ; Programmstart Convolution 50
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} 50 {USERNAME} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "120"                ; DreamSweeper (MindSweeper) EASY
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} USERNAME {USERNAME} MINES 10 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "121"                ; DreamSweeper (MindSweeper) MIDDLE
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} USERNAME {USERNAME} MINES 35 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "122"                ; DreamSweeper (MindSweeper) HEAVY
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} USERNAME {USERNAME} MINES 60 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "128"                ; Space Empire
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} {GAMEDIR} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "130"                ; Card Guppies III
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} USERNAME {USERNAME} LEVEL {LEVEL} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "200"                ; AnsiFilm
	Type Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "201"                ; AnsiFilm
	Type Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "202"                ; AnsiFilm
	Type Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "600"                ; Programmstart Voting Booth
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} {USERNAME} 20 color 80 1 
	Skip Ready
EndIf

If "{GAMENUM}" EQ "601"                ; Programmstart Voting Booth SYSOP-MODUS
	Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} {USERNAME} 255 color 80 1 
	Skip Ready
EndIf

;;; Normaler CLI-Door-Start (Sammelstart) ;;;

If "{GAMENUM}" EQ "999"                ; Programmstart mit Total-Logbuch!
	WriteProt Doors:Protokoll ":::RunCLIDoor:::" Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} 
EndIf

Execute G5_Bat:RunCLI{DEVPORT} "_G5RUN" {INDEV} {OUTDEV} {GAMEDIR}/{PROGRAMM} {USERNAME} 

LAB Ready:

Date >Env:GameZeit
G5_Bin:WriteProt Doors:Protokoll ENDE! $GameZeit Execute G5_Bat:RunCLI{DEVPORT} {GAMEDIR}/{PROGRAMM}

Cd Box:
END
