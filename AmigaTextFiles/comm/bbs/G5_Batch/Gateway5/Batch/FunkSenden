.KEY PORTNR/A,ZIEL/A
.BRA {
.KET }
If Exists G5_Ram:StoerSendung{ZIEL}
	G5_Bin:Echo "Funkruf an Port {ZIEL} wurde gestört, Sendung nicht möglich!" >>G5_Ram:Result{PORTNR}
	Delete G5_Ram:StoerSendung{ZIEL} QUIET
Else
	If Exists G5_Ram:Status{ZIEL}
		G5_Bin:Echo "Funkruf an Port {ZIEL}" >>G5_Ram:Result{PORTNR}
		Type G5_Ram:Funk{PORTNR} >>G5_Ram:RB_{ZIEL}
		Type G5_Ram:Status{ZIEL} >>G5_Ram:Result{PORTNR}
	Else
		G5_Bin:Echo "Auf Port {ZIEL} ist niemand!" >>G5_Ram:Result{PORTNR}
	EndIf
EndIf
