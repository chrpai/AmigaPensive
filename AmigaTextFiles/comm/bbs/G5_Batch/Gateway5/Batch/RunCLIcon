If {IDENTIFY} NOT EQ "_G5PRO"             ; Protokollmodus? NEIN ->2
	IF {IDENTIFY} NOT EQ "_G5RUN"         ; ->2 Kein Prot, kein Run, NO BOX!
		Skip NOBOX
	EndIf
