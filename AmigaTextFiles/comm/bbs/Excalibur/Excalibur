transmit "\f1\c2Attack thyself?  Highness, art thou drunk?!\n1"
call pause;signal main;end
if knights < 1 then do
transmit "\f1\c2You don't have any knights!\n1"
call pause;signal main;end
transmit "\f1\c3King "kingname"'s knights have vowed to fight to the death!"
war2:
transmit '\n1\c4Thy knights number \c1'knights'\c4.'
transmit '\c4There are \c1'guards' \c4guards in Camelot.\n1'
flagit = 0;var = random(1,10,time('s'))
if var < 6 then do
transmit "\c2Thoust didn't surprise them.  They get the first attack..."
call warnotsurprised;if flagit = 1 then signal wardefeat
call warsurprised;if flagit = 1 then signal capturethrone
signal continuewar;end
transmit "\c5Thoust caught them off-guard!  Thy knights get first attack..."
call warsurprised;if flagit = 1 then signal capturethrone
call warnotsurprised;if flagit = 1 then signal wardefeat
signal continuewar
warsurprised:
a = knights;if a > 999 then a = 999
var = random(1,a,time('s'))
if var > guards then do;flagit = 1;var = guards;end
guards = guards - var
transmit "\n1\c7Thy vassals slaughter \c4"var" \c7of the royal guards!" ;return
warnotsurprised:
a = guards;if a > 999 then a = 999
var = random(1,a,time('s'))
if var > knights then do;flagit = 1;var = knights;end
knights = knights - var
transmit "\n1\c7The King's knights kill \c4"var" \c7of thy warriors.";return
continuewar:
sendstring '\n1\c6Continue war? \c1';call ask;if ans = 'Y' then signal war2
if ans = 'N' then do;call savestats;signal main;end
signal continuewar
wardefeat:
transmit '\n1\c2Alas, all thy knights were defeated, master.\n1'
transmit "\c3"kingname"'s guards capture thee, seize all of thy gold,"
transmit "beat thee to within an inch of thy life, and then throw thee into"
transmit "a mudhole!\n1"
transmit "\c7Thy lie in a state of semi-consiousness for several hours, then"
transmit "manage to get to thy feet and plot thy revenge...\n1"
transmit "\c1I'm afraid thou art finished for the day, m'lord.\n1"
call pause;knights = 0;moves = 0;enemyname = kingname
if exists(dir''enemyname) then do
call loadenemy;engold = engold + gold;call saveenemy;end
call savestats;signal endgame
capturethrone:
transmit "\n1\c5Congratulations, m'lord!\n2\c7Thy knights hath captured Camelot!\n1"
transmit "\c1Thou art the new KING of EXCALIBUR!!"
guards = 0;kingname = name;kingdate = date()
if fi > 0 then do
transmit "\n2\c3Calling all thy knights to Camelot..."
do x = 1 to fi
place = fiefs.x;call loadcity;owner = "No One";gold = gold + amtgold
amtgold = 0;knights = knights + cityguards;cityguards = 0;call savecity
map.place = 'C';end;end
guards = knights;knights = 0;fiefknights = 0;place = 143;fi = 0
call savestats;transmit "\n1\c2Thou hast \c1"guards" \c2guards in Camelot, highness."
call pause;signal main
savestats:
call open file, (dir'_excal.stats'), 'W'
call writeln file, kingname;call writeln file, guards
call writeln file, kingdate;call writeln file, startdate
call close file;return
