sendstring '\n1\c73|';do x = 79 to 104;var = ' \c6:';if show.x = 1 then var = '\c1'map.x'\c6:';if x = place then var = '\c2'map.x'\c6:';sendstring var;end
sendstring '\n1\c74|';do x = 105 to 130;var = ' \c6:';if show.x = 1 then var = '\c1'map.x'\c6:';if x = place then var = '\c2'map.x'\c6:';sendstring var;end
