transmit '\n2\c3C = Cities          M = Mountains\n1S = Swamp           P = Plains'
transmit 'D = Desert          F = Forest         \n1@ = Your Fiefs     M5 = Camelot\n1'
transmit '. = Unexplored Territory\n1';call pause;return
knightstore:
transmit cls;if kingname = name then signal kingaddguards
transmit "Welcome to Knights 'R' Us, m'lord!\n1"
transmit 'Do you wish to\n1';transmit '     (H)ire or';transmit '     (S)ell\n1'
sendstring 'knights? ';call ask
if ans = '' then signal main
if ans = 'H' then signal knighthire
if ans = 'S' then signal knightsale
signal main
knighthire:
transmit '\n1\c4Knights hire for 20 gold pieces each now, plus 10 per day.\n1'
high = (gold/20)%1;query '\c7Hire how many? (max.\c5' high'\c7): \c3'
amo = result;if amo = "###PANIC" then signal main
if amo = '' then signal main
if amo < 1 then signal main
if amo > high then signal main
knights = knights + amo;gold = gold - (amo * 20)
transmit '\n1You are now accompanied by \c4'knights' \c3knights.'
call pause;signal main
knightsale:
transmit '\n1\c4Other adventurers will buy your knights for 10 gold each.\n1'
high = knights;query '\c7Sell how many? (max.\c5' high'\c7): \c3';amo = result
if amo = "###PANIC" then signal endgame
if amo = '' then signal main
if amo < 1 then signal main
if amo > high then signal main
knights = knights - amo;gold = gold + (amo * 10)
transmit '\n1You are now accompanied by \c4'knights' \c3knights.'
call pause;signal main
kingaddguards:
transmit '\n1\c4Welcome, highness.\n1Additional Camelot guards cost 20 gp each.\n1'
high = (gold/20)%1;query '\c7Hire how many? (max.\c5' high'\c7): \c3';amo = result
if amo = "###PANIC" then signal main
if amo = '' then signal main
if amo < 1 then signal main
if amo > high then signal main
guards = guards + amo;gold = gold - (amo * 20)
transmit '\n1There are now \c4'guards' \c3guards in Camelot.'
call savestats;call pause;signal main
vaults:
transmit "\f1Welcome to the royal vaults, m'lord!\n1"
transmit 'Do you wish to\n1';transmit '     (D)eposit or';transmit '     (W)ithdraw\n1'
sendstring 'gold? ';call ask
if ans = 'D' then signal vaultdeposit
if ans = 'W' then signal vaultwithdraw
signal main
vaultdeposit:
query '\n1\c7Deposit how much (max. \c5'gold'\c7): \c3';amo = result
if amo = "###PANIC" then signal endgame
if amo = '' then signal main
if amo < 1 then signal main
if amo > gold then signal main
vault = vault + amo;gold = gold - amo;call intro3;call pause;signal main
vaultwithdraw:
query '\n1\c7Withdraw how much (max. \c5'vault'\c7): \c3';amo = result
if amo = "###PANIC" then signal endgame
if amo = '' then signal main
if amo < 1 then signal main
if amo > vault then signal main
vault = vault - amo;gold = gold + amo;call intro3;call pause;signal main
jousting:
transmit cls;if jousts < 1 then do;transmit '\c2Thou must wait until tomorrow to joust again!\n1';call pause;signal main;end
an = 'Welcome to the tilting arena!';call cnter;transmit '\c5'
if jousts ~= 12 then signal joust2
transmit '     Here is thy chance to gain recognition and wealth.  The champions'
transmit 'are gathered together to challenge all who dare to meet them on the field'
transmit 'of honor.  The greater the champion, the larger the purse, but the greater'
transmit 'champions are loath to yield their gold.  Thou art allowed a maximum of'
transmit '12 jousts per day, but if thou art defeated five times in succession,'
transmit 'thou wilt be finished jousting for the rest of the day.'
transmit '\c7';an = 'WARNING:';call cnter
an = 'The Alchemist-General hath determined that';call cnter
an = 'jousting can be hazardous to thy health!';call cnter
transmit '';call pause
transmit '\f1\c2The finest heroes in the kingdom stand prepared to prove their prowess!'
transmit 'Thou must wager 25 gold pieces if thou wishest to issue a challenge, but'
transmit 'the prize thou canst win will mayhap make it worth the risk!\n1'
joust2:
var = 12 - jousts
transmit '\c1Your purse: 'gold'        Jousts today: 'var'        Consecutive Defeats: 'defeats'\n1'
if jousts ~= 12 then transmit 'Choose thy opponent 1-9 (0=quit, ?=full list)\n1'
if jousts = 12 then call joustlist
sendstring "Enter thy opponent's rank: ";call ask
if ans = "" then signal main
if ans = '?' then do;call joustlist;signal joust2;end
if ans = '0' then signal main
if ans = '1' | ans = '2' | ans = '3' | ans = '4' | ans = '5' | ans = '6' | ans = '7' | ans = '8' | ans = '9' then signal startjoust
transmit '';signal joust2
joustlist:
transmit '\c7';an = 'Rank  Knight           Purse';call cnter
an = '----------------------------';call cnter;an = ' 1    Sir Galahad       1000';call cnter
an = ' 2    Sir Lancelot       900';call cnter;an = ' 3    Sir Gawain         750';call cnter
an = ' 4    Sir Richard        500';call cnter;an = ' 5    Sir Pollinore      350';call cnter
an = ' 6    Sir Tristan        225';call cnter;an = ' 7    Sir Mordred        150';call cnter
