;Installationsscript für Commodore Installer

(set @default-dest "Prometheus:SkyTools")
(transcript "Installation von SkySetDupeCheck V1.3")

(set sourc "install/")
(set desti (tackon @default-dest "SkySetDupeCheck"))

(message
  "\n\n\n\nWillkommen bei der SkySetDupeCheck V1.3 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)

(working)

(if (= (exists (tackon @default-dest "SkySetDupeCheck")) 0 (makedir (tackon @default-dest "SkySetDupeCheck") (infos) )))

(complete 20)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "SkySetDupeCheck" "SkySetDupeCheck.guide" "NetzAntrag.txt")
  (source sourc)
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 80)

(makeassign "SkyTools" "Prometheus:SkyTools")

(startup "SkyTools"
  (prompt "\n\n\n\nDas SkyTools-Assign wird nun Ihrer User-Startup zugefügt.")
  (help @startup-help)
  (command "Assign SkyTools: \"" @default-dest "\"\n")
)

(complete 100)

(message
  "\n\n\nZur weiteren Installation und Konfiguration von SkySetDupeCheck schauen "
  "Sie bitte in die Anleitung.\n\n"
)

(Message
  "\n\n\nFür alle SkyTools existiert ein eigenes Support-Netz, das SkyNetz, in dem Sie Informationen, Hilfestellung, Diskussionen und natürlich die neusten Versionen der Programme erhalten."
)
