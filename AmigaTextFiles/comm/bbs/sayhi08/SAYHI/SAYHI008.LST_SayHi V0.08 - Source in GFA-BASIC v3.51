'
PROCEDURE getstats
  IF EXIST(sfd$+"BBSFILES/stats")
    OPEN "I",#2,sfd$+"BBSFILES/stats",512
    LINE INPUT #2,calls$
    LINE INPUT #2,msgs$
    LINE INPUT #2,uls$
    LINE INPUT #2,dls$
    LINE INPUT #2,fdbk$
    LINE INPUT #2,newu$
    LINE INPUT #2,newd$
    LINE INPUT #2,lastuser$
    LINE INPUT #2,email$
    CLOSE #2
  ELSE
    calls$="0"
    msgs$="0"
    uls$="0"
    dls$="0"
    fdbk$="0"
    newu$="0"
    newd$="0"
    lastuser$="NOBODY"
    email$="0"
  ENDIF
RETURN
