' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE pagepause
  '
  @tchk
  IF contin!=TRUE OR abscontin!=TRUE
    GOTO pagepauseexit
  ENDIF
  abort!=FALSE
  '
  @msend(" More (Y/n/c)?")
  @mget(9,1,0,1)
  IF car%>0
    GOTO pagepauseexit
  ENDIF
  @msend(de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$)
  '
  IF in$=" " OR in$="N" OR in$="S"
    abort!=TRUE
  ELSE IF in$="C"
    contin!=TRUE
  ENDIF
  '
  pagepauseexit:
  lncount%=0
  '
RETURN
'
' ######################################################
' ######################################################
' This procedure does the time conversions. (P.Broadnax)
' ######################################################
'
PROCEDURE timeconv
  '
  ' Originally Percy's code, but optimised by P.Deane and
  ' gives pd.time$ based on the 12 hour (not 24 hour) clock.
  ' Pd.time$ is always 'HH:MM:SS xM' (ie 11 chars long)
  '
  LOCAL t.t%
  '
  time1$=TIME$
  t.t%=VAL(LEFT$(time1$,2))
  IF t.t%>11
    a$=" PM"
  ELSE
    a$=" AM"
  ENDIF
  '
  IF t.t%=0
    t.t%=12
    time1$=STR$(t.t%)+RIGHT$(time1$,6)
  ELSE IF t.t%<10
    time1$="0"+STR$(t.t%)+RIGHT$(time1$,6)
  ELSE IF t.t%>21
    t.t%=t.t%-12
    time1$=STR$(t.t%)+RIGHT$(time1$,6)
  ELSE IF t.t%>12
    t.t%=t.t%-12
    time1$="0"+STR$(t.t%)+RIGHT$(time1$,6)
  ENDIF
  pd.time$=time1$+a$
  '
RETURN
'
' ###################################################
' ###################################################
' This procedure does the date conversions. (P.Deane)
' ###################################################
'
PROCEDURE dateconv(pddt$)
  '
  ' converts date to Fido style DD-Mmm-YY
  ' string to use in program is pd.date$
  '
  ' generally you call this with dateconv(DATE$) to convert the
  ' current date, however, other dates in MM/DD/YYYY format could
  ' be converted, just give it the string...
  '
  ' pd.date$ is always of the form DD-Mmm-YY (ie 9 chars long)
  '
  LOCAL pd.temp$,pd.date1$,pd.date2$,pd.date3$,pd.month%,pd.month$
  '
  ' (Only thing this returns is the pd.date$)
  '
  pd.date1$=LEFT$(pddt$,2)
  pd.date2$=MID$(pddt$,4,2)
  pd.date3$=RIGHT$(pddt$,2)
  pd.month%=VAL(pddt$)
  '
  SELECT pd.month%
    '
  CASE 1
    pd.month$="Jan"
  CASE 2
    pd.month$="Feb"
  CASE 3
    pd.month$="Mar"
  CASE 4
    pd.month$="Apr"
  CASE 5
    pd.month$="May"
  CASE 6
    pd.month$="Jun"
  CASE 7
    pd.month$="Jul"
  CASE 8
    pd.month$="Aug"
  CASE 9
    pd.month$="Sep"
  CASE 10
    pd.month$="Oct"
  CASE 11
    pd.month$="Nov"
  CASE 12
    pd.month$="Dec"
  DEFAULT
    pd.month$="???"
  ENDSELECT
  pd.date$=pd.date2$+"-"+pd.month$+"-"+pd.date3$
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)#######(mod.PKN)####
' ###################################################
'
PROCEDURE tchk
  timenow%=CINT(TIMER/200)
  ctime%=(timenow%-timeon%)
  ctime%=CINT(ctime%/60)
  rtime%=tpc%-ctime%
  '
  IF rtime%>5
    timewarn0!=FALSE
    timewarn1!=FALSE
    timewarn2!=FALSE
    timewarn5!=FALSE
    GOTO jumpwarn
  ELSE IF rtime%<=0
    @msend(ansi$(1)+cr$+cr$+" Sorry, Time Limit Exceeded!"+CHR$(7))
    DELAY 2
    car%=2
    timewarn0!=TRUE
    timewarn1!=TRUE
    timewarn2!=TRUE
    timewarn5!=TRUE
    GOTO jumpwarn
  ENDIF
  '
  IF rtime%<=1 AND timewarn1!=FALSE
    @msend(ansi$(1)+cr$+" WARNING: 1 Minute or Less Remaining This Call!"+cr$)
    DELAY 2
    timewarn1!=TRUE
    timewarn2!=TRUE
    timewarn5!=TRUE
    GOTO jumpwarn
  ENDIF
  IF rtime%<=2 AND timewarn2!=FALSE
    @msend(ansi$(1)+cr$+" WARNING: 2 Minutes or Less Remaining This Call!"+cr$)
    DELAY 1
    timewarn2!=TRUE
    timewarn5!=TRUE
    GOTO jumpwarn
  ENDIF
  IF rtime%<=5 AND timewarn5!=FALSE
    @msend(ansi$(1)+cr$+" WARNING: 5 Minutes or Less Remaining This Call!"+cr$)
    DELAY 1
    timewarn5!=TRUE
  ENDIF
  '
  jumpwarn:
  IF timewarn0!=TRUE
    @finish
  ENDIF
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE setpagepause
  oldscrnht%=scrnht%
  @msend(cr$+cr$+ansi$(2)+"Current Screen Height: "+ansi$(5)+STR$(oldscrnht%))
  @msend(cr$+cr$+ansi$(3)+"Change Screen Height (y/N)? ")
  @mget(3,1,0,1)
  IF in$="NO" OR car%>0
    GOTO pauseexit
  ENDIF
  @msend(cr$+ansi$(2)+"New Screen Height: "+ansi$(1))
  @mget(4,2,0,1)
  IF in$="" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=VAL(in$)
  @msend(cr$+ansi$(3)+"Are "+ansi$(1)+STR$(scrnht%)+ansi$(3)+" lines okay (Y/n)? ")
  @mget(3,1,1,1)
  IF in$="YES" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=oldscrnht%
  @msend(cr$+ansi$(1)+"No change to screen height.")
  '
  pauseexit:
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE checkansi
  '
  @msend(cr$+cr$+"Do you want ANSI (Y/n)? ")
  @mget(3,1,1,1)
  IF car%>0
    GOTO checkansiexit
  ENDIF
  '
  IF in$="YES"
    ansi!=TRUE
  ELSE
    ansi!=FALSE
  ENDIF
  checkansiexit:
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE setansi
  '
  IF ansi!=TRUE
    ansi$(1)=esc$+"[31m"
    ansi$(2)=esc$+"[32m"
    ansi$(3)=esc$+"[33m"
    ansi$(4)=esc$+"[34m"
    ansi$(5)=esc$+"[35m"
    ansi$(6)=esc$+"[36m"
    ansi$(7)=esc$+"[37m"
    ansi$(8)=esc$+"[1m"
    ansi$(9)=esc$+"[3m"
    ansi$(10)=esc$+"[4m"
    ansi$(11)=esc$+"[40m"
    ansi$(12)=esc$+"[44m"
  ELSE
    FOR kk%=1 TO 12
      ansi$(kk%)=""
    NEXT kk%
  ENDIF
  ' regardless of setting, this is needed for safety!
  ansi$(0)=esc$+"[0;37;40m"
  @msend(ansi$(0))
RETURN
'
' ###################################################
' #####################(P. DEANE)#######(mod.PKN)####
' ###################################################
'
PROCEDURE setabscon
  @msend(cr$+cr$+ansi$(2)+"Current Read Mode: "+ansi$(5))
  '
  IF abscontin!=TRUE
    @msend("NO page-pausing")
  ELSE
    @msend("Page-pausing on")
  ENDIF
  '
  @msend(cr$+cr$+ansi$(3)+"Toggle Read Mode (y/N)? ")
  @mget(3,1,0,1)
  IF in$="NO" OR car%>0
    @msend(cr$+ansi$(6)+"No change to read mode!"+cr$+cr$)
    GOTO absconexit
  ENDIF
  '
  IF abscontin!=TRUE
    abscontin!=FALSE
    @msend(cr$+ansi$(6)+"Page pausing now turned ON"+cr$+cr$)
  ELSE
    abscontin!=TRUE
    @msend(cr$+ansi$(1)+"Page pausing now turned OFF"+cr$+cr$)
  ENDIF
  '
  absconexit:
  @press
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE checkhotkey(hot$)
  '
  ' This function will not work at the moment. You'll need to put a list
  ' of valid commands in the array cmd$() and test each one.
  ' See this in action in a few of my other doors.
  '
  LOCAL jj%
  gotone!=FALSE
  cmd%=0
  '
  IF hot$=""
    GOTO checkhotexit
  ENDIF
  '
  jj%=1
  WHILE jj%<=50
    IF cmd$(jj%,2)=hot$
      gotone!=TRUE
      cmd%=jj%
    ENDIF
    EXIT IF gotone!=TRUE
    INC jj%
  WEND
  checkhotexit:
RETURN
