' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE status_window
  '
  OPENW #1,0,(sh%-8),sw%,8,0,2304,1
  PRINT esc$+"[35;43m"
  PRINT AT(1,1);" CALLS:    MSG:    PMSG:    FBK:    DLS:    ULS:    NEW:    BD:      CHT:    ";
  PRINT AT(8,1);esc$+"[34m"+calls$;
  PRINT AT(16,1);msgs$;
  PRINT AT(25,1);email$;
  PRINT AT(33,1);fdbk$;
  PRINT AT(41,1);dls$;
  PRINT AT(49,1);uls$;
  PRINT AT(57,1);newu$;
  PRINT AT(64,1);bd%;
  IF chat$="YES"
    PRINT AT(74,1);chat$;
  ELSE
    PRINT AT(74,1);"NO";
  ENDIF
RETURN
'
' ###################################################
' ####################(P. DEANE)#######(mod.PKN)#####
' ###################################################
'
PROCEDURE main_window
  '
  OPENW #2,0,11,sw%,sh%-20,0,2304,1
  '
  IF icon!=TRUE
    PRINT
    PRINT
    PRINT ansi4$+"                        Now running in ICONISED mode"
    PRINT
    PRINT ansi3$+"                           NO local console output"
    PRINT
    PRINT ansi5$+"                       Press F3 to un-iconise the door"
  ENDIF
  '
  ' ######################################################
  ' Set titles for window and screen and insert user data.
  ' ######################################################
  '
  title$=progname$+" (V"+versnum$+") by PKN  ID:"+id$+"  ("+uname$+")  Lev:"+lev$+"  "
  IF ring!=TRUE
    title$=title$+"Remote"
  ELSE
    title$=title$+"Local"
  ENDIF
  TITLEW #1,"",title$
  TITLEW #2,"",title$
  TITLES #1,title$
  '  TITLES #1,progname$+" (V"+versnum$+")  (C)1994  by Peter Nicolas"
  '
  IF ring!=FALSE
    ~ActivateWindow(WINDOW(2))
  ENDIF
  '
RETURN
'
'
' ###################################################
' #####################(P. DEANE)#######(mod.PKN)####
' ###################################################
'
PROCEDURE log(text$,how%)
  '
  ' Creates a log entry
  '
  ' text$ =log entry
  ' how% 0=Verbatim
  '    <>0=add the time at the start
  '
  IF EXIST(path$+progname$+".err")
    OPEN "A",#2,path$+progname$+".err",256
  ELSE
    OPEN "O",#2,path$+progname$+".err",256
  ENDIF
  IF how%=0
    PRINT #2,text$
  ELSE
    @timeconv
    PRINT #2,text$+"  "+pd.time$+" on "+pd.date$+" - "+uname$+" - ID:"+id$
  ENDIF
  CLOSE #2
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE spaceout(thing$,col%)
  '
  ' [Needs the string to format, and the column width it's going to fill]
  ' [Returns spc% - the number of spaces required - 0 if field overflow]
  '
  xx%=FRE(1)
  IF LEN(thing$)>col%
    spc%=0
  ELSE
    spc%=(col%-LEN(thing$))
  ENDIF
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)#######(mod.PKN)####
' ###################################################
'
' Now displays in ANSI if user has it turned on!
'
PROCEDURE seq.out(file$)
  '
  ' Simply will send out a text file to the user with page pausing, and
  ' an abort option (currently the space, 'N', 'S' or Ctrl-C will abort!)
  ' Abortions will take place once the current line has been printed.
  '
  ' we also support Xon/Xoff. Ctrl-S to pause, any other key will restart.
  '
  @msend(ansi$(4)+"ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ"+cr$)
  @msend(ansi$(3)+"  SayHi (V"+versnum$+") by Peter Nicolas. (c)1994. All rights reserved.  Greetings!"+cr$)
  @msend(ansi$(4)+"ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ"+cr$)
  '
  lncount%=4
  IF NOT EXIST(file$)
    @msend(ansi$(1)+"> "+cr$)
    @msend(ansi$(1)+"> "+ansi$(2)+"Looks like you're the first to Say Hi!"+ansi$(7)+cr$)
    @msend(ansi$(1)+"> "+cr$)
  ELSE
    OPEN "I",#2,file$,4096
    '
    DO UNTIL EOF(#2)
      LINE INPUT #2,text$
      INC lncount%
      @msend(ansi$(1)+"> "+ansi$(6)+text$+cr$)
      @mget(9,1,0,0)
      IF lncount%>=scrnht%
        @msend(ansi$(3))
        @pagepause
        ' we go down to pagepause, even if the setting is continuous,
        ' because pagepause does a time check, so will kick em off.
      ENDIF
      '
      EXIT IF (car%>0) OR abort!=TRUE
      EXIT IF EOF(#2)
    LOOP
    '
    CLOSE #2
  ENDIF
  '
  IF car%<=0
    abort!=FALSE
    contin!=FALSE
    @msend(ansi$(0))
  ENDIF
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE centre(some$)
  '
  ' [takes a string - MUST BE less than 76 chars - if not, no action]
  ' [returns centred$]
  '
  IF LEN(some$)<76
    centred$=SPACE$(38-(LEN(some$)/2))+some$
  ELSE
    centred$=some$
  ENDIF
  '
RETURN
