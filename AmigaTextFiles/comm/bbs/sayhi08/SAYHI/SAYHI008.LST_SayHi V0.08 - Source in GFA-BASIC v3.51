' ######################################
' ######################################
' This procedure displays the main menu!
' ######################################
'
PROCEDURE sayhimain
  '
  ans.m1$=ansi$(11)+SPACE$(4)+ansi$(8)+ansi$(2)+ansi$(12)+SPACE$(1)
  ans.m2$=ansi$(4)+"²"+ansi$(5)
  ans.m3$=ansi$(2)+ansi$(12)
  @msend(cr$)
  @msend(ans.m1$+"ÉÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ» "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(59)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(4)+ansi$(5)+"±±±±±"+ans.m2$+"  ±±±±"+ans.m2$+"  ±±"+ans.m2$+" ±±"+ansi$(4)+"²"+ansi$(2)+SPACE$(33)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(4)+ansi$(5)+"±±"+ans.m2$+"    ±±"+ans.m2$+" ±±"+ans.m2$+" ±±"+ans.m2$+" ±±"+ansi$(4)+"²"+ansi$(3)+"   Scribe a 1-Line message"+ansi$(1)+"-["+ansi$(7)+"S"+ansi$(1)+"]   "+ans.m3$+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(4)+ansi$(5)+"±±±±±"+ans.m2$+" ±±"+ans.m2$+" ±±"+ans.m2$+" ±±±±±±"+ansi$(4)+"²"+ansi$(2)+SPACE$(33)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(4)+ansi$(5)+"   ±±"+ans.m2$+" ±±±±±±"+ans.m2$+"   ±±"+ansi$(4)+"²"+ansi$(6)+SPACE$(5)+"Display 'em all for me!"+ansi$(1)+"-["+ansi$(7)+"D"+ansi$(1)+"]   "+ans.m3$+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(4)+ansi$(5)+"±±±±±"+ans.m2$+" ±±"+ans.m2$+" ±±"+ans.m2$+"   ±±"+ansi$(4)+"²"+ansi$(2)+SPACE$(35)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(28)+ansi$(2)+" Reconfigure my settings"+ansi$(1)+"-["+ansi$(7)+"R"+ansi$(1)+"]   "+ans.m3$+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(6)+ansi$(5)+"±±"+ans.m2$+"  ±±"+ans.m2$+" ±±±±±±"+ans.m2$+" ±"+ansi$(4)+"²"+ansi$(2)+SPACE$(34)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(6)+ansi$(5)+"±±"+ans.m2$+"  ±±"+ans.m2$+"   ±±"+ans.m2$+"   ±"+ansi$(4)+"²"+ansi$(3)+"    I bet there's some Info"+ansi$(1)+"-["+ansi$(7)+"I"+ansi$(1)+"]   "+ans.m3$+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(6)+ansi$(5)+"±±±±±±±"+ans.m2$+"   ±±"+ans.m2$+"   ±"+ansi$(4)+"²"+ansi$(2)+SPACE$(34)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(6)+ansi$(5)+"±±"+ans.m2$+"  ±±"+ans.m2$+"   ±±"+ansi$(4)+"²"+ansi$(6)+SPACE$(9)+"Time to check the Time!"+ansi$(1)+"-["+ansi$(7)+"T"+ansi$(1)+"]   "+ans.m3$+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(6)+ansi$(5)+"±±"+ans.m2$+"  ±±"+ans.m2$+" ±±±±±±"+ans.m2$+" ±"+ansi$(4)+"²"+ansi$(2)+SPACE$(34)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(28)+ansi$(2)+" Quit me back to the BBS"+ansi$(1)+"-["+ansi$(7)+"Q"+ansi$(1)+"]   "+ans.m3$+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(7)+ansi$(12)+"by Peter Nicolas"+ansi$(11)+SPACE$(36)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"º"+ansi$(11)+SPACE$(59)+ansi$(12)+"º "+cr$)
  @msend(ans.m1$+"ÈÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼ "+ansi$(0)+cr$+cr$)
  '
RETURN
'
' ##########################################
' ##########################################
' This procedure sets up the config values.
' #########################################
'
PROCEDURE config
  '
  flnm$=path$+progname$+".cfg"
  IF EXIST(flnm$)
    OPEN "I",#5,flnm$,1024
    WHILE NOT EOF(#5)
      LINE INPUT #5,sayrdlev$
      EXIT IF EOF(#5)
      LINE INPUT #5,saywrlev$
      EXIT IF EOF(#5)
      LINE INPUT #5,sayturns$
      EXIT IF EOF(#5)
      LINE INPUT #5,saylines$
      EXIT IF EOF(#5)
      LINE INPUT #5,skipem$
      EXIT IF skipem$=""
      EXIT IF skipem$<>""
    WEND
    CLOSE #5
  ENDIF
  '
RETURN
'
' ###################################################
' ###################################################
' Check for user level and allocate time accordingly.
' ###################################################
'
PROCEDURE checklev
  '
  semi$=sayrdlev$
  @strip.semi
  sayrdlev$=semi$
  sayrdlev.ck%=VAL(sayrdlev$)
  IF sayrdlev.ck%>=1 AND sayrdlev.ck<=9
    sayrdlev%=sayrdlev.ck%
  ENDIF
  '
  semi$=saywrlev$
  @strip.semi
  saywrlev$=semi$
  saywrlev.ck%=VAL(saywrlev$)
  IF saywrlev.ck%>=1 AND saywrlev.ck<=9
    saywrlev%=saywrlev.ck%
  ENDIF
  '
  semi$=sayturns$
  @strip.semi
  sayturns$=semi$
  sayturns.ck%=VAL(sayturns$)
  IF sayturns.ck%>=1 AND sayturns.ck<=50
    sayturns%=sayturns.ck%
  ENDIF
  '
  semi$=saylines$
  @strip.semi
  saylines$=semi$
  saylines.ck%=VAL(saylines$)
  IF saylines.ck%>=5 AND saylines.ck<=500
    saylines%=saylines.ck%
  ENDIF
  '
RETURN
'
' ##############################################
' ##############################################
' Procedure to strip comments from config lines.
' ##############################################
'
PROCEDURE strip.semi
  '
  IF INSTR(semi$,";")<>0
    scolon%=INSTR(semi$,";")
    semi$=TRIM$(LEFT$(semi$,scolon%-1))
  ENDIF
  '
RETURN
'
' #############################################
' #############################################
' This procedure returns to menu, or continues.
' #############################################
'
PROCEDURE tryagain
  '
  IF car%>0
    @finish
  ENDIF
  @msend(cr$+cr$+ansi$(2)+"        ["+ansi$(7)+"T"+ansi$(2)+"]ry Again.. or ("+ansi$(7)+"M"+ansi$(2)+")ain Menu? ")
  @mget(9,1,1,1)
  IF in$="M"
    in$=""
    go2menu!=TRUE
  ELSE
    in$=""
  ENDIF
  '
RETURN
'
' ###########################################
' ###########################################
' This procedure displays Information text.
' ###########################################
'
PROCEDURE sendtext
  '
  page1:
  on1now!=TRUE
  @msend(CHR$(27)+"[0;37m"+CHR$(12)+cr$+cr$)
  @msend(ansi$(4)+"     ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ"+cr$)
  @msend(ansi$(2)+"      SayHi (V"+versnum$+")  by Peter Nicolas. (c)1994. All rights reserved. "+cr$)
  @msend(ansi$(4)+"     ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ"+cr$)
  @msend(ansi$(6)+"     This simple door allows a user to enter '1-Line' messages for all"+cr$)
  @msend("     other users on the BBS.  The sysop has full control of the number"+cr$)
  @msend("     of lines that are stored, and the user levels that can read/write"+cr$)
  @msend("     messages.  Leave your sysop feedback should you like any settings"+cr$)
  @msend("     adjusted!  There's not much more to it.  I hope you like SayHi!"+cr$)
  @msend(ansi$(4)+"     ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ"+ansi$(0)+cr$)
  IF car%>0
    @finish
  ENDIF
  @getpage
  GOTO skipsend
  '
  page2:
  on2now!=TRUE
  @msend(CHR$(27)+"[0;37m"+CHR$(12)+cr$+cr$)
  @msend(ansi$(4)+"     ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ"+cr$)
  @msend(ansi$(2)+"      SayHi (V"+versnum$+")  by Peter Nicolas. (c)1994. All rights reserved."+cr$)
  @msend(ansi$(4)+"     ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ"+cr$)
  @msend(ansi$(6)+"     The author can be contacted via Netmail at fidonet (3:711/439) or"+cr$)
  @msend("     GlobalNet (54:6100/439) or AmigaNet (41:200/439).  Or call direct"+cr$)
  @msend("     to Budgie BBS.  In Australia: (043)99-2590.  Intl: 61-43-99-2590."+cr$)
  @msend(ansi$(4)+"     ÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ"+ansi$(0)+cr$)
  IF car%>0
    @finish
  ENDIF
  @getpage
  GOTO skipsend
  '
  page3:
  '
  skipsend:
  IF go1now!
    go1now!=FALSE
    GOTO page1
  ELSE IF go2now!
    go2now!=FALSE
    GOTO page2
  ENDIF
  '
RETURN
'
' #############################################
' #############################################
' This procedure sets up page selection prompt.
' #############################################
'
PROCEDURE getpage
  '
  @tchk
  @msend(cr$+ansi$(1)+"       <---("+ansi$(7)+"L"+ansi$(1)+")ast page         ("+ansi$(7)+"Q"+ansi$(1)+")uit to menu        ("+ansi$(7)+"N"+ansi$(1)+")ext page--->")
  '
  checkpage:
  @mget(9,1,0,1)
  IF car%>0
    @finish
  ENDIF
  '
  IF in$="Q"
    in$=""
    '
  ELSE IF in$="N" OR in$=""
    in$=""
    IF on1now!
      on1now!=FALSE
      go2now!=TRUE
    ELSE IF on2now!
      on2now!=FALSE
    ENDIF
    '
  ELSE IF in$="L"
    in$=""
    IF on1now!
      on1now!=FALSE
    ELSE IF on2now!
      on2now!=FALSE
      go1now!=TRUE
    ENDIF
    '
  ELSE
    in$=""
    GOTO checkpage
  ENDIF
  '
RETURN
'
' ###########################################
' ###########################################
' This procedure checks the SayHi line input.
' ###########################################
'
PROCEDURE checkline
  '
  lchk$=UPPER$(saymsg$)
  IF INSTR(lchk$,"SHIT-")<>0 OR INSTR(lchk$,"SHITHEAD")<>0 OR INSTR(lchk$,"SHITFACE")<>0 OR INSTR(lchk$,"PISS OFF")<>0 OR INSTR(lchk$,"PISS-OFF")<>0 OR INSTR(lchk$,"FUCK")<>0 OR INSTR(lchk$,"CUNT")<>0 OR INSTR(lchk$,"CLIT")<>0
    @msend(cr$+cr$+ansi$(7)+"       GET A LIFE, BUDDY!"+cr$)
    glife!=TRUE
    DELAY 2
  ELSE IF INSTR(lchk$,"DICK-")<>0 OR INSTR(lchk$,"DICKHEAD")<>0 OR INSTR(lchk$,"DICKFACE")<>0 OR INSTR(lchk$,"COCK-")<>0 OR INSTR(lchk$,"COCKSUC")<>0 OR INSTR(lchk$,"COCKFACE")<>0 OR INSTR(lchk$,"COCKBRE")<>0
    @msend(cr$+cr$+ansi$(7)+"       GET A LIFE, BUDDY!"+cr$)
    glife!=TRUE
    DELAY 2
  ELSE IF INSTR(lchk$,"ASS-")<>0 OR INSTR(lchk$,"ASSWIPE")<>0 OR INSTR(lchk$,"ASSHOLE")<>0 OR INSTR(lchk$,"LICK MY")<>0 OR INSTR(lchk$,"SUCK MY")<>0
    @msend(cr$+cr$+ansi$(7)+"       GET A LIFE, BUDDY!"+cr$)
    glife!=TRUE
    DELAY 2
  ENDIF
  IF car%>0
    @finish
  ENDIF
  '
RETURN
'
' #########################################
' #########################################
' This procedure handles the limit per day.
' #########################################
'
PROCEDURE sayquota
  '
  ' Check for "sayhi.quota" file
  jumpquota!=FALSE
  IF EXIST(qu$)
    OPEN "I",#31,qu$,4096
    WHILE NOT EOF(#31)
      LINE INPUT #31,xx$
      xx$=UPPER$(xx$)
      IF xx$=uname$
        LINE INPUT #31,xx$
        saycheck$=xx$
        jumpquota!=TRUE
      ELSE
        LINE INPUT #31,xx$
      ENDIF
      '
      EXIT IF jumpquota!
    WEND
    CLOSE #31
  ENDIF
  '
  IF jumpquota!
    IF LEFT$(saycheck$,9)=pd.date$
      IF saycheck$=pd.date$+" LINES:"+sayturns$
        saylimit!=TRUE
      ENDIF
    ENDIF
  ENDIF
  '
RETURN
'
' #########################################
' #########################################
' This procedure increments the quota file.
' #########################################
'
PROCEDURE sayupdate
  '
  IF NOT EXIST(qu$)
    OPEN "O",#31,qu$,1024
    PRINT #31,uname$
    PRINT #31,pd.date$+" LINES:1"
    CLOSE #31
  ELSE IF EXIST(qu$)
    ex$="copy "+qu$+" TO "+qu.o$
    EXEC ex$,-1,-1
    IF NOT jumpquota!
      OPEN "A",#31,qu$,1024
      PRINT #31,uname$
      PRINT #31,pd.date$+" LINES:1"
      CLOSE #31
    ELSE
      ' so the file exists AND the uname$ was found in it
      ' we had best shuffle it all over to a new file..
      ' So first determine what line needs to be added.
      '
      IF NOT LEFT$(saycheck$,9)=pd.date$
        ' ie there's an entry but it's not todays date..
        saynuline$=pd.date$+" LINES:1"
      ELSE
        ' this is the tricky one. Todays date so increment the value
        numadded$=TRIM$(MID$(saycheck$,17,3))
        numadded%=VAL(numadded$)
        numadded%=numadded%+1
        saynumt$=STR$(numadded%)
        saynuline$=pd.date$+" LINES:"+saynumt$
      ENDIF
      '
      ' open our quota file for input.
      OPEN "I",#31,qu$,4096
      '
      ' open our work file for output.
      OPEN "O",#32,qu.r$,4096
      '
      WHILE NOT EOF(#31)
        LINE INPUT #31,xx$
        xx$=UPPER$(xx$)
        xname$=xx$
        IF NOT xx$=uname$
          LINE INPUT #31,xx$
          ' While we're here, trim old entries..
          IF LEFT$(xx$,9)=pd.date$
            PRINT #32,xname$
            PRINT #32,xx$
          ENDIF
        ELSE
          LINE INPUT #31,xx$
          PRINT #32,xname$
          PRINT #32,saynuline$
        ENDIF
        EXIT IF EOF(#31)
      WEND
      CLOSE #32
      CLOSE #31
      ' copy work file to path$
      ex$="Copy "+qu.r$+" TO "+qu$
      EXEC ex$,-1,-1
      '
    ENDIF
  ENDIF
  '
RETURN
'
' #########################################
' #########################################
' This procedure handles the saylines file.
' #########################################
'
PROCEDURE saylines
  '
  @sayupdate
  '
  ' see if "sayhi.dat" exists.
  IF EXIST(da$)
    OPEN "I",#34,da$,4096
    WHILE NOT EOF(#34)
      LINE INPUT #34,xx$
      sayline$(nlines%)=TRIM$(xx$)
      nlines%=nlines%+1
      EXIT IF EOF(#34)
    WEND
  ENDIF
  CLOSE #34
  ' so add the new line to the array here.
  sayline$(nlines%)=saymsg$
  totlines%=nlines%+1
  IF totlines%>saylines%
    uselines%=saylines%
    lowline%=totlines%-saylines%
  ELSE
    uselines%=totlines%
    lowline%=0
  ENDIF
  '
  ' so open our work file.
  OPEN "O",#33,da.r$,4096
  WHILE (lowline%<nlines%+1)
    ' now PRINT to #33 the oldest line to be included..
    PRINT #33,sayline$(lowline%)
    lowline%=lowline%+1
    EXIT IF (lowline%=nlines%+2)
  WEND
  '
  ' rename old file for safety..
  ' may as well leave it there too!
  IF EXIST(da$)
    ex$="copy "+da$+" TO "+da.o$
    EXEC ex$,-1,-1
  ENDIF
  CLOSE #33
  ex$="Copy "+da.r$+" TO "+da$
  EXEC ex$,-1,-1
  '
RETURN
'
'
'
