'
' ################
'  SayHi by PKN
' ################
'
versnum$="$VER: SayHi 0.08 "
versnum$="0.08"
versdate$="7-Jan-95"
progname$="SayHi"
author$=" by Peter Nicolas. "
'
MODE 1
ON ERROR GOSUB woops
'
timeon%=CINT(TIMER/200)
@timeconv
time.o$=pd.time$
sysop%=9
'
DIM ansi$(12)
DIM sayline$(500)
'
cr$=CHR$(13)+CHR$(10)
de$=CHR$(8)+" "+CHR$(8)
esc$=CHR$(27)
'
' ###########################
'  So we need some variables.
' ###########################
'
sayrdlev%=1
saywrlev%=2
sayturns%=5
saylines%=20
'
' #################################################################
' Investigate our working environment from the s:metro.config file.
' #################################################################
'
IF EXIST("S:Metro.cfg")
  config$="S:Metro.cfg"
ELSE IF EXIST("BBS:Metro.cfg")
  config$="BBS:Metro.cfg"
ELSE IF EXIST("Metro.cfg")
  config$="Metro.cfg"
ELSE
  config$="XXX"
ENDIF
'
' Defaults
'
bbsname$="The OzMetro BBS"
sfd$="BBS:"
sysopname$="The Sysop"
winw$="640"
winh$="200"
'
IF config$<>"XXX"
  '
  OPEN "I",#2,config$,128
  DO WHILE (NOT EOF(#2))
    LINE INPUT #2,xx$
    xx$=TRIM$(xx$)
    xxu$=UPPER$(xx$)
    '
    IF xxu$="" OR LEFT$(xxu$,1)=";"
      ' Do nothing
    ELSE IF LEFT$(xxu$,7)="BBSNAME"
      xx$=MID$(xx$,8,255)
      xx$=TRIM$(xx$)
      bbsname$=xx$
    ELSE IF LEFT$(xxu$,9)="SYSOPNAME"
      xx$=MID$(xx$,10,255)
      xx$=TRIM$(xx$)
      sysopname$=xx$
    ELSE IF LEFT$(xxu$,11)="WINDOWWIDTH"
      xx$=MID$(xx$,12,255)
      xx$=TRIM$(xx$)
      winw$=xx$
    ELSE IF LEFT$(xxu$,12)="WINDOWHEIGHT"
      xx$=MID$(xx$,13,255)
      xx$=TRIM$(xx$)
      winh$=xx$
    ENDIF
    '
  LOOP UNTIL EOF(#2)
  CLOSE #2
ENDIF
'
'
' ###########################################
' find screen size required from Metro.config
' ###########################################
'
' this will open the screen at the size the SYSOP wants, and is extremely
' desirable rather than just hardcoding a 640*200 screen in. Some of us
' have the extremely nice video system called 'PAL' allowing for 640*256,
' which is far superior to the US 'Never Twice the Same Colour' (NTSC).
'
sw%=VAL(winw$)
sh%=VAL(winh$)
sx%=0
sy%=0
'
'
IF EXIST("RAM:Userdata")
  OPEN "I",#2,"RAM:Userdata",1024
  LINE INPUT #2,tpc$      ! Remaining time in minutes
  LINE INPUT #2,uname$    ! User's name
  LINE INPUT #2,id$       ! User number
  LINE INPUT #2,lev$      ! Security of caller (1-9)
  LINE INPUT #2,baud$     ! Baud rate
  LINE INPUT #2,ring$     ! Local (=0) or remote (=1)
  LINE INPUT #2,path$     ! The pathname for the door to use
  CLOSE #2
  '
ELSE
  '
  ' We have no ram:userdata, so we immediately assume that the
  ' door is being used in local mode (as a test while developing)
  ' or perhaps just being run by a sysop for the hell of it!
  '
  ' so we have a bit of a dodgy-up of the variables. The door will
  ' NOT work without these variables.
  '
  tpc$="60"                  ! An hour should do us nicely
  uname$="BORIS YELTZIK"     ! Well maybe someone else?
  id$="42"                   ! The ultimate answer
  lev$="9"                   ! Sysop clearance - maybe lower??
  baud$="19200"              ! Won't play a part in things here
  ring$="0"                  ! Very important. Now it's local and no modem
  '                          ! stuff is used. (Doesn't even open it)
  path$=""                   ! Sets to current directory..
  '
ENDIF
'
bd%=VAL(baud$)
tpc%=VAL(tpc$)
id%=VAL(id$)
lev%=VAL(lev$)
IF VAL(ring$)
  ring!=TRUE
ELSE
  ring!=FALSE
ENDIF
'
icon!=FALSE     ! let's open a screen and print locally, eh?
'
' scrnht% should be set to 1 line less than you actually have,
' to make room for the More? prompt itself
'
scrnht%=23
'
' and for the local screen, well, we KNOW how many lines there are anyway.
'
IF ring!=FALSE
  IF sh%>201
    scrnht%=27   ! See how much better PAL is? the extra lines are nice
  ELSE
    scrnht%=21   ! This may be 21 lines - anyway, figure it out yourself!
  ENDIF
ENDIF
'
@open_screen
@getstats
@status_window
@main_window
IF ring!=TRUE
  @open_serial
  DELAY 1    ! this is required for some (but not all) modems.
  '          ! only prob is if the modem needs it, and it's not here,
  '          ! it's either GURU or Task Held time. Mine doesn't need it.
  @set_baud(bd%)
ENDIF
'
' ###############################
' clear screen and send titles
' ###############################
'
@msend(CHR$(27)+"[0;37m"+CHR$(12)+cr$+cr$)
@centre("Presenting for your enjoyment!")
@msend(centred$+cr$+cr$)
@centre(progname$)
@msend(centred$+cr$)
@centre("(V"+versnum$+")")
@msend(centred$+cr$+cr$)
@centre("by Peter Nicolas")
@msend(centred$+cr$)
@centre("("+versdate$+")")
@msend(centred$+cr$+cr$)
@centre("Another OzMetro door by PKN!")
@msend(centred$+cr$+cr$)
'
' ###############################################
' get values from config and set levels and ansi.
' ###############################################
'
@config
@checklev
@checkansi
@setansi
'
' ###########################
' shorten some filenames for later
' ###########################
'
da.o$=path$+progname$+".dat.old"
da$=path$+progname$+".dat"
da.r$="RAM:"+progname$+".dat"
'
qu.o$=path$+progname$+".quota.old"
qu$=path$+progname$+".quota"
qu.r$="RAM:"+progname$+".quota"
'
' ======================================================================
main:
' ======================================================================
IF car%>0
  @finish
ENDIF
@timeconv
@dateconv(DATE$)
@msend(CHR$(27)+"[0;37m"+CHR$(12))
PRINT CHR$(27)+"[0 p"
'
@sayhimain
'
@tchk
IF car%>0
  @finish
ENDIF
IF ansi!=TRUE
  @msend(ansi$(7))
ENDIF
'
PRINT CHR$(27)+"[1 p"
@msend(SPACE$(40)+"Your Selection: ")
@mget(9,1,0,1)
PRINT CHR$(27)+"[0 p"
'
IF in$=""
  GOTO main
ENDIF
'
' Then you include a stack of IF-THEN statements dependent on what you want
' to do. Use IF-THENs, and NOT! SELECT/CASE so you can GOTO out of them
' in case the carrier's been dropped or they've run out of time.
'
'
IF in$="Q" OR car%>0
  in$=""
  @finish
ENDIF
'
IF in$="T"
  in$=""
  @timeconv
  @dateconv(DATE$)
  @msend(CHR$(27)+"[0;37m"+CHR$(12)+cr$+cr$+cr$)
  IF rtime%=1
    @msend(ansi$(2)+SPACE$(3)+"Time Remaining: "+ansi$(3)+STR$(rtime%)+" minute."+cr$+cr$)
  ELSE IF rtime%>1
    @msend(ansi$(2)+SPACE$(3)+"Time Remaining: "+ansi$(3)+STR$(rtime%)+" minutes"+cr$+cr$)
  ENDIF
  @msend(ansi$(2)+SPACE$(5)+"System Date:  "+ansi$(1)+pd.date$+cr$)
  @msend(ansi$(2)+SPACE$(5)+"System Time: "+ansi$(1)+pd.time$+cr$+cr$)
  IF car%>0
    @finish
  ENDIF
  @press
  GOTO main
ENDIF
'
IF in$="R"
  in$=""
  @msend(CHR$(12)+ansi$(3))
  @checkansi
  IF car%>0
    @finish
  ENDIF
  @setansi
  @setpagepause
  IF car%>0
    @finish
  ENDIF
  @setabscon
  IF car%>0
    @finish
  ENDIF
  GOTO main
ENDIF
'
IF in$="I"
  in$=""
  @sendtext
  IF car%>0
    @finish
  ENDIF
  GOTO main
ENDIF
'
IF in$="D"
  in$=""
  @msend(CHR$(27)+"[0;37m"+CHR$(12)+cr$)
  IF lev%>=sayrdlev%
    @seq.out(da$)
  ELSE
    @msend(cr$+ansi$(1)+"  Sorry.. Access denied!"+cr$+cr$)
  ENDIF
  IF car%>0
    @finish
  ENDIF
  @press
  GOTO main
ENDIF
'
IF in$="S"
  nlines%=0
  in$=""
  retry:
  IF car%>0
    @finish
  ENDIF
  @msend(CHR$(27)+"[0;37m"+CHR$(12)+cr$)
  @msend(ansi$(6)+" Say Hi, "+uname$+".."+cr$)
  IF lev%>=saywrlev%
    ' So first check if they've entered maximum messages allowed..
    @sayquota
    IF saylimit!=TRUE
      @msend(cr$+ansi$(2)+" Sorry, You've reached your quota for today!"+cr$)
      @press
      in$=""
      GOTO main
    ENDIF
    '
    PRINT CHR$(27)+"[1 p"
    @msend(cr$+ansi$(2)+" Enter Your 1-Line Message Here! (Maximum 78 characters)"+cr$+cr$+ansi$(1)+" >"+ansi$(3))
    @mget(1,78,0,1)
    PRINT CHR$(27)+"[0 p"
    saymsg$=TRIM$(in$)
    '
    IF in$=""
      @msend(cr$+ansi$(6)+" Are you sure you want to enter a blank line? (y/N) ")
      @mget(3,1,0,1)
      IF in$="NO"
        in$=""
        @tryagain
        IF go2menu!
          go2menu!=FALSE
          GOTO main
        ENDIF
        GOTO retry
      ELSE
        in$=""
        @saylines
      ENDIF
    ELSE
      in$=""
      @correct
      IF NOT in$="YES"
        in$=""
        @tryagain
        IF go2menu!
          go2menu!=FALSE
          GOTO main
        ENDIF
        GOTO retry
      ELSE
        in$=""
        @checkline
        IF glife!
          glife!=FALSE
          GOTO main
        ENDIF
        @saylines
      ENDIF
    ENDIF
    '
  ELSE
    @msend(cr$+ansi$(1)+"  Sorry.. Access denied!"+cr$+cr$)
    @press
  ENDIF
ENDIF
'
in$=""
GOTO main
'
' ###############################################################
' ###############################################################
' #                                                             #
' #  P R O C E D U R E S   F O L L O W   T H I S   N O T I C E  #
' #                                                             #
' ###############################################################
'
' ###################################################
' #####################(P. DEANE)#######(Mod.PKN)####
' ###################################################
'
PROCEDURE woops
  '
  ' For this to work properly of course, you must compile with
  ' English error messages turned on! (-E &E)
  '
  @msend(cr$+CHR$(7)+cr$+ansi$(1)+"Woops - FATAL ERROR!!"+cr$)
  @msend(cr$+CHR$(7)+"This will be logged for the sysop. You may even be able"+cr$)
  @msend("to re-run the door, and have it work fine - just try to avoid what you"+cr$)
  @msend("just did then!"+cr$)
  @msend(cr$+cr$+"Exiting door now. Please hold")
  @log(progname$+" crashed!!",1)
  @log("--> "+ERR$(ERR),0)
  DELAY 4
  '
  RESUME finish
  '
RETURN
'
' ############################################
' ############################################
' This procedure finishes the game up & exits.
' ############################################
'
PROCEDURE finish
  '
  @msend(CHR$(12)+cr$)
  @centre(progname$)
  @msend(ansi$(2)+centred$+cr$+cr$)
  @centre("by Peter Nicolas")
  @msend(ansi$(3)+centred$+cr$+cr$)
  @centre("Written in GFA-BASIC V3.51")
  @msend(ansi$(1)+centred$+cr$+cr$)
  @centre("Call 'Budgie BBS' on:")
  @msend(ansi$(6)+centred$+cr$+cr$)
  @centre("61-43-99-2590")
  @msend(ansi$(3)+centred$+cr$+cr$+cr$)
  IF EXIST(qu.r$)
    KILL qu.r$
  ENDIF
  IF EXIST(da.r$)
    KILL da.r$
  ENDIF
  IF EXIST("RAM:Userdata")
    KILL "RAM:Userdata"
  ENDIF
  DELAY 1
  @msend(cr$+cr$+ansi$(7)+SPACE$(4)+"Please hold - Reloading "+bbsname$)
  '
  IF ring!=TRUE
    @close_serial
  ENDIF
  '
  DELAY 1
  END
  '
RETURN
'
' ###################################################
' #####################(Author??)####################
' ###################################################
'
PROCEDURE open_serial
  '
  ' First thing is to setup the variables to simulate a C structure
  ' (originally this was a PROC, but why not just do it when you open
  ' the modem. Saves using this mem for local logins).
  '
  ' May I also add that I don't know who wrote these shared modem routines
  ' but I love them!!!! and he deserves to take a bow.
  '
  cmd_read%=2              ! Similar to INPUT #1,
  cmd_write%=3             ! Similar to PRINT #1,
  cmd_clear%=5
  sdcmd_break%=10          ! Special Serial Device commands
  sdcmd_query%=9           ! This command polls the serial device for how many chars to read
  sdcmd_setparams%=11      ! We will use this to adjust the buffer size **********
  '
  '
  ' These are the offsets into the IOExtSer structure (ie. we poke the commands
  ' like cmd_read into the io.command member, then DoIO to perform the read
  '
  io.command%=28           ! 2 byte command to perform (see directly above)
  io.flags%=30             ! 1 byte
  io.error%=31             ! 1 byte error # of last command
  io.actual%=32            ! 4 byte actual bytes read or written
  io.length%=36            ! 4 byte length of data to read or write
  io.data%=40              ! 4 byte address of data to send or recieve
  io.offset%=44            ! 4 byte ???
  io.ctlchar%=48           ! 4 byte handshaking = $11130000
  io.rbufflen%=52          ! 4 byte suggested size of the hardware buffer (16K ?)
  io.extflags%=56          ! 4 byte parity flags for serial port/modem
  io.baud%=60              ! 4 byte actual baud rate to use (1200, 2400, etc.)
  io.brktime%=64           ! 4 byte break time in micro seconds (250000 ?)
  io.termarray%=68         ! 8 byte a list of 8 termination characters (???????)
  io.readlen%=76           ! 1 byte # of bits per read character (7-8)
  io.writelen%=77          ! 1 byte # of bits per write character (should be same as read)
  io.stopbits%=78          ! 1 byte # of stop bits (1 or 2)
  io.serflags%=79          ! 1 byte serial port flags -
  '
  iof_quick%=1
  '
  serf_7wire|=4
  serf_eofmode|=64
  serf_parity_odd|=2
  serf_parity_on|=1
  serf_queuedbrk|=8
  serf_rad_boogie|=16
  serf_shared|=32         !This is the flag to set at OpenDevice for shared mode
  serf_xdisabled|=128     !this flag should also be set at OpenDevice
  '
  io.status%=80           ! 2 bytes set when we issue a SDCMD_QUERY
  '                      Bit# | what its for
  '                         0 = reserved
  '                         1 = reserved
  '                         2 = ring indicator on 500/2000
  '                         3 = Data set ready      (DSR)
  '                         4 = Clear To Send       (CTS)
  '                         5 = Carrier Detect      (CD)
  '                         6 = Ready to send       (RTS)
  '                         7 = Data Terminal Ready (DTR)
  '                         8 = Read overrun
  '                         9 = Break sent
  '                        10 = Break recieved
  '                        11 = transmit x-OFFed
  '                        12 = receive x-OFFed
  '
  sizeof_extserio%=82      ! The size of the ExtSerIO struct
  '
  '
  ' open the modem
  '
  device_name$="serial.device"+CHR$(0)
  '
  write_port%=CreatePort(0,0)
  write_io%=CreateExtIO(write_port%,sizeof_extserio%)
  read_port%=CreatePort(0,0)
  read_io%=CreateExtIO(read_port%,sizeof_extserio%)
  '
  POKE write_io%+io.serflags%,serf_7wire|+serf_shared|+serf_xdisabled|
  '
  ~OpenDevice(V:device_name$,0,write_io%,0)      ! Open the device
  '
  '
  LPOKE write_io%+io.baud%,19200                ! baud rate
  POKE write_io%+io.readlen%,8                  ! # read bits
  POKE write_io%+io.writelen%,8                 ! # write bits
  POKE write_io%+io.stopbits,1                  ! Stop bits - 1 please
  LPOKE write_io%+io.ctlchar%,&H1113000         ! handshaking
  LPOKE write_io%+io.rbufflen%,1024             ! hardware buffer size
  DPOKE write_io%+io.command%,sdcmd_setparams%
  ~DoIO(write_io%)
  '
  ' now copy the write_io request into the read_io request
  '
  FOR a%=20 TO sizeof_extserio%
    POKE read_io%+a%,PEEK(write_io%+a%)
  NEXT a%
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE close_serial
  ' close the modem
  ~AbortIO(write_io%)
  ~WaitIO(write_io%)
  ~CloseDevice(write_io%)
  '
  ' free up the memory of the IO request structure (must be 88!)
  '
  ~MFREE(write_io%,88)
  ~MFREE(read_io%,88)
  '
  ' Delete the message port
  '
  ~DeletePort(write_port%)
  ~DeletePort(read_port%)
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE ser_recv1
  ' read in data 1 byte at a time like a$=INPUT$(1,1)
  '
  ' first we check to see if there is any incoming data, and if so store the
  ' number of characters waiting in the variable waiting%
  '
  r_data$=""
  DPOKE read_io%+io.command%,sdcmd_query%
  ~DoIO(read_io%)
  waiting%=LPEEK(read_io%+io.actual%)
  IF waiting%<>0
    r_data$=SPACE$(1)
    DPOKE read_io%+io.command%,cmd_read%
    LPOKE read_io%+io.length%,1
    LPOKE read_io%+io.data%,V:r_data$
    ~DoIO(read_io%)
  ENDIF
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE ser_purge
  DPOKE read_io%+io.command%,cmd_clear%
  ~DoIO(read_io%)
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE chk_car
  ' no carrier=-1  |  valid carrier=0
  '
  DPOKE write_io%+io.command%,sdcmd_query%
  ~DoIO(write_io%)
  status&=DPEEK(write_io%+io.status%)
  car!=BTST(status&,5)
  IF car!=TRUE
    car%=20
  ENDIF
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE set_baud(baud%)
  '
  ' baud%        = actual baud rate (300,1200,2400,etc)
  '
  LPOKE write_io%+io.baud%,baud%
  DPOKE write_io%+io.command%,sdcmd_setparams%
  ~DoIO(write_io%)
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE msend(fred$)
  '
  ' [Sends the string out to the screen and modem if needed]
  '
  ' This will NOT send ANY text if the carrier has been dropped
  ' but WILL send text if car% is a value in case they've run out
  ' of time, etc.
  '
  IF icon!=FALSE
    PRINT fred$;
  ENDIF
  '
  IF ring!=TRUE
    @chk_car
    IF car!=FALSE
      ' send data string fred$ out to modem
      DPOKE write_io%+io.command%,cmd_write%
      LPOKE write_io%+io.length%,LEN(fred$)
      LPOKE write_io%+io.data%,V:fred$
      ~DoIO(write_io%)
    ENDIF
  ENDIF
  fred$=""
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE mget(intype%,inlength%,yesdef!,wait!)
  '
  ' [Usage @mget(intype%,inlength%,yesdef!,wait!) ]
  '
  ' input type= 0  Hot key response. Converted to uppercase. Always 1 char
  '           = 1  Normal Upper/Lowercase text input.
  '           = 2  UPPERCASE only text input
  '           = 3  Yes/No response. Will default to YES if yesdef!=TRUE
  '           = 4  Numerical input only
  '           = 5  For the Metro Line Editor's use
  '           = 9  No echoing, converted to uppercase.
  '
  ' input length   Just how many chars you want (max)
  '
  ' yesdef!   = TRUE then if <rtn> pressed, default is 'YES'+cr$
  '           = FALSE then if <rtn> pressed, default is 'NO'+cr$
  '             only applies for type 3 input, so can be anything otherwise
  '
  ' wait!     = TRUE, we'll wait until something is input
  '           = FALSE then if nothing pressed, we'll return and return
  '             in$=""
  '
  '
  LOCAL cd%,a$,key$,keyy%,b%,in1$,idle%
  '
  idle%=CINT(TIMER/200)
  ' /\ can't have them taking all day!
  '
  key$=""
  in$=""
  in1$=""
  a%=0
  keyy!=FALSE
  b%=0
  car%=0
  abort!=FALSE
  '
  ' Remember if car!=TRUE, then they DROPPED carrier!!!!!!
  '
  DO
    '
    IF MOUSEK=3
      ALERT 0,"REALLY kill "+progname$+" ?",2,"Yes|No",xx%
      IF xx%=1
        CLOSES 1
        IF ring!=TRUE
          @close_serial
        ENDIF
        END
      ENDIF
    ENDIF
    ' /\ a way out...
    '
    IF ring!=TRUE
      @chk_car
      IF car!=TRUE
        keyy!=TRUE
        abort!=TRUE
        ' set all the flags for an early departure! :-)
      ENDIF
    ENDIF
    '
    key$=INKEY$
    '
    ' Here we parse the Fkeys, they will only work when the door
    ' is waiting for input (most of the time). If not, then they WILL go
    ' into a buffer, and next time the serial sequence is entered they
    ' will go to work.
    '
    IF LEN(key$)>1 AND LEFT$(key$,1)=CHR$(155)
      '
      xx%=ASC(MID$(key$,2,1))
      IF xx%=48         ! F1
        ALERT 0,"Really kick em off?",2,"Yes|No",xx%
        IF xx%=1
          car%=20
          keyy!=TRUE
          abort!=TRUE
        ENDIF
      ENDIF
      IF xx%=50         ! F3
        IF icon!=TRUE
          icon!=FALSE
          CLOSEW #2
        ELSE
          icon!=TRUE
          CLOSEW #2
        ENDIF
        @main_window
        ~ActivateWindow(WINDOW(2))
      ENDIF
    ENDIF
    '
    EXIT IF car!=TRUE
    '
    ' no point going on, they've dropped carrier. Get rid of them!
    '
    IF ring!=TRUE AND key$=""
      ' sep test for ring!=TRUE cos if no user - no modem!
      @ser_recv1
      IF r_data$<>""
        key$=r_data$
      ENDIF
    ENDIF
    '
    IF key$=CHR$(19)
      ' Wow, they pressed ctrl-S. Let's pause a bit.
      pau$=""
      hold%=CINT(TIMER/200)
      '
      WHILE CINT(TIMER/200)<hold%+45
        ' pause for a MAXIMUM of /\ 45 seconds
        pau$=INKEY$
        IF ring!=TRUE
          IF LOC(#1)>0
            pau$=INPUT$(1,#1)
          ENDIF
        ENDIF
        EXIT IF pau$<>""
      WEND
      '
      key$=""
      pau$=""
    ENDIF
    '
    '
    IF wait!=FALSE
      keyy!=TRUE
      IF key$=" " OR key$="N" OR key$="S" OR key$="n" OR key$="s" OR key$=CHR$(3)
        abort!=TRUE
      ENDIF
    ENDIF
    '
    EXIT IF abort!=TRUE
    '
    IF key$=""
      GOTO getjump1
      ' /\ not worth running through the processing any further
    ENDIF
    '
    '
    a%=ASC(key$)
    b%=LEN(in$)
    '
    IF (a%=8 OR a%=127) AND LEN(in$)>=1
      in$=LEFT$(in$,b%-1)
      DEC b%
      @msend(de$)
    ENDIF
    '
    IF b%=inlength%
      GOTO getjump1
    ENDIF
    '
    IF intype%=0
      IF a%>31 AND a%<126
        key$=UPPER$(key$)
        @msend(key$+cr$)
        in$=key$
        keyy!=TRUE
      ENDIF
      '
    ELSE IF intype%=1 AND a%>31 AND a%<126
      @msend(key$)
      in$=in$+key$
      '
    ELSE IF intype%=2 AND a%>31 AND a%<126
      key$=UPPER$(key$)
      @msend(key$)
      in$=in$+key$
      '
    ELSE IF intype%=3
      IF a%=13 AND yesdef!=TRUE
        @msend("YES")
        in$="YES"
        keyy!=TRUE
      ELSE IF a%=13 AND yesdef!=FALSE
        @msend("NO")
        in$="NO"
        keyy!=TRUE
      ELSE IF a%=89 OR a%=121
        @msend("YES"+cr$)
        in$="YES"
        keyy!=TRUE
      ELSE IF a%=78 OR a%=110
        @msend("NO"+cr$)
        in$="NO"
        keyy!=TRUE
      ENDIF
      '
    ELSE IF intype%=4 AND a%>47 AND a%<58
      @msend(key$)
      in$=in$+key$
      '
    ELSE IF intype%=5
      '
      ' intype% needed for the Metro Line Editor.
      '
      ' DO NOT USE THIS unless using the Metro Line editor!!
      '
      ' this will rely on dim'ing ln$() and keeping ln% as the line #
      ' for an application of this, the BBBase door is the one to check out
      '
      IF (a%=8 OR a%=127) AND LEN(ln$(ln%))>=1
        ln$(ln%)=LEFT$(ln$(ln%),LEN(ln$(ln%))-1)
        @msend(de$)
        keyy!=TRUE
      ELSE IF a%=13
        in$=key$
        keyy!=TRUE
      ELSE IF a%=9
        @msend("        ")
        in$="        "
        keyy!=TRUE
      ELSE IF a%>=loascii% AND a%<>126 AND a%<=hiascii%
        @msend(key$)
        in$=key$
        keyy!=TRUE
      ENDIF
      '
    ELSE IF intype%=9
      ' no echoing of input and conversion to uppercase
      IF a%>31 AND a%<126
        key$=UPPER$(key$)
        in$=key$
        keyy!=TRUE
      ENDIF
      '
      ' \/ Of modem get types!
    ENDIF
    '
    ' Well, if we needed to jump, come to here...
    getjump1:
    '
    ' Handle our carriage returns..
    IF a%=13
      IF (intype%<>5 AND intype%<>9)
        @msend(cr$)
      ENDIF
      keyy!=TRUE
    ENDIF
    ' Look after idle timer
    '
    IF CINT(TIMER/200)>idle%+300
      IF lev%>=sysop% AND CINT(TIMER/200)>idle%+600
        car%=5
        keyy!=TRUE
        abort!=TRUE
      ELSE IF lev%<sysop%
        car%=5
        keyy!=TRUE
        abort!=TRUE
      ENDIF
    ENDIF
    '
  LOOP UNTIL keyy!=TRUE
  '
RETURN
'
' ###################################################
' #####################(P. DEANE)####################
' ###################################################
'
PROCEDURE mpos(line%,col%)
  '
  ' [Locates the cursor at the position specified]
  @msend(esc$+"["+STR$(line%)+";"+STR$(col%)+"H")
RETURN
