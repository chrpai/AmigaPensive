PROCEDURE open_screen
  OPENS 1,sx%,sy%,sw%,sh%,3,32768
  '
  IF ring!=TRUE
    FRONTS 1
  ENDIF
  '
  SETCOLOR 0,&H0
  SETCOLOR 1,&HF11
  SETCOLOR 2,&H1F1
  SETCOLOR 3,&HFF1
  SETCOLOR 4,&H55F
  SETCOLOR 5,&HF1F
  SETCOLOR 6,&H1FF
