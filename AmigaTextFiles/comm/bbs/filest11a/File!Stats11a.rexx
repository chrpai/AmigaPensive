;OPTIONS RESULTS;Port=ADDRESS();TR=TRANSMIT;GU=GETUSER;CALL Init;CALL Picture;CALL Inserts;EXIT;Init:;Esc='1b'x;Ps=ESC'[';bbsidentify name;BBSName=RESULT;BBSIDENTIFY SYSOP;BBSSysop=RESULT;BBSIDENTIFY BBS;BBSVer=RESULT;GU 1;Alias=RESULT;GU 3;Realname=RESULT;GU 4;city=RESULT;GU 5;zip=RESULT;GU 6;street=RESULT;GU 7;Timeleft=RESULT;GU 10;phone=RESULT;GU 11;lastcall=RESULT;GU 14;Birth=RESULT;GU 16;title=RESULT;GU 17;Sysopxs=RESULT;GU 22;tcalls=RESULT;GU 24;baud=RESULT;GU 25;frat=RESULT;GU 26;brat=RESULT;GU 29;data=RESULT;GU 32;comp=RESULT;GU 34;bup=RESULT;GU 35;fup=RESULT;GU 36;bdn=RESULT;GU 37;fdn=RESULT;GU 40;id=RESULT;GU 42;bcred=RESULT;GU 43;fcred=RESULT;GU 44;lastcps=RESULT;RETURN;Picture:;CLS;TR '\@4\c7-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-';TR '\c1       E! -=[STATS]=- \c3v1.1a \c6 by\c2 Reboot - http://www.lls.se/~tintin/reboot';TR '\c7-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-';TR '';TR '\c7 BBS                                      FILES';TR '\c2 BBSName     \c5:                            Transfer Rate    :';TR '\c2 Version     \c5:                            File Ratio       :';TR '\c2 Sysop Name  \c5:                            Byte Ratio       :';TR '\c5                                          File Credits     :';TR '\c7 PERSONAL                             \c5    Byte Credits     :';TR '\c5 ID          :                            Files Uploaded   :';TR '\c5 Real name   :                            Bytes Uploaded   :';TR '\c5 Handle      :                            Files Downloaded :';TR '\c5 Street      :                            Bytes Downloaded :';TR '\c5 Zipcode     :                            Last CPS         :';TR '\c5 City        :';TR '\c5 Birthdate   :';TR '\c5 Voice No.   :                            \c7Send bugreports to';TR '\c5 Data No.    :                            \c7jkg@w11.iwg.nl, for';TR '\c5 Access      :                            \c7updates,check Aminet!';TR '\c5 Computer    :';TR '\c5 Total Calls :';TR '\c5 Last call   :                            Time Remaining   :';TR '';TR '\c7-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-';TR '\c1       E! -=[STATS]=- \c3v1.1a \c6 by\c2 Reboot - http://www.lls.se/~tintin/reboot';TR '\c7-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-=====-';RETURN;Inserts:;TR PLACE(16,6)'\@4\c6'BBSname;TR PLACE(16,7)'\c6'BBSver;TR PLACE(16,8)'\c6'BBSSysop;TR PLACE(16,11)'\c3'id;TR PLACE(16,12)'\c3'Realname;TR PLACE(16,13)'\c3'alias;TR PLACE(16,14)'\c3'street;TR PLACE(16,15)'\c3'zip;TR PLACE(16,16)'\c3'city;TR PLACE(16,17)'\c3'birth;TR PLACE(16,18)'\c3'phone;TR PLACE(16,19)'\c3'data;TR PLACE(16,20)'\c3'title;TR PLACE(16,21)'\c3'comp;TR PLACE(16,22)'\c3'tcalls;TR PLACE(16,23)'\c3'lastcall;/* Now the right part of the screen :)) */;TR PLACE(62,6)'\c3'baud;TR PLACE(62,7)'\c3'frat'\c2:\c31';TR PLACE(62,8)'\c3'brat'\c2:\c31';TR PLACE(62,9)'\c3'fcred;TR PLACE(62,10)'\c3'bcred;TR PLACE(62,11)'\c3'fup;TR PLACE(62,12)'\c3'bup;TR PLACE(62,13)'\c3'fdn;TR PLACE(62,14)'\c3'bdn;TR PLACE(62,15)'\c3'lastcps;TR PLACE(62,23)'\c3'timeleft'\c3 Mins';TR '\n4\c6Press a key!\g0';CLS;RETURN;PLACE:PROCEDURE EXPOSE Ps;PARSE ARG x,y;Plaats=PS||y||';'||x||'H';RETURN(Plaats)