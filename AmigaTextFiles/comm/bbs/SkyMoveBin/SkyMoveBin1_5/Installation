;Installationsscript für Commodore Installer

(set @default-dest "Prometheus:SkyTools")
(transcript "Installation von SkyMoveBin V1.5")

(set sourc "install/")
(set desti (tackon @default-dest "SkyMoveBin"))

(message
  "\n\n\n\nWillkommen bei der SkyMoveBin V1.5 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)

(working)

(if (= (exists (tackon @default-dest "SkyMoveBin")) 0 (makedir (tackon @default-dest "SkyMoveBin") (infos) )))

(complete 20)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "SkyMoveBinA" "SkyMoveBinB" "SkyMoveBin.guide" "SkyMoveBin.cfg" "NetzAntrag.txt")
  (source sourc)
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 80)

(makeassign "SkyTools" "Prometheus:SkyTools")

(startup "SkyTools"
  (prompt "\n\n\n\nDas SkyTools-Assign wird nun Ihrer User-Startup zugefügt.")
  (help @startup-help)
  (command "Assign SkyTools: \"" @default-dest "\"\n")
)

(complete 100)

(message
  "\n\n\nZur weiteren Installation und Konfiguration von SkyMoveBin schauen "
  "Sie bitte in die Anleitung.\n\n"
)

(Message
  "\n\n\nFür alle SkyTools existiert ein eigenes Support-Netz, das SkyNetz, in dem Sie Informationen, Hilfestellung, Diskussionen und natürlich die neusten Versionen der Programme erhalten."
)
