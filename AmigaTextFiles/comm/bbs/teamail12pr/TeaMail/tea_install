(complete 5)

(message "\nTeaMail v1.2 [public release]\n\n"
         "Installer\n\n"
         "-+- Digital Design Production 1995-7 -+-"
)

(complete 10)

(set rexxdir
		  (askdir
					 (prompt "Where is your BBS Rexx Directory located?")
					 (help @askdir-help)
					 (default "BBS:Rexx")
		  )
)

(complete 20)

(set docsdir
		  (askdir
					 (prompt "Where is your BBS Docs Directory located?")
					 (help @askdir-help)
					 (default "BBS:Docs")
		  )
)

(complete 30)

					 (copyfiles (source "rexx") (dest (rexxdir)) (all))

(complete 40)

					 (copyfiles (source "docs/teamail.guide") (dest (docsdir)))

(complete 50)

(message "\n\n Now take a look at the docs please :-)")
					 (run "c/guide docs/teamail.guide")

(complete 60)

(message "\n\n Please edit logon.trans to include an entry for [TeaCheck]\n"
			"Similair To:\n\n"
			"call 'bbs:rexx/teacheck.trans\n"
)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:rexx/logon.trans")
	)
)

(complete 70)

					 (run edline)

(complete 75)

(message "\n\n Please edit Main.rx to include an entry for\n"
			"checking & writing e-mails:\n\n"
			"e.g.\n\n"
			"C Check E-Mails           10 -------- teacheck.trans\n"
			"C Write E-Mail            10 -------- teamail.trans\n"
)
(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Configs/main.rx")
	)
)

					 (run edline)

(complete 90)

(message "\n\n Please edit the .trans files and alter the\n"
			"variables to suite your needs:\n"
)
(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Rexx/teacheck.trans")
	)
)

					 (run edline)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Rexx/teamail.trans")
	)
)

(complete 95)

					 (run edline)

(complete 100)

(message "\n\n\n\n-<*>- TeaCheck Is Now Installed - Enjoy! -<*>-\n"
         "-<*>- Thanx For Choosing Digital Design -<*>-\n"
)
