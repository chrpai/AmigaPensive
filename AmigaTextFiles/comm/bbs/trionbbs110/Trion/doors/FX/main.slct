
;  Configuration for the Select Tron FX Door.

;  The place where the menu lines are:
;
;  SOURCE  path/file

SOURCE   "doors:fx/test.lines"

;  Position on the screen where to display the line:
;
;  POS  x  y

POS      40  5

;   Length of the inverted part of the text.
;
;   SIZE  n

SIZE     17

;   Time in 50th seconds between actions
;
;   DELAY  n

DELAY    5

