
;  Configuration for the Scroller Tron FX Door.

;  Text line we want to Scroll (max. 220 characters)
;
;  TEXT  "........"

TEXT     "   <<<    Amiga Pet Shop BBS.   >>>   Amiga Pet Shop BBS."

;   Size of the visable part of the line of the screen
;
;   SIZE  n

SIZE     35

;   Time in 50th seconds between actions
;
;   DELAY  n

DELAY    5

;  Position on the screen where to display the line:
;
;  POS  x  y

POS      20  23

;  Do we want the text between [...] characters ?
;
;  BOX

;BOX

;;  The Low and Hi-intensity colors you can use.
;;
;;  BLACK   RED   GREEN   YELLOW   BLUE   MAGENTA   CYAN   WHITE
;;  HIBLACK HIRED HIGREEN HIYELLOW HIBLUE HIMAGENTA HICYAN HIWHITE

;;  Define the ForeGround (is text) color

FCOL    HICYAN

;;  Define the BackGround color   (only low intensity !).

BCOL    BLACK

