

Menu "main_rip.menu"

FLAGS  hotkeyable, noscreen
level  0 - 255 , "Main_rip.Ansi"
prompt 0 , 0 - 255 , "|Main Menu : "
prompt 1 , 0 - 255 , "|Menu : "

BEGIN     ; Start the command definitions


MenuBegin
;   Print "MainMenu|"
   LogMessage "Entered main menu."
;   Print "[2!|"                          ;RIP-scrip mode on
EndCmd

;MenuEnd
;   Print "[1!|"                          ;RIP-scrip mode off
;EndCmd

;CommandBegin
;   Print "vvv"
;EndCmd

;CommandEnd
;   Print "^^^"
;EndCmd

BuildScreen
;;   PrintFile "trion:menutext/main.ansi"
;   CliDoor  "doors:FX/Random   ~50  main.rndm"
;   CliDoor  "doors:FX/scroller ~50  main.scrl"


;   CliDoor  "doors:FX/text ~50  main.text"
   CliDoor  "trion:utils/ripdoor ~50 0"


;;   CliDoor  "doors:FX/blink    ~50  main.blnk"
EndCmd


Cmd "V"
   CliDoor  "doors:FX/AddText ~50  main.text"
EndCmd


Cmd "G" , 0-255
   GotoMenu "Logout_rip.Menu"
EndCmd

Cmd "F" , 0-255
   GotoMenu "File_rip.Menu"
EndCmd

Cmd "M" , 0-255
   GotoMenu "Mail_rip.Menu"
EndCmd

Cmd "D" , 0-255
   GotoMenu "Door_rip.Menu"
EndCmd

Cmd "E" , 0-255
   GotoMenu "UserEdit_rip.Menu"
EndCmd

Cmd "B" , 0-255
   GotoMenu "Bulletin_rip.Menu"
EndCmd

Cmd "T" , 0-255
   GotoMenu "Test_rip.Menu"
EndCmd


; Toggle from RIP to ANSI menu's

Cmd "R" , 5 - 255
   GotoMenu "Main.Menu"
EndCmd


Cmd "$" , 0-239
   PassWord "test110"         ;voor Sysop als User online
   GotoMenu "Sysop.Menu"
EndCmd

Cmd "$" , 240-254
   PassWord "test110"              ;voor Cosysop level
   GotoMenu "Sysop_rip.Menu"
EndCmd


Cmd "$" , 255
   PassWord "test110"         ;voor Sysop level
   GotoMenu "Sysop_rip.Menu"
EndCmd



Cmd "P" , 0-255
   PageSysop
;   CliDoor  "doors:chatdoor/PageDoor ~50 "
;   CliDoor  "doors:chatdoor/RoboChat ~50 "
EndCmd

Cmd "=" , 0-255 , S
   CliDoor  "doors:chatdoor/SplitChat ~50 "
EndCmd

Cmd "-" , 0-255 , S
   CliDoor  "doors:chatdoor/LineChat ~50 "
EndCmd

Cmd "\" , 0-255 , S
   ClrScr
   FlushBuffer                           ; Flush the return after "\"
   PushIntoBuffer "Hallo daar !!|"
   StartChat
EndCmd




Cmd "C" , 0-255
   CommentToSysop
EndCmd


Cmd "I" , 0-255
   CliDoor  "trion:doors/conf/conf '~200' ~50 "
EndCmd






Cmd "S" , 0-255
   CliDoor  "doors:SendNodeMsg/SendNodeMsg ~50"
EndCmd


Cmd "L" , 0-255
;   DosCommandSync  "trion:utils/listnodes >ram:mylist"
;   Print "|Node Actie                              Name            Place Level |"
;   Print "====================================================================|"
;   Print "ออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออ|"
;   PrintFile   "ram:mylist"

   CliDoor  "trion:utils/listnodes ANSI"

   More
EndCmd






END

