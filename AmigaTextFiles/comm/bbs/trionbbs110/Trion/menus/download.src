
Menu "download.menu"

flags  hotkeyable
level  0 - 255 , "Download.Ansi"
prompt 0 , 0 - 255 , "|Download Menu : "
prompt 1 , 0 - 255 , "|Download Menu : "

BEGIN     ; Start the command definitions


Cmd "M"
   MarkFile
   ListMarkedFiles
EndCmd

Cmd "A"
   MarkName "ALLFILES.LHA"
   ListMarkedFiles
EndCmd

Cmd "V"
;   ListMarkedFiles
   KillMarkedFile
   ListMarkedFiles
EndCmd

Cmd "*"
   UnmarkFiles
   ListMarkedFiles
EndCmd

Cmd "D"
   MarkFile
   Download
   More
EndCmd

Cmd "Q"
   PreviousMenu                             ;  GotoMenu "File.Menu"
EndCmd

Cmd "G"
   Download
   DownloadLogout "5"                       ;  Waits 5 secs for an abort key
EndCmd

Cmd "D"
   Download
   More
   PreviousMenu                             ;  GotoMenu "File.Menu"
EndCmd

Cmd ""                                      ;  Action on return
   Download
   More
   PreviousMenu                             ;  GotoMenu "File.Menu"
EndCmd

END

