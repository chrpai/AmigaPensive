

Menu "test_rip.menu"

flags  hotkeyable
level  0 - 255 , "Test.Ansi"
prompt 0 , 0 - 255 , "|Press a key : "
prompt 1 , 0 - 255 , "|Press a key : "

BEGIN     ; Start the command definitions


BuildScreen
;;   PrintFile "trion:menutext/main.ansi"
;   CliDoor  "doors:FX/Random   ~50  main.rndm"
;   CliDoor  "doors:FX/scroller ~50  main.scrl"
;   CliDoor  "doors:FX/text ~50  main.text"
   CliDoor  "doors:FX/select ~50  main.slct"
;;   CliDoor  "doors:FX/blink    ~50  main.blnk"
EndCmd



Cmd "a"
   PrintFileNoPause "s:startup-sequence"
   PrintFile        "s:startup-sequence"
EndCmd


Cmd "b"
   ModemCommand "AT%q%l"
EndCmd

Cmd "c"
   GotoMenu "bbs_rip.menu"
EndCmd


Cmd "#"
   CliDoor     "doors:lastcallers/lastcallers lastcallers.cfg"
   more
EndCmd

Cmd "T"
   CliDoor     "trion:doors/quest/DoQuest ~50 ~51"
EndCmd

Cmd "R"
   CliDoor     "trion:doors/quest/ViewQuest ~50 ~51"
   more
EndCmd


Cmd "X"
   Clidoor "Doors:TronTAG/TronTAG -A -F ~201 ~300"
   GotoMenu "TAG.menu"
EndCmd

Cmd "M" ,  1 - 255 ,
   LUMA
EndCmd

Cmd "F" ,  1 - 255
   LUFA
EndCmd

Cmd "L" , 0-255
;   DosCommandSync  "trion:utils/listnodes >ram:mylist"
;   Print "|Node Actie                         Name Place Level |"
;   Print "=====================================================|"
;   PrintFile   "ram:mylist"
;   Print "|"
;   More

   CliDoor  "trion:utils/listnodes IBM"
   More
EndCmd



Cmd "P"
   Print "PageTest|"
   CLIDoor "Doors:SysopPage/SysopPage"
   CLIDoor "Doors:SysopPage/Data/Start ~50"
EndCmd

Cmd "Q" , 0 - 255
;   PreviousMenu                      ;   GotoMenu "Main.Menu"
   GotoMenu "Main_rip.Menu"
EndCmd

Cmd ""
   PreviousMenu                      ;   GotoMenu "Main.Menu"
EndCmd


END

