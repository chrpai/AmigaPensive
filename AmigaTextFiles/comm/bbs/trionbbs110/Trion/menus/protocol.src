
; Select a file transfer protocol

Menu "Protocol.menu"

flags  hotkeyable
level  0 - 255 , "Protocol.Ansi"
prompt 0 , 0 - 255 , "|Protocol Menu : "
prompt 1 , 0 - 255 , "|Protocol Menu : "

BEGIN     ; Start the command definitions


Cmd "Z"                           ; Zmodem  (Default)
   ChangeProtocol "0"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "Y"                           ; Ymodem
   ChangeProtocol "1"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "G"                           ; Ymodem-G
   ChangeProtocol "2"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "X"                           ; Xmodem
   ChangeProtocol "5"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "C"                           ; Xmodem-CRC
   ChangeProtocol "6"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "B"                           ; Xmodem-1K
   ChangeProtocol "7"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "A"                           ; Xmodem-1K-G
   ChangeProtocol "8"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd

Cmd "K"                           ; Kermit
   ChangeProtocol "9"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd


Cmd ""
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd


Cmd "Q"
   PreviousMenu                   ; GotoMenu "File.Menu"
EndCmd


END

