
Menu "bulletin_rip.menu"

flags  hotkeyable, noscreen
level  0 - 255 , "Bulletin.Ansi"
prompt 0 , 0 - 255 , "|Bulletin Menu : "
prompt 1 , 0 - 255 , "|Bulletin Menu : "

BEGIN     ; Start the command definitions


MenuBegin
   LogMessage "Entered Bulletin menu."
EndCmd

BuildScreen
   CliDoor  "trion:utils/ripdoor ~50 3"
EndCmd

;BuildScreen
;   CliDoor  "doors:FX/blink    ~50 main.blnk"
;EndCmd


Cmd "G" , 0-255
   GotoMenu "Logout_rip.Menu"
EndCmd

Cmd "F" , 0-255
   GotoMenu "File_rip.Menu"               ;Spring naar een ander menu
EndCmd

Cmd "M" , 0-255
   GotoMenu "Mail_rip.Menu"               ;Spring naar een ander menu
EndCmd

Cmd "D" , 0-255
   GotoMenu "Door_rip.Menu"
EndCmd

Cmd "E" , 0-255
   GotoMenu "UserEdit_rip.Menu"               ;Spring naar een ander menu
EndCmd



Cmd "Q" , 0-255
   GotoMenu "Main_rip.Menu"
EndCmd



Cmd "L" , 0-255
   PrintFile  "trion:text/login2.ansi"
   More
EndCmd


Cmd "U" , 0-255
   CliDoor  "doors:lastcallers/GraphUsage"
   More
EndCmd


Cmd "T" , 0 - 255
;  DosCommand  "trion:utils/topdl >ram:top"
   PrintFile   "trion:text/topdl.ansi"
   More
EndCmd

Cmd "O" , 0-255
   CliDoor  "trion:utils/topDL"
   More
EndCmd


Cmd "A" , 0-255
   CliDoor  "doors:TrionText/TrionText ~50"
;   More
EndCmd


Cmd "I" , 0-255
   PrintFile  "trion:text/SysInfo.ansi"
   More
EndCmd



Cmd "0" , 0-255
   CliDoor  "trion:utils/ShowStats 0"
   More
EndCmd

Cmd "1" , 0-255
   CliDoor  "trion:utils/ShowStats 1"
   More
EndCmd

Cmd "2" , 0-255
   CliDoor  "trion:utils/ShowStats 2"
   More
EndCmd

Cmd "3" , 0-255
   CliDoor  "trion:utils/ShowStats 3"
   More
EndCmd

Cmd "4" , 0-255
   CliDoor  "trion:utils/ShowStats 4"
   More
EndCmd

Cmd "5" , 0-255
   CliDoor  "trion:utils/ShowStats 5"
   More
EndCmd

Cmd "6" , 0-255
   CliDoor  "trion:utils/ShowStats 6"
   More
EndCmd

Cmd "7" , 0-255
   CliDoor  "trion:utils/ShowStats 7"
   More
EndCmd




Cmd "P" , 0-255
   PageSysop
EndCmd

Cmd "C" , 0-255
   CommentToSysop
EndCmd



END

