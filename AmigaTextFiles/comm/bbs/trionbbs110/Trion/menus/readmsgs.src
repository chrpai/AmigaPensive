
; Menu to select a methode of reading messages

Menu "ReadMsgs.menu"

flags  hotkeyable
level  0 - 255 , "ReadMsgs.Ansi"
prompt 0 , 0 - 255 , "|Read Menu : "
prompt 1 , 0 - 255 , "|Read Menu : "

BEGIN     ; Start the command definitions


Cmd "N"
   ReadNew
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "F"
   ReadForward
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "R"
   ReadReverse
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "1"
   ReadToUser
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "2"
   ReadFromUser
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "3"
   ReadToFromUser
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "4"
   ReadSubject
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "5"
   ReadToFromSubject
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd



Cmd "6"
   ClrScr
   ReadToYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "7"
   ClrScr
   ReadFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "8"
   ClrScr
   ReadToOrFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "9"
   ClrScr
   ReadReverseToYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "A"
   ClrScr
   ReadReverseFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "B"
   ClrScr
   ReadReverseToOrFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd


Cmd "Z" , 0-255
   ReadGlobalNew
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "W" , 0-255
   ReadWaitingMail
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "M" , 0-255
   ReadMarkedMessages
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd




Cmd ""
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd


Cmd "Q"
   PreviousMenu                ;   GotoMenu "Mail.Menu"
EndCmd


END

