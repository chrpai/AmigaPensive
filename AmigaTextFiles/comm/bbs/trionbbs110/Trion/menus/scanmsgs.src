
; Menu to select a methode of scanning messages

Menu "ScanMsgs.menu"

flags  hotkeyable
level  0 - 255 , "ScanMsgs.Ansi"
prompt 0 , 0 - 255 , "|Scan Menu : "
prompt 1 , 0 - 255 , "|Scan Menu : "

BEGIN     ; Start the command definitions


Cmd "N"
   ClrScr
   ScanNew
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "F"
   ClrScr
   ScanForward
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "R"
   ClrScr
   ScanReverse
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "1"
   ClrScr
   ScanToUser
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "2"
   ClrScr
   ScanFromUser
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "3"
   ClrScr
   ScanToFromUser
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "4"
   ClrScr
   ScanSubject
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "5"
   ClrScr
   ScanToFromSubject
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd



Cmd "6"
   ClrScr
   ScanToYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "7"
   ClrScr
   ScanFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "8"
   ClrScr
   ScanToOrFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "9"
   ClrScr
   ScanReverseToYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "A"
   ClrScr
   ScanReverseFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd

Cmd "B"
   ClrScr
   ScanReverseToOrFromYou
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd



Cmd ""
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd


Cmd "Q"
   PreviousMenu                 ;   GotoMenu "Mail.Menu"
EndCmd


END

