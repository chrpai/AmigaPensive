

Menu "door_rip.menu"

flags  hotkeyable, noscreen
level  0 - 255 , "Door.Ansi"
prompt 0 , 0 - 255 , "|Door Menu : "
prompt 1 , 0 - 255 , "|Door Menu : "

BEGIN     ; Start the command definitions


MenuBegin
   LogMessage "Entered Door menu."
EndCmd

BuildScreen
   CliDoor  "trion:utils/ripdoor ~50 4"
EndCmd


Cmd "T" , 0-255
   CliDoor  "doors:TrionTetris/TrionTetris ~50 "
EndCmd


;Cmd "O" , 0-255
;   CliDoor  "trion:utils/conf '~200' ~50 "
;EndCmd


Cmd "S" , 0-255
   PassWord "test110"
   RemoteShell
EndCmd





Cmd "R" , 0-255
   CliDoor  "doors:chatdoor/RoboChat ~50 "
EndCmd

Cmd "E" , 0-255
   CliDoor  "doors:chatdoor/RoboChat_eng ~50 "
EndCmd

Cmd "P" , 0-255
   CliDoor  "doors:chatdoor/PageDoor ~50 "
EndCmd

Cmd "=" , 0-255
   CliDoor  "doors:chatdoor/SplitChat ~50" , 9000
EndCmd

Cmd "-" , 0-255
   CliDoor  "doors:chatdoor/LineChat ~50" , 9000
EndCmd

Cmd "\" , 0-255 , S
   ClrScr
   FlushBuffer                           ; Flush the return after "\"
   PushIntoBuffer "Hallo daar !!|"
   StartChat
EndCmd




Cmd "D" , 0-255
   CliDoor  "doors:demodoor/demodoor ~50 "
EndCmd


Cmd "C" , 0-255
   DosCommandSync "execute doors:TrionCDDoor/mount.script"
   CliDoor        "doors:TrionCDDoor/CDDoor ~50 "
EndCmd




Cmd "." , 0-255
   CliDoor  "doors:fsed/fsed2 ~50 "
EndCmd



Cmd "A" , 0-255
   RexxDoor  "doors:rexxtest/test.rexx"      ;~50
;   RexxDoor  "doors:rexxtest/download.rexx"      ;~50
;   RexxDoor  "doors:rexxtest/downtext.rexx"      ;~50
EndCmd

;Cmd "" , 0-255
;   CliDoor  "RX doors:rexxtest/test.rexx ~50 "
;EndCmd








Cmd "B" , 0-255
   ParagonDoor  "doors:TusTimeBank/TusTimeBank"
EndCmd

Cmd "O" , 0-255
   ParagonDoor  "doors:chess/chess.exe"
EndCmd




Cmd "1" , 0-255
   ParagonDoor  "doors:sector2/sectorwarsII"
EndCmd

Cmd "2" , 0-255
   ParagonDoor  "doors:androfight/andro"
EndCmd

Cmd "3" , 0-255
   ParagonDoor  "doors:Death/death"
EndCmd

Cmd "3" , 0-255
   ParagonDoor  "doors:Globalwar/globalwar"
EndCmd




Cmd "Z" , 0-255
;   MaxDoor  "doors:CDRomDoor/CDRomDoor"
   MaxDoor  "doors:kewlcd/kewlcdpro"
EndCmd




Cmd "L" , 0-255
   ParagonDoor  "doors:loto/loto"
EndCmd

Cmd "J" , 0-255
   ParagonDoor  "doors:joke/joke"
EndCmd

Cmd "M" , 0-255
   ParagonDoor  "doors:mine/minefield"
EndCmd

Cmd "S" , 0-255
   ParagonDoor  "doors:spcemp/spcemp13"
EndCmd







Cmd "G" , 0-255
   GotoMenu "Logout_rip.Menu"
EndCmd

Cmd "F" , 0-255
   GotoMenu "File_rip.Menu"
EndCmd

Cmd "M" , 0-255
   GotoMenu "Mail_rip.Menu"
EndCmd


Cmd "Q" , 0 - 255
   GotoMenu "Main_rip.Menu"
EndCmd



END
