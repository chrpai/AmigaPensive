
Menu "Mail_rip.menu"

flags  hotkeyable, noscreen
level    0 - 239 , "Mail"                          ;"Mail.Ansi"
level  240 - 255 , "Mail"                      ;"Mail.sys.Ansi"
prompt 0 , 0 - 255 , "|Mail Menu : "
prompt 1 , 0 - 255 , "|Mail Menu : "

BEGIN     ; Start the command definitions


BuildScreen
   CliDoor  "trion:utils/ripdoor ~50 2"
EndCmd


MenuBegin
;   Print "MailMenu|"
   LogMessage "Entered mail menu."
EndCmd


;Cmd "G" , 0-255
;   GotoMenu "Logout.Menu"
;EndCmd

Cmd "Q" , 0-255
   GotoMenu "Main_rip.Menu"
EndCmd

Cmd "S" , 0-255
   GotoMenu "ScanMsgs_rip.Menu"
EndCmd

Cmd "R" , 0-255
   GotoMenu "ReadMsgs_rip.Menu"
EndCmd


Cmd "1" , 0-255
   ChangeMessageArea "1"
   LogMessage "Changed to message area: ~101."
EndCmd

Cmd "2" , 0-255
   ChangeMessageArea "2"
   LogMessage "Changed to message area: ~101."
EndCmd

Cmd "3" , 0- 255
   ChangeMessageArea "3"
   LogMessage "Changed to message area: ~101."
EndCmd



Cmd "-" , 0- 255
   PreviousMenu
EndCmd



Cmd "G" , 0-255
   ClrScr
   ListMessageGroups
   OtherMessageGroup

   ClrScr
   ListMsgAreas
   ; PrintFile "trion:text/MsgAreas.ansi"
   OtherMessageArea
   LogMessage "Changed to message area: ~101."
EndCmd


Cmd "O" , 0-255
   ClrScr
   ListMsgAreas
   ; PrintFile "trion:text/MsgAreas.ansi"
   OtherMessageArea
   LogMessage "Changed to message area: ~101."
EndCmd

Cmd "A" , 0-255
   OtherMessageArea
   LogMessage "Changed to message area: ~101."
EndCmd




Cmd "4" , 0-255
   ClrScr
   PrintFile "trion:text/NetMail.ansi"
   OtherMessageArea
   LogMessage "Changed to message area: ~101."
EndCmd

Cmd "5" , 0-255
   ClrScr
   PrintFile "trion:text/NLA.ansi"
   OtherMessageArea
   LogMessage "Changed to message area: ~101."
EndCmd

Cmd "Y" , 0-255
   RexxDoor  "doors:rexxtest/ReadNLA.rexx"
EndCmd



Cmd "6" , 0-255
   ClrScr
   PrintFile "trion:text/DAN.ansi"
   OtherMessageArea
   LogMessage "Changed to message area: ~101."
EndCmd




Cmd "N" , 0-255
   ReadNew
EndCmd

Cmd "Z" , 0-255
   ReadGlobalNew
EndCmd





Cmd "?" , 0- 255
   Confirm  "Do you really want to scan for waiting mail (Y/n) ? "
   ScanWaitingMail
   More
EndCmd

Cmd "W" , 0-255
   ClrScr
   ReadWaitingMail
EndCmd

Cmd "L" , 0-255
   PlaySample "trion:samples/alf-yes!"
   WriteMessage
EndCmd

Cmd "E" , 0-255
   GotoMenu "Editor_rip.menu"
EndCmd

Cmd "I" , 0-255
   EditSignature
EndCmd




Cmd "T" , 0-255
   Print "There are ~105 unread messages|"
   More
EndCmd





Cmd "F" , 0-255
   ReadForward
EndCmd

Cmd "M" , 0-255
   ReadMarkedMessages
;   UnmarkMessages
EndCmd

Cmd "U" , 0-255
   UnmarkMessages
EndCmd

Cmd "@" , 0-255
   FlushUserData
EndCmd



END

