

Menu "useredit.menu"

flags  hotkeyable
level  0 - 255 , "useredit.Ansi"
prompt 0 , 0 - 255 , "|UserEdit Menu : "
prompt 1 , 0 - 255 , "|UserEdit Menu : "

BEGIN     ; Start the command definitions


MenuBegin
   LogMessage "Entered UserEdit menu."
EndCmd


Cmd "P" ,  0 - 255
   ChangePassword
EndCmd

Cmd "A" ,  0 - 255
   ChangeAlias
EndCmd

Cmd "S" ,  0 - 255
   ChangeSet
EndCmd

Cmd "U" ,  0 - 255
   UserList
EndCmd

Cmd "L" ,  0 - 255
   AliasList
EndCmd

Cmd "C" ,  0 - 255
   ChangeScreenLength
EndCmd

Cmd "M" ,  0 - 255
   ChangeMsgsMode
EndCmd

Cmd "F" ,  0 - 255
   ChangeFileMode
EndCmd

Cmd "1" ,  5 - 255
   ChangePhoneNumber
EndCmd

Cmd "2" ,  5 - 255
   ChangeDataNumber
EndCmd


Cmd "D"
   GotoMenu "Protocol.Menu"
EndCmd

Cmd "E" , 0-255
   GotoMenu "Editor.menu"
EndCmd


Cmd "Q" , 0 - 255
   GotoMenu "Main.Menu"
EndCmd


END

