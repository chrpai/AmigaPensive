
; The menu in which a File Browse methode is selected


Menu "Browse_rip.menu"

flags  hotkeyable, noscreen
level  0 - 255 , "Browse.Ansi"
prompt 0 , 0 - 255 , "|Browse Menu : "
prompt 1 , 0 - 255 , "|Browse Menu : "

BEGIN     ; Start the command definitions

BuildScreen
   CliDoor  "trion:utils/ripdoor ~50 10"
EndCmd

Cmd "F"
   ClrScr
   BrowseFindGlobal
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd

Cmd "Z"
   ClrScr
   BrowseFindFile
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd

Cmd "L"
   ClrScr
   BrowseAlpha
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "C"
   ClrScr
   BrowseChrono
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd

Cmd "R"
   ClrScr
   BrowseAlphaReverse
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "T"
   ClrScr
   BrowseChronoReverse
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "N"
   ClrScr
   BrowseChronoNew
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "G"
   ClrScr
   BrowseChronoGLobalNew
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "A"
   ClrScr
   BrowseChronoGLobal
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "H"
   ClrScr
   BrowseAlphaGLobal
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd

Cmd "V"
   ClrScr
   BrowseChronoUnvalidated
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "U"
   ClrScr
   BrowseChronoUnvalidatedGlobal
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd

Cmd "M"
   ClrScr
   BrowseAlphaNew
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd

Cmd "B"
   ClrScr
   BrowseAlphaGlobalNew
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd



Cmd ""
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


Cmd "Q"
   PreviousMenu                   ;   GotoMenu "File.Menu"
EndCmd


END

