

Menu "file_rip.menu"

flags  hotkeyable, noscreen
level  0 - 255 , "File.Ansi"
prompt 0 , 0 - 255 , "|File Menu : "
prompt 1 , 0 - 255 , "|File Menu : "

BEGIN     ; Start the command definitions


MenuBegin
;   Print "FileMenu|"
   LogMessage "Entered file menu."
EndCmd

;BuildScreen
;;   PrintFile "trion:menutext/main.ansi"
;;   CliDoor  "doors:FX/scroller ~50 main.scrl"
;   CliDoor  "doors:FX/blink    ~50 main.blnk"
;EndCmd

BuildScreen
   CliDoor  "trion:utils/ripdoor ~50 1"
EndCmd



;Cmd "G"
;   GotoMenu "Logout_rip.Menu"
;EndCmd

Cmd "Q" , 0 - 255
   GotoMenu "Main_rip.Menu"
EndCmd

Cmd "L"
   GotoMenu "List_rip.Menu"
EndCmd

Cmd "B"
   GotoMenu "Browse_rip.Menu"
EndCmd

Cmd "P"
   GotoMenu "Protocol_rip.Menu"
EndCmd


Cmd "1"
   ChangeFileArea "1"
   LogMessage "Changed to file area: ~301."
EndCmd

Cmd "2"
   ChangeFileArea "2"
   LogMessage "Changed to file area: ~301."
EndCmd

Cmd "3"
   ChangeFileArea "3"
   LogMessage "Changed to file area: ~301."
EndCmd


Cmd "G"
   ClrScr
   ListFileGroups
   OtherFileGroup

   ClrScr
   ListFileAreas
   ;  PrintFile "trion:text/FileAreas.ansi"
   OtherFileArea
   LogMessage "Changed to file area: ~301."
EndCmd


Cmd "A"
   ClrScr
   ListFileAreas
   ;  PrintFile "trion:text/FileAreas.ansi"
   OtherFileArea
   LogMessage "Changed to file area: ~301."
EndCmd

Cmd "O"
;   ClrScr
;   ListFileAreas
   PrintFile "trion:text/FileAreas.ansi"
   OtherFileArea
   LogMessage "Changed to file area: ~301."
EndCmd


Cmd "R"
   PrintFile "trion:text/ratio.ansi"
   More
EndCmd

Cmd "+"
   AddFile
EndCmd

Cmd "F"
   ClrScr
   CatalogFindGlobal
EndCmd

Cmd "N"
   ClrScr
   CatalogChronoGlobalNew
EndCmd

Cmd "S"
   SetScanDate
;   CatalogChronoGlobalNew
EndCmd

Cmd "Y"
   SetScanDays
;   CatalogChronoGlobalNew
EndCmd

Cmd "C"
   ClrScr
   CatalogChrono
EndCmd

Cmd "M"
   MarkFile
   More
EndCmd

Cmd "I"
   MarkName "ALLFILES.LHA"
   More
EndCmd

Cmd "J"
   ListMarkedFiles
   More
EndCmd

Cmd "V"
   ListMarkedFiles
   KillMarkedFile
EndCmd

Cmd "*"
   UnmarkFiles
   Print "|Unmarked all marked files.|"
   More
EndCmd

Cmd "U"
   CliDoor  "doors:FreeSpace/FreeSpace DH1:"
   More
   Print "||Start Uploading now..||"
   Upload
EndCmd

Cmd "-"
   UploadToArea "~300 "
EndCmd

Cmd "T"
   ViewArchive
EndCmd


;Cmd "D"
;   MarkFile
;   Download
;   More
;EndCmd

Cmd "D"
   ListMarkedFiles
   GotoMenu "Download_rip.menu"
EndCmd

Cmd "K" , 240 - 255
   DeleteFile
EndCmd

Cmd "E" , 240 - 255
   EditFile
EndCmd

Cmd "H" , 240 - 255
   MakeFreeDownload
EndCmd

Cmd "#" , 0 - 255
   PassWord  "test110"
   DownloadFromDos
EndCmd


END

