
Menu "logout.menu"

flags  hotkeyable
level  0 - 255 , "logout.Ansi"
prompt 0 , 0 - 255 , "|"
prompt 1 , 0 - 255 , "|"

BEGIN     ; Start the command definitions


BuildScreen
   CliDoor  "doors:FX/Random   ~50  logout.rndm"
   CliDoor  "doors:FX/scroller ~50  logout.scrl"
EndCmd



Cmd "M" , 1-255
   GotoMenu "Main.Menu"
EndCmd

Cmd "P" , 0-255
   PreviousMenu
EndCmd


Cmd "C" , 0-255
   CommentToSysop
EndCmd

Cmd "A" , 10 - 255
   ChangeMessageArea "2"      ;If no acces to area 5 goto 2.
   ChangeMessageArea "5"      ;Change to area 'Msgs To All'.
   FlushBuffer
   PushIntoBuffer "All|"      ;Push receiver name in buffer.
   WriteMessage
   FlushBuffer                ;Flush 'All' if no writeAcces
EndCmd


Cmd "!"
   Logout
EndCmd

Cmd "G" , 0-255
   PrintFile  "trion:text/logout.ansi"
;   DosCommand "echo ~200 logging out."
   Pause "30"
   Logout
EndCmd


END

