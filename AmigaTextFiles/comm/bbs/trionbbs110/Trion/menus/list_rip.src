
; The menu in which a File List methode is selected


Menu "list_rip.menu"

flags  hotkeyable, noscreen
level  0 - 255 , "List.Ansi"
prompt 0 , 0 - 255 , "|List Menu : "
prompt 1 , 0 - 255 , "|List Menu : "

BEGIN     ; Start the command definitions


BuildScreen
   CliDoor  "trion:utils/ripdoor ~50 11"
EndCmd

Cmd "F"
   ClrScr
   CatalogFindGlobal
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd

Cmd "Z"
   ClrScr
   CatalogFindFile
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd

Cmd "L"
   ClrScr
   CatalogAlpha
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "C"
   ClrScr
   CatalogChrono
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd

Cmd "R"
   ClrScr
   CatalogAlphaReverse
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "T"
   ClrScr
   CatalogChronoReverse
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "N"
   ClrScr
   CatalogChronoNew
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "G"
   ClrScr
   CatalogChronoGLobalNew
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "A"
   ClrScr
   CatalogChronoGLobal
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "H"
   ClrScr
   CatalogAlphaGLobal
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd

Cmd "V"
   ClrScr
   CatalogChronoUnvalidated
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "U"
   ClrScr
   CatalogChronoUnvalidatedGlobal
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "M"
   ClrScr
   CatalogAlphaNew
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd

Cmd "B"
   ClrScr
   CatalogAlphaGlobalNew
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd



Cmd ""
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


Cmd "Q"
   PreviousMenu                             ;   GotoMenu "File.Menu"
EndCmd


END

