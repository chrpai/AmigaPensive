

Menu "sysop_rip.menu"

flags  hotkeyable
level  0 - 255 , "Sysop.Ansi"
prompt 0 , 0 - 255 , "|Sysop Menu : "
prompt 1 , 0 - 255 , "|Sysop Menu : "

BEGIN     ; Start the command definitions


MenuBegin
   LogMessage "Entered SYSOP menu."
EndCmd


Cmd "P" ,  0 - 255
   ChangePassword
EndCmd

Cmd "A" ,  0 - 255
   ChangeAlias
EndCmd

Cmd "S" ,  0 - 255
   ChangeSet
EndCmd

Cmd "C" ,  0 - 255
   ChangeScreenLength
EndCmd

Cmd "V" , 0 - 255
   Print "|Geldig level van 0 tot 255|"
   Print "cosysop acces is 240+|"
   ChangeLevel
EndCmd


Cmd "D" , 0 - 255
   DownloadFromDos
EndCmd

Cmd "X" , 0-255
   PassWord "test110"
   RemoteShell
EndCmd

Cmd "Y" , 0-255
   PassWord "test110"
   LineEditFile
EndCmd




Cmd "U" ,  0 - 255
   UserList
EndCmd

Cmd "L" ,  0 - 255
   AliasList
EndCmd

Cmd "K" ,  0 - 255
   KillUser
EndCmd

Cmd "E" , 0 - 255
   EditUser
EndCmd

Cmd "O" , 0 - 255
   EditUserOnline
EndCmd

Cmd "N" , 0 - 255
   AddUser
EndCmd



Cmd "1"
   CliDoor  "doors:FreeSpace/FreeSpace DH1:"
   More
EndCmd


Cmd "2"
   CliDoor  "doors:FreeSpace/FreeSpace DH2:"
   More
EndCmd



Cmd "Q" , 0 - 255
   GotoMenu "Main_rip.Menu"
EndCmd


END

