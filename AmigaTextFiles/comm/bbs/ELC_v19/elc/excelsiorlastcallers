GetInfo:
  GU  4 ; tmp=result ; v3=right(tmp,2)     ; city=left(tmp,length(tmp)-3)
  GU  1 ; tmp=result ; v1=left(tmp,18,' ') ;  v2=left(city,14,' ')
  GU 30 ; tmp=result ; v4=left(tmp, 4,' ')
  if LCN=1 & index(LocalCountries,left(v4,3))=0 then do;C4=H4;C3=H3;C2=H2;signal LD;end
  if LST=1 & index(LocalStates,v3)=0 then do;C3=H3;C2=H2;signal LD;end
  if LCT=1 & index(LocalCities,city)=0 then C2=H2
LD:
  GU 13 ; tmp=result ; temporary=left(tmp,21,' ') ; call FixTime
  v6=left(v6,3,' ') ; v7=right(v7,11,' ') ; v8=right(v8,7,' ')
  GU 22 ; tmp=result ; v5=left(tmp, 5,' ')
  GU 24 ; tmp=result ; v9=right(tmp, 5,' ') ; if tmp=19200 then v9="LOCAL"
return

FixTime:
  parse var temporary v6' 'v7' 'v8
  parse var v8 hour':'mins
  if hour>12 then hour=hour-12
  v8=hour||':'||left(mins,2)||translate(right(time('c'),2),xrange('a','z'),xrange('A','Z'))
return

CheckFile:
  if ~exists(path||File) then
  do
    open(file1,path||File, 'W')
    call DoHeader
    writeln(file1,b1)
    do i=1 to Lines
      writeln(file1,default)
    end
    writeln(file1,b3)
    close(file1)
  end
  open(file1,path||File, 'R')
  top=readln(file1);top=readln(file1);top=readln(file1);top=readln(file1)
  do i=1 to Lines
    Last.i=readln(file1)
    if Last.i='' | Last.i=b3 then Last.i = default
  end
  bottom=readln(file1)
  close(file1)
return

UpdateFile:
  open(file1,path||File, 'W')
  call DoHeader
  writeln(file1,b2)
  writeln(file1,C0'º'C1||v1||C0||DV||C2||v2||C0||DV||C3||v3||C0||DV||C4||v4||C0||DV||C5||v5||C0||DV||C6||v6||C0||DV||C7||v7||C0||DV||C8||v8||C0||DV||C9||v9||C0'º')
  do i=1 to Lines-1
    writeln(file1,Last.i)
  end
  writeln(file1,b3)
  close(file1)
return

DoHeader:
  writeln(file1,'\q1\f1\c5Excelsior! Last Callers v'||ver||' -*- by Sean Workman - AmigaX 503-342-2144 16.8k DS')
  writeln(file1,b1)
  head1='Last '||Lines||' Callers' ; head1=left(head1,15,' ')
  writeln(file1,C0'º'TX||T1||head1||'   'T2||C0||DV||TX||T1'City/Town     'T2||C0||DV||TX||T1'ST'T2||C0||DV||TX||T1'Ctry'T2||C0||DV||TX||T1'Calls'T2||C0||DV||TX||T1'Day'T2||C0||DV||TX||T1'Date       'T2||C0||DV||TX||T1'Time   'T2||C0||DV||TX||T1'Baud 'C0'\z0º')
return

