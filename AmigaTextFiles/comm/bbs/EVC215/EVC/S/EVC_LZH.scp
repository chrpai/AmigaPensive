.KEY TEMPFILE,FILE
.BRA [
.KET ]

FAILAT 50

; Put this whereever you want,  make sure it's big
MAKEDIR T:EVC

; Unarc the file for EVC to check
; EVC.REXX will delete this when it is done 
LHA >[TEMPFILE] -M -m -v9 x [FILE] T:EVC/

DELETE REXX:EVC.REXX
echo >REXX:EVC.REXX /*   EVC.REXX   Checks files for Viruses  */
echo >>REXX:EVC.REXX 
echo >>REXX:EVC.REXX options results
echo >>REXX:EVC.REXX Transmit '\#5EVC T:EVC REC BBS VCHECK MASTER FILE=[FILE] TRASH=RAM:\'
echo >>REXX:EVC.REXX address command 'RUN DELETE T:EVC ALL QUIET'
