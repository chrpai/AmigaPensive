.KEY TEMPFILE,FILE
.BRA [
.KET ]

; Unarc the file for EVC to check
; EVC.REXX will delete this when it is done 

DMS <NIL: >[TEMPFILE] WRITE [FILE] TO RAD:

DELETE REXX:EVC.REXX
echo >REXX:EVC.REXX /*   EVC.REXX   Checks files for Viruses  */
echo >>REXX:EVC.REXX 
echo >>REXX:EVC.REXX options results
echo >>REXX:EVC.REXX Transmit '\#5EVC RAD: REC BBS VCHECK MASTER FILE=[FILE] TRASH=RAM:\'
;                                      ^    ^   ^     ^      ^       ^            ^
;             The directory to look at-/    |   |     |      |       |            |
;                                           |   |     |      |       |            |
;                      Do a recursive search/   |     |      |       |            |
;                                               |     |      |       |            | 
;                  format the output for the BBS/     |      |       |            |
;                                                     |      |       |            |
;                     Check all files here for viruses/      |       |            |
;                                                            |       |            |
;                              Log everything to MASTER_REXX1/       |            |
;                                                                    |            |
;                 This is the path & filename of the original archive/            |
;                                                                                 |
;                                  This is where to put the file if it has a virus/
;

