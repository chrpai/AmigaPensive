(set @default-dest "Prometheus:")
(transcript "Installation von TyxX V1.1")

(set sourc "install/")

(message "\n\n\n\nWillkommen bei der TyxX V1.1 Installation.")

(working)

(set desti1
  (askdir
    (prompt "Wo soll TyxX installiert werden?\n(Ein Verzeichnis wird erzeugt.)")
    (default "Prometheus:")
    (help "Wählen Sie hier den Pfad, wo TyxX hinkopiert werden soll. Das Programmverzeichnis wird automatisch erzeugt.")
  )
)

(set desti
  (tackon desti1 "TyxX")
)

(if (= (exists desti) 0 (makedir desti (infos))))

(complete 30)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "TyxX" "TyxX-Prefs" "Words.dat" "Register.txt" "NetzAntrag.txt")
  (source sourc)
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 60)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "TyxX.guide")
  (source "")
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 70)

(if
  (askchoice
    (prompt "Haben Sie eine frühere Version von TyxX bereits installiert oder ist dies die Erstinstallation?")
    (choices "Update" "Erstinstallation")
    (help "")
  )

  (run (cat (cat sourc "InstallCommand bn=TyxX a=\"Run ") (cat desti "/TyxX $PO\" k=\"Wer tippt am Schnellsten?\" sc=2 b e sb"))
    (prompt "\n\n\nTyxX wird nun als Befehl in Prometheus eingebaut.")
    (help "TyxX wird vollautomatisch in den Befehlseditor von Prometheus eingebaut. Sie brauchen dann nur noch die entsprechenden Gruppen einzustellen.")
    (confirm)
  )
)

(complete 100)

(message "\n\nFertig! TyxX ist nun sofort spielbar.\n\nAber einen kleinen Blick in die Doku sollten Sie trotzdem werfen.")

(message "\n\n\nDies ist die unregistrierte Version von TyxX. Um zu registrieren, schauen Sie bitte in die Anleitung.")

(Message "\n\n\nFür TyxX existiert ein Support-Netz, das SkyNetz, in dem Sie Informationen, Hilfestellung, Diskussionen und natürlich die neusten Updates erhalten.")

