; In dieser Datei können die verschiedenen Packverfahren für den Pointbe-
; trieb festgelegt werden. Die Datei dient lediglich dazu, daß man über
; den PointEd ab V 1.00 das Packverfahren über die Maus auswählen kann.

; Dateiaufbau :

; #name:<packer>	- Name des Packers, wie er im Display stehen soll
; #pack:<packkomm>	- Kommando, daß zum Packen ausgeführt werden soll
; #xtract:<entpackkomm>	- Kommando, daß zum Entpacken ausgeführt werden soll
; #suffix:<suffix>	- die Archiv Endung, die der Packer erzeugt.
; ###			- Abschluß für einen Eintrag

; Packen über das Programm LHA / -lh5- Verfahren

#name:LHA
#test:lha -X t %s
#list:lha -X v %s
#pack:lha a %o %p
#xtract:lha x %i
#suffix:.LHA
###

; Packen über das Programm LHA / -lh0- Verfahren (Storing)

#name:LH0
#test:lha -X t %s
#list:lha -X v %s
#pack:lha -z a %o %p
#xtract:lha x %i
#suffix:.LHA
###

; Packen über das Programm ZOO

#name:ZOO
#test:zoo t %s
#list:zoo v %s
#pack:zoo a %o %p
#xtract:zoo x %i
#suffix:.ZOO
###


; ungepackte NetCalls, Achtung : nicht für MultiPuffer Archive geeignet !
; ACHTUNG : Hier müssen <tempfad> und <systemname> ersetzt werden

#name:NoPack
#pack:Copy %p %o
#xtract:Copy %i <tempfad>/<systemname>/Puffer
###

; Packen über das Programm ZIP / DeflateX-Pack-Methode -> effizienter packen
; ACHTUNG : Hier muß unbedigt der absolute Pfadname bei #xtract: ausgetauscht werden !

#name:ZIP-X
#test:unzip -t %s
#list:unzip -v %s
#pack:zip -9jk %o %p
#xtract:unzip %i -d hd1:t/<systemname>/
#suffix:.ZIP
###

; Packen über das Programm ZIP / DeflateF-Pack-Methode -> schneller packen
; ACHTUNG : Hier muß unbedigt der absolute Pfadname bei #xtract: ausgetauscht werden !

#name:ZIP-F
#test:unzip -t %s
#list:unzip -v %s
#pack:zip -1jk %o %p
#xtract:unzip %i -d hd1:t/<systemname>/
#suffix:.ZIP
###

; Packen über das Programm ZIP / Store-Methode -> _NUR_ archivieren !!!

#name:ZIP-0
#test:unzip -t %s
#list:unzip -v %s
#pack:zip -0jk %o %p
#xtract:unzip %i -d hd1:t/<systemname>/
#suffix:.ZIP
###

; Daten für das Programm LZX / effizient packen

#name:LZX-Deep
#test:lzx -X0 t %s
#list:lzx -X0 l %s
#pack:lzx -3 a %o %p
#xtract:lzx x %i
#suffix:.LZX
###

; Daten für das Programm LZX / schnell packen

#name:LZX-Fast
#test:lzx -X0 t %s
#list:lzx -X0 l %s
#pack:lzx -1 a %o %p
#xtract:lzx x %i
#suffix:.LZX
###

; Daten für das Programm LZX / Store-Methode -> _NUR_ archivieren !!!

#name:LZX-Store
#test:lzx -X0 t %s
#list:lzx -X0 l %s
#pack:lzx -0 a %o %p
#xtract:lzx x %i
#suffix:.LZX
###
