       SHIFT UP ARROW = 301
           DOWN ARROW = 400
     SHIFT DOWN ARROW = 401
           LEFT ARROW = 500
     SHIFT LEFT ARROW = 501
          RIGHT ARROW = 600
    SHIFT RIGHT ARROW = 601

