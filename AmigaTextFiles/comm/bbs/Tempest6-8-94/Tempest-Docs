    EXAMPLE CALL ROUTINE:
    ====================

    int  cursor
    char string[50];

    cursor=CursorHotKey();
    if(cursor>255)
     {
      switch(cursor)
       {
        case 300: // UP ARROW
        case 301: // SHIFT UP ARROW
        case 400: // DOWN ARROW
        case 401: // SHIFT DOWN ARROW
        case 500: // LEFT ARROW
        case 501: // SHIFT LEFT ARROW
        case 600: // RIGHT ARROW
        case 601: // SHIFT RIGHT ARROW
       }
     }
    if(cursor<256) string[0]=(char)cursor; // Normal character entered!
    string[1]=NULL;
