E! comment V 1.1 © 1996 Martin Berglund^GRANiTE 

*/;options results;bufferflush;file='DOORS:E!_Comment.config';tr=transmit;ss=sendstring;tr "";ss "\C2 Would you like to leave a comment ? (\C3Y\C2/\C3N\C2) ";getchar;anst=upper(result);if asnt='###PANIC' then data='QUIT';if anst='Y' then data='YES';if anst='N' then data='QUIT';if anst='' then data='QUIT';if anst~='Y' then data='QUIT';if data='YES' then call onesagain;if data='QUIT' then call quit;onesagain:;if ~Exists(file)then call noexist;if exists(file)then do;open(fn1,file,'R');nums=0;do until eof(fn1);nums=nums+1;feedback.nums=readln(fn1);comment.nums=readln(fn1);if feedback.nums='' then nums=nums-1;end;close(fn1);end;ss "\C3"data;newline;tr "";tr "                       \C3----\C2> \C5E! Comment V1.1 \C2<\C3----";tr "";tr "                \C2    © 1996 by Martin Berglund ^GRANiTE";newline;newline;tr " Who would you like to make a comment to ?";newline;tr "\C2.---.-------------------------.---------------------------------------.";do i=1 to nums;feedback=left(feedback.i,24);comment=left(comment.i,38);tr "\C2|\C3 "i" \C2|\C6 "feedback"\C2|\C5 "comment"\C2|";if i~=nums then tr "\C2|---+-------------------------+---------------------------------------|";end;tr "\C2`---^-------------------------^---------------------------------------'";newline;ss "\Z0\C2Who ? [RETURN=QUIT] > ";getchar;ans=upper(result);i=ans;if i>0 then do;if i<=nums then tr "\C6"feedback.i;end;if i>0 then call send;if i='' then call quit2;if i='###PANIC' then call quit2;quit2:;exit;end;send:;if i>nums then call quit2;sendmail feedback.i;exit;end;quit:;data='QUIT';ss "\C3"data;newline;exit;end;noexist:;tr "";tr "\C1ERR: Can''t locate config file.. Please contact sysop.";exit;end