F1  \mForceChat.baud   ; Forces user into chat mode at next prompt
F2  \m"oldcom=GETCLIP('BBS_COMMAND');CALL SETCLIP('BBS_COMMAND',oldcom'G')"
F3  \mBumpTime.baud    ; Opens requester to change session time. (NOT-SAVED)
F4  \m"oldcom=GETCLIP('BBS_COMMAND');CALL SETCLIP('BBS_COMMAND',oldcom'M')"
F5  \mBumpLevels.baud  ; Opens requester to change level or ul:dl ratio. (SAVED)
F6  \m"CALL SETCLIP('BBS_fkeyhelp');ADDRESS BBSPOST RESET" ; KILLS THE FKey HELP window
F7  \mShowLog.baud     ; displays current log on BB screen
F8  \m"x=GETCLIP('BBS_totalusage');IF WORDS(x)<1 THEN RETURN;MSG;MSG 'Total usage for' DATE('M')':' WORD(x,1) 'hours' WORD(x,2) 'minutes.';MSG"
F9  \mBaud.rexx OFF    ; Turns BB screen off (BBS still on). CLI> rx Baud to re-open
F10 \m"CALL SETCLIP('BBS_fkeyhelp',1);ADDRESS BBSPOST RESET" ; Function Key HELP
S1  \mBBBBS.baud
S2  \m"CALL SETCLIP('BBS_QUIT','QUIT')"
S3  \m"CALL SETCLIP('BBS_QUIT')"
S4  \mToggleNoise.rexx ; Toggle Sounds and Speech ON/OFF
S5  \mbbsArcSTOP.rexx  ; Display (and abort?) background archive processes
S6  \m"Send 'ATH1\r'"
S7  \m"Send 'ATH\r'"
S8  \m"MSG;MSG STORAGE() 'bytes of RAM available.';MSG"
S9  \m"CALL SETCLIP('BBS_COMMAND','B');TimeOut 1 /* Close editors capture buffer */"
S10 \m"m=Request(100,100,'Enter Message To Current User','',,'CANCEL','BAUD');IF m='' THEN RETURN;o=GETCLIP('BBS_MESSAGE');IF o~='' THEN o=o'0D0A'x;CALL SETCLIP('BBS_MESSAGE',o||m)"
A1  \m"DO i=0 TO 7;Send '\S'i'-'WORD('000 FEF 79F FAC D7F DD7 CCF 7FA',i+1);END /* un-dim colors */"
A6  \r\rPatience is a virtue!\r\r
A9  \m"SAY 'Hourly stats in less than 30 seconds.';CALL SETCLIP('BBS_interpret','level=99;linesperpage=30;CALL hourly()')"
A10 \m"SAY 'Stats in less than 30 seconds.';CALL SETCLIP('BBS_interpret','lastondate=DATE(INTERNAL);level=99;CALL counts();level=0')"
