/* BumpTime.baud */

oldminutes=GETCLIP('BBS_minutes')
oldcom=GETCLIP('BBS_COMMAND')

minutes=Request(100,100,"Enter new minutes",oldminutes,,'CANCEL','BAUD')
IF DATATYPE(minutes,'N') & minutes>0 & minutes~=oldminutes THEN
  DO
    CALL SETCLIP('BBS_minutes',minutes)
    CALL SETCLIP('BBS_COMMAND',oldcom'T')
  END

/* BumpTime.baud */

