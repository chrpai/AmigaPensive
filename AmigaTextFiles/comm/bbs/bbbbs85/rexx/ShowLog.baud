/* ShowLog.baud */

OPTIONS RESULTS

dcd
IF RC>0 THEN RETURN

yearmonthday=""
PARSE ARG yearmonthday .
IF LENGTH(yearmonthday)~=8 THEN yearmonthday=DATE('S')

bbspath=GETCLIP('BBS_path')
filename=bbspath'Logs/log.'yearmonthday

Send 'ATH1\r'
IF EXISTS(filename) THEN
  ADDRESS COMMAND 'type' filename
ELSE SAY 'Can''t find log file for' DATE(,yearmonthday,'S')
Send 'ATH\r'

/* ShowLog.baud */
