/* Bumplevels.baud */

oldlevel=GETCLIP('BBS_level')
oldcom=GETCLIP('BBS_COMMAND')
level=Request(100,100,"Enter new access level",oldlevel,,'CANCEL','BAUD')
IF DATATYPE(level,'N') & level~=oldlevel THEN
  DO
    CALL SETCLIP('BBS_level',level)
    CALL SETCLIP('BBS_COMMAND',oldcom'L')
  END
oldcom=oldcom'L'

oldratio=GETCLIP('BBS_ratio')
ratio=Request(100,100,"Enter new ul:dl ratio",oldratio,,'CANCEL','BAUD')
IF DATATYPE(ratio,'N') & ratio~=oldratio THEN
  DO
    CALL SETCLIP('BBS_ratio',ratio)
    CALL SETCLIP('BBS_COMMAND',oldcom'R')
  END
EXIT;
