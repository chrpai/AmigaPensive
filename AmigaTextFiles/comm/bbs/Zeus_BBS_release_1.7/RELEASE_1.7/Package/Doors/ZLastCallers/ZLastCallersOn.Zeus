Options Results
Parse Arg Line

ChkCarrier
If RC~=0 Then Exit

Call Addlib("rexxsupport.library",0,-30,0)

Start=Time()
Call Delete("ENV:ZLC"Line".On")
Call Open("Time","ENV:ZLC"Line".On","W")
Call Writeln("Time",Start)
Call Close("Time")
Exit
