/*
** StartUp0.pl -- Start up script for line 0 (Local line)
**/

Options Results
Parse Arg Line
Trace Off

Call Addlib("rexxsupport.library",0,-30,0)

CallScript 'Doors:ZLastCallers/ZLastCallersOff'

InitLine

SetStatus '"Waiting for local logon"'

WaitReturn

Online

CallScript 'Doors:ZLastCallers/ZLastCallersOn'

NextScript 'Logon/Logon'
