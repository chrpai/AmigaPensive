/*
** Remote.zeus -- Start up script for remote lines (Mailer/Connector)
*/

Options Results
Parse Arg Line
Trace Off

Call Addlib("rexxsupport.library",0,-30,0)

CallScript 'Doors:ZLastCallers/ZLastCallersOff'

/*
**	Update stats
**
Address Command 'W:Doors/ZUFStats/ZUFStats filesdlpath=W:Scripts/Statistics/Top10FilesDL.TXT bytesdlpath=W:Scripts/Statistics/Top10BytesDL.TXT filesulpath=W:Scripts/Statistics/Top10FilesUL.TXT bytesulpath=W:Scripts/Statistics/Top10BytesUL.TXT USERS=10'
Address Command 'W:Doors/ZTopFiles/ZTopFiles FILE=W:Scripts/Statistics/Top10Files.TXT BBS=Wedlock FILES=10 AREAS=1-1000'
**
**	Done...
**/

InitLine

CloseDev
MailerQuit

SetStatus '"Waiting for Call"'

MailerWait
OpenDev

Online

CallScript 'Doors:ZLastCallers/ZLastCallersOn'

NextScript 'Logon/Logon'
Exit
