/*
** PostLogon.zeus -- Display the title, news and stuff like that.
**/
Options Results
Parse Arg Line

/*
**	First check if the user is running out of time...
**/
SetAccLimit
IF RC = 5 THEN DO
	Display 'Logon/TimeLimit'
	WaitReturn
END

/*
**	Read users XData to see what logo we should display.
**/
CallScript 'Logon/DisplayLogo'

NextScript 'FrontDoor/FrontDoorMenu'
Exit
