/*
** DisplayLogo.zeus			- Display the right logo depending on what the user has seen before.
**/
Options Results
Parse Arg Line

ClrScr

GetUserXData '"LOGO"'

IF RC = 20 THEN DO
   AddUserXData '"LOGO"' '"1"'
	GetUserXData '"LOGO"'
	END

Logo = RESULT

Display 'Logon/Logo-'Logo

IF Logo = 1 THEN AddUserXData '"LOGO"' '"2"'
ELSE			 	  AddUserXData '"LOGO"' '"1"'

Write '"\n\n"'
WaitReturn
IF RC ~= 0 THEN Exit
