/*
** BootUser.pl -- Script that gets called when the user is due to depart..
*/

Options Results
Parse Arg Line

ClrScr

GetLogOffCode
Code = RESULT

select
	when Code = 1 then do
		/* Inactivity Timeout */
		Write '"Inactivity timeout.\n"'
		end

	when Code = 2 then do
		/* Booted off by the SysOp */
		Write '"You''re outta here!\n"'
		end

	when Code = 3 then do
		/* Lost carrier */
		Write '"Lost Carrier.\n"'
		end

	when Code = 4 then do
		/* No time left */
		Write '"You have no more time left this call.\n"'
		end

	otherwise do
		Write '"Unknown logoff code 'Code'!\n"'
		end

	end
