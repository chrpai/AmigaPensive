/*
** CharSet.zeus -- Ask the user for a char-set to use, and select it.
*/

Options Results
Parse Arg Line

GetCharSet:
   Write '"\nAvailable translations:\n-----------------------\n"'
	CLIDoor '"C:DIR Zeus:Config/Translation"'
	Write '"\n"'
	Write '"Select translation: "'
	Read MakeUpper MaxLen 10 OnlyAlpha
	IF RC ~= 0 THEN Exit
	CharSet = RESULT
	IF CharSet = '0x10' | CharSet = 'RESULT' THEN Quit

	IF ~Exists('Zeus:Config/Translation/'||CharSet) THEN DO
		Exit
	END

	SetTrans BOTH TABLE CharSet
	SetTrans BOTH SAVE
	SaveUser
