/*
** Language.pl
*/

Options Results
Parse Arg Line

do forever
	Display 'Options/MenuSet'

	Prompt GetMenuSet
	Read Opts '"0123456789?\r\n"' MaxLen 1
	if RC ~= 0 | RESULT = 'RESULT' then exit

	MenuSet = RESULT

	if DataType( MenuSet, 'N' ) then do
		SetUserData 'MenuSet' MenuSet
		exit
		end
	end
