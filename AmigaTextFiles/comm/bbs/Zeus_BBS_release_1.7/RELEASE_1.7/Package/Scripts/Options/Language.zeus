
/*
** Language.pl
*/

Options Results
Parse Arg Line

do forever
	Display 'Options/LanguageSelect'

	Prompt GetLanguage
	Read Opts '"0123456789?\r\n"' MaxLen 1
	if RC ~= 0 | RESULT = 'RESULT' then exit

	Lang = RESULT

	if DataType( Lang, 'N' ) then do
		SetUserData 'Language' Lang
		exit
		end
	end