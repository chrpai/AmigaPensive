/*
** Loads up the user's notes into your favourite text editor.
*/

Options Results
Address 'ZEUS'


/* Dummy line for ExpandCC */
Line = 0

UEDThere
if RC = 0 then do
	UEDGetCurrentUserName
	if RC = 0 then do
		UserName = RESULT
		LoadUser '"'UserName'"'
		if RC = 0 then do
			User = RESULT
			UserName = Translate(UserName,'_',' ')
			ExpandCC '"%125|"'
			UserPath = RESULT
			FileName = UserPath||UserName||'/Notes'
			GetLocalEditor '"'FileName'"'
			if RC = 0 then do
				address command RESULT
				end
			else do
				UEDDisplayUser '"No local editor defined!"'
				end
			end
		else do
			UEDDisplayUser '"Could not load 'RESULT'!"'
			end
		end
	else do
		UEDDisplayUser '"No User Selected!"'
		end
	end
exit
