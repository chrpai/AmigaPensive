pipeline.library/KillMe                               pipeline.library/KillMe

    NAME
        KillMe -- when Pipeline is shutting down, the task calling this
                  function will be signalled.

    SYNOPSIS
        success = KillMe( SigBits )
          d0                d0
          
        int KillMe( ULONG );

    FUNCTION
        When writing ARexx functions and control code handlers, your main
        program may not have much to do apart from install the commands and
        then wait for Pipeline to quit.  To do this in a CPU friendly way
        use this function to tell Pipeline to signal you when it's about to
        shut down.
        
    INPUTS
        SigBits - The mask of bits that your task will be sent.

    EXAMPLE
       
       /* Example 'main' for a program that adds functions and control */
       /*    codes to Pipeline                                         */
       
       int main( void )
       {
           APTR fdlist;
           
           if( fdlist = AddFDList( &my_func_list, ..... 
           {
               if( KillMe( SIGBREAKF_CTRL_C ) )
               {
                   Wait( SIGBREAKF_CTRL_C );      /* No CPU time taken */
               }
               
               RemFDList( fdlist );
           }
       }
       
    RESULTS
       FALSE - Not sucessful.
       TRUE  - Task installed in list.

    BUGS

    SEE ALSO
       DontKillMe(), LineKillMe(), LineDontKillMe()
pipeline.library/LayoutGads                       pipeline.library/LayoutGads

    NAME
        LayoutGads -- Spaces the control screen gadgets nicely.

    SYNOPSIS
        LayoutGads()

        void LayoutGads( void );

    FUNCTION
        Lays out the gadgets in rows on the control screen.
        
    BUGS
        Doesn't think about text attached to gadgets.

    SEE ALSO
       AddGad(), RemGad(), AttachGads(), DetachGads()

pipeline.library/LineDontKillMe               pipeline.library/LineDontKillMe

    NAME
        LineDontKillMe -- Cancels a call to LineKillMe

    SYNOPSIS
        success = LineDontKillMe( Line )
          d0                       d0
          
        int LineDontKillMe( UWORD );

    FUNCTION
        If you previously called LineKillMe but need to exit before Pipeline
        then a call to this function will tell Pipeline not to send you any
        signals when it closes the line.
        
    INPUTS
       Line - The same line number given to LineKillMe

    RESULTS
       FALSE - Not sucessful.
       TRUE  - Task removed from list.

    BUGS

    SEE ALSO
       KillMe(), DontKillMe(), LineKillMe()

pipeline.library/LineKillMe                       pipeline.library/LineKillMe

    NAME
