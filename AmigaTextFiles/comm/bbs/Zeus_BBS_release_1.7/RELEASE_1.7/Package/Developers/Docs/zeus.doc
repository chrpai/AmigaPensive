pipeline.library/MakeNewUser                     pipeline.library/MakeNewUser

    NAME
        MakeNewUser -- Allocates and fills out a new user structure.

    SYNOPSIS
        User = MakeNewUser( Name )
         d0                  a0
        
        struct User *MakeNewUser( char * );

    FUNCTION
        Allocates, initialises and links in a new User structure.  The
        fields filled are as follows:
        
        ur_Name           - The supplied Name
        ur_Alias          - Also set to the supplied name.
        ur_CallsToday     - 1
        ur_FirstCall      - Set to current date and time
        ur_MinsLeft       - 1440
        ur_MaxMinsPerDay  - 1440
        ur_Flags          - UF_NO8BIT | UF_NOANSI | UF_LOGUSER

    NOTES        
        The user is not saved.

    INPUTS
        Name - The name of the new user.

    RESULTS
        0 - User cannot be created.
       >0 - New user pointer.

    BUGS
        None.

    SEE ALSO
        SaveUser()
pipeline.library/NextRexxArg                     pipeline.library/NextRexxArg

    NAME
        NextRexxArg -- Get the next argument to your function.

    SYNOPSIS
        Len = NextRexxArg( LineNum, Buffer, Max )
         d0                   d0      a0     d1
         
        int NextRexxArg( int, char *, int );

    FUNCTION
        In order to read the arguments passed to your ARexx function, you
        can use 'NextRexxArg' to read them off one at a time into a buffer.
        The arguments can have control codes in them which follow the
        standard C format of a backslash followed by the escaped character.
        
        '\n' = 0x0D (Carrage Return)
        '\r' = 0x0A (Line Feed)
        '\b' = 0x08 (Backspace)
        '\"' = '"'
        '\\' = '\'

    INPUTS
        LineNum - The current line number;
        Buffer  - Pointer to where the argument will be put.
        Max     - Maximum characters allowed in Buffer.

    RESULTS
        0 - No more arguments.
       >0 - Length of the argument put into Buffer.

    BUGS
       None.

pipeline.library/NextUserKey                     pipeline.library/NextUserKey

    NAME
        NextUserKey -- Get the next user index.

    SYNOPSIS
        success = NextUserKey( UserKey )
          d0                     a0
        
        BOOL NextUserKey( struct UserKey * );

    FUNCTION
        Gets the next userkey in the direction specified with InitUserKey.

    INPUTS
       UserKey - A UserKey as obtained by InitUserKey

    RESULTS
        TRUE  - Key has been filled out with the new data.
        FALSE - No more users or other error.

    BUGS
        None.

    SEE ALSO
        InitUserKey(), EndUserKey(), LoadUserFromKey()
pipeline.library/NiceLine                           pipeline.library/NiceLine

    NAME
        NiceLine -- Formats a string nicely with support for comments.

    SYNOPSIS
        DestLen = NiceLine( Source, Dest, CommentFlag )
          D0                 A0     A1       D0

        int NiceLine( char *, char *, ULONG );

    FUNCTION
        Designed to be an useful function for reading text based config
        files.  Given a input line which may contain spaces, tabs and
        comments, it will return a line with one space between each option,
        no trailing spaces and will cut comments out.  Comments start with
        a semicolon.

    EXAMPLE
        Source = '   OPTION   18237  ; This is a comment...'
        
        will return
        
        Dest   = 'OPTION 18237'
        
    INPUTS
        Source - a pointer to the string to be formatted
        Dest   - a pointer to a buffer where the destination string will be
                     stored
        CommFlag - set to NULL if you don't want comments to be cut off.

    RESULTS
        DestLen - The length of the formatted string in Dest.

    BUGS
        None.

pipeline.library/NiceName                           pipeline.library/NiceName

    NAME
        NiceName -- Formats a users name nicely.

    SYNOPSIS
        UserName = NiceName( UserName )
           D0                   A0
           
        char *NiceName( char * );

    FUNCTION
        NiceName will attempt to capitalise a users name correctly.

    EXAMPLES
        Name = 'aLeX mAy'      ->  'Alex May'
        Name = 'bill mcfoort'  ->  'Bill McFoort'
        Name = 'roger d'rog'   ->  'Roger D'Rog'

    INPUTS
       UserName - Pointer to the users name.

    RESULTS
       UserName - the same pointer is returned so you can use NiceName in
                  printf statements etc.

       void main( void )
       {
          char name[] = "foodle humplings";

          printf( "My name is *DEFINATLY* not %s\n", NiceName( name ) );
       }

    BUGS
       None.

