@Node RebuildFiles()

zmf.library/RebuildFiles

   NAME
      RebuildFiles

   SYNOPSIS
      int RebuildFiles ( ULONG Area, BOOL Safe, BOOL RollOff )
       d0                 d0          d1         d2

   FUNCTION
      Rebuilds the File Catalogue. This includes removing deleted records,
      rebuilding and resorting the quick index lists.

   INPUTS
      Area -       Area to Rebuild.
      Safe -       Operate in safe mode (will be alright after a reboot).
                   NB: It is faster in non-safe mode, but very dangerous
                  in that you could lose a file catalogue!
      RollOff -   Roll off the files in the area according to the
                  number specified in the area config in PLFileCfg.
                  Files can be protected from rolling off by the
                  'No Roll Off' flag. This can be attributed to a file
                  in PLFileEd.

   RETURNS
      0 - Successful
      1 - Rebuilder Already Active!
       2 - Can't Create MsgPort!

   SEE ALSO
      "Pipeline:Bin/Rebuild" Information.

@EndNode

@Node DeleteCatFile()

zmf.library/DeleteCatFile

    NAME
       DeleteCatFile

    SYNOPSIS
       signed int DeleteCatFile ( ULONG Number )
        d0              d0

    FUNCTION
       Deletes a file's catalogue entry, but not Physical file.
       NB: Although the system will no longer recognise the file
       after this function is called successfully, the indexing
       information will still be stored in the FileDesc and
       FileData files. To remove these totally, a call to
       FileRebuild will be necessary. This is, however, a long
       operation.

    INPUTS
       Number - The number of the file to delete.

    RESULTS
       0  - Success
       -1 - No Such File!
       -2 - Can't Load DataFile
       -3 - Can't Open FileIndex file.
       -4 - Can't Get Alpha Index filename.
       -5 - Can't open Alpha Index
       -6 - Can't open File Pointers file.

    BUGS

@EndNode

@Node GetFileNoExt()

zmf.library/GetFileNoExt

    NAME
      GetFileNoExt

    SYNOPSIS
       struct fileindex *GetFileNoExt ( char *FileNameNoExt )
       d0                               a0

    FUNCTION
      Returns the index structure corresponding to the file 'FileNameNoExt'.
      However, unlike GetFile, this function ignores the prefix of the
      filename, e.g. 'A_FILE.LHA' would be the same as 'A_FILE.TXT'. This
      allows you to check for duplicate files simply packed with a
      different archiver!

    INPUTS
      FileName - FileName of file to find.

    RESULTS
      NULL - No match found!
      >0   - Pointer to data structure.

    EXAMPLE

      ------------------- 8< --------------------   
      struct fileindex *indx;

      indx = GetFileNoExt ( "A_FILE.LHA" ) ;

      if ( indx )
      {
         /* e.g. Could return 'A_FILE.ZIP' or 'A_FILE.TXT' */
         printf ( "Matching file %s\n", indx->FileName ) ;
      }
      else
      {
         printf ( "No Such File on BBS!\n" ) ;
      }
      ------------------- 8< --------------------   

@EndNode

