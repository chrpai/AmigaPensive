@Node FindMessageFromDate()

zmf.library/FindMessageFromDate

   NAME
      FindMessageFromDate

   SYNOPSIS
      MessageNumber = FindMessageFromDate ( Area, Date, Flags )
       d0                                    d0    a0    d1

      ULONG FindMessageFromDate ( int, time_t *, int )

   FUNCTION
      Find's the Message Number corresponding to a specific
      date (stored in standard UNIX C time_t format). This
      message can then be loaded by LoadMsg(), or forward/backward
      scanned using ScanMessages().

   INPUTS
      Area -- Area to search.
      Date -- Date to search for in time_t format.
      Flags --
         #define FMFD_EQUAL     0x0001
         #define FMFD_LESS_THAN 0x0002
         #define FMFD_MORE_THAN 0x0004
         #define FMFD_MONTH     0x0008
         #define FMFD_HOUR      0x0010
         #define FMFD_MIN       0x0020
         #define FMFD_SECONDS   0x0040
         #define FMFD_DAY       0x0080

         FMFD_EQUAL - Find the first message number which
            matches the date exactly.
         FMFD_LESS_THAN - Find the last message number
            which is dated earlier than 'Date'.
         FMFD_MORE_THAN - Find the first message number
            which is dated later than 'Date'.

         FMFD_MONTH - Use the information from YY/MM
            date fields.
         FMFD_HOUR - Use the information from YY/MM/DD HH
            data fields.
         FMFD_MIN - Use the information from YY/MM/DD HH:MM
            data fields.
         FMFD_SECONDS - Use the information from YY/MM/DD
            HH:MM:SS data fields.
         FMFD_DAY - Use the information from YY/MM/DD
            data fields. (Used most often.)

   RESULTS
      >0 - File Number
      -1 - Error!
      0  - No File with this date.

   BUGS

@EndNode

@Node FindFileFromDate()

zmf.library/FindFileFromDate

   NAME
      FindFileFromDate

   SYNOPSIS
      FileNumber = FindFileFromDate ( Area, Date, Flags )
       d0             d0    a0    d1
      ULONG FindFileFromDate ( int, time_t *, int )

   FUNCTION
      Find's the File Number corresponding to a specific date
      (stored in standard UNIX C time_t format). This
      file can then be loaded by LoadFile(), or forward/backward
      scanned by ScanFiles().

   INPUTS
      Area -- Area to search.
      Date -- Date to search for in time_t format.
      Flags --
         #define FMFD_EQUAL     0x0001
         #define FMFD_LESS_THAN 0x0002
         #define FMFD_MORE_THAN 0x0004
         #define FMFD_MONTH     0x0008
         #define FMFD_HOUR      0x0010
         #define FMFD_MIN       0x0020
         #define FMFD_SECONDS   0x0040
         #define FMFD_DAY       0x0080

         FMFD_EQUAL - Find the first message number which
            matches the date exactly.
         FMFD_LESS_THAN - Find the last message number
            which is dated earlier than 'Date'.
         FMFD_MORE_THAN - Find the first message number
            which is dated later than 'Date'.

         FMFD_MONTH - Use the information from YY/MM
            date fields.
         FMFD_HOUR - Use the information from YY/MM/DD HH
            data fields.
         FMFD_MIN - Use the information from YY/MM/DD HH:MM
            data fields.
         FMFD_SECONDS - Use the information from YY/MM/DD
            HH:MM:SS data fields.
         FMFD_DAY - Use the information from YY/MM/DD
            data fields. (Used most often.)

   RESULTS
      >0 - File Number
      -1 - Error!
      0  - No File with this date.

   BUGS

@EndNode

@Node InsertNodeAlpha()

zmf.library/InsertNodeAlpha

   NAME
      InsertNodeAlpha -- Insert a node at a particular point in a
         list.

   SYNOPSIS
      Success = InsertNodeAlpha ( List, Node, CompareFunc )
       d0                          a0    a1    a2

      signed int InsertNodeAlpha ( struct List *, struct Node *, int (*)() )

   FUNCTION
      This function scans down the list, passing 'Node' into
      arg1 of CompareFunc, and the current scan node into
      arg2. When it finds the correct node to insert Node
      in front of, it calls - Insert ( List, Node, ScanNode ) ;

      This functions purpose is to maintain an Alphabetically
      sorted list at all times. If the list is protected by
      a semaphore, this should be obtained before calling
      InsertNodeAlpha.

      If a node could not be inserted (for some reason), this
      function will return FALSE.

   INPUTS
      List -- Pointer to List to insert Node into.
      Node -- Node to Insert into List.
      CompareFunc -- A function which compares two nodes,
         and returns < 0 if arg1 is less than arg2,
         0 if they are equal, and > 0 if arg1 is more
         than arg2.

   RESULTS
      FALSE -- Insert() failed.
      TRUE  -- Node placed in list.

   EXAMPLE
      ---------------------------------------------------
      struct List   *FileListAlpha; /* A previously initialised list */

      signed int __saveds
      CompFunc ( struct Node *one, struct Node *two )
      {
         return ( strcmp ( one->ln_Name, two_ln_Name ) ) ;
      }

      int InsertNode ( char *Name )
      {
         struct Node   *NewNode;

         if ( NewNode = (struct Node *) AllocMem ( sizeof ( struct NewNode ), MEMF_PUBLIC ) )
         {
            if ( NewNode->ln_Name = strdup ( Name ) )
            {
               InsertNodeAlpha ( FileListAlpha, NewNode, CompFunc ) ;
            }
         }
      }
      ---------------------------------------------------
   
@EndNode

@Node MatchStr()

zmf.library/MatchStr

   NAME
      MatchStr -- Does UNIX Style Pattern Matching on a String

   SYNOPSIS
      Success = MatchStr ( String, PatternString )
       d0                   a0      a1

      int MatchStr ( char *, char * ) ;

   FUNCTION
      Compares 'String' against a Pattern String, which may
      contain the wildcards '*' and '?'.

   INPUTS
      String -- String to Compare
      PatternString -- String containing any number of wildcards.

   RESULTS
      0 - Didn't Match
      1 - Matched OK!

@EndNode

@Node GetHighPointer()

   NAME
      GetHighPointer -- Gets an on-line uses High Message Pointer for an Area.

   SYNOPSIS
      Pointer = GetHighPointer ( Line, Area )
       d0                         d0    d1
      LONG      GetHighPointer ( int, int )

   FUNCTION
      Finds the Highest Message Number a User has read in a specific Message
      Area and returns it.
      
   INPUTS
      Line -- LineNumber of user to find.
      Area -- AreaNumber to get High Message information from.

   RESULTS
      >= 0 -- Data Requested.
      -1   -- Error!
      -2   -- Area not listed in HighPointers list. This means that the
              users low pointer is whatever the low message pointer of
              that particular message base is. See GetPointers().


   SEE ALSO
      @{"GetPointers()" Link GetPointers()}
      

@EndNode

@Node ReadWholeFile()

   NAME
      ReadWholeFile -- Allocates and Buffer and reads an entire file into it.

   SYNOPSIS
      Buffer = ReadWholeFile ( Name, Len )
       d0                       a0    a1
      APTR ReadWholeFile ( char *, ULONG * )

   FUNCTION
      Allocates a Buffer to the size of the file specified in Name, Reads
      the entire file into it, places the length of the buffer into *Len,
      and returns the buffer as an APTR.
      
   INPUTS
      Name -- Name of File To Read
      Len  -- Location to place the number of bytes Allocated into.

   RESULTS
      NULL -- Error Reading File!
      >0   -- Pointer to Requested Data

   NOTES
      Requires Pipeline to be Running!      

   EXAMPLE
      /* Simple TYPE Command */

      #include <exec/types.h>
      #include <dos/dos.h>

      #include <proto/pipeline.h>
      #include <proto/pipeutil.h>

      main(int argc, char **argv)
      {
         struct Library *PipeLineBase;
         struct Library *PipeUtilBase;
         ULONG           len;
         char           *text;

         PipelineBase = OpenLibrary ( "zeus.library", 37 ) ;
         if ( PipelineBase )
         {
             PipeUtilBase = OpenLibrary ( "zmf.library", 37 ) ;
             if ( PipeUtilBase )
             {
                 if ( argc == 2 )
                 {
                     text = ReadWholeFile ( argv[1], &len ) ;
                     if ( text )
                     {
                           PutStr ( text ) ;
                           Printf ( "\nLen = %ld\n, len ) ;
                     } else PutStr ( "Error!\n" ) ;
                 } else PutStr ( "Usage: Type <FileName>\n" ) ;
             } else PutStr ( "No PipeUtilBase\n" ) ;
         } else PutStr ( "No PipelineBase\n" ) ;
      }

@EndNode

@Node ReadWholeFile()

   NAME
      ReadWholeFile -- Allocates and Buffer and reads an entire file into it.

   SYNOPSIS
