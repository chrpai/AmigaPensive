             } else PutStr ( "No PipeUtilBase\n" ) ;
         } else PutStr ( "No PipelineBase\n" ) ;
      }

@EndNode

@Node ReadWholeFile()

   NAME
      ReadWholeFile -- Allocates and Buffer and reads an entire file into it.

   SYNOPSIS
      Buffer = ReadWholeFile ( Name, Len )
       d0                       a0    a1
      APTR ReadWholeFile ( char *, ULONG * )

   FUNCTION
      Allocates a Buffer to the size of the file specified in Name, Reads
      the entire file into it, places the length of the buffer into *Len,
      and returns the buffer as an APTR.

      Free the memory after use with FreeMem( Buffer, Len ).
      
   INPUTS
      Name -- Name of File To Read
      Len  -- Location to place the number of bytes Allocated into.

   RESULTS
      NULL -- Error Reading File!
      >0   -- Pointer to Requested Data

   NOTES
      Requires Zeus to be Running!

   EXAMPLE
      /* Simple TYPE Command */

      #include <exec/types.h>
      #include <dos/dos.h>

      #include <proto/pipeline.h>
      #include <proto/pipeutil.h>

      main(int argc, char **argv)
      {
         struct Library *PipeLineBase;
         struct Library *PipeUtilBase;
         ULONG           len;
         char           *text;

         PipelineBase = OpenLibrary ( "zeus.library", 37 ) ;
         if ( PipelineBase )
         {
             PipeUtilBase = OpenLibrary ( "zmf.library", 37 ) ;
             if ( PipeUtilBase )
             {
                 if ( argc == 2 )
                 {
                     text = ReadWholeFile ( argv[1], &len ) ;
                     if ( text )
                     {
                           PutStr ( text ) ;
                           Printf ( "\nLen = %ld\n, len ) ;
                           FreeMem ( Buffer, Len ) ;
                     } else PutStr ( "Error!\n" ) ;
                 } else PutStr ( "Usage: Type <FileName>\n" ) ;
             } else PutStr ( "No PipeUtilBase\n" ) ;
         } else PutStr ( "No PipelineBase\n" ) ;
      }

@EndNode

@Node ParseFidoAddr()

   NAME
      ParseFidoAddr - Parses a 2D-5D FidoNet address.

   SYNOPSIS
      Success = ParseFidoAddr ( String, Address )
       d0                        a0      a1
      BOOL  ParseFidoAddr ( char *, struct FidoAddress * )

   FUNCTION
      Parses a FidoNet Address in 'String', and converts it into it's
      respective parts in FidoAddress. Make sure the Address structure
      is cleared before use, because it will not write into fields
      not specified in the String.

      This function supports -
           "Net/Node"
           "Zone:Net/Node"
           "Net/Node.Point"
           "Zone:Net/Node.Point"
           "Domain#Zone:Net/Node.Point"
           "Zone:Net/Node.Point@Domain"
      
   INPUTS
      String -- Character String containing FidoNet address to Parse.
      Adr -- Address Structure to fill in.

   RESULTS
      TRUE -- Address Parsed Successfully
      FALSE -- Invalid FidoNet address.

@EndNode

