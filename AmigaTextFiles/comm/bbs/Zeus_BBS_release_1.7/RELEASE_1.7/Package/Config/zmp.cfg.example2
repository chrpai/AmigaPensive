;
; AreaFix flags:
;
;    N - No access
;    Y - May link/unlink to echos
;    U - May request echos from uplink
;    C - Full areafix control
;

;
; ZeusNet setup
;

NODE			85:1/1.0@zeusnet
AKA			0
POINTNET		8511
ZONES			85
CREATENEW	150
CREATELINK	150
NEWTICKAREA	500

;								,-------- AreaFix access        (N,Y,U,C)
;								|,------- Control line type     (2,3)
;								||,------ Allow packet change   (Y,N)
;								|||,----- Allow archiver change (Y,N)
;								||||,---- Netmail FLO type      (N,H,D,C)
;                       |||||,--- Echomail FLO type     (N,H,D,C)
;								||||||,-- *.TIC file FLO type   (N,H,D,C)
;								|||||||,- Packet header type    (A,B,C,D)
;								||||||||' Archive Netmail       (Y,N)
;				Address		vvvvvvvvv	Arc	Packet	AreaFix	Tick		Group(s)

SYSTEM		2				U2YYHHHCY	LHA	-NONE-	-NONE-	  ""		0 1
