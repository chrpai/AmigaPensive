;
; Configuration file for ZMP
;
; Use TAB size 3.
; Full documentation is provided in the manual.


; Global Settings

; Set MSGBUFFER as big as possible - it determines the maximum message size processed.
MSGBUFFER		32768
; Number of indexes used for dupe checking.
IDXSTORE			1024

FLOCTRL
4DFLO
CTRLCHAR			^

; MINMSGS			20

; CRCDUPE
; NODUPECHECK

; DELNETATTACHED
; DELNETMAIL

NOCHKNETDOMAIN
; NOCHKECHODOMAIN
NOCHKPKTDOMAIN

BOUNCEBADADDR
BOUNCENOROUTE
BOUNCENOUSER

UNPACKDIR		T:
PACKDIR			T:

ATTACHDIR		File:Attached

AREAFMT			\t\t\t%-11s\s%ld\t\t\t
TICKFMT			\t\t\t%-11s\t%ld\t%ld\t

; HIDEARCS

ALLOWRESCAN

; ALLOWMIXEDPKT

; Set this to announce the auto-creation of new message/tick echoes in the specified area number.
; ANNOUNCEAREA   3





;
; AreaFix flags:
;
;    N - No access
;    Y - May link/unlink to echos
;    U - May request echos from uplink
;    C - Full areafix control
;
;
; Linked systems prefixes
;
;       - - The system has Read Only access
;       = - The system is not linked, but if they do fix in they will have
;           read only access
;       | - The systems mail is currently paused to this area
;       # - The systems mail is currently paused, and when they resume the
;           area they will have read only access.


;
; ZeusNet setup
;

NODE			85:1/2.0@zeusnet
AKA			0
POINTNET		8512
ZONES			85
CREATENEW	100
CREATELINK	100
NEWTICKAREA	500

;								,-------- AreaFix access        (N,Y,U,C)
;								|,------- Control line type     (2,3)
;								||,------ Allow packet change   (Y,N)
;								|||,----- Allow archiver change (Y,N)
;								||||,---- Netmail FLO type      (N,H,D,C)
;                       |||||,--- Echomail FLO type     (N,H,D,C)
;								||||||,-- *.TIC file FLO type   (N,H,D,C)
;								|||||||,- Packet header type    (A,B,C,D)
;								||||||||' Archive Netmail       (Y,N)
;				Address		vvvvvvvvv	Arc	Packet	AreaFix	Tick		Group(s)

SYSTEM		1				U2YYNNNBY		LHA	-NONE-	-NONE-	-NONE-	0 1
SYSTEM		11				U2YYNNHBY		LHA	-NONE-	HOOPHOOP	-NONE-	0
SYSTEM		15				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		17				U2YYNNHBY		LZX	-NONE-	-NONE-	MAUI		0
SYSTEM		23				U2YYNNHBY		LHA	-NONE-	-NONE-	asdfo9nw	0
SYSTEM		29				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		30				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		31				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		32				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		33				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		34				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		36				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		38				U2YYNNHBY		LHA	ALLO	ALLO	ALLO	0
SYSTEM		42				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		44				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		45				U2YYNNHAY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		46				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		47				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		54				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0
SYSTEM		60				U2YYNNHBY		LHA	-NONE-	-NONE-	-NONE-	0

;				Tag Name		Group		Linked in

AREA			ZEUS_BETA	0			1 2 11 17 23 29 30 31 32 33 34 38 42 44 45 46 47 54 60
AREA			ZEUS_SYSOP	0			1 2 11 17 23 29 30 31 32 33 34 38 42 44 45 46 47 54 60
AREA			ZEUS_UTIL	0			1 2 11 17 23 29 30 31 32 33 34 38 42 44 45 46 47 54 60
AREA			ZEUS_SCRIPT 0			1 2 11 17 23 29 30 31 32 33 34 38 42 44 45 46 47 54 60


;				Tagname	Group	FileArea	Linked in
TICK			ZEUS_BETA	0	200	1 2 11 17 23 29 30 31 32 33 34 36 38 42 44 45 46 47 54 60
TICK			ZEUS_UTIL	0	201	1 2 11 17 23 29 30 31 32 33 34 36 38 42 44 45 46 47 54 60


; If a user requests an area which is not on your system but is on an uplink,
; this will be used to find the area and send the required AreaFix message.
;         Address  Password

;UPLINK    101      uplink_pass

; Addresses which can create new areas on your BBS.
;         Addresses

;ALLOWNEW  101 256/607 255/160 442/108 .50



;				From			To

ROUTE			11	11
ROUTE			15	15
ROUTE			17	17
ROUTE			23	23
ROUTE			24	23
ROUTE			29 29
ROUTE			30	30
ROUTE			31	31
ROUTE			32	32
ROUTE			33	33
ROUTE			34	34
ROUTE			36	36
ROUTE			38	38
ROUTE			42	42
ROUTE			44	44
ROUTE			45	45
ROUTE			47 47
ROUTE			46	46
ROUTE			54	54
ROUTE			60 60
ROUTE			61	60
ROUTE			*.* 1



; These automatically fix the given systems in if a new area is created here.
;AUTOTICKADD   250/366 103
;AUTOECHOADD   .1

; Limit all packets in ZeusNet to half a MB.
;MAXPKTSIZE      524288 *:*/*.*

; Limit all bundles to 1MB.  Packets are compressed, so about 6 or 8 512KB
; packets fit one of these.
;MAXBUNDLESIZE  1048576 *:*/*.*
