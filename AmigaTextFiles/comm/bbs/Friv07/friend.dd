/* Online friend v0.5 */
Parse Arg node;Options results;nodeid="DREAMREXX"node;address value nodeid;
MAIN:
transmit "";
transmit "Hello, how are you ? I'm okay "
prompt 300 NORMAL ")"
transmit "Yeah,"

LOOPER:
prompt 300 NORMAL ")"
if result = "Bye" then call SHUTUP
if result = "Cyaz" then call SHUTUP
if result = "Goodbye" then call SHUTUP
if result = "goobye" then call SHUTUP
if result = "bye" then call SHUTUP
if result = "cyaz" then call SHUTUP
if result = "see you soon" then call SHUTUP
if result = "exit" then call SHUTUP
if result = "EXIT" then call SHUTUP
if result = "QUIT" then call SHUTUP
if result = "quit" then call SHUTUP
if result = "x" then call SHUTUP
ANS = RANDOM(1,5)
if ANS = 1 then call TRA
if ANS = 2 then call TRB
if ANS = 3 then call TRC
if ANS = 4 then call TRD
if ANS = 5 then call TRE

TRA:
transmit "Okay,"
call LOOPER
TRB:
transmit "Yeah,"
CALL LOOPER
TRC:
transmit "I see what you mean,"
CALL LOOPER
TRD:
transmit "I know,"
CALL LOOPER
TRE:
transmit "Continue.."
call LOOPER

SHUTUP:
newline
transmit "Okay, C u soon,"
getchar;SHUTDOWN
