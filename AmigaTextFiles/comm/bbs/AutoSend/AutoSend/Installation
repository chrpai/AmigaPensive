;Installationsscript für Commodore Installer

(set @default-dest (cat "prometheus:SkyTools/AutoSend/"))
(transcript "Installation von AutoSend V1.55")

(set #source (cat "install/"))
(set #dest (cat "prometheus:SkyTools/AutoSend/"))

(message
  "\n\n\n\nWillkommen bei der AutoSend V1.55 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)  

(working)
(complete 0)

(makedir "prometheus:SkyTools"
  (infos)
)

(makedir "prometheus:SkyTools/AutoSend"
  (infos)
)

(complete 10)

(copyfiles
  (prompt "Kopiere Files...")
  (choices "AutoSend" "AutoSend.guide" "NetzAntrag.txt")
  (source #source)
  (dest #dest)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 40)

(copyfiles
  (prompt "Kopiere Files...")
  (choices "AutoSend-Prefs")
  (source #source)
  (dest "SYS:Prefs")
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 70)

(copyfiles
  (prompt "Kopiere Files...")
  (choices "UUEncode")
  (source #source)
  (dest "c:")
  (help @copyfiles-help)
  (confirm)
)

(complete 100)
