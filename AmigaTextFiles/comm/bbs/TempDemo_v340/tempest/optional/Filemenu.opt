-=File Area=-

[*,*,*,*,*]   =A    |CLONE|LF
[*,*,*,*,*]   =C    |CLONE|L
[20-,*,*,*,*] =D Z  |CLONE|D
[*,*,*,*,*]   =EALL |MACRO|MB;MM;E
[20-,*,*,*,*] =F 1  |MACRO|+;F
[*,*,*,*,*]   =M    |MACRO|TS;7;;
[20-,*,*,*,*] =NEW  |CLONE|F
[*,*,*,*,*]   =OFF  |MACRO|G;;
[*,*,*,*,*]   =R    |MACRO|MB;R
[*,*,*,*,*]   =R -  |MACRO|MB;R;-;
[*,*,*,*,*]   =R Y  |MACRO|MB;SM;1;
[*,*,*,*,*]   =SM   |MACRO|MB;SM
[255,*,*,*,*] =SYSOP|PRINT|SCRIPTS:SysopCommands
[*,*,*,*,*]   =TB   |MACRO|TS;11;;
[20-,*,*,*,*] =U Z  |MACRO|U;;;
[20-,*,*,*,*] =V    |CLONE|R
[*,*,*,*,*]   =X    |MACRO|TS;9;;

-=DOORS=-

[20-,*,*,*,*] =L    |MODULE|CONFERENCE.mod
[*,*,*,*,*]   =S    |T-DOOR|DOORS:DSKEL-XS

[20-,*,*,*,*] =E    |FORCE|
