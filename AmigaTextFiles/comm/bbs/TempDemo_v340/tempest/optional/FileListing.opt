-=FILE LISTINGS=-

[*,*,*,*,*]   =A    |CLONE|LF
[*,*,*,*,*]  =B    |MACRO|Q;MM;B
[20-,*,*,*,*] =D Z  |CLONE|D
[20-,*,*,*,*] =N S A|MACRO|Q;N S A
[20-,*,*,*,*] =N S U NS|MACRO|Q;N S U
[20-,*,*,*,*] =N T U|MACRO|Q;N T U
[*,*,*,*,*]   =OFF  |MACRO|G;;;
[20-,*,*,*,*] =RZ   |MACRO|U;;;
[20-,*,*,*,*] =U Z  |MACRO|U;;;
[20-,*,*,*,*] =Z    |MACRO|Q;Z

-=DOORS=-

[*,*,*,*,*]   =S    |T-DOOR|DOORS:DSKEL-XS
;[20-,*,*,*,*] =T    |P-DOOR|DOORS:P-Time
[255,*,*,*,*]=$    |MACRO|Q;$
