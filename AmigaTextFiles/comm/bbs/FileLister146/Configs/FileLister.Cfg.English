; Config file for Filelister V1.4xx

; Access for faking
FakerAccess       255
; Access for changing a description
ChangeDescAccess  255

; maximum amount of files which can exist online
; each file need 8 bytes
; !! IMPORTANT !! If you use the sorted index you MUST set this value to
                  the amount of files which can be accessed via TA. Setting
                  this value to low will cause a crash.
MaxFiles          20000

; pattern symbols to be acknowledged
PatternSymbols    "?#()~[]%*"

; path to the private dirs of the users
PrivPfad          "FILE:/privfiles/"

; never mark files that match this pattern
NeverMark         "(Files.BBS#?|#?.Desc)"

; path to the private messages (for Faker)
PrivMsg           "MAIL:priv/"

; default download counter to be used
DCAdd             "[00]"
; maximum length of filedescription
DescLength        37

; path to the user data for file marks (better DON'T use bbs:users/ to
; avoid chaos)
MarkierungsPfad   "USER:"

; access to files via Files.BBS or directory access ?
SearchInFilesBBS  NO

; for Sysops with low memory (<2MB of free memory after running TA)
; MemoryLamer NO will speed up filelister
MemoryLamer       YES

; use TA1.11 commands only ?
UseOnlyTA111Cmds  NO

; areas to be listet while newfiles scan
; Syntax :  x-y   : list area x to y
;           x,y,z : list area x, y and z
;           x-    : list areas from x
;           -x    : list areas to x
;           Exmample : 1,3,5-10,20-
Arealist          1-

; to work arround a missing feature of TrXpr you can set a flag for
; sending one file after another or send as much files as possible
; in one batch session
; (0 = send EVERYTIME the maximum amount of files in one batch session
;  256 = send EVERYTIME single)
SendSingle        1

; private use for setting lastread pointers
; contact me for more informations
MessageConfs      29

; show logoff text after autologoff ?
ShowLogoffText    YES

; complete the fileliste after destroying via marking many files or
; viewing a long description (ANSI users only)
CompleteList      YES

; abort list after pressing one of the abort keys (SPACE, CTRL+C, CTRL+D,
; ESC) and quit after the prompt or go on after using the prompt ?
ReallyAbortList   YES

; decide what to do with the ratios
; IGNORE     : ignore ratio
; FILEBASED  : use ratio with the amount of down/uploaded files
; BYTESBASED : use ratio with the amount of down/uploaded bytes
UseRatio          IGNORE

; give every user a certain amount of upload additional
UploadAdd         1

; check if the marked files really exist before downloading
CheckBeforeDl     YES

; access for unlimited download-time
UnlimitedAccess   255

; ask for the protocol (TA1.12+) before downloading
AskProtocol       YES

; show the choice of each query even when command stack was used ?
HideStackedQuerys NO

; index file when NOT using the sorted index in the memory (for low
; memory systems)
; will be ignored when using internal index
SortedIndexFile   "FILE2:FileIndex.Sortiert"

; create internal index ? (need at least 4xMaxfiles bytes of memory)
; finds up to 50 files/second if the using enters the full filename
; (independent of the position in your filebase !!!)
; !! IMPORTANT !! This option only runs if MemoryLamer NO was set
UseIndex          YES

; area not to be put in the index because they was often changed
; Example : private dir, sysop dir, upload dir
; Comment : privat dir has number 0 !
PutNotInIndex     0,40,41

; because the Shortdescriptions are short anough, you can specify here
; if you want to skip the download counters in the listing or not
SkipDCounter      NO

; this is for saving CPU time. The unit is microsecons. (Default : 10000
; = 0.01 seconds). Time was waited after every outputted line on the
; screen
WaitAfterLine     10000

; here you can set the task priority of FileLister, because on multiline
; system it can be useful to set this value <0
TaskPriority      -1


