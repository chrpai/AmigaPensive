/* Upload.Trans fuer den Filelister, falls MemoryLamer=NO */

options results

systeminfo 2 ; currentarea=result
bbsidentify term
bbsline=strip(word(result,4))

/* Schauen, ob Filelister ueberhaupt aktiv ist */
befehl="host=show('P','FILELISTER."||bbsline||"')"
interpret befehl

/* Wenn ja, dann die aktuelle Filearea rescannen */
if host then do
  befehl="address 'FILELISTER."||bbsline||"' 'RESCAN "||currentarea||"'"
  interpret befehl
end

exit 0
