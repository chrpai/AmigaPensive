;$HBBS
; File: HBBS:Conferences/<confdir>/ConfConfig
; purpose: defines the conference options

ConfActive=TRUE             ; set to false to disable ALL access to the conference
ConfName=Group              ; conference name
ConfAccess=100              ; access level required to allow access to conference

HoldFileList=HBBS:Conferences/Group/FileLists/HoldList
HoldFiles_1=HBBS:Conferences/Group/Hold/

BadFileList=HBBS:Conferences/Group/FileLists/BADList
BadFiles_1=HBBS:Conferences/Group/BadFiles/

FileList_1=HBBS:Conferences/Group/FileLists/Files_1
ListDesc_1=Latest Files

PartUpload_1=HBBS:Conferences/Group/PartUpload/

NeedDIZ_1=HBBS:Conferences/Group/NeedDiz/

; upload_1 gets filled first..

Upload_1=HBBS:Files/Group/

; existance of files are checked in this order.

Download_1=HBBS:Files/Group/

; amount of lines that can be used for the file descriptions for this conf.

MaxDIZLines=12

; {S} = system name
; {C} = conf name
; {L} = time left
; {T} = time
; {D} = date
; {B} = bytes availiable! (per conf!)

MenuPrompt={E}33m{E}44m {S} [{C}] {L} Mins {E}37m{E}40m >

; same as /X's force newscan!...

AutoMailScan=YES

; confpasswd defines the password that a user needs before they can join a conference
; conf join programs MUST be aware of this setting!

;ConfPassWD=PASSWORD

; use these options to set who's allowed into the conference..
; if they aint on this list then they don't get in
; (if you use this option then it's best not to allow the user to change thier
; username!!)

;UserAllowed_1=Hydra
;UserAllowed_2=Daffy Duck
;UserAllowed_3=Cruise
;UserAllowed_4=Stab

KeepDIZWithFile=YES
