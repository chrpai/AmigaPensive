# Proteus Configuration file
# 
# NOTE: anything starting with a '#' will be ignored.
#
#
# The DIAL command allows you to specify two things, first, if you have a
# live 24 hour a day connection or not and which port the system is on;
# Set it to zero for a 24 hour a day connection, otherwise set it to the
# number of the port that the dialing is to take place on.
#
DIAL=0
#
#
#
# TO activate the credit system, use 1, to have PID ignore C-Nets accounting
# system, use zero
#
CREDIT=1
#
#
# ACCESS specifies the minimum access level to use PID.
#
ACCESS=1
#
#
# FTP specifies how many people can FTP at the same time thru PID.  Set to
# zero to disable and allow unlimited.
#
FTP=0
#
#
# SYSOP specifies the access level to permit pings and other high-end commands
#
SYSOP=31
#
#
# FDIR is the drive wou wish to make availible for the users to place
# their user directories for pid in. Be sure to use a trailing / or :
#
FDIR=Gwork:user/
#
#
# WHO will set the who banner in C-Nets who command to display anything you like
#
WHO=Internet Live!         
#
#
# ADDRESS specifies your machines address
#
#
ADDRESS=biolink.com
#
#
# TFTP sets the default ftp type to use, 0= ftp  1= ncftp
# Users may override for their own choice
#
TFTP=1
#
#
# FTPD turns on FTPD support.  NOTE that Proteus only supports M. Saunby's FTPD.
#               1=on 0=off
FTPD=1
#
#
# End PIDfig
