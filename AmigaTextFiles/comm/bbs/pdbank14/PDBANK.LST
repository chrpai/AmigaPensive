'
MODE 1
DIM hold$(20)
DIM ansi$(10)
' rem the next line when compiling the final door !!!
' test%=1
'
cr$=CHR$(13)+CHR$(10)
de$=CHR$(8)+" "+CHR$(8)
esc$=CHR$(27)
screenclr$=cr$+cr$+CHR$(12)
'
IF (test%=1) AND (NOT EXIST("Ram:Userdata"))
  ' setup dummy names, etc
  rtime$="300"
  uname$="PETER DEANE"
  id$="1"
  lev$="1"
  bd$="2400"
  ring$="0"
  ansi%=1
  path$="BBS:Doorfiles1/Door211/"
ELSE
  IF EXIST("ram:doordata")
    OPEN "I",#2,"RAM:USERDATA"
    LINE INPUT #2,rtime$
    LINE INPUT #2,uname$
    LINE INPUT #2,id$
    LINE INPUT #2,lev$
    LINE INPUT #2,bd$
    LINE INPUT #2,ring$
    LINE INPUT #2,path$
    CLOSE #2
  ELSE
    '
    ' THIS door WON'T work without doordata!!
    END
    '
  ENDIF
ENDIF
'
' Investigate our working environment from the config file...
'
IF EXIST("S:Metro.cfg")
  config$="S:Metro.cfg"
ELSE IF EXIST("BBS:Metro.cfg")
  config$="BBS:Metro.cfg"
ELSE IF EXIST("Metro.cfg")
  config$="Metro.cfg"
ELSE
  config$="XXX"
ENDIF
'
' Defaults
'
bbsname$="The OzMetro BBS"
sfd$="BBS:"
sysopname$="The Sysop"
winw$="640"
winh$="200"
'
IF config$<>"XXX"
  '
  OPEN "I",#2,config$,128
  DO WHILE (NOT EOF(#2))
    LINE INPUT #2,xx$
    xx$=TRIM$(xx$)
    xxu$=UPPER$(xx$)
    '
    IF xxu$="" OR LEFT$(xxu$,1)=";"
      ' Do nothing
    ELSE IF LEFT$(xxu$,7)="BBSNAME"
      xx$=MID$(xx$,8,255)
      xx$=TRIM$(xx$)
      bbsname$=xx$
    ELSE IF LEFT$(xxu$,9)="SYSOPNAME"
      xx$=MID$(xx$,10,255)
      xx$=TRIM$(xx$)
      sysopname$=xx$
    ELSE IF LEFT$(xxu$,11)="WINDOWWIDTH"
      xx$=MID$(xx$,12,255)
      xx$=TRIM$(xx$)
      winw$=xx$
    ELSE IF LEFT$(xxu$,12)="WINDOWHEIGHT"
      xx$=MID$(xx$,13,255)
      xx$=TRIM$(xx$)
      winh$=xx$
    ENDIF
    '
  LOOP UNTIL EOF(#2)
  CLOSE #2
ENDIF
'
' integer conversion for system variables
'
tpc%=VAL(rtime$)
id%=VAL(id$)
lev%=VAL(lev$)
ring%=VAL(ring$)
bd%=VAL(bd$)
timeon%=CINT(TIMER/200)
'
sw%=VAL(winw$)
sh%=VAL(winh$)
sx%=0
sy%=0
ww%=sw%
wh%=sh%-12
wx%=0
wy%=11
'
'
OPENS 1,sx%,sy%,sw%,sh%,3,32768
IF ring%=1
  BACKS 1
  OPENW #1,wx%,wy%,ww%,wh%,0,2304,1
ELSE
  OPENW #1,wx%,wy%,ww%,wh%,0,2304,1
  ~ActivateWindow(WINDOW(1))
ENDIF
'
' Hack these settings if you like: format &Hxxx
' the xxx is the HEX value of the RGB register
'
SETCOLOR 0,&H141
SETCOLOR 1,&HD62
SETCOLOR 2,&H2D2
SETCOLOR 3,&HCB2
SETCOLOR 4,&H56C
SETCOLOR 5,&HB6B
SETCOLOR 6,&H5DC
SETCOLOR 7,&HFEF
'
title$="Time Bank  ID: "+id$+" ("+uname$+") Lev: "+lev$+" Baud: "
IF ring%=0
  title$=title$+"Local Login"
ELSE
  title$=title$+bd$
ENDIF
TITLEW #1,"",title$
TITLES #1,title$
'
' modem need not be opened if it's a local login!
' then you can test em standalone with the BBS running, among other things...
'
IF ring%<>0
  GOSUB modem.o
ENDIF
'
' Figure out the page pause setting!
'
flnm$=sfd$+"BBSFILES/userlog"
IF EXIST(flnm$)
  OPEN "R",#2,flnm$,125
  FIELD #2,25 AS un$,10 AS pa$,1 AS le$,25 AS fr$,12 AS ph$,10 AS dl$,6 AS lm$,6 AS lf$,10 AS ind$,3 AS tc$,3 AS td$,1 AS sw$,1 AS pr$,1 AS mo$,5 AS cn$,4 AS dm1$,2 AS dm2$
  GET #2,id%
  page%=VAL(dm2$)
  CLOSE #2
ELSE
  page%=21
ENDIF
IF page%>5
  scrnht%=page%-1
ELSE
  scrnht%=22
ENDIF
IF ring%=0
  scrnht%=(wh%/8)-4
ENDIF
'
' ======================================================================
'
' We're in, hit em hard and good!
'
' reset terminal
o$=esc$+"[0;40;37m"+CHR$(12)
GOSUB 2
o$=cr$+cr$+"           Metro Time Bank"
GOSUB 2
o$=cr$+cr$+"               (c) PFD"
GOSUB 2
o$=cr$+cr$+"             Version 1.4"
GOSUB 2
o$=cr$+cr$+"              25-Nov-94"+cr$
GOSUB 2
GOSUB setansi
'
' ======================================================================
'
' Fix up the accounts files, and config
'
GOSUB dateconv
IF NOT EXIST(path$+"Accounts")
  ' this is for the very first time -  start afresh
  ' a bit of code here, but saves the sysops work.
  ' make up a dummy random file with the sysopname
  '
  OPEN "R",#2,path$+"Accounts",59
  FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
  LSET acname$=sysopname$
  LSET acbal$="0"
  LSET acdate$="Never"
  LSET acdep$="0"
  LSET acwith$="0"
  LSET actran$="0"
  PUT #2,1
  CLOSE #2
ENDIF
PAUSE 3
'
' search through file to get their details
'
o$=cr$+cr$+"Checking your account..."
GOSUB 2
'
' Check to see if they are banned!
banned!=FALSE
'
IF EXIST(path$+"PDBank.banned")
  OPEN "I",#2,path$+"PDBank.banned",1024
  DO
    LINE INPUT #2,check$
    IF uname$=UPPER$(TRIM$(check$))
      banned!=TRUE
    ENDIF
    EXIT IF banned!=TRUE
  LOOP UNTIL EOF(#2)
  CLOSE #2
ENDIF
'
IF banned!=TRUE
  '
  o$=cr$+cr$+"You have been BANNED from the use"+cr$
  GOSUB 2
  o$="of the Time Bank!!!"+cr$
  GOSUB 2
  o$=cr$+"Contact your sysop for more information."
  GOSUB 2
  GOSUB press
  GOSUB 1
  GOTO bye
ENDIF
'
OPEN "R",#2,path$+"Accounts",59
FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
'
' how many people do we have records for?
'
users%=(LOF(#2)/59)
'
' Hmm, that easy, eh?
'
k%=0
foundit%=0
'
WHILE k%<users%
  INC k%
  IF (k% MOD 10)=0
    o$="."
    GOSUB 2
  ENDIF
  GET #2,k%
  check$=TRIM$(acname$)
  IF INSTR(check$,uname$)>0
    foundit%=1
    balance%=VAL(acbal$)
    lastdate$=acdate$
    lastdep%=VAL(acdep$)
    lastwith%=VAL(acwith$)
    lasttran%=VAL(actran$)
    acnumber%=k%
  ENDIF
  '
  EXIT IF foundit%=1
  '
  ' /\ So it's kludgy, but we stop wasting time, and avoid 2 matches!!
WEND
'
IF foundit%<>1
  o$=cr$+cr$+"You don't have an account with us at the moment!"
  GOSUB 2
  o$=cr$+cr$+"Would you like to open one (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF in$="NO" OR car%>0
    GOTO bye
  ENDIF
  users%=users%+1
  acnumber%=users%
  o$=cr$+cr$+"No worries! Your account number is "+STR$(acnumber%)+"."
  GOSUB 2
  LSET acname$=uname$
  LSET acbal$="0"
  LSET acdate$=pd.date$
  LSET acdep$="0"
  LSET acwith$="0"
  LSET actran$="0"
  PUT #2,users%
  balance%=0
  lastdep%=0
  lastwith%=0
  lasttran%=0
  lastdate$="Never"
  GOSUB press
  GOSUB 1
  IF car%>0
    GOTO bye
  ENDIF
ENDIF
'
CLOSE #2
'
' Get the config
'
OPEN "I",#2,path$+"pdbank.config",50
LINE INPUT #2,bankname$
LINE INPUT #2,temp$
maxdeposit%=VAL(temp$)
LINE INPUT #2,temp$
maxwithdrawal%=VAL(temp$)
LINE INPUT #2,temp$
maxtransfer%=VAL(temp$)
CLOSE #2
'
' initialisation
'
GOSUB dateconv
lastdate$=TRIM$(lastdate$)
IF lastdate$=pd.date$
  ' that is, they have already been in the door today
  ' isn't it good how time NEVER goes backward, and if the
  ' last date isn't the same as today's it must have been a
  ' PREVIOUS visit!!
  '
  deposits%=lastdep%
  withdrawals%=lastwith%
  transfers%=lasttran%
ELSE
  deposits%=0
  withdrawals%=0
  transfers%=0
ENDIF
depsnow%=0
withsnow%=0
' /\ nothing to do with SNOW - deposits/withdrawals NOW!
'
winnings%=0
'
' ======================================================================
'
' Check for messages for them
'
cfile$=path$+uname$+".msg"
IF EXIST(cfile$)
  o$=cr$+cr$
  GOSUB 2
  '
  file$=cfile$
  GOSUB seq.o
  GOSUB press
  GOSUB 1
  IF car%>0
    GOTO bye
  ENDIF
  '
  KILL cfile$
ENDIF
'
' ======================================================================
main:
' ======================================================================
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
GOSUB printmenu
GOSUB tchk
IF cmd%=1
  cmd%=0
ELSE
  o$=cr$+cr$+ansi$(2)+"("+ansi$(3)+STR$(rtime%)+" min"+ansi$(2)+")"+ansi$(5)+" Enter Transaction: "
  in%=0
  il%=1
  GOSUB 1
ENDIF
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
' ======================================================================
IF in$="Q"
  GOTO bye
ENDIF
'
' ======================================================================
IF in$="R"
  ' re-configure details
  o$=CHR$(12)
  GOSUB 2
  GOSUB setansi
  IF car%>0
    GOTO bye
  ENDIF
  GOSUB setpagepause
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="D"
  ' Deposit Time
  GOSUB deposit
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="W"
  ' Withdraw time
  GOSUB withdraw
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="T"
  ' Transfer time
  GOSUB transfer
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="M" AND lev%=9
  GOSUB sysop
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="H"
  GOSUB printdocs
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="L"
  GOSUB listaccounts
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="G"
  GOSUB gamble
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
' final check before looping.
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
in$=""
GOTO main
' ======================================================================
'
bye:
cs$="The Metro Time Bank was written by Peter Deane."
GOSUB center
o$=screenclr$+cr$+ansi$(6)+lcs$+cr$
GOSUB 2
cs$="Brought to you on "+bbsname$
GOSUB center
o$=cr$+cr$+ansi$(2)+lcs$
GOSUB 2
cs$="by "+sysopname$
GOSUB center
o$=cr$+cr$+ansi$(5)+lcs$
GOSUB 2
cs$="See you next time."
GOSUB center
o$=cr$+cr$+ansi$(3)+lcs$+cr$
GOSUB 2
IF EXIST("ram:userdata")
  KILL "RAM:USERDATA"
ENDIF
PAUSE 25
CLOSES 1
GOSUB modem.c
CLEAR
END
'
' *******************************************
PROCEDURE deposit
  ' *****************************************
  '
  depositentrance:
  o$=CHR$(12)
  GOSUB 2
  o$=ansi$(5)+"       Deposit Time"+cr$+"       ~~~~~~~~~~~~"+cr$+cr$
  GOSUB 2
  availtime%=rtime%-5
  IF availtime%>(maxdeposit%-deposits%)
    availtime%=(maxdeposit%-deposits%)
  ENDIF
  IF availtime%<1
    availtime%=0
  ENDIF
  o$=ansi$(6)+"You can deposit up to "+ansi$(1)+STR$(availtime%)+ansi$(6)+" minutes."
  GOSUB 2
  IF availtime%<1
    GOSUB press
    GOSUB 1
    GOTO depositexit
  ENDIF
  o$=cr$+cr$+ansi$(3)+"Minutes to deposit? "+ansi$(2)
  in%=4
  il%=3
  GOSUB 1
  IF car%>0
    GOTO depositexit
  ENDIF
  temp%=VAL(in$)
  IF temp%>availtime%
    GOTO depositentrance
  ELSE IF temp%<1
    GOTO depositexit
  ENDIF
  timechange%=-(temp%)
  GOSUB adjusttime
  deposits%=deposits%+temp%
  depsnow%=depsnow%+temp%
  balance%=balance%+temp%
  GOSUB adjustaccounts
  '
  depositexit:
RETURN
'
'
' *******************************************
PROCEDURE withdraw
  ' *****************************************
  '
  withdrawentrance:
  o$=CHR$(12)
  GOSUB 2
  o$=ansi$(5)+"       Withdraw Time"+cr$+"       ~~~~~~~~~~~~~"+cr$+cr$
  GOSUB 2
  availtime%=balance%
  IF balance%>maxwithdrawal%-withdrawals%
    availtime%=maxwithdrawal%-withdrawals%
  ENDIF
  IF availtime%>balance%
    availtime%=balance%
  ENDIF
  ' \/ needed as a failsafe... hmmm probably not - but better be sure they
  ' can get out of this loop
  IF availtime%<1
    availtime%=0
  ENDIF
  o$=ansi$(6)+"You can withdraw up to "+ansi$(1)+STR$(availtime%)+ansi$(6)+" minutes."
  GOSUB 2
  IF availtime%<1
    GOSUB press
    GOSUB 1
    GOTO withdrawexit
  ENDIF
  o$=cr$+cr$+ansi$(3)+"Minutes to withdraw? "+ansi$(1)
  in%=4
  il%=3
  GOSUB 1
  IF car%>0
    GOTO withdrawexit
  ENDIF
  temp%=VAL(in$)
  IF temp%>availtime%
    GOTO withdrawentrance
  ELSE IF temp%<1
    GOTO withdrawexit
  ENDIF
  timechange%=(temp%)
  GOSUB adjusttime
  withdrawals%=withdrawals%+temp%
  withsnow%=withsnow%+temp%
  balance%=balance%-temp%
  GOSUB adjustaccounts
  '
  withdrawexit:
  ' /\ bit of a tautology, eh? :-)
  '
RETURN
'
'
' *******************************************
PROCEDURE transfer
  ' *****************************************
  '
  transferentrance:
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  o$=ansi$(5)+"       Transfer Time"+cr$+"       ~~~~~~~~~~~~~"
  GOSUB 2
  availtime%=balance%
  IF availtime%>maxtransfer%-transfers%
    availtime%=maxtransfer%-transfers%
  ENDIF
  IF availtime%<1
    availtime%=0
  ENDIF
  o$=cr$+cr$+ansi$(6)+"You can transfer up to "+ansi$(1)+STR$(availtime%)+ansi$(6)+" minutes."
  GOSUB 2
  IF availtime%<1
    GOSUB press
    GOSUB 1
    GOTO transferexit
  ENDIF
  o$=cr$+cr$+ansi$(2)+"You may enter a full or PART name."
  GOSUB 2
  o$=cr$+cr$+ansi$(3)+"Transfer to which user? "+ansi$(1)
  in%=2
  il%=25
  GOSUB 1
  IF car%>0
    GOTO transferexit
  ENDIF
  transto$=in$
  transname$=""
  OPEN "R",#2,path$+"Accounts",59
  FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
  FOR k%=1 TO users%
    GET #2,k%
    match2$=TRIM$(acname$)
    IF INSTR(match2$,transto$)>0
      transname$=TRIM$(acname$)
      transnumber%=k%
      k%=users%+50
    ENDIF
  NEXT k%
  CLOSE #2
  IF transname$=""
    o$=cr$+cr$+ansi$(6)+"Sorry, that user has no account here!"+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO transferexit
  ENDIF
  '
  o$=ansi$(2)+cr$+cr$+"Transfer time to "+ansi$(1)+transname$+ansi$(2)+" (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF car%>0
    GOTO transferexit
  ENDIF
  '
  IF in$="NO"
    o$=cr$+cr$+ansi$(6)+"Okay, transfer aborted."+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO transferexit
  ENDIF
  '
  o$=ansi$(3)+cr$+cr$+"Time to transfer: "+ansi$(5)
  in%=4
  il%=6
  GOSUB 1
  IF car%>0
    GOTO transferexit
  ENDIF
  temp%=VAL(in$)
  '
  IF temp%>availtime%
    o$=cr$+cr$+ansi$(6)+"You only have "+STR$(availtime%)+" minutes to transfer!"+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO transferentrance
  ELSE IF temp%<1
    o$=cr$+cr$+ansi$(6)+"Okay, transfer aborted."+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO transferexit
  ENDIF
  '
  ' Fix up the online user's balance
  '
  transfers%=transfers%+temp%
  balance%=balance%-temp%
  GOSUB adjustaccounts
  '
  ' Fix up the recipient's stuff
  '
  OPEN "R",#2,path$+"Accounts",59
  FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
  GET #2,transnumber%
  newbal$=STR$(VAL(acbal$)+temp%)
  LSET acbal$=newbal$
  PUT #2,transnumber%
  CLOSE #2
  '
  ' write message
  '
  GOSUB tchk
  cfile$=path$+transname$+".msg"
  IF EXIST(cfile$)
    OPEN "A",#2,cfile$,1024
  ELSE
    OPEN "O",#2,cfile$,1024
  ENDIF
  PRINT #2,""
  PRINT #2,"----------------------------------------"
  PRINT #2,uname$;" transferred ";temp%;" mins to"
  PRINT #2,"your account at ";time1$
  PRINT #2,"----------------------------------------"
  CLOSE #2
  '
  o$=cr$+ansi$(5)+cr$+transname$+" has been notified of"
  GOSUB 2
  o$=cr$+"your transfer of "+STR$(temp%)+" minutes."
  GOSUB 2
  '
  GOSUB press
  GOSUB 1
  transferexit:
RETURN
'
'
' *******************************************
PROCEDURE printdocs
  ' *****************************************
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  file$=path$+"PDBank.help"
  GOSUB seq.o
  GOSUB press
  GOSUB 1
  '
RETURN
'
'
' *******************************************
PROCEDURE listaccounts
  ' *****************************************
  accountlistentrance:
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  o$=ansi$(5)+"       List Accounts"+cr$+"       ~~~~~~~~~~~~~"+cr$+cr$
  GOSUB 2
  o$=ansi$(2)+"List ALL accounts (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF car%>0
    GOTO accountlistexit
  ENDIF
  type$=in$
  IF type$="NO"
    o$=cr$+ansi$(5)+"Enter search name or part of name."
    GOSUB 2
    o$=cr$+"(NO wildcards are needed)"
    GOSUB 2
    o$=cr$+cr$+ansi$(6)+"? : "
    GOSUB 2
    in%=2
    il%=25
    GOSUB 3
    match$=in$
  ENDIF
  lncount%=3
  modout%=1
  in%=9
  il%=1
  banktotal%=0
  '
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  o$=ansi$(1)+"อออออออออออออออออออออออออออออออออออออออออ"+cr$
  GOSUB 2
  o$=ansi$(3)+"Name                     Time  Last Visit"+cr$
  GOSUB 2
  o$=ansi$(1)+"อออออออออออออออออออออออออออออออออออออออออ"+cr$
  GOSUB 2
  OPEN "R",#2,path$+"Accounts",59
  FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
  FOR k%=1 TO users%
    GET #2,k%
    match2$=TRIM$(acname$)
    banktotal%=banktotal%+VAL(acbal$)
    o$=ansi$(5)+acname$+ansi$(2)+acbal$+ansi$(6)+acdate$+cr$
    IF type$="YES"
      GOSUB 2
      INC lncount%
    ELSE
      IF INSTR(match2$,match$)>0
        GOSUB 2
        INC lncount%
      ENDIF
    ENDIF
    '
    IF contin%=0
      IF lncount%>=scrnht%
        GOSUB pagepause
      ENDIF
    ENDIF
    IF car%>0
      k%=users%+50
    ENDIF
    IF abort%=1
      abort%=0
      k%=users%+50
      ' /\ won't let me GOTO out of this - ah well, there's always another way!
    ENDIF
    '
  NEXT k%
  accountlistexit:
  '
  CLOSE #2
  modout%=0
  lncount%=0
  contin%=0
  o$=ansi$(1)+"อออออออออออออออออออออออออออออออออออออออออ"+cr$
  GOSUB 2
  o$=ansi$(3)+STR$(users%)+ansi$(2)+" depositors have "+ansi$(3)+STR$(banktotal%)+ansi$(2)+" minutes on call"+cr$
  GOSUB 2
  o$=ansi$(1)+"อออออออออออออออออออออออออออออออออออออออออ"
  GOSUB 2
  GOSUB press
  GOSUB 1
RETURN
'
'
' *******************************************
PROCEDURE gamble
  ' *****************************************
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  o$=ansi$(5)+"       Gamble Time"+cr$+"       ~~~~~~~~~~~"+cr$+cr$
  GOSUB 2
  '
  gambleentrance:
  extra%=0
  availtime%=rtime%-5
  RANDOMIZE TIMER
  o$=ansi$(2)+"Winnings now   : "+ansi$(5)+STR$(winnings%)
  GOSUB 2
  o$=cr$+ansi$(2)+"Available loot : "+ansi$(5)+STR$(availtime%)
  GOSUB 2
  IF availtime%<2
    o$=cr$+cr$+ansi$(6)+"Sorry, you haven't got enough time!!"+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO gambleexit
  ENDIF
  o$=cr$+cr$+ansi$(3)+"Your Bet       : "+ansi$(1)
  in%=4
  il%=6
  GOSUB 1
  IF car%>0
    GOTO gambleexit
  ENDIF
  bet%=VAL(in$)
  IF bet%<2
    o$=cr$+cr$+ansi$(6)+"Okay, chicken. The bet's off!"+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO gambleexit
  ELSE IF bet%>availtime%
    o$=cr$+cr$+ansi$(6)+"You ain't got that much, sucker!"+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    IF car%>0
      GOTO gambleexit
    ENDIF
    o$=cr$+cr$+CHR$(12)
    GOSUB 2
    GOTO gambleentrance
  ELSE IF (bet% MOD 2)<>0
    bet%=bet%-1
    o$=cr$+cr$+ansi$(6)+"Your bet must be a EVEN amount."
    GOSUB 2
    o$=cr$+"Bet has been adjusted to "+ansi$(1)+STR$(bet%)
    GOSUB 2
    GOSUB press
    GOSUB 1
    IF car%>0
      GOTO gambleexit
    ENDIF
  ENDIF
  '
  roll1%=RANDOM(6)+1
  roll2%=RANDOM(6)+1
  roll3%=RANDOM(6)+1
  roll4%=RANDOM(6)+1
  '
  o$=cr$+cr$+ansi$(7)+"Rolling First Dice...."
  GOSUB 2
  DELAY 1
  o$=cr$+cr$+ansi$(5)+"Your Roll : "+ansi$(6)+STR$(roll1%)
  GOSUB 2
  DELAY 1
  o$=cr$+ansi$(5)+"House Roll: "+ansi$(6)+STR$(roll2%)
  GOSUB 2
  DELAY 1
  IF roll1%>roll2%
    o$=cr$+cr$+ansi$(2)+"You won "+STR$(bet%/2)+" minutes"+cr$
    extra%=extra%+(bet%/2)
  ELSE
    o$=cr$+cr$+ansi$(1)+"You lost "+STR$(bet%/2)+" minutes"+cr$
    extra%=extra%-(bet%/2)
  ENDIF
  GOSUB 2
  '
  DELAY 1
  o$=cr$+ansi$(7)+"Rolling Second Dice...."
  GOSUB 2
  DELAY 1
  o$=cr$+cr$+ansi$(5)+"Your Roll : "+ansi$(6)+STR$(roll3%)
  GOSUB 2
  DELAY 1
  o$=cr$+ansi$(5)+"House Roll: "+ansi$(6)+STR$(roll4%)
  GOSUB 2
  DELAY 1
  IF roll3%>roll4%
    o$=cr$+cr$+ansi$(2)+"You won "+STR$(bet%/2)+" minutes"+cr$
    extra%=extra%+(bet%/2)
  ELSE
    o$=cr$+cr$+ansi$(1)+"You lost "+STR$(bet%/2)+" minutes"+cr$
    extra%=extra%-(bet%/2)
  ENDIF
  GOSUB 2
  winnings%=winnings%+extra%
  GOSUB tchk
  IF extra%<>0
    timechange%=extra%
    GOSUB adjusttime
  ENDIF
  o$=cr$+cr$+ansi$(3)+"Another attempt (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF in$="NO" OR car%>0
    GOTO gambleexit
  ELSE
    o$=cr$+cr$+CHR$(12)
    GOSUB 2
    GOTO gambleentrance
  ENDIF
  '
  gambleexit:
RETURN
'
