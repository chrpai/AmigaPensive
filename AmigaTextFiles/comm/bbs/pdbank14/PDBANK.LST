' *******************************************
PROCEDURE adjusttime
  ' *****************************************
  ' this works!!! (with a change or two in Metro!!)
  '
  IF test%<>1
    OPEN "I",#2,"ram:doordata",1028
    k%=0
    WHILE NOT EOF(#2)
      INC k%
      LINE INPUT #2,hold$(k%)
    WEND
    CLOSE #2
    dd.lines%=k%
    secs%=VAL(hold$(5))
    secs%=secs%+(60*timechange%)
    hold$(5)=STR$(secs%)
    OPEN "O",#2,"ram:DOORDATA",1028
    FOR k%=1 TO dd.lines%
      PRINT #2,hold$(k%)
    NEXT k%
    CLOSE #2
  ENDIF
  '
RETURN
'
' *******************************************
PROCEDURE adjustaccounts
  ' *****************************************
  GOSUB dateconv
  ' /\ hmm - probably is the same day, but what the hell!
  OPEN "R",#2,path$+"Accounts",59
  FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
  '
  LSET acname$=uname$
  LSET acbal$=STR$(balance%)
  LSET acdate$=pd.date$
  LSET acdep$=STR$(deposits%)
  LSET acwith$=STR$(withdrawals%)
  LSET actran$=STR$(transfers%)
  '
  PUT #2,acnumber%
  CLOSE #2
  '
RETURN
' *******************************************
PROCEDURE sysop
  ' *****************************************
  '
  maintloop:
  IF lev%<>9
    GOTO sysopexit
  ENDIF
  '
  o$=cr$+CHR$(12)+ansi$(5)+"Sysop Maintenance Menu"+cr$+"~~~~~~~~~~~~~~~~~~~~~~"+cr$
  GOSUB 2
  o$=cr$+ansi$(1)+"["+ansi$(7)+"D"+ansi$(1)+"]"+ansi$(3)+"elete A User"
  GOSUB 2
  o$=cr$+ansi$(1)+"["+ansi$(7)+"E"+ansi$(1)+"]"+ansi$(2)+"dit A User"
  GOSUB 2
  o$=cr$+ansi$(1)+"["+ansi$(7)+"A"+ansi$(1)+"]"+ansi$(5)+"dd A User"
  GOSUB 2
  o$=cr$+ansi$(1)+"["+ansi$(7)+"L"+ansi$(1)+"]"+ansi$(7)+"ist Accounts"
  GOSUB 2
  o$=cr$+ansi$(1)+"["+ansi$(7)+"Q"+ansi$(1)+"]"+ansi$(4)+"uit"
  GOSUB 2
  '
  o$=cr$+cr$+ansi$(6)+"Enter Command: "+ansi$(7)
  in%=0
  il%=1
  GOSUB 1
  cmd$=in$
  '
  IF car%>0 OR cmd$="Q"
    GOTO sysopexit
  ENDIF
  '
  IF cmd$="L"
    GOSUB listaccounts
    IF car%>0
      GOTO sysopexit
    ELSE
      cmd$=""
      GOTO maintloop
    ENDIF
  ENDIF
  '
  IF cmd$="A"
    '
    cmd$=""
    o$=cr$+cr$+ansi$(3)+"Enter User's Name to Add: "+ansi$(1)
    in%=2
    il%=25
    GOSUB 1
    IF car%>0
      GOTO sysopexit
    ENDIF
    addname$=in$
    '
    o$=cr$+cr$+ansi$(1)+"Add "+ansi$(3)+addname$+ansi$(1)+" (y/N)? "+ansi$(7)
    in%=3
    il%=1
    yes%=0
    GOSUB 1
    IF car%>0
      GOTO sysopexit
    ELSE IF in$="NO"
      o$=cr$+cr$+ansi$(6)+"Okay. Addition aborted!"+cr$
      GOSUB 2
      GOSUB press
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ELSE
        GOTO maintloop
      ENDIF
    ENDIF
    '
    GOSUB dateconv
    OPEN "R",#2,path$+"Accounts",59
    FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
    INC users%
    LSET acname$=addname$
    LSET acbal$="0"
    LSET acdate$=pd.date$
    LSET acdep$="0"
    LSET acwith$="0"
    LSET actran$="0"
    PUT #2,users%
    CLOSE #2
    o$=cr$+cr$+ansi$(3)+addname$+ansi$(5)+" has an account. You can now [E]dit it if you like."
    GOSUB 2
    GOSUB press
    GOSUB 1
    IF car%>0
      GOTO sysopexit
    ELSE
      GOTO maintloop
    ENDIF
  ENDIF
  '
  o$=cr$+cr$+ansi$(3)+"Enter User Name: "+ansi$(1)
  in%=2
  il%=25
  GOSUB 1
  IF car%>0
    GOTO sysopexit
  ENDIF
  IF in$=""
    GOTO maintloop
  ENDIF
  match1$=in$
  edname$=""
  OPEN "R",#2,path$+"Accounts",59
  FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
  FOR k%=1 TO users%
    GET #2,k%
    match2$=TRIM$(acname$)
    IF match2$=match1$
      edname$=TRIM$(acname$)
      ednumber%=k%
      k%=users%+50
    ENDIF
  NEXT k%
  CLOSE #2
  IF edname$=""
    o$=cr$+ansi$(6)+"No Such Account!"
    GOSUB 2
    GOSUB press
    GOSUB 1
    IF car%>0
      GOTO sysopexit
    ENDIF
    GOTO maintloop
  ENDIF
  '
  IF cmd$="D" AND lev%=9
    o$=cr$+cr$+ansi$(1)+"Delete "+ansi$(3)+edname$+ansi$(1)+" (y/N)? "+ansi$(7)
    in%=3
    il%=1
    yes%=0
    GOSUB 1
    '
    IF edname$=uname$
      o$=cr$+cr$+ansi$(6)+"You can't delete YOURSELF, numbskull!!"
      GOSUB 2
      GOSUB press
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      GOTO maintloop
    ENDIF
    '
    IF car%>0
      GOTO sysopexit
    ELSE IF in$="NO"
      GOTO maintloop
    ENDIF
    '
    o$=cr$+ansi$(2)+"Last Chance !!!"
    GOSUB 2
    o$=cr$+cr$+ansi$(1)+"Delete "+ansi$(3)+edname$+ansi$(1)+" (y/N)? "+ansi$(7)
    in%=3
    il%=1
    yes%=0
    GOSUB 1
    IF car%>0
      GOTO sysopexit
    ELSE IF in$="NO"
      GOTO maintloop
    ENDIF
    '
    OPEN "R",#2,path$+"Accounts",59
    FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
    OPEN "O",#3,path$+"Accounts.temp",4096
    FOR k%=1 TO users%
      GET #2,k%
      IF k%<>ednumber%
        PRINT #3,acname$
        PRINT #3,acbal$
        PRINT #3,acdate$
        PRINT #3,acdep$
        PRINT #3,acwith$
        PRINT #3,actran$
      ENDIF
    NEXT k%
    CLOSE #2
    CLOSE #3
    DEC users%
    KILL path$+"accounts"
    OPEN "R",#2,path$+"Accounts",59
    FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
    OPEN "I",#3,path$+"Accounts.temp",4096
    FOR k%=1 TO users%
      LINE INPUT #3,acname$
      LINE INPUT #3,acbal$
      LINE INPUT #3,acdate$
      LINE INPUT #3,acdep$
      LINE INPUT #3,acwith$
      LINE INPUT #3,actran$
      PUT #2,k%
    NEXT k%
    CLOSE #3
    CLOSE #2
    KILL path$+"Accounts.temp"
    '
    IF EXIST(path$+edname$+".msg")
      KILL path$+edname$+".msg"
    ENDIF
    '
    o$=cr$+cr$+ansi$(6)+edname$+ansi$(1)+" Deleted!!!"+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
  ENDIF
  '
  IF cmd$="E" AND lev%=9
    OPEN "R",#2,path$+"Accounts",59
    FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
    GET #2,ednumber%
    edname$=TRIM$(acname$)
    edbal$=TRIM$(acbal$)
    eddate$=TRIM$(acdate$)
    eddep$=TRIM$(acdep$)
    edwith$=TRIM$(acwith$)
    edtran$=TRIM$(actran$)
    CLOSE #2
    '
    edloop:
    o$=cr$+CHR$(12)
    GOSUB 2
    o$=cr$+ansi$(5)+"(1) "+ansi$(2)+"User Name         : "+ansi$(1)+edname$
    GOSUB 2
    o$=cr$+ansi$(5)+"(2) "+ansi$(2)+"Time Balance      : "+ansi$(1)+edbal$
    GOSUB 2
    o$=cr$+ansi$(5)+"(3) "+ansi$(2)+"Last Date         : "+ansi$(1)+eddate$
    GOSUB 2
    o$=cr$+ansi$(5)+"(4) "+ansi$(2)+"Deposits Today    : "+ansi$(1)+eddep$
    GOSUB 2
    o$=cr$+ansi$(5)+"(5) "+ansi$(2)+"Withdrawals Today : "+ansi$(1)+edwith$
    GOSUB 2
    o$=cr$+ansi$(5)+"(6) "+ansi$(2)+"Transfers Today   : "+ansi$(1)+edtran$
    GOSUB 2
    o$=cr$+cr$+ansi$(3)+"Enter number to edit (<rtn> saves changes): "
    in%=0
    il%=1
    GOSUB 1
    IF car%>0
      GOTO sysopexit
    ENDIF
    edbit%=VAL(in$)
    IF edbit%=0 OR edbit%>6
      OPEN "R",#2,path$+"Accounts",59
      FIELD #2,25 AS acname$,6 AS acbal$,10 AS acdate$,6 AS acdep$,6 AS acwith$,6 AS actran$
      LSET acname$=edname$
      LSET acbal$=edbal$
      LSET acdate$=eddate$
      LSET acdep$=eddep$
      LSET acwith$=edwith$
      LSET actran$=edtran$
      PUT #2,ednumber%
      CLOSE #2
      GOTO maintloop
    ELSE IF edbit%=1
      o$=cr$+cr$+ansi$(6)+"Enter New Name : "+ansi$(7)
      in%=2
      il%=25
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      IF in$<>""
        edname$=in$
      ENDIF
      GOTO edloop
    ELSE IF edbit%=2
      o$=cr$+cr$+ansi$(6)+"Enter New Balance : "+ansi$(7)
      in%=4
      il%=6
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      IF in$<>""
        edbal$=in$
      ENDIF
    ELSE IF edbit%=3
      o$=cr$+cr$+ansi$(6)+"Enter Last Date : "+ansi$(7)
      in%=1
      il%=9
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      IF in$<>""
        eddate$=in$
      ENDIF
    ELSE IF edbit%=4
      o$=cr$+cr$+ansi$(6)+"Enter Today's Deposits : "+ansi$(7)
      in%=4
      il%=6
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      IF in$<>""
        eddep$=in$
      ENDIF
    ELSE IF edbit%=5
      o$=cr$+cr$+ansi$(6)+"Enter Today's Withdrawals : "+ansi$(7)
      in%=4
      il%=6
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      IF in$<>""
        edwith$=in$
      ENDIF
    ELSE IF edbit%=6
      o$=cr$+cr$+ansi$(6)+"Enter Today's Transfers : "+ansi$(7)
      in%=4
      il%=6
      GOSUB 1
      IF car%>0
        GOTO sysopexit
      ENDIF
      IF in$<>""
        edtran$=in$
      ENDIF
    ENDIF
    IF car%=0
      GOTO edloop
    ENDIF
    '
    cmd$=""
  ENDIF
  '
  IF car%=0
    GOTO maintloop
  ENDIF
  '
  sysopexit:
RETURN
'
'
'
'
PROCEDURE 1
  GOSUB 2
  GOSUB 3
RETURN
'
'
PROCEDURE 2
  '
  IF ring%=1
    PRINT #1,o$;
  ENDIF
  IF icon%=0
    PRINT o$;
  ENDIF
  IF (modout%=1)
    GOSUB 3
  ENDIF
  2.1:
  o$=""
RETURN
'
'
PROCEDURE 3
  idle%=CINT(TIMER/200)
  key$=""
  in$=""
  in1$=""
  a%=0
  keyy%=0
  b%=0
  car%=0
  cmd%=0
  DO
    IF MOUSEK=3
      ALERT 0,"Really kill the Door?",2,"Yes|No",pdq%
      IF pdq%=1
        END
      ENDIF
      ' reset idle timer after returning from Alert
      idle%=CINT(TIMER/200)
    ENDIF
    IF ring%=1
      cd%=0
      cd%=LPEEK(12570624)
      cd%=cd% AND 8192
      IF cd%<>0
        car%=1
        keyy%=1
      ENDIF
    ENDIF
    key$=INKEY$
    IF key$<>""
      GOTO mod.in1
    ENDIF
    '
    IF ring%=1
      IF LOC(#1)>0
        in1$=INPUT$(1,#1)
        key$=in1$
        in1$=""
      ENDIF
    ENDIF
    '
    mod.in1:
    IF key$=CHR$(19)
      pau$=""
      hold%=CINT(TIMER/200)
      WHILE CINT(TIMER/200)<hold%+45
        pau$=INKEY$
        IF pau$<>""
          key$=""
          pau$=""
          GOTO mod.in1.1
        ENDIF
        IF ring%=1
          IF LOC(#1)>0
            key$=""
            pau$=""
            GOTO mod.in1.1
          ENDIF
        ENDIF
      WEND
      key$=""
      pau$=""
      GOTO mod.in1.1
    ENDIF
    '
    mod.in1.1:
    IF modout%=1 AND key$=""
      cmd%=0
      keyy%=1
    ENDIF
    IF modout%=1 AND key$=CHR$(32)
      abort%=1
      GOTO 2.1
    ENDIF
    IF modout%=1 AND key$<>CHR$(32)
      keyy%=1
    ENDIF
    IF key$=""
      GOTO mod.in2
    ENDIF
    mod.in1.5:
    a%=ASC(key$)
    b%=LEN(in$)
    IF a%=13
      GOTO mod.in1.6
    ENDIF
    IF (a%=8 OR a%=127) AND LEN(in$)>=1
      in$=LEFT$(in$,b%-1)
      DEC b%
      o$=de$
      GOSUB 2
    ENDIF
    IF b%=il%
      GOTO mod.in2
    ENDIF
    IF in%=0
      IF a%>31 AND a%<126
        IF cmd%=1
          cmdmenu%=0
          dismsg%=0
        ENDIF
        key$=UPPER$(key$)
        o$=key$+cr$
        GOSUB 2
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    mod.in1.6:
    IF in%=1 AND a%>31 AND a%<126
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=2 AND a%>31 AND a%<126
      key$=UPPER$(key$)
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=3
      IF a%=13 AND yes%=1
        o$="YES"
        GOSUB 2
        in$="YES"
        keyy%=1
      ENDIF
      IF a%=13 AND yes%=0
        o$="NO"
        GOSUB 2
        in$="NO"
        keyy%=1
      ENDIF
      IF a%=89 OR a%=121
        o$="YES"+cr$
        GOSUB 2
        in$="YES"
        keyy%=1
      ENDIF
      IF a%=78 OR a%=110
        o$="NO"+cr$
        GOSUB 2
        in$="NO"
        keyy%=1
      ENDIF
    ENDIF
    IF in%=4 AND a%>47 AND a%<58
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=5
      IF (a%=8 OR a%=127) AND LEN(ln$(ln%))>=1
        ln$(ln%)=LEFT$(ln$(ln%),LEN(ln$(ln%))-1)
        o$=de$
        GOSUB 2
        keyy%=1
      ENDIF
      IF a%=13
        in$=key$
        keyy%=1
      ENDIF
      IF a%=9
        o$="     "
        GOSUB 2
        in$="     "
        keyy%=1
      ENDIF
      IF a%>26 AND a%<127
        o$=key$
        GOSUB 2
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    '
    ' new one: no echoing of input at all! Good for More (Y/n)? stuff, etc...
    '
    IF in%=9
      IF a%>31 AND a%<126
        key$=UPPER$(key$)
        in$=key$
        keyy%=1
        cmd%=1
      ENDIF
    ENDIF
    '
    mod.in1.7:
    IF a%=13
      IF (in%<>5 AND in%<>7 AND in%<>9)
        o$=cr$
        GOSUB 2
        keyy%=1
      ENDIF
      IF in%=9
        keyy%=1
      ENDIF
    ENDIF
    mod.in2:
    IF CINT(TIMER/200)>idle%+300
      IF lev%>7 AND CINT(TIMER/200)>idle%+600
        car%=1
        keyy%=1
      ENDIF
      IF lev%<8
        car%=1
        keyy%=1
      ENDIF
    ENDIF
    mod.in2.0:
  LOOP UNTIL keyy%=1
  '
  mod.in2.1:
RETURN
'
'
PROCEDURE seq.o
  '
  IF NOT EXIST(file$)
    o$=cr$+cr$+ansi$(1)+"File Not Found..."+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO seq.o9
  ENDIF
  lncount%=0
  modout%=1
  in%=9
  il%=1
  OPEN "I",#2,file$,4096
  '
  DO UNTIL EOF(#2)
    LINE INPUT #2,text$
    INC lncount%
    o$=text$+cr$
    GOSUB 2
    IF contin%=0
      IF lncount%>=scrnht%
        GOSUB pagepause
      ENDIF
    ENDIF
    IF car%>0
      GOTO seq.o9
    ENDIF
    IF abort%=1
      CLOSE #2
      abort%=0
      GOTO seq.o9
    ENDIF
  LOOP
  CLOSE #2
  seq.o9:
  modout%=0
  contin%=0
  o$=ansi$(0)
  GOSUB 2
RETURN
'
'
PROCEDURE center
  lcs%=LEN(cs$)
  lcs$=SPACE$(38-lcs%/2)+cs$
RETURN
'
PROCEDURE press
  o$=cr$+cr$+ansi$(0)+"[Any_Key] "
  in%=0
  il%=1
RETURN
'
PROCEDURE correct
  ' not sure if this is used??
  o$=cr$+cr$+"Is This Correct? (Y/n) "
  yes%=1
  in%=3
  il%=1
RETURN
'
PROCEDURE pagepause
  modout%=0
  o$="More (Y/n/c)?"
  GOSUB 2
  in%=9
  il%=1
  GOSUB 3
  IF car%>0
    GOTO pagepause9
  ENDIF
  o$=de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$
  GOSUB 2
  IF in$=" " OR in$="N"
    abort%=1
  ENDIF
  IF in$="C"
    contin%=1
  ENDIF
  lncount%=0
  modout%=1
  pagepause9:
RETURN
'
PROCEDURE time1
  t.t%=FRE(0)
  time1$=TIME$
  t.t%=VAL(LEFT$(time1$,2))
  IF t.t%>11
    a$=" PM"
  ELSE
    a$=" AM"
  ENDIF
  IF t.t%=0
    t.t%=12
    time1$=RIGHT$(STR$(t.t%),2)+RIGHT$(time1$,6)
  ELSE IF t.t%<10
    time1$=RIGHT$(STR$(t.t%),1)+RIGHT$(time1$,6)
  ELSE IF t.t%>21
    t.t%=t.t%-12
    time1$=RIGHT$(STR$(t.t%),2)+RIGHT$(time1$,6)
  ELSE IF t.t%>12
    t.t%=t.t%-12
    time1$=RIGHT$(STR$(t.t%),1)+RIGHT$(time1$,6)
  ENDIF
  GOSUB dateconv
  pd.time$=time1$+a$
  time1$=pd.time$+"  "+pd.date$
RETURN
'
PROCEDURE tchk
  GOSUB time1
  timenow%=CINT(TIMER/200)
  ctime%=(timenow%-timeon%)
  ctime%=CINT(ctime%/60)
  rtime%=tpc%-ctime%-depsnow%+withsnow%+winnings%
  IF rtime%<=0
    o$=cr$+cr$+"Sorry, Time Limit Exceeded!"
    GOSUB 2
    DELAY 2
    car%=2
  ENDIF
RETURN
'
PROCEDURE modem.c
  CLOSE #1
RETURN
'
PROCEDURE modem.o
  OPEN "",#1,"COM1:"+bd$+",n,8,1",4096
  DELAY 1
RETURN
'
'         ************
PROCEDURE setpagepause
  '       ************
  '
  oldscrnht%=scrnht%
  o$=cr$+cr$+ansi$(2)+"Current Screen Height: "+ansi$(5)+STR$(oldscrnht%)
  GOSUB 2
  o$=cr$+cr$+ansi$(3)+"Change Screen Height (y/N)? "
  in%=3
  il%=1
  yes%=0
  GOSUB 1
  IF in$="NO" OR car%>0
    GOTO pauseexit
  ENDIF
  o$=cr$+ansi$(2)+"New Screen Height: "+ansi$(1)
  in%=4
  il%=2
  GOSUB 1
  IF in$="" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=VAL(in$)
  o$=cr$+ansi$(3)+"Are "+ansi$(1)+STR$(scrnht%)+ansi$(3)+" lines okay (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF in$="YES" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=oldscrnht%
  o$=cr$+cr$+ansi$(1)+"No Change"
  GOSUB 2
  GOSUB press
  GOSUB 1
  '
  pauseexit:
RETURN
'
'         *******
PROCEDURE setansi
  '       *******
  '
  o$=cr$+cr$+"Do you want ANSI (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF car%>0
    GOTO setansi9
  ENDIF
  '
  IF in$="YES"
    ansi%=1
    ansi$(1)=esc$+"[31m"
    ansi$(2)=esc$+"[32m"
    ansi$(3)=esc$+"[33m"
    ansi$(4)=esc$+"[34m"
    ansi$(5)=esc$+"[35m"
    ansi$(6)=esc$+"[36m"
    ansi$(7)=esc$+"[37m"
    ansi$(8)=esc$+"[1m"
    ansi$(9)=esc$+"[3m"
    ansi$(10)=esc$+"[4m"
  ELSE
    ansi%=0
    FOR kk%=1 TO 10
      ansi$(kk%)=""
    NEXT kk%
  ENDIF
  setansi9:
  ' regardless of setting, this is needed for safety!
  ansi$(0)=esc$+"[0;37;40m"
  o$=ansi$(0)
  GOSUB 2
RETURN
'
'
'   **************
PROCEDURE dateconv
  ' **************
  ' converts date to Fido style DD-Mmm-YY
  ' string to use is pd.date$
  pd.temp$=DATE$
  pd.date1$=LEFT$(pd.temp$,2)
  pd.date2$=MID$(pd.temp$,4,2)
  pd.date3$=RIGHT$(pd.temp$,2)
  pd.month%=VAL(pd.date1$)
  pd.month$="Xxx"
  IF pd.month%=1 THEN
    pd.month$="Jan"
  ELSE IF pd.month%=2
    pd.month$="Feb"
  ELSE IF pd.month%=3
    pd.month$="Mar"
  ELSE IF pd.month%=4
    pd.month$="Apr"
  ELSE IF pd.month%=5
    pd.month$="May"
  ELSE IF pd.month%=6
    pd.month$="Jun"
  ELSE IF pd.month%=7
    pd.month$="Jul"
  ELSE IF pd.month%=8
    pd.month$="Aug"
  ELSE IF pd.month%=9
    pd.month$="Sep"
  ELSE IF pd.month%=10
    pd.month$="Oct"
  ELSE IF pd.month%=11
    pd.month$="Nov"
  ELSE IF pd.month%=12
    pd.month$="Dec"
  ENDIF
  pd.date$=pd.date2$+"-"+pd.month$+"-"+pd.date3$
RETURN
'
