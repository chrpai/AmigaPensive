' PlutDoor Point Pickup Door:
'
' By Peter Deane
'
' (c) 1992-1995
'
'
testingit!=FALSE
'
MODE 1
ON ERROR GOSUB woops
'
'
versnum$="$VER: PlutDoor 1.00 (22-Aug-95)kyj"
versnum$="1.00"
versdate$="22-Aug-95"
doorname$="PlutDoor"
'
'
DIM ansi$(10)
DIM m68%(15)
DIM m67%(15)
DIM aka$(10)
DIM aka%(10,4)
'
cr$=CHR$(13)+CHR$(10)
de$=CHR$(8)+" "+CHR$(8)
esc$=CHR$(27)
'
timeon%=CINT(TIMER/200)
'
' Parse command line.
'
problem!=FALSE
cline$=_dosCmd$
'
IF testingit!
  cline$="-uRay Markham -b19200 -t40 -pBBS:Doorfiles1/door227 -s0"
ENDIF
'
IF LEN(cline$)
  '
  IF INSTR(cline$,"-u")=0
    problem!=TRUE
  ELSE
    uu%=INSTR(cline$,"-u")
    ll%=LEN(cline$)
    uname$=RIGHT$(cline$,ll%-2)
    '
    IF INSTR(uname$,"-b")=0
      problem!=TRUE
    ELSE
      bb%=INSTR(uname$,"-b")
      ll%=LEN(uname$)
      baud$=RIGHT$(uname$,(ll%-bb%-1))
      uname$=LEFT$(uname$,bb%-2)
      uname$=TRIM$(uname$)
      '
      IF INSTR(baud$,"-t")=0
        problem!=TRUE
      ELSE
        tt%=INSTR(baud$,"-t")
        ll%=LEN(baud$)
        tpc$=RIGHT$(baud$,ll%-tt%-1)
        baud$=LEFT$(baud$,tt%-2)
        '
        IF INSTR(tpc$,"-p")=0
          problem!=TRUE
        ELSE
          pp%=INSTR(tpc$,"-p")
          ll%=LEN(tpc$)
          '
          path$=RIGHT$(tpc$,ll%-pp%-1)
          tpc$=LEFT$(tpc$,pp%-2)
          '
          IF INSTR(path$,"-s")=0
            problem!=TRUE
          ELSE
            ss%=INSTR(path$,"-s")
            ll%=LEN(path$)
            '
            ring$=RIGHT$(path$,ll%-ss%-1)
            path$=LEFT$(path$,ss%-2)
          ENDIF
          path$=TRIM$(path$)
          IF RIGHT$(path$,1)<>"/" AND RIGHT$(path$,1)<>":"
            path$=path$+"/"
          ENDIF
          '
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  '
  '
ELSE
  problem!=TRUE
  IF EXIST("RAM:Userdata")
    '
    OPEN "I",#2,"Ram:Userdata",1024
    LINE INPUT #2,tpc$      ! Remaining time in minutes
    LINE INPUT #2,uname$    ! User's name
    LINE INPUT #2,id$       ! User number
    LINE INPUT #2,lev$      ! Security of caller (1-9)
    LINE INPUT #2,baud$     ! Baud rate
    LINE INPUT #2,ring$     ! Local (=0) or remote (=1)
    LINE INPUT #2,path$     ! The pathname for the door to use
    CLOSE #2
    problem!=FALSE
    '
  ENDIF
  '
ENDIF
'
'
IF problem!
  '
  PRINT "Error in setting up"
  PRINT
  PRINT "Usage details:"
  PRINT
  PRINT "PlutDoor -u<User Name> -b<Baud> -t<Time> -p<Path> -s<0|1>"
  PRINT
  PRINT "-u<User Name> should NOT be in inverted commas"
  PRINT "-b<Baud>      is the locked modem (DTE) speed"
  PRINT "-t<Time>      is the time remaining for the user"
  PRINT "-p<Path>      is the pathname for config/userdir etc"
  PRINT "-s<0|1>       serial type. -s0 = local, -s1 = remote"
  PRINT
  PRINT "-u, -b, -t, -p, -s are all case-sensitive!"
  PRINT
  PRINT "If the door is run with no command line, a Metro ram:userdata"
  PRINT "file is searched for. If found the door will also run."
  PRINT
  PRINT "This window will close in 10 seconds...."
  DELAY 10
  END
ENDIF
'
' Real baud rate now dummied to DTE speed.
'
realbaud$=baud$
'
' Go for more info from the doordata file if it's there
'
IF EXIST("ram:doordata")
  OPEN "I",#2,"ram:doordata",16384
  LINE INPUT #2,temp$
  LINE INPUT #2,realbaud$
  LINE INPUT #2,temp$
  LINE INPUT #2,temp$
  LINE INPUT #2,temp$
  LINE INPUT #2,temp$
  LINE INPUT #2,ansi$
  CLOSE #2
  ansi!=VAL(ansi$)
  askansi!=FALSE
ELSE
  askansi!=TRUE
ENDIF
'
@lowercase(uname$)
uname$=lcase$
'
'
@find.config
'
'
IF config$="XXX"
  PRINT "No config file could be found"
  PRINT "We look in the directory "+path$
  PRINT "for it. Please check that either."
  PRINT "the config exists or the command"
  PRINT "line is correct."
  PRINT
  PRINT "This window will close in 10 seconds...."
  DELAY 10
  END
ENDIF
'
' First write to log makes sure we've got one, so this'll work
' under WB 1.3.  All subsequent log writes use APPEND mode, and
' don't have to do an If Exist() all the time.  Faster logging.
'
IF EXIST(logfile$)
  OPEN "A",#54,logfile$,4096
ELSE
  OPEN "O",#54,logfile$,4096
ENDIF
'
PRINT #54,CHR$(10)+"% ";
@dateconv(DATE$)
PRINT #54,pd.date$;" ";
PRINT #54,TIME$;"  ";
PRINT #54,"PlutDoor V"+versnum$+" opened"
CLOSE #54
'
@log(logfile$,"%","Online user: "+uname$)
'
' find screen size required from PlutDoor.cfg
'
sw%=VAL(winw$)
sh%=VAL(winh$)
sx%=0
sy%=0
'
' convert strings to numbers
'
bd%=VAL(baud$)
tpc%=VAL(tpc$)
id%=VAL(id$)
lev%=VAL(lev$)
IF VAL(ring$)
  ring!=TRUE
ELSE
  ring!=FALSE
ENDIF
'
'
scrnht%=23
'
@open_screen
@main_window
'
arplib$="arp.library"+CHR$(0)
arpbase%=OpenLibrary(V:arplib$,0)
'
IF ring!=TRUE
  @open_serial
  PAUSE 24
  @set_baud(bd%)
ENDIF
'
' ======================================================================
'
' We're in, hit em hard and good!
'
' reset terminal
@msend(esc$+"[0;40;37m"+CHR$(12)+cr$)
IF car%>0
  GOTO finish
ENDIF
'
@killkeys
IF askansi!=TRUE
  @checkansi
ENDIF
'
IF car%>0
  GOTO finish
ENDIF
@setansi
abscontin!=FALSE
'
' ======================================================================
main:
' ======================================================================
@tchk
IF car%>0
  GOTO finish
ENDIF
'
@banner
IF car%>0
  GOTO finish
ENDIF
'
@msend(CHR$(12))
'
fl$=userdir$+uname$
'
IF NOT EXIST(fl$)
  @log(logfile$,"%","No config setup for this user")
  '
  @msend(ansi$(2)+"To use this door, the sysop has to set you up an account."+cr$)
  @msend("No account for '"+uname$+"' could be found."+cr$+cr$)
  IF car%>0
    GOTO finish
  ENDIF
  '
  @killkeys
  @msend(ansi$(3)+"Do you wish to read more about this door (Y/n)? ")
  @mget(3,1,1,1)
  IF in$="NO" OR car%>0
    GOTO finish
  ENDIF
  @log(logfile$,"%","User asked for more info")
  '
  @msend(CHR$(12)+ansi$(6))
  @seq.out(textdir$+"New_User.txt")
  IF car%>0
    GOTO finish
  ENDIF
  @press
  IF car%>0
    GOTO finish
  ENDIF
  @msend(ansi$(0)+cr$+cr$)
  @killkeys
  @tchk
  IF car%>0
    GOTO finish
  ENDIF
  @msend(ansi$(5)+"Do you wish to download further info (y/N)? ")
  @mget(3,1,0,1)
  IF in$="NO" OR car%>0
    GOTO finish
  ENDIF
  @chooseproto
  IF car%>0
    GOTO finish
  ENDIF
  @log(logfile$,"%","User downloaded more info")
  @xfer(protocol%,"S",textdir$+"New_User.lha",1)
  '
  GOTO finish
ENDIF
'
@find.user
@log(logfile$,"%","User has an account")
@embed_convert(freqhandler$)
freqhandler$=embed$
'
tries%=0
leaveloop!=FALSE
'
DO WHILE tries%<3
  '
  @killkeys
  @msend(cr$+cr$+ansi$(2)+"Enter your mail session password: "+ansi$(1))
  @mget(6,10,0,1)
  IF car%>0
    leaveloop!=TRUE
    tries%=99
  ENDIF
  incoming$=in$
  incoming$=TRIM$(incoming$)
  IF password$<>incoming$
    @msend(cr$+CHR$(7)+ansi$(6)+"Incorrect. You only have three tries!"+cr$)
    IF tries%<2
      @msend(cr$+ansi$(3)+"(this is not necessarily the same as the BBS password)"+cr$)
    ENDIF
    @log(logfile$,"%","User entered wrong password ('"+incoming$+"')")
    INC tries%
  ELSE
    leaveloop!=TRUE
  ENDIF
  '
LOOP UNTIL leaveloop!
'
IF tries%>=3
  '
  @killkeys
  @log(logfile$,"%","User excluded from door!!!")
  @msend(cr$+cr$+ansi$(1)+"You have incorrectly entered the password three times now.")
  @msend(cr$+cr$+"To disable any further fraudulent attempts, your account will be renamed.")
  @msend(cr$+cr$+ansi$(5)+"You must now contact the sysop to access this account!")
  @killkeys
  @press
  '
  IF EXIST(userdir$+uname$)
    IF EXIST(userdir$+uname$+".BadPwd")
      KILL userdir$+uname$+".BadPwd"
    ENDIF
    '
    NAME userdir$+uname$ AS userdir$+uname$+".BadPwd"
    @log(logfile$,"%","Renaming "+userdir$+uname$)
    @log(logfile$,"%","as "+userdir$+uname$+".BadPwd")
    '
  ENDIF
  GOTO finish
ENDIF
'
' okay, our user is in and all legit...
@log(logfile$,"%","User entered correct password")
'
OPEN "O",#9,userdir$+uname$+".RLO",24
'
FOR k%=0 TO 9
  '
  IF aka$(k%)<>""
    @msend(cr$+ansi$(5)+"Mail for AKA: "+ansi$(1)+aka$(k%)+cr$)
    '
    core$=STR$(aka%(k%,1))+"."+STR$(aka%(k%,2))+"."+STR$(aka%(k%,3))+"."+STR$(aka%(k%,4))+"."
    '
    IF EXIST(outbound$+core$+"HUT")
      PRINT #9,"@"+outbound$+core$+"HUT"
      @msend(ansi$(6)+outbound$+core$+"HUT"+cr$)
    ENDIF
    IF EXIST(outbound$+core$+"CUT")
      PRINT #9,"@"+outbound$+core$+"CUT"
      @msend(ansi$(6)+outbound$+core$+"CUT"+cr$)
    ENDIF
    IF EXIST(outbound$+core$+"DUT")
      PRINT #9,"@"+outbound$+core$+"DUT"
      @msend(ansi$(6)+outbound$+core$+"DUT"+cr$)
    ENDIF
    IF EXIST(outbound$+core$+"OUT")
      PRINT #9,"@"+outbound$+core$+"OUT"
      @msend(ansi$(6)+"@"+outbound$+core$+"OUT"+cr$)
    ENDIF
    '
    IF EXIST(outbound$+core$+"FLO")
      OPEN "I",#2,outbound$+core$+"FLO",1024
      WHILE NOT EOF(#2)
        LINE INPUT #2,xx$
        IF LEFT$(xx$,1)<>"~"
          PRINT #9,xx$
          @msend(ansi$(6)+xx$+cr$)
        ENDIF
      WEND
      CLOSE #2
      '
    ENDIF
    '
    IF EXIST(outbound$+core$+"HLO")
      OPEN "I",#2,outbound$+core$+"HLO",1024
      WHILE NOT EOF(#2)
        LINE INPUT #2,xx$
        IF LEFT$(xx$,1)<>"~"
          PRINT #9,xx$
          @msend(ansi$(6)+xx$+cr$)
        ENDIF
      WEND
      CLOSE #2
      '
    ENDIF
    '
    IF EXIST(outbound$+core$+"CLO")
      OPEN "I",#2,outbound$+core$+"CLO",1024
      WHILE NOT EOF(#2)
        LINE INPUT #2,xx$
        IF LEFT$(xx$,1)<>"~"
          PRINT #9,xx$
          @msend(ansi$(6)+xx$+cr$)
        ENDIF
      WEND
      CLOSE #2
      '
    ENDIF
    '
    IF EXIST(outbound$+core$+"DLO")
      OPEN "I",#2,outbound$+core$+"DLO",1024
      WHILE NOT EOF(#2)
        LINE INPUT #2,xx$
        IF LEFT$(xx$,1)<>"~"
          PRINT #9,xx$
          @msend(ansi$(6)+xx$+cr$)
        ENDIF
      WEND
      CLOSE #2
      '
    ENDIF
    '
  ENDIF
  '
NEXT k%
'
CLOSE #9
@killkeys
@press
'
'
@msend(CHR$(12)+cr$)
@msend(ansi$(7)+"   ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿"+cr$)
@msend("   ³   "+ansi$(2)+"P l u t D o o r  "+ansi$(5)+"  -  "+ansi$(6)+"P i c k i n g   U p   Y o u r   M a i l   "+ansi$(7)+"³"+cr$)
@msend("   ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ"+cr$+cr$)
'
@msend(ansi$(7)+"------------------------------      ------"+cr$)
@msend(ansi$(3)+"Summary of mail/files for you:      Bytes:"+cr$)
@msend(ansi$(7)+"------------------------------      ------"+cr$+cr$)
'
OPEN "I",#2,userdir$+uname$+".RLO",1024
'
totalbytes%=0
totalfiles%=0
rlolen%=0
'
WHILE NOT EOF(#2)
  LINE INPUT #2,xx$
  IF LEFT$(xx$,1)="~"
    xx$="~~"+xx$
  ENDIF
  IF LEFT$(xx$,1)="^" OR LEFT$(xx$,1)="@" OR LEFT$(xx$,1)="#" OR LEFT$(xx$,1)="-"
    xx$=RIGHT$(xx$,LEN(xx$)-1)
  ENDIF
  '
  IF LEFT$(xx$,1)<>"~"
    IF EXIST(xx$)
      spaceout(xx$,36)
      @msend(ansi$(6)+xx$+SPACE$(spc%))
      OPEN "I",#5,xx$,10
      xx%=LOF(#5)
      CLOSE #5
      INC totalfiles%
      totalbytes%=totalbytes%+xx%
      @spaceout(STR$(xx%),6)
      @msend(ansi$(2)+SPACE$(spc%)+STR$(xx%)+cr$)
      rlolen%=rlolen%+LEN(xx$)
    ELSE
      xx%=0
    ENDIF
  ENDIF
  '
  IF totalfiles% MOD 23=16
    @killkeys
    @pagepause
  ENDIF
  '
WEND
CLOSE #2
@msend(cr$+SPACE$(36)+ansi$(1)+"------")
@spaceout(STR$(totalbytes%),6)
@msend(cr$+SPACE$(36+spc%)+STR$(totalbytes%))
@msend(cr$+SPACE$(36)+ansi$(1)+"------"+cr$)
@killkeys
@pagepause
'
sends%=(rlolen%/200)+1
'
@log(logfile$,"%","User has "+STR$(totalbytes%)+" bytes in "+STR$(totalfiles%)+" files here")
'
a$="This will take "+STR$(sends%)+" batch send"
IF sends%<>1
  a$=a$+"s"
ENDIF
@log(logfile$,"%",a$)
'
IF totalfiles%=0
  @msend(cr$+cr$+ansi$(3)+"Well, whaddya know? No mail!")
  @press
  GOTO nomailjump
ENDIF
'
'
@msend(cr$+ansi$(5)+"The transfer consists of "+STR$(totalfiles%)+" file(s),")
@msend(cr$+ansi$(5)+"which will require "+STR$(sends%)+" batch send")
IF sends%<>1
  @msend("s."+cr$)
ELSE
  @msend("."+cr$)
ENDIF
@msend(cr$+ansi$(2)+"At  1200 baud non-MNP, approx "+ansi$(3)+STR$(ROUND((totalbytes%/115)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At  2400 baud non-MNP, approx "+ansi$(3)+STR$(ROUND((totalbytes%/230)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At  2400 baud MNP-4,   approx "+ansi$(3)+STR$(ROUND((totalbytes%/270)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At  9600 baud non-MNP, approx "+ansi$(3)+STR$(ROUND((totalbytes%/940)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At  9600 baud MNP-4,   approx "+ansi$(3)+STR$(ROUND((totalbytes%/1100)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At 14400 baud non-MNP, approx "+ansi$(3)+STR$(ROUND((totalbytes%/1400)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At 14400 baud MNP-4,   approx "+ansi$(3)+STR$(ROUND((totalbytes%/1650)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At 28800 baud non-MNP, approx "+ansi$(3)+STR$(ROUND((totalbytes%/2800)/60))+ansi$(2)+" mins")
@msend(cr$+ansi$(2)+"At 28800 baud MNP-4,   approx "+ansi$(3)+STR$(ROUND((totalbytes%/3100)/60))+ansi$(2)+" mins")
@killkeys
@press
@killkeys
@msend(cr$+ansi$(1)+CHR$(7)+"Commence the download (Y/n)? ")
@mget(3,1,1,1)
IF car%>0
  GOTO finish
ENDIF
IF in$="NO"
  @log(logfile$,"%","User rejected the download")
  GOTO nomailjump
ENDIF
'
'
@chooseproto
IF car%>0
  GOTO finish
ENDIF
'
@killkeys
@msend(cr$+cr$)
SELECT protocol%
CASE 1
  @msend(ansi$(5)+"(Last chance) Commence SZmodem download (Y/n)? ")
CASE 2
  @msend(ansi$(5)+"(Last chance) Commence Ymodem download (Y/n)? ")
DEFAULT
  @msend(ansi$(5)+"(Last chance) Commence Zmodem download (Y/n)? ")
ENDSELECT
'
@mget(3,1,1,1)
IF car%>0
  GOTO finish
ELSE IF in$="NO"
  @log(logfile$,"%","User rejected the download")
  GOTO nomailjump
ENDIF
'
'
'
OPEN "I",#2,userdir$+uname$+".RLO",1024
'
persend%=totalfiles%/sends%
'
cmdline$=""
jj%=1
WHILE jj%<sends%
  @msend(ansi$(3)+cr$+"Copying and renaming files...")
  '
  FOR k%=1 TO persend%
    LINE INPUT #2,xx$
    IF LEFT$(xx$,1)<>"~"
      cmdline%=cmdline%+LEN(xx$)+1
      '
      IF LEFT$(xx$,1)="#"
        a$=HEX$(TIMER,8)
        fl$=RIGHT$(xx$,LEN(xx$)-1)
        mo$=RIGHT$(fl$,4)
        ex$="Copy "+CHR$(34)+fl$+CHR$(34)+" to "+CHR$(34)+xferdir$+a$+mo$+CHR$(34)
        @log(logfile$,"%",ex$)
        EXEC ex$,-1,-1
        @msend(".")
        fl$=xferdir$+a$+mo$
      ELSE IF LEFT$(xx$,1)="@"
        a$=HEX$(TIMER,8)
        fl$=RIGHT$(xx$,LEN(xx$)-1)
        ex$="Copy "+CHR$(34)+fl$+CHR$(34)+" to "+CHR$(34)+xferdir$+a$+".PKT"+CHR$(34)
        @log(logfile$,"%",ex$)
        EXEC ex$,-1,-1
        @msend(".")
        fl$=xferdir$+a$+".PKT"
      ELSE IF LEFT$(xx$,1)="^"
        fl$=RIGHT$(xx$,LEN(xx$)-1)
      ELSE IF LEFT$(xx$,1)="-"
        fl$=RIGHT$(xx$,LEN(xx$)-1)
      ELSE
        fl$=xx$
      ENDIF
      '
      fl$=TRIM$(fl$)
      '
      IF EXIST(fl$)
        cmdline$=cmdline$+fl$+" "
        '
      ENDIF
    ENDIF
    '
  NEXT k%
  '
  @msend(cr$+cr$)
  @xfer(protocol%,"S",cmdline$,persend%)
  cmdline$=""
  '
  jumpout!=FALSE
  '
  @log(logfile$,"%","Download "+STR$(jj%)+" returned "+STR$(m67%(0)))
  IF xfer.ret!=FALSE
    @msend(cr$+cr$+"File transfer failed!!")
    @msend(cr$+cr$+ansi$(1)+"Quit downloading (Y/n)? ")
    @mget(3,1,1,1)
    IF in$="YES" OR car%>0
      jumpout!=TRUE
      jj%=sends%+99
      IF in$="YES"
        @log(logfile$,"%","User quits download")
      ENDIF
    ENDIF
  ENDIF
  '
  IF NOT jumpout!
    @msend(cr$+cr$+ansi$(1)+"Ready for next (Y/n)? ")
    @mget(3,1,1,1)
    IF in$="NO" OR car%>0
      jumpout!=TRUE
      jj%=sends%+99
      IF in$="NO"
        @log(logfile$,"%","User quits download")
      ENDIF
    ENDIF
    INC jj%
  ENDIF
  '
WEND
'
IF car%>0
  CLOSE #2
  GOTO finish
ENDIF
IF jumpout!
  CLOSE #2
  GOTO nomailjump
ENDIF
'
'
cmdline$=""
persend%=0
@msend(ansi$(3)+cr$+"Copying and renaming files...")
WHILE NOT EOF(#2)
  LINE INPUT #2,xx$
  IF LEFT$(xx$,1)<>"~"
    cmdline%=cmdline%+LEN(xx$)+1
    '
    IF LEFT$(xx$,1)="#"
      a$=HEX$(TIMER,8)
      fl$=RIGHT$(xx$,LEN(xx$)-1)
      mo$=RIGHT$(fl$,4)
      ex$="Copy "+CHR$(34)+fl$+CHR$(34)+" to "+CHR$(34)+xferdir$+a$+mo$+CHR$(34)
      @log(logfile$,"%",ex$)
      EXEC ex$,-1,-1
      @msend(".")
      fl$=xferdir$+a$+mo$
    ELSE IF LEFT$(xx$,1)="@"
      a$=HEX$(TIMER,8)
      fl$=RIGHT$(xx$,LEN(xx$)-1)
      ex$="Copy "+CHR$(34)+fl$+CHR$(34)+" to "+CHR$(34)+xferdir$+a$+".PKT"+CHR$(34)
      @log(logfile$,"%",ex$)
      EXEC ex$,-1,-1
      @msend(".")
      fl$=xferdir$+a$+".PKT"
    ELSE IF LEFT$(xx$,1)="^"
      fl$=RIGHT$(xx$,LEN(xx$)-1)
    ELSE IF LEFT$(xx$,1)="-"
      fl$=RIGHT$(xx$,LEN(xx$)-1)
    ELSE
      fl$=xx$
    ENDIF
    '
    fl$=TRIM$(fl$)
    '
    IF EXIST(fl$)
      cmdline$=cmdline$+fl$+" "
      INC persend%
      '
    ENDIF
  ENDIF
  '
WEND
CLOSE #2
'
@msend(cr$+cr$)
@xfer(protocol%,"S",cmdline$,persend%)
@log(logfile$,"%","Download "+STR$(jj%)+" returned "+STR$(m67%(0)))
'
IF xfer.ret!=FALSE
  @msend(cr$+cr$+"File transfer failed!!")
  @msend(cr$+cr$+ansi$(1)+"Do you want to quit (Y/n)? ")
  @mget(3,1,1,1)
  IF in$="YES" OR car%>0
    IF in$="YES"
      @log(logfile$,"%","User elects to quit")
    ENDIF
    GOTO finish
  ENDIF
ENDIF
'
@beepthree
@msend(cr$+cr$+cr$+ansi$(3)+"Okay. Now the file transfer is over.")
@msend(cr$+"If the transfer was succesful, you will want")
@msend(cr$+"us to clean up the directories, so you don't")
@msend(cr$+"get this mail sent to you again.")
@msend(cr$+cr$+ansi$(5)+"This command will be final!")
@msend(cr$+cr$+ansi$(2)+"Shall we clean up the directories (Y/n)? ")
@mget(3,1,1,1)
IF car%>0
  GOTO finish
ENDIF
IF in$="NO"
  @log(logfile$,"%","NO directory purging selected")
  GOTO nomailjump
ENDIF
'
@msend(cr$+cr$+ansi$(6)+"Are you sure (Y/n)? ")
@mget(3,1,1,1)
IF car%>0
  GOTO finish
ENDIF
