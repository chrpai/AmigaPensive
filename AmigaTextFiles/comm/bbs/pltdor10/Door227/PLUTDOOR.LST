IF LOF(#2)=0
  CLOSE #2
  @log(logfile$,"%","No files received!")
  @msend(cr$+cr$+"no files received!")
  @press
  GOTO finish
ENDIF
'
WHILE NOT EOF(#2)
  LINE INPUT #2,xx$
  xx$=TRIM$(xx$)
  @log(logfile$,"%","Received file: "+xx$)
  callfreq!=FALSE
  @msend(cr$+ansi$(2)+"Received file: "+ansi$(1)+xx$)
  xx$=UPPER$(xx$)
  '
  IF LEN(xx$)<4
    xx$="XXX.XXX"
  ENDIF
  '
  mo$=RIGHT$(xx$,4)
  mo.short$=MID$(mo$,2,2)
  pewdy$=HEX$(TIMER,8)
  '
  IF mo$=".REQ"
    @msend(cr$+cr$+CHR$(7)+ansi$(3)+"Calling File Request Server...")
    @log(logfile$,"%","Calling F'req Server")
    callfreq!=TRUE
    ex$="copy "+xx$+" to Ram:PlutDoor.REQ"
    EXEC ex$,-1,-1
    ex$="Delete "+xx$
    EXEC ex$,-1,-1
    ex$=freqhandler$
  ELSE IF mo$=".OUT" OR mo$=".DUT" OR mo$=".CUT" OR mo$=".HUT" OR mo$=".PKT"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+".PKT"
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+".PKT")
  ELSE IF mo.short$="MO"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo.short$="TU"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo.short$="WE"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo.short$="TH"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo.short$="FR"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo.short$="SA"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo.short$="SU"
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","Renamed "+xx$+" as "+pewdy$+mo$)
  ELSE IF mo$=".FLO"
    @msend(cr$+ansi$(6)+"Please DON'T send *.FLO files back! Deleting this one!"+CHR$(7))
    ex$="Delete "+xferdir$+xx$
  ELSE IF mo$=".HLO"
    @msend(cr$+ansi$(6)+"Please DON'T send *.HLO files back! Deleting this one!"+CHR$(7))
    ex$="Delete "+xferdir$+xx$
  ELSE IF mo$=".CLO"
    @msend(cr$+ansi$(6)+"Please DON'T send *.CLO files back! Deleting this one!"+CHR$(7))
    ex$="Delete "+xferdir$+xx$
  ELSE IF mo$=".DLO"
    @msend(cr$+ansi$(6)+"Please DON'T send *.DLO files back! Deleting this one!"+CHR$(7))
    ex$="Delete "+xferdir$+xx$
  ELSE IF NOT EXIST(inbound$+xx$)
    ex$="Copy "+xferdir$+xx$+" to "+inbound$
  ELSE
    ex$="Copy "+xferdir$+xx$+" to "+inbound$+pewdy$+mo$
    @log(logfile$,"%","No MAIL filename avail. Renaming to "+pewdy$+mo$)
  ENDIF
  '
  EXEC ex$,-1,-1
  '
  IF callfreq!=TRUE
    @msend(".... file server returns!"+cr$)
    IF EXIST("Ram:PlutDoor.REQ")
      KILL "Ram:PlutDoor.REQ"
    ENDIF
  ENDIF
  '
WEND
CLOSE #2
'
'
cmdline%=0
cmdline$=""
sends%=0
this%=0
jumpout!=FALSE
'
IF EXIST(userdir$+uname$+".RLO")
  OPEN "I",#2,userdir$+uname$+".RLO",1024
  '
  DO WHILE NOT EOF(#2)
    LINE INPUT #2,xx$
    xx$=TRIM$(xx$)
    '
    IF LEFT$(xx$)="^"
      xx$=RIGHT$(xx$,LEN(xx$)-1)
    ELSE IF LEFT$(xx$)="-"
      xx$=RIGHT$(xx$,LEN(xx$)-1)
    ENDIF
    '
    IF EXIST(xx$)
      INC this%
      cmdline$=cmdline$+" "+xx$
      cmdline%=LEN(cmdline$)
    ENDIF
    '
    IF cmdline%>180
      INC sends%
      @msend(cr$+cr$)
      @msend(ansi$(7)+"File send # "+STR$(sends%))
      @xfer(protocol%,"S",cmdline$,this%)
      @log(logfile$,"%","Download "+STR$(sends%)+" returned "+STR$(m67%(0)))
      this%=0
      cmdline$=""
      '
      IF (xfer.ret!=FALSE) AND (car%=0)
        @msend(cr$+cr$+"File transfer failed!!")
        @msend(cr$+cr$+ansi$(1)+"Do you want to quit (Y/n)? ")
        @mget(3,1,1,1)
        IF in$="YES" OR car%>0
          IF in$="YES"
            @log(logfile$,"%","User elects to quit")
          ENDIF
          jumpout!=TRUE
        ENDIF
      ENDIF
    ENDIF
    IF car%>0
      jumpout!=TRUE
    ENDIF
    '
  LOOP UNTIL jumpout!=TRUE
  '
  CLOSE #2
ENDIF
IF cmdline$<>""
  '
  INC sends%
  @msend(cr$+cr$)
  @msend(ansi$(7)+"File send # "+STR$(sends%))
  @xfer(protocol%,"S",cmdline$,this%)
  @log(logfile$,"%","Download "+STR$(sends%)+" returned "+STR$(m67%(0)))
  '
ENDIF
'
'
@msend(cr$+cr$+ansi$(5)+"Thank you. Until we meet again...")
'
DELAY 1
'
bye:
'
xq3%=0
'
finish:
'
@killkeys
@msend(CHR$(12)+cr$+cr$+ansi$(0))
@msend(cr$+"Program  : "+doorname$)
@msend(cr$+"Author   : Peter Deane")
@msend(cr$+"Version  : "+versnum$)
@msend(cr$+"Date     : "+versdate$)
@msend(cr$+"Language : GFA Basic"+cr$)
@pagepause
@msend("Reloading: "+bbsname$+cr$+cr$)
'
IF EXIST("RAM:userdata")
