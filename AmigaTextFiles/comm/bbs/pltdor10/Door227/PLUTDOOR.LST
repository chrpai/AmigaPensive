PROCEDURE banner
  '
  @msend(CHR$(12)+ansi$(0))
  @msend(ansi$(6)+"  ÉÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ»"+cr$)
  @msend(ansi$(6)+"  º "+ansi$(5)+"  ÜÜÜÜÜÜÜ  "+ansi$(1)+"Ü      "+ansi$(2)+"Ü    Ü  "+ansi$(4)+"ÜÜÜÜÜÜÜ  "+ansi$(7)+"ÜÜÜ     "+ansi$(6)+"ÜÜÜÜÜÜÜ  "+ansi$(3)+"ÜÜÜÜÜÜÜ  "+ansi$(5)+"ÜÜÜÜÜ    "+ansi$(6)+"º "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(6)+"  º "+ansi$(5)+"  Û     Û  "+ansi$(1)+"Û      "+ansi$(2)+"Û    Û  "+ansi$(4)+"   Û     "+ansi$(7)+"Û  ßÜ   "+ansi$(6)+"Û     Û  "+ansi$(3)+"Û     Û  "+ansi$(5)+"Û    ßÜ  "+ansi$(6)+"º "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(6)+"  º "+ansi$(5)+"  Û     Û  "+ansi$(1)+"Û      "+ansi$(2)+"Û    Û  "+ansi$(4)+"   Û     "+ansi$(7)+"Û    Û  "+ansi$(6)+"Û     Û  "+ansi$(3)+"Û     Û  "+ansi$(5)+"Û    Üß  "+ansi$(6)+"º "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(6)+"  º "+ansi$(5)+"  Ûßßßßßß  "+ansi$(1)+"Û      "+ansi$(2)+"Û    Û  "+ansi$(4)+"   Û     "+ansi$(7)+"Û    Û  "+ansi$(6)+"Û     Û  "+ansi$(3)+"Û     Û  "+ansi$(5)+"ÛßßßßÜ   "+ansi$(6)+"º "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(6)+"  º "+ansi$(5)+"  Û        "+ansi$(1)+"Û      "+ansi$(2)+"Û    Û  "+ansi$(4)+"   Û     "+ansi$(7)+"Û  Üß   "+ansi$(6)+"Û     Û  "+ansi$(3)+"Û     Û  "+ansi$(5)+"Û    ßÜ  "+ansi$(6)+"º "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(6)+"  º "+ansi$(5)+"  ß        "+ansi$(1)+"ßßßßß  "+ansi$(2)+"ßßßßßß  "+ansi$(4)+"   ß     "+ansi$(7)+"ßßß     "+ansi$(6)+"ßßßßßßß  "+ansi$(3)+"ßßßßßßß  "+ansi$(5)+"ß     ß  "+ansi$(6)+"º "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(6)+"  ÈÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼ "+ansi$(4)+"°°"+cr$)
  @msend(ansi$(4)+"    °°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°"+cr$+cr$+cr$)
  '
  IF ansi!
    @msend(esc$+"[0;31m  "+esc$+"[43mÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿"+esc$+"[0m"+cr$)
    @msend(esc$+"[0;31m  "+esc$+"[43m³  "+esc$+"[35m                The Online Point Pickup Program                      "+esc$+"[31m³"+esc$+"[0m"+cr$)
    @msend(esc$+"[0;31m  "+esc$+"[43m³  "+esc$+"[34m   Copyright (c) 1992 by Peter Deane - Inquestor BBS, Australia      "+esc$+"[31m³"+esc$+"[0m"+cr$)
    @msend(esc$+"[0;31m  "+esc$+"[43mÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ"+esc$+"[0m"+cr$)
  ELSE
    @msend("  ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿"+cr$)
    @msend("  ³                 The Online Point Pickup Program                       ³"+cr$)
    @msend("  ³     Copyright (c) 1992 by Peter Deane - Inquestor BBS, Australia      ³"+cr$)
    @msend("  ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ"+cr$)
  ENDIF
  @killkeys
  @press
  '
