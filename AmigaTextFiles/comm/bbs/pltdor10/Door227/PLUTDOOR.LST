@msend("   ³ "+ansi$(2)+"P l u t D o o r "+ansi$(5)+" - "+ansi$(3)+"S e n d i n g   U s   Y o u r   R e p l i e s  "+ansi$(7)+"³"+cr$)
@msend("   ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ"+cr$+cr$)
