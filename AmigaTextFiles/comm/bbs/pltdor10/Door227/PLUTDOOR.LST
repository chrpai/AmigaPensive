'
'
PROCEDURE convfqfa(enterednode$)
  '
  convnode$=enterednode$+CHR$(0)
  convprob!=FALSE
  addr%=0
  defaddr%=0
  '
  nodelistlib$="traplist.library"+CHR$(0)
  nodelistbase%=OpenLibrary(V:nodelistlib$,0)
  '
  IF nodelistbase%=0
    convprob!=TRUE
    @msend(cr$+"ERROR: traplist.library couldn't be opened."+cr$)
    @msend("Using 0:0/0.0 as node number."+cr$)
    zone&=0
    net&=0
    node&=0
    point&=0
  ELSE
    '
    addr%=AllocMem(8,65536)
    defaddr%=AllocMem(8,65536)
    '
    DPOKE defaddr%+0,0
    DPOKE defaddr%+2,0
    DPOKE defaddr%+4,0
    DPOKE defaddr%+6,0
    '
    ' parse the input into addr% via the library.
    '
    nlparseaddr(addr%,V:convnode$,defaddr%)
    '
    IF m68%(0)=0
      zone&=DPEEK(addr%+0)
      net&=DPEEK(addr%+2)
      node&=DPEEK(addr%+4)
      point&=DPEEK(addr%+6)
    ELSE
      @msend(cr$+"ERROR: Invalid host node # in config."+cr$)
      @msend("Using 0:0/0.0 as node number."+cr$+cr$)
      convprob!=TRUE
      zone&=0
      net&=0
      node&=0
      point&=0
    ENDIF
  ENDIF
  '
  IF addr%
    ~FreeMem(addr%,8)
  ENDIF
  '
  IF defaddr%
    ~FreeMem(defaddr%,8)
  ENDIF
  '
  IF nodelistbase%
    ~CloseLibrary(nodelistbase%)
  ENDIF
  '
RETURN
'
'
PROCEDURE nlparseaddr(addr%,str%,default%)
  m68%(8)=addr%
  m68%(9)=str%
  m68%(10)=default%
  m68%(14)=nodelistbase%
  RCALL nodelistbase%-156,m68%()
RETURN
'
'
PROCEDURE find.config
  '
  IF EXIST(path$+"PlutDoor.cfg")
    config$=path$+"PlutDoor.cfg"
  ELSE
    config$="XXX"
  ENDIF
  '
  ' Defaults
  '
  here$="3:0/0.0"
  '
  winw$="640"
  winh$="200"
  actwin!=TRUE
  sysopname$="Sysop"
  bbsname$="This BBS"
  lockedmodem!=FALSE
  logfile$=path$+"PlutDoor.log"
  maxbaud$="2400"
  outbound$="MAIL:Outbound/"
  inbound$="MAIL:Inbound/"
  textdir$=path$+"Texts/"
  xferdir$=path$+"Xfers/"
  userdir$=path$+"Users/"
  device$="serial.device"
  unit%=0
  freqconfig$="Mail:FFRS.cfg"
  freqhandler$="FFRS %C %i %o %B %n %s"
  '
  '
  IF config$<>"XXX"
    '
    OPEN "I",#2,config$,128
    configerr!=FALSE
    DO
      '
      LINE INPUT #2,xx$
      '
      xx$=TRIM$(xx$)
      xxu$=UPPER$(xx$)
      '
      IF xx$="" OR LEFT$(xx$,1)=";"
        ' Do nothing
      ELSE IF LEFT$(xxu$,14)="ACTIVATEWINDOW"
        actwin!=TRUE
      ELSE IF LEFT$(xxu$,16)="NOACTIVATEWINDOW"
        actwin!=FALSE
      ELSE IF LEFT$(xxu$,4)="HERE"
        xx$=RIGHT$(xx$,LEN(xx$)-4)
        xx$=TRIM$(xx$)
        here$=xx$
      ELSE IF LEFT$(xxu$,6)="SWIDTH"
        xx$=MID$(xx$,7,4)
        xx$=TRIM$(xx$)
        winw$=xx$
      ELSE IF LEFT$(xxu$,7)="SHEIGHT"
        xx$=MID$(xx$,8,4)
        xx$=TRIM$(xx$)
        winh$=xx$
      ELSE IF LEFT$(xxu$,5)="SYSOP"
        xx$=RIGHT$(xx$,LEN(xx$)-5)
        xx$=TRIM$(xx$)
        sysopname$=xx$
      ELSE IF LEFT$(xxu$,7)="BBSNAME"
        xx$=RIGHT$(xx$,LEN(xx$)-7)
        xx$=TRIM$(xx$)
        bbsname$=xx$
      ELSE IF LEFT$(xxu$,7)="INBOUND"
        xx$=RIGHT$(xx$,LEN(xx$)-7)
        xx$=TRIM$(xx$)
        inbound$=xx$
        IF RIGHT$(inbound$,1)<>"/" AND RIGHT$(inbound$,1)<>":"
          inbound$=inbound$+"/"
        ENDIF
      ELSE IF LEFT$(xxu$,8)="OUTBOUND"
        xx$=RIGHT$(xx$,LEN(xx$)-8)
        xx$=TRIM$(xx$)
        outbound$=xx$
        IF RIGHT$(outbound$,1)<>"/" AND RIGHT$(outbound$,1)<>":"
          outbound$=outbound$+"/"
        ENDIF
      ELSE IF LEFT$(xxu$,9)="TEXTFILES"
        xx$=RIGHT$(xx$,LEN(xx$)-9)
        xx$=TRIM$(xx$)
        textdir$=xx$
        IF RIGHT$(textdir$,1)<>"/" AND RIGHT$(textdir$,1)<>":"
          textdir$=textdir$+"/"
        ENDIF
      ELSE IF LEFT$(xxu$,5)="USERS"
        xx$=RIGHT$(xx$,LEN(xx$)-5)
        xx$=TRIM$(xx$)
        userdir$=xx$
        IF RIGHT$(userdir$,1)<>"/" AND RIGHT$(userdir$,1)<>":"
          userdir$=userdir$+"/"
        ENDIF
      ELSE IF LEFT$(xxu$,5)="XFERS"
        xx$=RIGHT$(xx$,LEN(xx$)-5)
        xx$=TRIM$(xx$)
        xferdir$=xx$
        IF RIGHT$(xferdir$,1)<>"/" AND RIGHT$(xferdir$,1)<>":"
          xferdir$=xferdir$+"/"
        ENDIF
      ELSE IF LEFT$(xxu$,6)="DEVICE"
        xx$=RIGHT$(xx$,LEN(xx$)-6)
        xx$=TRIM$(xx$)
        device$=xx$
      ELSE IF LEFT$(xxu$,4)="UNIT"
        xx$=RIGHT$(xx$,LEN(xx$)-4)
        xx$=TRIM$(xx$)
        unit%=VAL(xx$)
      ELSE IF LEFT$(xxu$,7)="LOGFILE"
        xx$=RIGHT$(xx$,LEN(xx$)-7)
        xx$=TRIM$(xx$)
        logfile$=xx$
      ELSE IF LEFT$(xxu$,10)="FREQCONFIG"
        xx$=RIGHT$(xx$,LEN(xx$)-10)
        freqconfig$=TRIM$(xx$)
      ELSE IF LEFT$(xxu$,11)="FREQHANDLER"
        xx$=RIGHT$(xx$,LEN(xx$)-11)
        freqhandler$=TRIM$(xx$)
        '
        '
      ENDIF
      '
    LOOP UNTIL EOF(#2)
    CLOSE #2
    '
    '
  ENDIF
  '
RETURN
'
'
PROCEDURE find.user
  '
  OPEN "I",#2,userdir$+uname$,4096
  WHILE NOT EOF(#2)
    LINE INPUT #2,xx$
    xx$=TRIM$(xx$)
    '
    IF xx$="" OR LEFT$(xx$,1)=";"
      ' Do nothing
    ELSE IF LEFT$(xx$,4)="AKA0"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(0)=xx$
    ELSE IF LEFT$(xx$,4)="AKA1"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(1)=xx$
    ELSE IF LEFT$(xx$,4)="AKA2"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(2)=xx$
    ELSE IF LEFT$(xx$,4)="AKA3"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(3)=xx$
    ELSE IF LEFT$(xx$,4)="AKA4"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(4)=xx$
    ELSE IF LEFT$(xx$,4)="AKA5"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(5)=xx$
    ELSE IF LEFT$(xx$,4)="AKA6"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(6)=xx$
    ELSE IF LEFT$(xx$,4)="AKA7"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(7)=xx$
    ELSE IF LEFT$(xx$,4)="AKA8"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(8)=xx$
    ELSE IF LEFT$(xx$,4)="AKA9"
      xx$=RIGHT$(xx$,LEN(xx$)-4)
      xx$=TRIM$(xx$)
      aka$(9)=xx$
    ELSE IF LEFT$(xx$,8)="PASSWORD"
      xx$=RIGHT$(xx$,LEN(xx$)-8)
      xx$=TRIM$(xx$)
      password$=xx$
      password$=UPPER$(password$)
    ELSE IF LEFT$(xx$,10)="FREQCONFIG"
      xx$=RIGHT$(xx$,LEN(xx$)-10)
      freqconfig$=TRIM$(xx$)
      '
    ENDIF
  WEND
  CLOSE #2
  '
  c%=0
  WHILE aka$(0)=""
    INC c%
    IF aka$(0)=""
      DELETE aka$(0)
    ENDIF
    EXIT IF c%>=9
  WEND
  '
  FOR k%=0 TO 9
    @convfqfa(aka$(k%))
    IF (convprob!=TRUE) OR (zone&+net&+node&+point&=0)
      aka$(k%)=""
    ELSE
      aka$(k%)=STR$(zone&)+":"+STR$(net&)+"/"+STR$(node&)+"."+STR$(point&)
    ENDIF
    aka%(k%,1)=zone&
    aka%(k%,2)=net&
    aka%(k%,3)=node&
    aka%(k%,4)=point&
  NEXT k%
  '
RETURN
'
'
PROCEDURE embed_convert(xx.arg$)
  LOCAL c%,out$
  '
  c%=0
  out$=""
  '
  DO
    IF xx.arg$=""
      embed$=xx.arg$
    ENDIF
    EXIT IF xx.arg$=""
    '
    INC c%
    xx$=MID$(xx.arg$,c%,1)
    '
    IF xx$<>"%"
      out$=out$+xx$
    ELSE
      INC c%
      xy$=MID$(xx.arg$,c%,1)
      '
      SELECT xy$
      CASE "%"
        out$=out$+"%"
      CASE "Z"
        out$=out$+STR$(aka%(0,1))
      CASE "N"
        out$=out$+STR$(aka%(0,2))
      CASE "F"
        out$=out$+STR$(aka%(0,3))
      CASE "P"
        out$=out$+STR$(aka%(0,4))
      CASE "n"
        out$=out$+aka$(0)
      CASE "S"
        out$=out$+UPPER$(uname$)
      CASE "s"
        out$=out$+uname$
      CASE "I"
        out$=out$+inbound$
      CASE "O"
        out$=out$+outbound$
      CASE "b"
        out$=out$+baud$
      CASE "B"
        out$=out$+realbaud$
      CASE "l"
        out$=out$+logfile$
      CASE "A"
        xx$=""
        FOR kkq%=1 TO 10
          IF aka$(kkq%)<>""
            xx$=xx$+aka$(kkq%)+" "
          ENDIF
        NEXT kkq%
        out$=out$+TRIM$(xx$)
      CASE "C"
        out$=out$+freqconfig$
      CASE "i"
        out$=out$+CHR$(34)+"Ram:PlutDoor.REQ"+CHR$(34)
      CASE "o"
        out$=out$+CHR$(34)+userdir$+uname$+".RLO"+CHR$(34)
        '
      ENDSELECT
    ENDIF
    EXIT IF c%>=LEN(xx.arg$)
  LOOP
  embed$=out$
  out$=""
RETURN
