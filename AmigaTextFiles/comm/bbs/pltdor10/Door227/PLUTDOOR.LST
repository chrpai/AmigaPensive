'
OPEN "I",#2,userdir$+uname$+".RLO",1024
@log(logfile$,"%","Purging "+outbound$+" directory")
'
WHILE NOT EOF(#2)
  LINE INPUT #2,xx$
  '
  IF LEFT$(xx$,1)="#"
    fl$=RIGHT$(xx$,LEN(xx$)-1)
    @msend(cr$+ansi$(5)+"Truncating "+fl$+" to zero bytes")
    @log(logfile$,"%","Truncating "+fl$+" to zero bytes")
    OPEN "O",#5,fl$,24
    PRINT #5,"";
    CLOSE #5
  ELSE IF LEFT$(xx$,1)="@" OR LEFT$(xx$,1)="^" OR LEFT$(xx$,1)="-"
    fl$=RIGHT$(xx$,LEN(xx$)-1)
    @msend(cr$+ansi$(1)+"Deleting "+fl$)
    @log(logfile$,"%","Deleting "+fl$)
    IF EXIST(fl$)
      KILL fl$
    ENDIF
  ENDIF
  '
WEND
'
CLOSE #2
'
FOR k%=0 TO 9
  core$=outbound$+STR$(aka%(k%,1))+"."+STR$(aka%(k%,2))+"."+STR$(aka%(k%,3))+"."+STR$(aka%(k%,4))+"."
  IF EXIST(core$+"FLO")
    @log(logfile$,"%","Deleting "+core$+"FLO")
    @msend(cr$+ansi$(3)+"Deleting "+core$+"FLO")
    KILL core$+"FLO"
  ENDIF
  IF EXIST(core$+"HLO")
    @log(logfile$,"%","Deleting "+core$+"HLO")
    @msend(cr$+ansi$(3)+"Deleting "+core$+"HLO")
    KILL core$+"HLO"
  ENDIF
  IF EXIST(core$+"CLO")
    @log(logfile$,"%","Deleting "+core$+"CLO")
    @msend(cr$+ansi$(3)+"Deleting "+core$+"CLO")
    KILL core$+"CLO"
  ENDIF
  IF EXIST(core$+"DLO")
    @log(logfile$,"%","Deleting "+core$+"DLO")
    @msend(cr$+ansi$(3)+"Deleting "+core$+"DLO")
    KILL core$+"DLO"
  ENDIF
NEXT k%
@press
