PROCEDURE userlogprep
  ' open and field the userlog.
  '
  OPEN "R",#3,flnm$,125
  FIELD #3,25 AS un$,10 AS pa$,1 AS le$,25 AS fr$,12 AS ph$,10 AS dl$,6 AS lm$,6 AS lf$,10 AS ind$,3 AS tc$,3 AS td$,1 AS sw$,1 AS pr$,1 AS mo$,5 AS cn$,4 AS dm1$,2 AS dm2$
RETURN
'
'
PROCEDURE setpagepause
  oldscrnht%=scrnht%
  o$=cr$+cr$+ansi$(2)+"Current Screen Height: "+ansi$(5)+STR$(oldscrnht%)
  GOSUB 2
  o$=cr$+cr$+ansi$(3)+"Change Screen Height (y/N)? "
  in%=3
  il%=1
  yes%=0
  GOSUB 1
  IF in$="NO" OR car%>0
    GOTO pauseexit
  ENDIF
  o$=cr$+ansi$(2)+"New Screen Height: "+ansi$(1)
  in%=4
  il%=2
  GOSUB 1
  IF in$="" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=VAL(in$)
  o$=cr$+ansi$(3)+"Are "+ansi$(1)+STR$(scrnht%)+ansi$(3)+" lines okay (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF in$="YES" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=oldscrnht%
  o$=cr$+cr$+ansi$(1)+"No Change"
  GOSUB 2
  GOSUB press
  GOSUB 1
  '
  pauseexit:
RETURN
'
'
PROCEDURE checkansi
  '
  o$=cr$+cr$+"Do you want ANSI (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF car%>0
    GOTO checkansiexit
  ENDIF
  '
  IF in$="YES"
    ansi%=1
  ELSE
    ansi%=0
  ENDIF
  checkansiexit:
  '
RETURN
'
PROCEDURE setansi
  '
  ans%(1)=1
  ans%(2)=2
  ans%(3)=3
  ans%(4)=5
  ans%(5)=6
  '
  IF ansi%=1
    ansi$(1)=esc$+"[31m"
    ansi$(2)=esc$+"[32m"
    ansi$(3)=esc$+"[33m"
    ansi$(4)=esc$+"[34m"
    ansi$(5)=esc$+"[35m"
    ansi$(6)=esc$+"[36m"
    ansi$(7)=esc$+"[37m"
    ansi$(8)=esc$+"[1m"
    ansi$(9)=esc$+"[3m"
    ansi$(10)=esc$+"[4m"
  ELSE
    FOR kk%=1 TO 10
      ansi$(kk%)=""
    NEXT kk%
  ENDIF
  ' regardless of setting, this is needed for safety!
  ansi$(0)=esc$+"[0;37;40m"
  o$=ansi$(0)
  GOSUB 2
RETURN
'
PROCEDURE cmdread
  ' Read in Menu File
  ' array   =   cmd$(x,2)
  ' cmd$(x,1) = Keypress
  ' cmd$(x,2) = Menu Text (after the []s)
  '
  IF NOT EXIST(path$+"Poll.menu") OR car%>0
    errflag%=1
    GOTO cmdreadexit
  ENDIF
  OPEN "I",#2,path$+"Poll.menu",1024
  errflag%=0
  k%=0
  WHILE NOT EOF(#2)
    INC k%
    '
    ' The keypress
    LINE INPUT #2,cmd$(k%,1)
    cmd$(k%,1)=TRIM$(cmd$(k%,1))
    IF (LEN(cmd$(k%,1))>1)
      errflag%=1
    ENDIF
    EXIT IF (LEN(cmd$(k%,1))>1) OR (EOF(#2))
    '
    LINE INPUT #2,cmd$(k%,2)
    IF LEN(cmd$(k%,2))<2
      errflag%=1
    ENDIF
    EXIT IF (LEN(cmd$(k%,2))<2) OR (EOF(#2))
  WEND
  pollsavail%=k%
  cmdreadexit:
  CLOSE #2
RETURN
'   **************
PROCEDURE dateconv
  ' **************
  ' converts date to Fido style DD-Mmm-YY
  ' string to use is pd.date$
  pd.temp$=DATE$
  pd.date1$=LEFT$(pd.temp$,2)
  pd.date2$=MID$(pd.temp$,4,2)
  pd.date3$=RIGHT$(pd.temp$,2)
  pd.month%=VAL(pd.date1$)
  pd.month$="Xxx"
  IF pd.month%=1
    pd.month$="Jan"
  ELSE IF pd.month%=2
    pd.month$="Feb"
  ELSE IF pd.month%=3
    pd.month$="Mar"
  ELSE IF pd.month%=4
    pd.month$="Apr"
  ELSE IF pd.month%=5
    pd.month$="May"
  ELSE IF pd.month%=6
    pd.month$="Jun"
  ELSE IF pd.month%=7
    pd.month$="Jul"
  ELSE IF pd.month%=8
    pd.month$="Aug"
  ELSE IF pd.month%=9
    pd.month$="Sep"
  ELSE IF pd.month%=10
    pd.month$="Oct"
  ELSE IF pd.month%=11
    pd.month$="Nov"
  ELSE IF pd.month%=12
    pd.month$="Dec"
  ENDIF
  pd.date$=pd.date2$+"-"+pd.month$+"-"+pd.date3$
RETURN
'
'
'
'
PROCEDURE timeconv
  ' Pd.time$ is always 'HH:MM:SS xM' (ie 11 chars long) a leading 0 if needed
  '
  LOCAL t.t%
  '
  time1$=TIME$
  t.t%=VAL(LEFT$(time1$,2))
  IF t.t%>11
    a$=" PM"
  ELSE
    a$=" AM"
  ENDIF
  '
  IF t.t%=0
    t.t%=12
    time1$=STR$(t.t%)+RIGHT$(time1$,6)
  ELSE IF t.t%<10
    time1$="0"+STR$(t.t%)+RIGHT$(time1$,6)
  ELSE IF t.t%>21
    t.t%=t.t%-12
    time1$=STR$(t.t%)+RIGHT$(time1$,6)
  ELSE IF t.t%>12
    t.t%=t.t%-12
    time1$="0"+STR$(t.t%)+RIGHT$(time1$,6)
  ENDIF
  pd.time$=time1$+a$
  '
RETURN
'
'
'
PROCEDURE beepthree
  @msend(CHR$(7))
  PAUSE 5
  @msend(CHR$(7))
  PAUSE 5
  @msend(CHR$(7))
  PAUSE 5
RETURN
'
PROCEDURE lowercase(ucase$)
  '
  LOCAL ad%,ad2%
  ad%=0
  ad2%=0
  '
  lcase$=ucase$
  IF LEN(ucase$)<1 OR LEN(ucase$)>56
    GOTO noworkjump
  ENDIF
  '
  ad%=AllocMem(60,0)
  IF ad%=0
    GOTO noworkjump
  ENDIF
  ad2%=AllocMem(60,0)
  IF ad2%=0
    GOTO noworkjump
  ENDIF
  '
  FOR k%=0 TO 59
    POKE ad%+k%,0
    POKE ad2%+k%,0
  NEXT k%
  '
  FOR k%=1 TO LEN(ucase$)
    POKE ad%+(k%-1),ASC(MID$(ucase$,k%,1))
    POKE ad2%+(k%-1),ASC(MID$(ucase$,k%,1))
  NEXT k%
  '
  FOR k%=1 TO 60
    ' start at second char. Leave first one alone!
    temp|=PEEK(ad%+k%)
    IF temp|>64 AND temp|<91
      IF PEEK(ad%+k%-1)>64 AND PEEK(ad%+k%-1)<91
        temp|=BSET(temp|,5)
        POKE ad2%+k%,temp|
      ENDIF
    ENDIF
  NEXT k%
  '
  lcase$=CHAR{ad2%}
  lcase$=TRIM$(lcase$)
  '
  noworkjump:
  IF ad%>0
    ~FreeMem(ad%,60)
  ENDIF
  IF ad2%>0
    ~FreeMem(ad2%,60)
  ENDIF
  '
RETURN
'
'
PROCEDURE main_window
  OPENW #2,0,11,sw%,sh%-20,0,2304,1
  IF icon!=TRUE
    PRINT
    PRINT
    PRINT ansi4$+"                        Now running in ICONISED mode"
    PRINT
    PRINT ansi3$+"                           NO local console output"
    PRINT
    PRINT ansi5$+"                       Press F3 to un-iconise the door"
  ENDIF
  '
  xx$=doorname$+" V"+versnum$+"    ID#:"+STR$(id%)+" Lev:"+STR$(lev%)+" ["+uname$+"]  "
  IF ring!=TRUE
    xx$=xx$+"Remote"
  ELSE
    xx$=xx$+"Local"
  ENDIF
  TITLEW #1,"",xx$
  TITLEW #2,"",xx$
  TITLES #1,xx$
  ~ActivateWindow(WINDOW(2))
  '
RETURN
