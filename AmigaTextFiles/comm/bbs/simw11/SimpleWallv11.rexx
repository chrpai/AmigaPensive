;OPTIONS RESULTS;tr=TRANSMIT;leeg=COPIES(' ',79);Datafile='Doors:SimpleWall.dat';CLS;tr '\c6                               __                       __  __         ';tr '\c6         _____ __ __    __ ___|_ |____     _    _______|  ||  |        ';tr '\c6        (  ___|  |  \\  /  |  __ ||  __|   | |  | |     |  ||  |       ';tr '\c6         \\  \\ |  |   \\/   |  ___||__|_    | |/\\| |  T  |  ||__|__  ';tr '\c6         _\\  \\|  |        |  ||     |_    |      | ___ |      |  |   ';tr '\c6        (_____)__|__|\\/|__|__||_____|_|   |__/\\__|_| |_|______|__|   ';tr '\c3             Version 1.1 by \c2Lord Adrenaline ^ Reboot & JAVE ';tr '\c1-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-';tr '\!9\!1\c1-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-';CALL Getlines;CALL Showlines;queryn '\!6\c7Do you want to add a line to this wall? (y/N) \c3';dump=RESULT;IF dump='###PANIC' THEN EXIT;IF dump='NO' THEN CALL einde;IF dump='YES' THEN;DO;prompt 60 NORMAL '\c6Enter text (60 chars max)\c7\n1';regel=RESULT;IF regel='###PANIC' THEN EXIT;IF LENGTH(regel)<3 THEN;DO;tr '\c3This is not enough!';CALL einde;END;ELSE;DO;queryn '\c2Do you want to be anonymous? \c3';dump=RESULT;IF dump='###PANIC' THEN EXIT;IF dump='YES' THEN;DO;poster='Someone...';END;ELSE;DO;getuser 1;poster=RESULT;END;END;END;counter=lijn.0;IF counter=10 THEN;DO;DO A=2 TO 10;B=A-1;lijn.B=lijn.A;END;counter=9;END;counter=counter+1;lijn.0=counter;lijn.counter='\c6'LEFT(poster,15)' \c1> \c7'regel;CALL Clearfield;CALL Showlines;CALL Writelines;tr leeg;tr leeg;tr leeg;tr leeg;einde:;DO FOREVER;/*    Checkio
    IF RESULT='TRUE' THEN DO
*/;cls;tr '\c7Press a button\G0';cls;LEAVE;END;END;EXIT;Getlines:;IF ~EXISTS(Datafile) THEN;DO;lijn.0=0;END;ELSE;DO;CALL OPEN(file,Datafile,R);counter=0;DO UNTIL EOF(file);counter=counter+1;lijn.counter=READLN(file);END;IF lijn.counter='' THEN counter=counter-1;lijn.0=counter;END;CALL CLOSE(file);RETURN;Showlines:;tr '\F0\!7';DO A=1 TO lijn.0;tr lijn.A;END;tr '\F0\!9\!3';RETURN;Writelines:;CALL OPEN(file,datafile,W);DO A=1 TO lijn.0;CALL WRITELN(file,lijn.A);END;CALL CLOSE(file);RETURN;Clearfield:;tr '\F0\!7';DO A=1 TO 9;tr leeg;END;RETURN