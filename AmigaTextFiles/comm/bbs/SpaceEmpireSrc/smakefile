#
# Doors make file
#
NEWUSOBJS  = io.o newuser.o
BULLEOBJS  = extra.o io.o bulletin.o
BULLOBJS   = extra.o io.o bull.o
SPACEOBJS  = extra.o io.o message.o random.o space.o space1.o budget.o addon.o
SYSEDOBJS  = io.o sysedit.o
NWOBJS     = nw.o extra.o io.o
#
LINKOPTS   = smallcode smalldata verbose addsym
#
all        : space  sysedit nw bulletin newuser bull
#
space      : $(SPACEOBJS)
             slink <WITH <
                    FROM  lib:catch.o $(SPACEOBJS) to space
                    LIB LIB:scm.lib LIB:sc.lib LIB:amiga.lib
                    $(LINKOPTS)
<
sysedit    : $(SYSEDOBJS)
             slink <WITH <
                    FROM LIB:catch.o $(SYSEDOBJS) TO sysedit
                    LIB LIB:scm.lib LIB:sc.lib LIB:amiga.lib
                    $(LINKOPTS)
<
nw         : $(NWOBJS)
             slink <WITH <
                    FROM LIB:catch.o $(NWOBJS) TO NW
                    LIB LIB:scm.lib  LIB:sc.lib LIB:amiga.lib
                    $(LINKOPTS)
<
bulletin   : $(BULLEOBJS)
             slink <WITH <
                    FROM LIB:catch.o $(BULLEOBJS) TO bulletin
                    LIB  LIB:scm.lib LIB:sc.lib LIB:amiga.lib
                    $(LINKOPTS)
<
bull       : $(BULLOBJS)
             slink <WITH <
                    FROM LIB:catch.o $(BULLOBJS) TO bull
                    LIB  LIB:scm.lib LIB:sc.lib LIB:amiga.lib
                    $(LINKOPTS)
<
newuser    : $(NEWUSOBJS)
             slink <WITH <
                    FROM LIB:catch.o $(NEWUSOBJS) TO NewUser
                    LIB LIB:scm.lib LIB:sc.lib LIB:amiga.lib
                    $(LINKOPTS)
<
bulletin.o : bulletin.c extra.h io.h
bull.o     : bull.c extra.h io.h
nw.o       : nw.c       nw.h    extra.h io.h
newuser.o  : newuser.c  io.h
space.o    : space.c    space.h extra.h io.h
space1.o   : space1.c   space.h extra.h io.h
sysedit.o  : sysedit.c  space.h extra.h io.h sysedit.h
extra.o    : extra.c    space.h extra.h io.h
io.o       : io.c       space.h extra.h io.h
message.o  : message.c  space.h extra.h io.h
random.o   : random.c   space.h extra.h io.h
budget.o   : budget.c   space.h extra.h io.h
addon.o    : addon.c    space.h extra.h io.h
