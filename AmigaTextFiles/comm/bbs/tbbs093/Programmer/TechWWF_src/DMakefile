
OD = dtmp:TWWF/

CFLAGS = -r -v -mRR -ms -mi -EError.txt -proto

EXE = TechWWF

CSRCS = TechWWF.c WWFData.c WWFSLM.c CConv.asm

OBJS = $(CSRCS:"*.*":"$(OD)*.o")

all : err $(EXE)

err : Error.txt
   -delete %(right)

$(EXE) : $(OBJS)
   dcc $(CFLAGS) %(right) -o %(left)

$(OBJS) : $(CSRCS)
   dcc $(CFLAGS) %(right) -o %(left) -c

