##INFO_INTROLINE
Boards
##MSG_UNKNOWN
$(NORMAL)$(COL{1})Unknown board %s.\n
##MSG_BRETTFORMAT
%-30.30s $(COL{5})%-30.30s
##MSG_UNTERBRETTER
$(NORMAL)$(UNDERLINE)Subboards from here:$(NORMAL)\n
##MSG_ALLEBRETTER
$(NORMAL)$(UNDERLINE)All boards in this box:\n
##MSG_SYNTAX
$(NORMAL)BRETT <boardname> [pattern]\n
##MSG_BRETTAUSWAHL
Boards - Choose with cursorkeys, Quit Q
##MSG_INHALT
$(NORMAL)\nDidn't find any subboards. Enter $(BOLD)INHALT$(NORMAL) for new entrys,\nor $(BOLD)INHALT *$(NORMAL) for all entrys.\n
##MSG_NONEW
$(NORMAL)\nDidn't find any subboards where can be found $(UNDERLINE)new$(NORMAL) articles.\nEnter $(BOLD)BRETT *$(NORMAL) for $(UNDERLINE)all$(NORMAL) subboards.\n
##MSG_ACTUAL
$(NORMAL)Please wait, getting data.\n
