##INFO_INTROLINE
Read news
##MSG_NUMMER
$(NORMAL)$(COL{4})Number     : $(NORMAL)$(BOLD)%ld\n
##MSG_BETREFF
$(NORMAL)$(COL{4})Subject    : $(NORMAL)$(BOLD)%-60.60s\n
##MSG_ABSENDER
$(NORMAL)$(COL{4})From       : $(NORMAL)$(BOLD)%-60.60s\n
##MSG_FILENAME
$(NORMAL)$(COL{4})Filename   : $(NORMAL)$(BOLD)%-60.60s\n
##MSG_KOMMENTAR
$(NORMAL)$(COL{4})Comment    : $(NORMAL)$(BOLD)%-60.60s\n
##MSG_MSGID
$(NORMAL)$(COL{4})MsgId      : $(NORMAL)$(BOLD)%-60.60s\n
##MSG_GELESEN
$(NORMAL)$(COL{4})Read count : $(NORMAL)$(BOLD)%ld\n
##MSG_FLAGS
$(NORMAL)$(COL{4})Flags      : $(NORMAL)$(BOLD)%s\n
##MSG_SENDDATE
$(NORMAL)$(COL{4})Send       : $(NORMAL)$(BOLD)%s\n
##MSG_INCOMDATE
$(NORMAL)$(COL{4})Received   : $(NORMAL)$(BOLD)%s\n
##MSG_LENGTH
$(NORMAL)$(COL{4})Length     : $(NORMAL)$(BOLD)%s\n
##MSG_TRENNUNG
$(NORMAL)$(COL{5})---------------------------------------------------------------------\n
##MSG_WHATNEWS
$(NORMAL)No new messages.\nPlease choose, $(BOLD)which$(NORMAL) article you want to read.\n
##MSG_NOBOARD
$(NORMAL)You are in a hierachy, please choose a board.\n
##MSG_CENSOR
$(NORMAL)$(BOLD)$(COL{1})This message need to be given free by the censor.$(NORMAL)\n
##MSG_DELETE
$(NORMAL)$(BOLD)$(COL{1})Sorry, this message is being deleted$(NORMAL).\n
##MSG_BINARY
$(NORMAL)$(BOLD)$(COL{1})Message contains binary (Download with D)\n
##MSG_ANSWER
$(NORMAL)Answer. ($(BCOL{4})$(BOLD)p$(NORMAL)$(BCOL{0}))rivate, ($(BCOL{4})$(BOLD)O$(NORMAL)$(BCOL{0})) public?
##MSG_QUOTE
$(NORMAL)Copy original mail? ($(BCOL{4})$(BOLD)j$(NORMAL)$(BCOL{0})) Yes, ($(BCOL{4})$(BOLD)N$(NORMAL)$(BCOL{0}))o.
##MSG_RATIO
$(NORMAL)\n$(BOLD)$(COL{1})*** You don't have download credits ***\n
##MSG_SEND
$(NORMAL)$(COL{3})Sending message...$(NORMAL)\n
##MSG_NOWRITE
$(NORMAL)$(BOLD)$(COL{1})You cannot write in this board.\n
##MSG_NONET
$(NORMAL)$(BOLD)$(COL{1})You cannot use networks, yet.\n
##MSG_DELETEMSG
$(NORMAL)Delete messages? ($(BCOL{4})$(BOLD)j$(NORMAL)$(BCOL{0})) Yes, ($(BCOL{4})$(BOLD)N$(NORMAL)$(BCOL{0}))o.
##MSG_SHORT_WEITER
-Continue
##MSG_SHORT_NOCHMAL
-Again
##MSG_SHORT_ANTWORTEN
nswer
##MSG_SHORT_DOWNLOAD
ownload
##MSG_SHORT_MERKEN
-Remember
##MSG_SHORT_QUIT
uit
