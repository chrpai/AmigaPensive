

Echo	"*E[0 p" NOLINE
Echo	"*N     Lancement de MAD-le-RTC qui rend fou !"

Assign	MAD-Multi: MAD MAD-Disk-2:MAD-Multi/MAD
Assign	MADData-Multi: MAD-Disk-2:MAD-Multi/DATA
Assign	MADPage-Multi: MAD/Page
List	>RAM:MAD.temp MAD-Multi:Page DIRS LFORMAT "Assign MADPage-Multi: MADPage-Multi:%s ADD"
Execute	RAM:MAD.temp
Delete	>NIL: RAM:MAD.temp

Run	>NIL: MAD-Multi:MAD-le-RTC

Wait	100
Echo	"       Copie des pages vidéotex en RAM:"
MakeDir	>NIL: RAM:Page
Copy	>NIL: MADPage-Multi: to RAM:Page ALL
List	>RAM:MAD.temp RAM:Page DIRS LFORMAT "Assign MADPage-Multi: MADPage-Multi:%s ADD"
Assign	MADPage-Multi: RAM:Page
Execute	RAM:MAD.temp
Delete	>NIL: RAM:MAD.temp

EndShell
