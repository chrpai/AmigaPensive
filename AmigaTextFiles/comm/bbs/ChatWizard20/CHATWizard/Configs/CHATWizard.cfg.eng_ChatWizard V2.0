; 
; System settings
;

SYSOPNAME "Sysop"
COLORBGROUND 4
COLORFGROUND 6
COLORWRITE 7
MAXLENGTH 28
YELLFILE CHATWizard:YellProgramm/English/ChatYell01.prg

;
; Special Functions of the LINEWizard
;

LINECOLORSYSOP 5
LINECOLORUSER 3
LINEYELLSTRING "Hi. The Sysop wants to talk with you !"
LINEUSERBREAK
