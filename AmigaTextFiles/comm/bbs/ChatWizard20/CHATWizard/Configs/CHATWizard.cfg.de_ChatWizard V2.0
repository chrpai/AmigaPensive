; 
; Systemeinstellungen
;

SYSOPNAME "Sysop"
COLORBGROUND 4
COLORFGROUND 6
COLORWRITE 7
MAXLENGTH 28
YELLFILE CHATWizard:YellProgramm/deutsch/ChatYell01.prg

;
; Spezielle Funktionen von LINEWizard
;

LINECOLORSYSOP 5
LINECOLORUSER 3
LINEYELLSTRING "Hallo User, der Sysop hat Lust mit dir zu reden..."
LINEUSERBREAK

