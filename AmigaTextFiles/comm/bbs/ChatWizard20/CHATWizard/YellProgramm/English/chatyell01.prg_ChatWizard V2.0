; Beschreibung der Buchstaben bei YellEndKey

KeyExit    e
KeyReplay  r
KeyMessage m

; Bildschirmaufbau

CLS

LoadPic bbs:ChatWizard/ChatPic01.ANSI

color 6
position 12 37
input 42 "." 7

color 4
bkcolor 5
position 6 57
print "±±±±±±±±±±±±±±"
bkcolor 0

color 4
position 8 53
printuser "Press <CTRL X> to exit"
printsysop "Press <SPACE> to start"

position 6 57
bar 14 1 5

wait 1

position 6 57
bkcolor 5
color 0
print "   finished   "

wait 2

bkcolor 0
color 4
position 2 50
print "ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿"
position 3 50
print "³                           ³"
position 4 50
print "³                           ³"
position 5 50
print "³ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ³"
position 6 50
print "³                           ³"
position 7 50
print "³                           ³"
position 8 50
print "³                           ³"
position 9 50
print "³                           ³"
position 10 50
print "³                           ³"
position 11 50
print "³                           ³"
position 12 50
print "³                           ³"
position 13 50
print "ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ"

color 7
position 3 53
print "Sysop no available at"
position 4 53
print "     the moment      "

color 5
position 7 55
print "R"
position 9 55
print "E"
position 11 55
print "M"

color 6
position 7 57
print "Retry"
