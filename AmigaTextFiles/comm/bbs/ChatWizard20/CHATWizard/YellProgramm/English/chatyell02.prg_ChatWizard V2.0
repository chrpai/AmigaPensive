; Beschreibung der Buchstaben bei YellEndKey

KeyExit    e
KeyReplay  r
KeyMessage m

; Bildschirmaufbau

CLS

LoadPic CHATWizard:YellPicture/ChatPic02.ANSI

color 7
position 16 12
input 63 " " 0

color 6
position 19 26
print "SENDING SUBSPACE MESSAGE TO SYSOP"

position 21 34
print "北北北北北北北北"

color 6
position 13 25
PrintUser "      Press <CTRL X> to exit          "
PrintSysop "      Press <SPACE> to start          "

ScreenToFront

color 6
position 21 34
bar 16 1 6

wait 1

color 0
bkcolor 6
position 21 34
print "   sending ok   "

bkcolor 0
color 6
position 13 14
print "    LEAVE CHAT          RETRY                  MESSAGE TO SYSOP"

color 4
position 13 14
print "- -"

position 13 34
print "- -"

position 13 57
print "- -"

color 7
position 13 15
print "E"
position 13 35
print "R"
position 13 58
print "M"

position 24 1

yellendkey

