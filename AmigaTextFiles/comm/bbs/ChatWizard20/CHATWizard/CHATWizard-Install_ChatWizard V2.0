; Install Script für ChatWizard V2.0                             Version 1.0
; Copyright 1994-96 by TFB-Software, Created by Dietmar Zettel

(complete 0)

(set @default-dest "BBS:Extras/")
(set @app-name "CHATWizard V2.0")
(user 2)

; ---------------------------------
; ---  Englische Dokumentation  ---
; ---------------------------------

(set #Intro-Chat
    (cat
        "CHATWizard V2.0\n\n"
        "Copyright 1994-96 by TFB-Software\n\n"
        "CHATWizard is Postcardware.\n"
        "You can copy it freely if you\n"
        "take no money for it.\n\n"
        "If you have installed an earlier version of ChatWizard, "
        "you should delete it an all entries in your *.rx files "
        "Please read the manual for more information."
))

(set #Default_Dir
    (cat
        "Enter your destination path for ChatWizard 2.0"
))

(set #Default_Dir-help
    (cat
        "Please enter a Path where ChatWizard can copy it's"
        "programms. Normally it's known as BBS:Extras"
))

(set #Rexx_Dir
    (cat
        "Enter your TransAmigas Rexx directory"
))

(set #Rexx_Dir-help
    (cat
        "Enter here your path to your \"TransAmiga Rexx\" "
        "directory. Normally it's known as \n\nBBS:Rexx"
))

(set #Config_Dir
    (cat
        "Enter your TransAmiga Config Path."
))

(set #Config_Dir-help
    (cat
        "Enter here your path to your \"TransAmiga Config\" "
        "directory. Normally it's known as \n\nBBS:Configs"
))

(set #Sprach_Auswahl_text (cat "Which language do you want to install"))
(set #Sprach_Auswahl_text-help
    (cat
        "Enter the language, you want to use in the programm"
))

(set #Sprache_1 (cat "Deutsch"))
(set #Sprache_2 (cat "English"))

(set #Shell_Startup_Auswahl (cat"'CHATWizard:' -establish assign?"))
(set #Shell_Startup_Auswahl-help
    (cat
        ""
))

(set #Key_Auswahl_text (cat "Which key do you want to use in mainmenu to launch the Chat?"))
(set #Key_Auswahl_text-help
    (cat
        ""
))

(set #Config_Append (cat "Shall I insert this line in your Main.Rx file?"))
(set #Config_Append-help
    (cat
        ""
))

(set #Sysop_Name (cat "Please enter the Sysop's name "))
(set #Sysop_Name-help
    (cat
        ""
))

(set #Config-Chat
    (cat
        "Now the configfile will be build. "
))

(set #Color_Back   (cat "Please choose the backgroundcolor"))
(set #Color_Forder (cat "Please choose the foregroundcolor"))
(set #Color_Write  (cat "Please choose the pencolor"))

(set #Color-schwarz (cat "black"))
(set #Color-rot     (cat "red"))
(set #Color-gruen   (cat "green"))
(set #Color-gelb    (cat "yellow"))
(set #Color-blau    (cat "blue"))
(set #Color-rosa    (cat "pink"))
(set #Color-tuerk   (cat "cyan"))
(set #Color-weiss   (cat "white"))

(set #Color-help (cat "Choose your favourite colors for the chat..."))

(set #Max_Length (cat "Please enter your maxmimal screenlength (20-40) "))
(set #Max_Length-help (
    cat
       ""))

(set #Yellauswahl (cat "Which yellprogram do you want"))
(set #Yellauswahl-help (
    cat
       "Da Wahn ist einfach das StarTrek Yell Programm !!"))

(set #Yellprogramm_1 (cat "StarTrek"))
(set #Yellprogramm_2 (cat "CHATWizard"))
(set #Yellprogramm_3 (cat "Interner"))

(set #Color_SLine (cat "Choose the sysops color"))

(set #Color_ULine (cat "Choose the users color"))

(set #Yell_Line (cat "Enter the text, wich will appear on LineWizards start:"))
(set #Yell_Line-help (
   cat
      ""))
(set #Yell_Line_ask (cat "Hello User, your Sysop wants to talk with you..."))

(set #Line_end (cat "Enable exiting the LineChat for the user?"))
(set #Line_end-help (
   cat
      ""))
(set #Line_end_Ja (cat "Yes"))
(set #Line_end_Nein (cat "No"))

(set #Config_Save (cat "Have you all entered correctly?"))
(set #Config_Save-help (
  cat
     ""))

; -------------------------
; ---  Fehlermeldungen  ---
; -------------------------

(set #Error_Level_1
  (cat     "I hope you had no problems with understanding this."
           "If there are any questions left, refer the programmers"
           "which are listed in the appendix of the manual."))

(set #Error_Level_2
  (cat   "Sorry, no memory left. Please exit some unimportant"
         "programms"))

(set Error_Level_3 (cat "Error in script !"))
(set Error_Level_4 (cat "DOS Error  !"))
(set Error_Level_5 (cat "Wrong parameters or data !"))

; --------------------------------
; ---  Deutsche Dokumentation  ---
; --------------------------------

(if (= @language "deutsch") (
  (set #Intro-Chat
      (cat
          "CHATWizard V2.0\n\n"
          "Copyright 1994-96 by TFB-Software\n\n"
          "CHATWizard ist Postcardware. Er darf \n"
          "frei kopiert werden, solange keine\n"
          "Gebühr für das Kopieren verlangt wird.\n\n"
          "Wenn schon eine ältere Version vom ChatWizard installiert ist, "
          "sollten sie diese löschen und alle Einträge in den *.rx Dateien "
          "löschen, da es sonst zu Fehlern kommen könnte. Lesen sie dazu "
          "bitte die Anleitung genau durch."
  ))

  (set #Default_Dir
      (cat
          "Auf welche Festplatte oder Verzeichnis wollen"
          " sie \"CHATWizard V2.0\" Installieren ?"
  ))

  (set #Default_Dir-help
      (cat
          "Es wird von ihnen einen Pfad verlangt im dem der "
          "CHATWizard alle seine wichtigen Daten ablegen kann. "
          "Am besten sollte es ein Verzeichnis im BBS:EXTRAS sein, "
          "da hier alle TA Doors abgespeichert werden. "
          "Der Installer legt dann automatisch das CHATWIZARD "
          "Verzeichnis an."
  ))

  (set #Rexx_Dir
      (cat
          "Wo befindet sich auf ihrer Festplatte das \"TransAmiga Rexx\" "
          "Verzeichnis ???"
  ))

  (set #Rexx_Dir-help
      (cat
          "Sie müssen hier den Pfad für ihr \"TransAmiga Rexx\" "
          "Verzeichnis angeben. Normalerweise heisst das "
          "Verzeichnis:\n\nBBS:Rexx"
  ))

  (set #Config_Dir
      (cat
          "Wo befindet sich auf ihrer Festplatte das \"TransAmiga Config\" "
          "Verzeichnis ???"
  ))

  (set #Config_Dir-help
      (cat
          "Sie müssen hier den Pfad für ihr \"TransAmiga Config\" "
          "Verzeichnis angeben. Normalerweise heisst das "
          "Verzeichnis:\n\nBBS:Configs"
  ))

  (set #Sprach_Auswahl_text (cat "Welche Sprache wollen sie Installieren"))
  (set #Sprach_Auswahl_text-help
      (cat
          "Das Programm kann zwei Sprachen, Deutsch und Englisch. "
          "Sie muessen nun angeben, welchen von den 2 Sprachen Installiert "
          "werden soll. \n"
          "Alle Scripte und das Programm sind in dieser Sprache nach der "
          "Installation."
  ))

  (set #Sprache_1 (cat "Deutsch"))
  (set #Sprache_2 (cat "English"))

  (set #Shell_Startup_Auswahl (cat"'CHATWizard:' - Assign einrichten ?"))
  (set #Shell_Startup_Auswahl-help
      (cat
          "Der Chat braucht den Assign um diverse Programmfiles und "
          "Daten aufzufinden. Die Befehlszeile wird automatisch "
          "in ihre USER-STARTUP geschrieben.\n"
          "Das Programm erkennt ob der Assign schon vorhanden ist."
  ))

  (set #Key_Auswahl_text (cat "Mit welcher Taste wollen sie den ANSIWizard vom Hauptmenue aus starten ?"))
  (set #Key_Auswahl_text-help
      (cat
          "Um den Chat vom Hauptmenue aus starten zu koennen muessen sie "
          "zuerst angeben mit welcher Taste. Dies ist spaeter noch Manuell "
          "veraenderbar.\n"
          "Aber VORSICHT: Wenn schon die Taste anderstweitig belegt "
          "wurde kann dies zu konflikten kommen !!!"
  ))

  (set #Config_Append (cat "Wollen sie das die Start Zeile in ihr Main.Rx File geschrieben wird"))
  (set #Config_Append-help
      (cat
          "Um den ANSIWizard aus dem Hauptmenue aus zu starten muss "
          "zuerst das MAIN.RX File geaendert werden. Die Startzeile "
          "dazu wird automatisch eingebunden. Die Daten (Access, "
          "Auswahlbuchstabe usw.) koennen spaeter auch noch veraendert "
          "werden."
  ))

  (set #Config-Chat
      (cat
          "Die nächsten Fragen, betreffen das Configfile. Dies "
          "wird nach ihren Spezifikationen erstellt. Sie koennen "
          "es spaeter auch noch Manuell veraendern."
  ))

  (set #Sysop_Name (cat "Bitte geben sie den Sysopnamen ein "))
  (set #Sysop_Name-help
      (cat
          "Bei aelteren TransAmiga Versionen kann man noch nicht "
          "den Sysopnamen direkt aus dem Programm auslesen. Hier "
          "ist es wichtig wenn der Sysopname korrekt angegeben wurde.\n"
          "Er erscheint im Chatfenster des Sysops."
  ))

  (set #Color_Back   (cat "Bitte geben sie die Hintergrundfarbe an "))
  (set #Color_2Back  (cat "Bitte geben sie die 2. Hintergrundfarbe an"))
  (set #Color_Forder (cat "Bitte geben die die Fordergrundfarbe an "))
  (set #Color_Write  (cat "Bitte geben sie die Schreibfarbe an "))

  (set #Color-schwarz (cat "schwarz"))
  (set #Color-rot     (cat "rot"))
  (set #Color-gruen   (cat "grün"))
  (set #Color-gelb    (cat "gelb"))
  (set #Color-blau    (cat "blau"))
  (set #Color-rosa    (cat "rosa"))
  (set #Color-tuerk   (cat "türkis"))
  (set #Color-weiss   (cat "weiß"))

  (set #Color-help
      (cat
          "Die Farben die sie einstellen, sind die normalen Standart "
          "ANSI Farben. Diese koennen spaeter auch Manuell im Config "
          "File geaendert werden. Die eingestellten Farben ergeben "
          "das Standartbild. Am besten man probiert einfach ein klein "
          "wenig herum, da das persoenliche aussehen erst durch die "
          "Variation entsteht. "
  ))

  (set #Max_Length (cat "Bitte geben sie die maximale Bildschirmlänge an (20-40) "))
  (set #Max_Length-help (
      cat
         "Der Chat passt sich an die aktuelle User Bildschirmlaenge an. "
         "Diese kann auch mal groesse sein als dem Sysop sein Bildschirm. "
         "Es wuerde zu Datenmuell auf dem Bildschirm kommen.\n"
         "Sie muessen nun dir genaue MAX. Bildschirmlaenge ermitteln und "
         "eingeben. "
  ))

  (set #Yellauswahl (cat "Welches Yellprogramm wollen sie als Standart haben"))
  (set #Yellauswahl-help (
      cat
         "Beim Starten des ANSIWizards, erscheint ein Yellprogramm. "
         "Von dem Chat sind schon 2 fertige Yellprogramme vorgegeben, "
         "die sie auswaehlen koennen. \n"
         "Spaeter koennen sie auch die Yellprogramme selber schreiben, "
         "eine ausfuehrliche Anleitung liegt dem Programm bei.\n\n"
         "Das STARTREK Yellprogramm ist einfach der WAHN !!!"
  ))

  (set #Yellprogramm_1 (cat "StarTrek"))
  (set #Yellprogramm_2 (cat "CHATWizard"))
  (set #Yellprogramm_3 (cat "Interner"))

  (set #Color_SLine (cat "Bitte geben sie die Schreibfarbe des Sysops an"))

  (set #Color_ULine (cat "Bitte geben sie die Schreibfarbe des Users an"))

  (set #Yell_Line (cat "Bitte geben sie den Starttext des LINEWizard an:"))
  (set #Yell_Line-help (
     cat
        "Nach dem start des LINEWizards erscheint ein Text bevor der User "
        "bzw. der Sysop schreiben koennen. Dieser sollte ein 'Hallo' fuer "
        "User sein.\n"
        "Normalerweise werden pfiffigere Texte als der Standarttext genommen. "
        "Also der Phantasie sind hier keine Grenzen gesetzt."
  ))

  (set #Yell_Line_ask (cat "Hallo User, der Sysop hat Lust mit dir zu reden..."))

  (set #Line_end (cat "Wollen sie dem User das beenden des LINE Chat`s gestatten"))
  (set #Line_end-help (
     cat
        "Es besteht die moeglichkeit, dem User das selbstaendige beenden des "
        "LINEWizards zu verbieten (CTRL-Q). Beim ANSIWizard ist dies nicht "
        "moeglich. "
  ))
  (set #Line_end_Ja (cat "Ja"))
  (set #Line_end_Nein (cat "Nein"))

  (set #Config_Save (cat "Wollen sie die Config so abspeichern "))
  (set #Config_Save-help (
    cat
       "Die komplett von ihnen eingestellte Configuration wird in das "
       "von ihnen zugewiesene Configurationsdirectory abgespeichert.\n"
       "Spaeter koennen sie Manuell die Configuration veraendern. Wie "
       "das genau geht wird in der beigelegten Anleitung beschrieben. "
  ))

  ; -------------------------
  ; ---  Fehlermeldungen  ---
  ; -------------------------

  (set #Error_Level_1
    (cat     "Ich hoffe das dies nicht zu kompliziert war für sie."
             "Wenn sie noch einige Fragen oder Probleme haben, nehmen"
             "sie am besten Kontakt mit einem TransAmiga Support Board auf."
             "Sollten sie jedoch einen Programmfehler oder ein Problem"
             " haben können sie uns auch Kontaktieren:\n\nDietmar Zettel\n"
             "Fido: 2:246/5004.7 oder"
             "\n\nVolker Braun\nFido 2:xxx/xxx.0"))

  (set #Error_Level_2
    (cat   "Kein Speicherplatz mehr vorhanden. Bitte schliessen sie"
           "ein paar Fenster oder Programme."))

  (set Error_Level_3 (cat "Fehler im Scriptfile !"))
  (set Error_Level_4 (cat "DOS Fehler !"))
  (set Error_Level_5 (cat "Falsche Parameter oder Daten !"))
))

; --------------------------------
; ---   Install Hauptprogramm  ---
; --------------------------------

(message #Intro-Chat)     

(set CHAT_dest
    (askdir
        (prompt #Default_Dir)
        (help
            #Default_Dir-help
        )
        (default @default-dest)
    )
)

(complete 1)

(set Chat_dest_dir (tackon Chat_dest "CHATWizard"))
(makedir Chat_dest_dir)                              ; Directory erstellen
(set @execute-dir (pathonly @icon))                  ; aktueller Pfad
(makeassign "CHATWizard" Chat_dest_dir)              ; Assign setzten

(set Chat_Rexx_dest
    (askdir
        (prompt #Rexx_Dir)
        (help
            #Rexx_Dir-help
        )
        (default "BBS:Rexx")
    )
) ; Set Rexxdirectory

(complete 3)

(set Chat_Config_dest
    (askdir
        (prompt #Config_Dir)
        (help
            #Config_Dir-help
        )
        (default "BBS:Configs")
    )
)

(complete 5)

; ------------------------------------------
; ---  Files copieren ohne Sprachangabe  ---
; ------------------------------------------

(copyfiles
    (prompt "")
    (help "")
    (source (tackon @execute-dir "bin"))
    (dest (tackon Chat_dest_dir "bin"))
    (all)
)

(complete 10)

; -----------------------------------------
; ---  Files copieren mit Sprachangabe  ---
; -----------------------------------------

(set Sprach_Auswahl (askchoice

    (prompt #Sprach_Auswahl_text)
    (help #Sprach_Auswahl_text-help)

    (choices
        #Sprache_1
        #Sprache_2
    )

    (default 0)
    )
)


(if (= Sprach_Auswahl 0)
    (copyfiles
        (prompt "")
        (help "")
        (source (tackon @execute-dir "Docs"))
        (dest (tackon Chat_dest_dir "Docs"))
        (pattern "#?.dok")
    )
)
(if (= Sprach_Auswahl 1)
    (copyfiles
        (prompt "")
        (help "")
        (source (tackon @execute-dir "Docs"))
        (dest (tackon Chat_dest_dir "Docs"))
        (pattern "#?.doc")
    )
)

(complete 14)

(copyfiles
    (prompt "")
    (help "")
    (source (tackon @execute-dir "YellPicture"))
    (dest (tackon Chat_dest_dir "YellPicture"))
    (all)
)

(complete 18)

(if (= Sprach_Auswahl 0)
    (copyfiles
        (prompt "")
        (help "")
        (source (tackon @execute-dir "YellProgramm/Deutsch"))
        (dest (tackon Chat_dest_dir "YellProgramm"))
        (all)
    )
)
(if (= Sprach_Auswahl 1)
    (copyfiles
        (prompt "")
        (help "")
        (source (tackon @execute-dir "YellProgramm/English"))
        (dest (tackon Chat_dest_dir "YellProgramm"))
        (all)
    )
)

(complete 22)

(copyfiles
    (prompt "")
    (help "")
    (source (tackon @execute-dir "Rexx"))
    (dest Chat_rexx_dest)
    (all)
)

(complete 26)


(startup "CHATWizard"
    (help #Shell_Startup_Auswahl-help)
    (prompt #Shell_Startup_Auswahl)
    (command ("ASSIGN >NIL: CHATWizard: %s" Chat_dest_dir))
)

(complete 28)

(set Key_Auswahl (askchoice

    (prompt #Key_Auswahl_text)
    (help #Key_Auswahl_text-help)

    (choices
        "A"
        "C"
        "*"
        "#"
    )

    (default 0)
))  ; Sprachauswahl

(complete 34)

(textfile
    (prompt #Config_Append)
    (help #Config_Append-help)
    (dest (tackon Chat_Config_dest "main.rx"))
    (include (tackon Chat_Config_dest "main.rx"))
    (if (= Key_Auswahl 0)
        (append "A ANSIWizard             000 -------- ANSIWizard.trans\n")
    )
    (if (= Key_Auswahl 1)
        (append "C ANSIWizard             000 -------- ANSIWizard.trans\n")
    )
    (if (= Key_Auswahl 2)
        (append "* ANSIWizard             000 -------- ANSIWizard.trans\n")
    )
    (if (= Key_Auswahl 3)
        (append "# ANSIWizard             000 -------- ANSIWizard.trans\n")
    )

    (confirm)
) ; Configfile von Transamiga verändern

(complete 41)

; ------------------------------
; ---  Configfile erstellen  ---
; ------------------------------

    (message #Config-Chat)

    (complete 44)

    (set Sysop_Name-Chat (askstring
        (prompt #Sysop_Name)
        (help #Sysop_name-help)
        (default "Sysop")
    ))
    (complete 47)
    (set ColorB-Chat (askchoice
        (prompt #Color_Back)
        (help #Color-help)
        (choices
            #Color-schwarz
            #Color-rot
            #Color-gruen
            #Color-gelb
            #Color-blau
            #Color-rosa
            #Color-Tuerk
            #Color-Weiss
        )
        (default 4)
    ))
    (complete 50)
    (set ColorB2-Chat (askchoice
        (prompt #Color_2Back)
        (help #Color-help)
        (choices
            #Color-schwarz
            #Color-rot
            #Color-gruen
            #Color-gelb
            #Color-blau
            #Color-rosa
            #Color-Tuerk
            #Color-Weiss
        )
        (default 0)
    ))
    (complete 55)
    (set ColorF-Chat (askchoice
        (prompt #Color_Forder)
        (help #Color-help)
        (choices
            #Color-schwarz
            #Color-rot
            #Color-gruen
            #Color-gelb
            #Color-blau
            #Color-rosa
            #Color-Tuerk
            #Color-Weiss
        )
        (default 6)
    ))
    (complete 59)
    (set ColorW-Chat (askchoice
        (prompt #Color_Write)
        (help #Color-help)
        (choices
            #Color-schwarz
            #Color-rot
            #Color-gruen
            #Color-gelb
            #Color-blau
            #Color-rosa
            #Color-Tuerk
            #Color-Weiss
        )
        (default 7)
    ))
    (complete 63)
    (set MaxLength-Chat (askstring
        (prompt #Max_Length)
        (help #Max_Length-help)
        (default "28")
    ))
    (complete 66)
    (set Key_Auswahl (askchoice
        (prompt #Yellauswahl)
        (help #Yellauswahl-help)

        (choices
            #Yellprogramm_1
            #Yellprogramm_2
            #Yellprogramm_3
        )
    ))
    (complete 70)
    (if (= Key_Auswahl 0)
      (set Yell-File "YELLFILE CHATWizard:YellProgramm/ChatYell02.prg"))
    (if (= Key_Auswahl 1)
      (set Yell-File "YELLFILE CHATWizard:YellProgramm/ChatYell01.prg"))
    (if (= Key_Auswahl 2)
      (set Yell-File ""))

    (set ColorU-Chat (askchoice
        (prompt #Color_ULine)
        (help #Color-help)
        (choices
            #Color-schwarz
            #Color-rot
            #Color-gruen
            #Color-gelb
            #Color-blau
            #Color-rosa
            #Color-Tuerk
            #Color-Weiss
        )
        (default 3)
    ))
    (complete 74)
    (set ColorS-Chat (askchoice
        (prompt #Color_SLine)
        (help #Color-help)
        (choices
            #Color-schwarz
            #Color-rot
            #Color-gruen
            #Color-gelb
            #Color-blau
            #Color-rosa
            #Color-Tuerk
            #Color-Weiss
        )
        (default 5)
    ))
    (complete 77)
    (set Yell-Chat (askstring
        (prompt #Yell_Line)
        (help #Yell_Line-help)
        (default #Yell_Line_ask)
    ))
    (complete 81)
    (set Key_Auswahl (askchoice
        (prompt #Line_end)
        (help #Line_end-help)

        (choices
            #Line_end_Ja
            #Line_end_Nein
        )
    ))
    (complete 88)
    (set mainconfig (cat "; Configfile for CHATWizard V2.0          (c) 1994 by TFB-Software\n"
                        ";                                                                  \n"
                        "; Written by: Dietmar Zettel                                       \n"
                        ";             Volker Braun                                         \n"
                        ";                                                                  \n"
                        "                                                                   \n"
                        ";                                                                  \n"
                        "; System Funktion                        \n"
                        ";                                                                  \n"
                        "\nSYSOPNAME \""Sysop_Name-Chat"\"\n"
                        "COLORBGROUND "ColorB-Chat
                        "\nCOLORB2GROUND "ColorB2-Chat
                        "\nCOLORFGROUND "ColorF-Chat
                        "\nCOLORWRITE "ColorW-Chat
                        "\nMAXLENGTH "MaxLength-Chat
                        "\n"Yell-File
                        "\n"
                        "\n;\n;Special Funktion for the LINEWizard\n;\n"
                        "\nLINECOLORSYSOP "ColorS-Chat
                        "\nLINECOLORUSER "ColorU-Chat
                        "\nLINEYELLSTRING \""Yell-Chat"\""
                        (if (= Key_Auswahl 0)
                          "\nLINEUSERBREAK\n"
                        )
                    )
    )
    (complete 95)
    (textfile
        (prompt #Config_Save)
        (help #Config_Save-help)
        (dest (tackon Chat_Config_dest "CHATWizard.cfg"))
        (append mainconfig)
        (confirm)
    )


(complete 100)

; -------------------------
; ---  Fehlermeldungen  ---
; -------------------------

(trap 1 (message #Error_Level_1))
(trap 2 (abort #Error_Level_2))
(trap 3 (abort #Error_Level_3))
(trap 4 (abort #Error_Level_4))
(trap 5 (abort #Error_Level_5))

