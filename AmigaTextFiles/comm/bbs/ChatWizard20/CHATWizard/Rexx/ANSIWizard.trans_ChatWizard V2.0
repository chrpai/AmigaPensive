/******************> Startup Script for ANSIWizard V2 <******************/



/*> configuration <******************************************************/

Path   = "ChatWizard:bin/"                        /* path to chat prg    */
Config = "BBS:Configs/CHATWizard.cfg"             /* path to config file */
Modus  = 0                                        /* startup mode        */
ChatM  = 0                                        /* chat if used ASCII  */
Sprache = 1                                       /* language            */

/*>          Please read the manual for further discriptions !          */

/*> end of configuration <***********************************************/


options results

SYSTEMINFO 8 ;line=result
USERINFO   x ;ansi=result

if ansi='ON' then do
  Address Command Path||'ANSIWizard -c'||Config||' -m'||Modus||' -l'||Sprache||' -n'||line
end

if ansi='OFF' then do
  if ChatM=0 then do
    Address Command Path||'LINEWizard -c'||Config||' -n'||line
  end
  else do
    yell
  end
end

/******************************> TFB-Software <****************************/

