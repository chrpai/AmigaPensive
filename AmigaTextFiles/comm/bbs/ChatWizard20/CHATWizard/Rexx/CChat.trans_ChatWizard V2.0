/********************> ChatWizard V2.0 - CChat.trans <**********************/


/***> Mode Setting:  Mode  |  ANSI  |  NOANSI
                    -------+--------+---------
                       0   | AnsiWi | LineWi <default>
                       1   | LineWi | LineWi
                       2   | AnsiWi | Intern
                       3   | LineWi | Intern

*/

 Mode   = 0    /* Mode setting (0/1/2/3) */


/***> ANSIWizard Startup Mode:   Mode | Yell | Splittype
                                ------+------+----------
                                   0  |  xx  | horiz.
                                   1  |  xx  | verti.
                                   2  |      | horiz. <default>
                                   3  |      | verti.
*/

 AMode = 2   /* Startup Mode setting (0/1/2/3) */


/***> Path settings <***/
                                        
 Path   = "ChatWizard:bin/"                    /* Path to Executables  */
 Config = "BBS:Configs/ChatWizard.cfg"         /* Path to Config File  */


              /*  Please refer the manual for more details ! */

/************************> End of configuration <***************************/



options results

systeminfo 8
line = result

userinfo x
ANSI = result

if ANSI = "ON"  & Mode = 0 then call ansiwizard
if ANSI = "ON"  & Mode = 1 then call linewizard
if ANSI = "ON"  & Mode = 2 then call ansiwizard
if ANSI = "ON"  & Mode = 3 then call linewizard
if ANSI = "OFF" & Mode = 0 then call linewizard
if ANSI = "OFF" & Mode = 1 then call linewizard
if ANSI = "OFF" & Mode = 2 then call internal
if ANSI = "OFF" & Mode = 3 then call internal

exit(0)

ansiwizard:
address command Path||"ANSIWizard -c"||Config||" -m"||amode||" -n"||line
exit

linewizard:
address command Path||"LINEWizard -c"||Config||" -n"||line
exit

internal:
yell
exit


/******************************> TFB-Software <****************************/

