; $VER: hardcheker v1.8 installerscript v1.2update
;

(complete 0)

(set prg-version "1.8")

;====================================================================
; Einige Initialisierungen
;====================================================================


(set _prg                               "filechecker/checker")
(set _prg2                              "filechecker/harded")
(set _prg3                              "filechecker/sentby")
(set _prg4                              "c/mpprosp")

(set _text                              "filechecker.guide")
(set destdirc				"c:")

(set #intro
(cat " Dieses Script kopiert das Update v1.8 auf ihre Festplatte. Sie benötigen eine bereits Installierte version (mindestens v1.6)"
))



(set #select_Hadir_help
(cat "Bitte geben sie den pfad zum Checker an."
))

(set #select1_help
(cat "In diesem Menu koennen sie waehlen, ob sie die jeweilige version des programmteiles installieren wollen"
))

(message #intro)

(set destdir
        (askdir
                (prompt "Wohin soll das Update v1.8 kopiert werden? \n")
                (help #select_hadir_help)
                (default "prometheus:extern")
        )
)

(copyfiles
          (prompt "Hardschecker v1.8 kopieren?\n")
          (help "Die alte Checkerversion wird ueberschrieben")
          (source _prg)
          (dest destdir)
          (confirm)
)

(copyfiles
          (prompt "Neue Filechecker.guide kopieren?\n")
          (help "Die alte anleitung wird überschrieben!!")
          (source _text)
          (dest destdir)
 (confirm)
)

(copyfiles
          (prompt "Den Online-Konfig Editor v1.2 kopieren?\n")
          (help "wird zum ändern der einstellungen benötigt")
          (source _prg2)
          (dest destdir)
 (confirm)
)

(copyfiles
          (prompt "Den Sentby-Line Editor v1.3 kopieren?\n")
          (help "wird zum ändern der sentby-line benötigt")
          (source _prg3)
          (dest destdir)
 (confirm)
)

(copyfiles
          (prompt "MPProSP v1.6.3 nach c: kopieren?\n")
          (help "nicht jetzt")
          (source _prg4)
          (dest destdirc)
 (confirm)
)

(set #extro
(cat "Die Installation vom hardchecker "prg-Version" ist nun beendet. Weitere Infos entnehmen sie bitte dem Filechecker.Guide im Verzeichniss "destdir"\n\nBitte starten sie als erstes Online den Hardchecker KonfigEditor um ihre konfig an evntl. Änderungen anzupassen!!"
))

(complete 100)
(message #extro)
