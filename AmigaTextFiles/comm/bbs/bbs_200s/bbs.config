FS_SV_Path=          Path to the Root Directory in File System
FS_SV_Directory=     Root Directory Name in File System
FS_SV_Comment=       Comment to the Directory Name
FS_Security_UL=      Security Level for Upload Files
FS_Security_DL_PF=   Security Level for Download Files and Pack Files

FS_SV_Path_0=GMC-BBS:
