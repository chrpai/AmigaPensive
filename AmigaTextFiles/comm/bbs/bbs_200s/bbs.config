BM_SV_Path=          Path to the Root Directory in Bulletins Menu
BM_SV_Directory=     Root Directory Name in Bulletins Menu
BM_SV_Comment=       Comment to the Directory Name
BM_Security_RB=      Security Level for Read Bulletin

BM_SV_Path_0=GMC-BBS:
