MB_SV_Path=          Path to the Root Directory in Message Board
MB_SV_Directory=     Root Directory Name in Message Board
MB_SV_Comment=       Comment to the Directory Name
MB_Security_RM=      Security Level for Read Message
MB_Security_AM_WM=   Security Level for Answer Message and Write Message

MB_SV_Path_0=GMC-BBS:
MB_SV_Directory_0=Message_Board/
MB_SV_Comment_0=Message Board Area
MB_Security_RM_0=10
MB_Security_AM_WM_0=20

MB_SV_Path_1=
MB_SV_Directory_1=RAM:
