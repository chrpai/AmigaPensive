FS_Security_DL_PF_1=20

FS_SV_Path_2=
FS_SV_Directory_2=RAM:
FS_SV_Comment_2=RAM: ( SysOp only )
FS_Security_UL_2=100
FS_Security_DL_PF_2=100

FS_SV_Path_3=
FS_SV_Directory_3=DH0:
FS_SV_Comment_3=DH0: ( SysOp only )
FS_Security_UL_3=100
FS_Security_DL_PF_3=100

FS_SV_Path_4=
FS_SV_Directory_4=DH1:
FS_SV_Comment_4=DH1: ( SysOp only )
FS_Security_UL_4=100
FS_Security_DL_PF_4=100

