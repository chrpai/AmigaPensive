.key Date
.bra <
.ket >

;FAMEBackUpConfDatas 1.0
;
;Simple FAME BackUp subscript by David Wettig (strider@trsi.de).
;
;Or call it SlaveScript ;))))
;
;This script simply backups the Conferences and Conference Access
;settings of FAME.

;*******************************************************************
;-------------- Conference and ConfAccess data backup --------------
;*******************************************************************

;Create subdirectories
Echo "Creating subdirectories..." NOLINE

;Create subdirectories.
IF NOT EXISTS FAME:BackUp/<Date>/Settings
	MakeDir >NIL: FAME:BackUp/<Date>/Settings
ENDIF
IF NOT EXISTS FAME:BackUp/<Date>/Settings/Conferences
	MakeDir >NIL: FAME:BackUp/<Date>/Settings/Conferences
ENDIF
IF NOT EXISTS FAME:BackUp/<Date>/Settings/Access
	MakeDir >NIL: FAME:BackUp/<Date>/Settings/Access
ENDIF
IF NOT EXISTS FAME:BackUp/<Date>/Settings/Access/Conferences
	MakeDir >NIL: FAME:BackUp/<Date>/Settings/Access/Conferences
ENDIF

;Say done.
Echo "done!"

;Inform about copy process.
Echo ""
Echo "Now copying files..." NOLINE

;Copy Conference settings.
Copy >NIL: FAME:Settings/Conferences/#? FAME:BackUp/<Date>/Settings/Conferences/ ALL
Copy >NIL: FAME:Settings/Access/Conferences/#? FAME:BackUp/<Date>/Settings/Access/Conferences/ ALL

;Inform about copy process.
Echo "done."

;Final words.
Echo ""
IF WARN
	Echo "BackUp not completely successful!"
ELSE
	Echo "BackUp successful!"
ENDIF

