.key Date
.bra <
.ket >

;FAMEBackUpSettings 1.0
;
;Simple FAME BackUp subscript by David Wettig (strider@trsi.de).
;
;Or call it SlaveScript ;))))
;
;This script backups all settings of FAME.
;
;This includes: - FAME:Settings/#? (with subdirectories and their files)
;               - FAME:Modules/#?.dat
;               - FAME:Modules/CoProcessConfig/#? (with subdirectories and their files)
;               - FAME:ExternEnv/#? (with subdirectories and their files)

;*******************************************************************
;-------------- Conference and ConfAccess data backup --------------
;*******************************************************************

;Create subdirectories
Echo "Creating subdirectories..." NOLINE

;Create subdirectories.
IF NOT EXISTS FAME:BackUp/<Date>/Settings
	MakeDir >NIL: FAME:BackUp/<Date>/Settings
ENDIF
IF NOT EXISTS FAME:BackUp/<Date>/Modules
	MakeDir >NIL: FAME:BackUp/<Date>/Modules
ENDIF
IF NOT EXISTS FAME:BackUp/<Date>/Modules/CoProcessConfig
	MakeDir >NIL: FAME:BackUp/<Date>/Modules/CoProcessConfig
ENDIF
IF NOT EXISTS FAME:BackUp/<Date>/ExternEnv
	MakeDir >NIL: FAME:BackUp/<Date>/ExternEnv
ENDIF

;Say done.
Echo "done!"

;Inform about copy process.
Echo ""
Echo "Now copying files..." NOLINE

;Copy Conference settings.
Copy >NIL: FAME:Settings/ FAME:BackUp/<Date>/Settings/ ALL
Copy >NIL: FAME:Modules/#?.dat FAME:BackUp/<Date>/Modules/ ALL
Copy >NIL: FAME:Modules/CoProcessConfig/ FAME:BackUp/<Date>/Modules/CoProcessConfig/ ALL
Copy >NIL: FAME:ExternEnv/ FAME:BackUp/<Date>/ExternEnv/ ALL

;Inform about copy process.
Echo "done."

;Final words.
Echo ""
IF WARN
	Echo "BackUp not completely successful!"
ELSE
	Echo "BackUp successful!"
ENDIF

