; InstallScript for ProPoint Version 2.16

(complete 0)

(if
	(askbool
		(prompt	"Bist Du registriert?")
		(help	"Nix Help...")
	)=0
		(Run "Muchmore Doks/Registrierung.TXT")
		ExtraDir
)

(complete 15)

(set InstallDir
	(askdir
		(prompt "Wohin soll ProPoint kopiert werden?")
		(help "Kopiert ProPoint...")
		(default "Prometheus:Extern/")
	)
)

(complete 25)

(copyfiles
	(prompt "Kopiere ProPoint...")
	(source "ProPoint")
	(dest InstallDir)
	(help "Kopiert ProPoint")
	(infos)
	(noposition)
)

(complete 30)

(set HelpDir
	(askdir
		(prompt "Wohin soll das GuideFile kopiert werden?")
		(help "Kopiert ProPoint..Guide...")
		(default "HELP:Deutsch/")
	)
)
(copyfiles
	(prompt "Kopiere GuideFile nach HELP:Deutsch")
	(source "Doks/ProPoint.Guide")
	(dest HelpDir)
	(help "Kopiert ProPoint.Guide...........")
	(infos)
	(noposition)
)

(complete 50)

(if 
	(askbool
		(prompt "Wenn Du englischsprachige User hast\nund die ProPoint nutzen, kannst Du ein\nenglisches CatalogFile für ProPoint installieren.\nWillst Du diesen installieren?")
		(help "Hierbei handelt es sich um ein echtes CatalogFile, welches mit jedem CatalogEditor verändert werden kann. Dabei ist es egal, ob der Catalog nach 'LOCALE:Catalogs/English/' oder nach 'PROGDIR:Catalogs/English/' kopiert wird!  Empfehlen würde ich aber, der Übersichtlichkeit halber, nach 'PROGDIR:Catalogs/English/' (PROGDIR: ist das Verzeichnis in dem ProPoint sich befindet).")
		(choices "Ja" "Nein")
	)
	(
		(set CTDir
			(askdir
				(prompt "Wohin soll der Catalog kopiert werden?")
				(help "Normalerweise wird der Catalog nach LOCALE: oder ins Progdir: kopiert!")
				(default "LOCALE:Catalogs/English/")
			)
		)
		(copyfiles
			(prompt "Kopiere ProPoint.Catalog " CTDir)
			(source "Catalogs/English/ProPoint.Catalog")
			(dest CTDir)
			(help "Kopiert ProPoint.Catalog..........")
			(infos)
			(noposition)
		)
	)
)

(complete 80)

(set @default-dest InstallDir)

(complete 100)


