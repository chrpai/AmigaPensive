(set @default-dest "Prometheus:")
(transcript "Installation von SlotMachine V1.5")

(set sourc "install/")

(message "\n\n\n\nWillkommen bei der SlotMachine V1.5 Installation.")

(working)

(set desti1
  (askdir
    (prompt "Wo soll SlotMachine installiert werden?\n(Ein Verzeichnis wird erzeugt und enthält SlotMachine.)")
    (default "SkyTools:")
    (help "Wählen Sie hier das Verzeichnis aus, wo Sie SlotMachine und alle benötigten Daten installiert haben möchten. In dem ausgewählten Zielpfad wird ein eigenes Verzeichnis für SlotMachine erzeugt.")
  )
)

(set desti
  (tackon desti1 "SlotMachine")
)

(if (= (exists desti) 0 (makedir desti (infos))))

(complete 30)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "SlotMachine" "Register.txt" "NetzAntrag.txt")
  (source sourc)
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 60)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "SlotMachine.guide")
  (source "")
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 70)

(if
  (askchoice
    (prompt "Haben Sie eine frühere Version von SlotMachine bereits installiert oder ist dies die Erstinstallation?")
    (choices "Update" "Erstinstallation")
    (help "")
  )

  (run (cat (cat sourc "InstallCommand bn=SlotMachine a=\"Run ") (cat desti "/SlotMachine $PO\" k=\"Einarmiger Bandit um Downloadfreiraum!\" sc=4 b e sb"))
    (prompt "\n\n\nSlotMachine wird nun als Befehl in Prometheus eingebaut.")
    (help "SlotMachine wird vollautomatisch in den Befehlseditor von Prometheus eingebaut. Sie brauchen anschließend nur noch die entsprechenden Gruppen einzustellen.")
    (confirm)
  )
)

(complete 100)

(message "\n\nFertig! SlotMachine ist nun sofort spielbar.\n\nAber einen kleinen Blick in die Doku sollten Sie trotzdem werfen.")

(message "\n\n\nDies ist die unregistrierte Version von SlotMachine. Um zu registrieren, schauen Sie bitte in die Anleitung.")

(Message "\n\n\nFür SlotMachine existiert ein Support-Netz, das SkyNetz, in dem Sie Informationen, Hilfestellung, Diskussionen und natürlich die neusten Updates erhalten.")
