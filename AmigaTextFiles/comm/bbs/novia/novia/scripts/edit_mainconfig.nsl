MAINCONFIG = LOADMAINCONFIG()

MENU_MAIN = MENU(MENUTAG_COLS, 2, MENUTAG_AUTOFORMAT,
	FIELD("System Name",					MAINCONFIG->SYSTEMNAME),		NULL,
	PRINT("Registration ID",			MAINCONFIG->REGID),				NULL,
	PRINT("Registration Name",			MAINCONFIG->REGNAME),			NULL,
	PRINT("Registration Location",	MAINCONFIG->REGLOCATION),		NULL,
	PRINT("Registration Voiceno",		MAINCONFIG->REGVOICENUMBER),	NULL,
	PRINT("Registration Modemno",		MAINCONFIG->REGMODEM),			NULL,
	PRINT("Registration EMail",		MAINCONFIG->REGEMAIL),			NULL,
	FIELD("MainPortNumber",				MAINCONFIG->MAINPORTNUMBER),	NULL,
	FIELD("UUCP Domainname",			MAINCONFIG->UUCPDOMAIN),		NULL,
	FIELD("Sysop Account Number",		MAINCONFIG->SYSOPACCOUNTNO),	NULL,
	PRINT("UserIP Counter",				MAINCONFIG->USERIPCOUNTER),	PRINT("Base IP Counter",			MAINCONFIG->BASEIPCOUNTER),
	PRINT("User Accounts",				MAINCONFIG->USERACCOUNTS),		PRINT("Number of Clients",			MAINCONFIG->NUMBEROFCLIENTS),
	PRINT("Sysdir",						MAINCONFIG->SYSDIR),				NULL,
	PRINT("Userdir",						MAINCONFIG->USERDIR),			NULL,
	PRINT("Sysdata",						MAINCONFIG->SYSDATA),			NULL,
	PRINT("Systext",						MAINCONFIG->SYSTEXT),			NULL,
	PRINT("Newuser",						MAINCONFIG->NEWUSER),			NULL,
	LINK("Exit", 							MENU_EXIT),					NULL,
)

MENU_EXIT = MENU(MENUTAG_COLS, 3,
	NULL, NULL, NULL,
	NULL, PRINT("Save changes", NULL), NULL,
	NULL, NULL, NULL,
	RETURN("Yes",		"SAVE"),
	RETURN("No",		"EXIT"),
	LINK("Cancel"							MENU_MAIN)
)


JUMP MENU_MAIN
EXIT