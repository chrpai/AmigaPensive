USER = LOADUSER(ARGSTRING)

MENU_MAIN = MENU(MENUTAG_COLS, 2, MENUTAG_AUTOFORMAT,
	PRINT("User account number",		USER->USERID),				NULL,
	PRINT("User IP number",				USER->USERIP),				NULL,
	NULL,																		NULL,
	LINK("Exit", 							MENU_EXIT),					NULL,
	NULL,																		NULL,
	FIELD("Username",						USER->USERNAME),			NULL,
	FIELD("Realname",						USER->REALNAME),			NULL,
	FIELD("Address",						USER->ADDRESS),			NULL,
	FIELD("City",							USER->CITY),				NULL,
	FIELD("Postal Code",					USER->POSTAL),				FIELD("Phone verification",	USER->PHONEVERIFICATION),
	FIELD("Country",						USER->COUNTRY),			FIELD("Voica phone number#",	USER->VOICENO),
	FIELD("local directory",			USER->LOCALDIR),			FIELD("Modem  data number#",	USER->DATANO),
	FIELD("UUCP username",				USER->UUCPNAME),			FIELD("FAX    data number#",	USER->FAXNO),
	FIELD("UUCP Forward to",			USER->UUCPFWDADDRESS),	FIELD("Sex",							USER->SEX),
	FIELD("Access",						USER->ACCESS),				FIELD("Edit password",			USER->PASSWORD),
	FIELD("Access group",				USER->ACCESSGROUP),		LINK("Credit/balance", 			MENU_CREDIT),
	FIELD("Users Birthday",				USER->BIRTHDAY),			LINK("Netware support",			MENU_NETWORK),
	FIELD("Users first call",			USER->FIRSTCALL),			LINK("Limits/ration flags",	MENU_LIMITS),
	FIELD("Users last call",			USER->LASTCALL),			LINK("Privileg/Security",		MENU_SECURITY),
	NULL,																		LINK("Preferences/term",		MENU_TERM),
	FIELD("Expiration date",			USER->EXPIRATIONDATE),	NULL,
	FIELD("Expiration days",			USER->EXPIRATIONDAYS),	LINK("KILL THIS ACCOUNT",		MENU_KILLACCOUNT),
	FIELD("Banner",						USER->BANNER),				NULL,
)

MENU_CREDIT = MENU(MENUTAG_COLS, 3, MENUTAG_AUTOFORMAT,
	PRINT("User account number",		USER->USERID),				PRINT("Handle",						USER->USERNAME),				NULL,
	PRINT("User IP number",				USER->USERIP),				NULL,																			NULL,
	NULL,																		NULL,																			NULL,
	LINK("Exit",							MENU_EXIT),					FIELD("Can send OLMs",				USER->SENDOLMS),				FIELD("unlimited fi. credits",	USER->UNLIMITFILES),
	LINK("Main menu",						MENU_MAIN),					FIELD("Can send MEGA OLMs",		USER->SENDMEGAOLMS),			FIELD("unlimited by. credits",	USER->UNLIMITBYTES),
	NULL,																		FIELD("Can use broadcast OLM",	USER->BROADCASTOLMS),		FIELD("AutoCallBack @login",		USER->CALLBACK),
	FIELD("SYSTEM OPERATOR",			USER->SYSOP),				FIELD("Can use userchat",			USER->USERCHAT),				FIELD("TimeLock exempt",			USER->TIMELOCK),
	FIELD("Send EMails",					USER->SENDEMAILS),		FIELD("Can use multichat",			USER->MULTICHAT),				FIELD("Add new vote topics",		USER->ADDVOTES),
	FIELD("Receive EMails",				USER->RECEIVEEMAILS),	FIELD("NSL level 1",					USER->NSLLEVEL1),				FIELD("Add new vote choices",		USER->ADDCHOICES),
	FIELD("Set mail expiration",		USER->MAILEXPIRATION),	FIELD("NSL level 2",					USER->NSLLEVEL2),				FIELD("Kill/edit vote topic",		USER->EDITVOTES),
	FIELD("Add mailing list",			USER->ADDMAILINGLIST),	FIELD("Relogin",						USER->RELOGIN),				FIELD("Edit Handle",					USER->EDITHANDLE),
	FIELD("Add msg mailinglist",		USER->CANWRITEMAILLIST) FIELD("Multi login",					USER->MULTILOGIN),			FIELD("Edit name, bday, sex",		USER->EDITNAME),
	TEXT("reserved1"),													TEXT("reserved10"),														FIELD("Edit address, st/zip",		USER->EDITADDRESS),
	TEXT("reserved2"),													FIELD("Alias msg authors",			USER->ALIASMSGS),				FIELD("Edit voice phone#",			USER->EDITVOICENO),
	TEXT("reserved3"),													FIELD("Adopt orphans",				USER->ADOPTORPHANS),			FIELD("Edit data phone#",			USER->EDITDATANO),
	TEXT("reserved4"),													FIELD("Read private msgs",			USER->READPRIVATEMAILS),	FIELD("Edit FAX phone#",			USER->EDITFAXNO),
	TEXT("reserved5"),													FIELD("Kill/Edit any files",		USER->EDITANYFILES),			FIELD("Allow banner",				USER->ALLOWBANNER),
	TEXT("reserved6"),													FIELD("Kill/Edit own files",		USER->EDITOWNFILES),			FIELD("Use TermLink",				USER->USETERMLINK),
	TEXT("reserved7"),													FIELD("Skip file validation",		USER->SKIPFILEVALIDATION),	FIELD("Port monitoring",			USER->PORTMONITOR),
	FIELD("Use Forward mail",			USER->MAILFORWARD),		FIELD("Write anonymously",			USER->WRITEANONYMOUS),		FIELD("Alarm sysop @logon",		USER->ALARMSYSOP),
	TEXT("reserved8"),													FIELD("Trace anonymous",			USER->TRACEANONYMOUS),		FIELD("Open screen @logon",		USER->OPENSCREEN),
	TEXT("reserved9"),													FIELD("Private messages",			USER->WRITEPRIVATEMAILS),	FIELD("Open capture @logon",		USER->CAPTURING),
	TEXT("Use the UserList"),											FIELD("Conference control",		USER->CONFERENCECONTROL),	FIELD("May page the sysop",		USER->SYSOPPAGEING),
)

MENU_LIMITS = MENU(MENUTAG_COLS, 2, MENUTAG_AUTOFORMAT,
	PRINT("User account number",		USER->USERID),				PRINT("Handle",						USER->USERNAME),
	PRINT("User IP number",				USER->USERIP),				NULL,
	NULL,																		FIELD("Costs per call"				USER->COSTSPERDAY				),
	LINK("Exit",							MENU_EXIT),					FIELD("Costs per Minute"			USER->COSTSPERMINUTE			),
	LINK("Main menu",						MENU_MAIN),					FIELD("Costs per KB"					USER->COSTSPERKB				),
	NULL,																		FIELD("Case Zone"						USER->CASEZONE					),
	FIELD("Uploads today",				USER->UPLOADTODAY),		FIELD("Total tele. costs"			USER->TOTALTELCOSTS			),
	FIELD("Uploads this months",		USER->UPLOADMONTH),		FIELD("Total credits"				USER->TOTALCREDITS			),
	FIELD("Total uploads",				USER->TOTALUPLOADS),		FIELD("Public msgs/call"			USER->PUBLICMSGSCALL			),
	FIELD("Downloads today",			USER->DOWNLOADTODAY),	FIELD("Public msgs/day"				USER->PUBLICMSGSDAY			),
	FIELD("Downloads this month",		USER->DOWNLOADMONTH),	FIELD("Public msgs/week"			USER->PUBLICMSGSWEEK			),
	FIELD("Total downloads",			USER->TOTALDOWNLOADS),	FIELD("Public msgs/month"			USER->PUBLICMSGSMONTH		),
	FIELD("Bytes download Today",		USER->BYTESTODAY),		FIELD("Total public msgs"			USER->TOTALPOSTS				),
	FIELD("Bytes download month",		USER->BYTESMONTH),		FIELD("Private msgs/call"			USER->PRIVATEMSGSCALL		),
	FIELD("Total bytes download",		USER->TOTALBYTES),		FIELD("Private msgs/day"			USER->PRIVATEMSGSDAY			),
	FIELD("Byte credits",				USER->BYTECREDITS),		FIELD("Private msgs/week"			USER->PRIVATEMSGSWEEK		),
	FIELD("File credits",				USER->FILECREDITS),		FIELD("Private msgs/month"			USER->PRIVATEMSGSMONTH		),
	FIELD("Calls today",					USER->CALLSTODAY),		FIELD("Total private msgs"			USER->TOTALEMAILS				),
	FIELD("Time today",					USER->TIMETODAY),			FIELD("OLMs per call"				USER->OLMSCALL					),
	FIELD("Total Time",					USER->TIMETOTAL),			FIELD("OLMs per day"					USER->OLMSDAY					),
	NULL,																		FIELD("OLMs per week"				USER->OLMSWEEK					),
	NULL,																		FIELD("OLMs per month"				USER->OLMSMONTH				),
	NULL,																		FIELD("Total OLMs"					USER->TOTALOLMS),


)
	
MENU_SECURITY = MENU(MENUTAG_COLS, 2, MENUTAG_AUTOFORMAT,
	PRINT("User account number",		USER->USERID),				PRINT("Handle",						USER->USERNAME),
	PRINT("User IP number",				USER->USERIP),				NULL,
	NULL,																		NULL,
	LINK("Exit",							MENU_EXIT),					NULL,
	LINK("Main menu",						MENU_MAIN),					NULL,
	NULL,																		NULL,
	FIELD("Network aliases",			USER->NETWORKALIASES),	FIELD("Calls/day",					USER->CALLSPERDAY),
	FIELD("File credit ratio 1",		USER->FILECREDITRATIO1),FIELD("Min per call",				USER->MINSPERCALL),
	FIELD("Byte credit ratio 1",		USER->BYTECREDITRATIO1),FIELD("Mins per day",				USER->MINSPERDAy),
	FIELD("File credit ratio 2",		USER->FILECREDITRATIO2),FIELD("Mins idle",					USER->MINSIDLE),
	FIELD("Byte credit ratio 2",		USER->BYTECREDITRATIO2),FIELD("Messages/call",				USER->MSGSPERCALL),
	FIELD("File credit ratio 3",		USER->FILECREDITRATIO3),FIELD("Feedback per call",			USER->FBPERCALL),
	FIELD("Byte credit ratio 3",		USER->BYTECREDITRATIO3),FIELD("Editor lines",				USER->EDITORLINES),
	FIELD("File credit ratio 4",		USER->FILECREDITRATIO4),FIELD("Maximum emails",				USER->MAXEMAILS),
	FIELD("Byte credit ratio 4",		USER->BYTECREDITRATIO4),FIELD("Inactivity days",			USER->INACTIVDAYS),
	FIELD("File credit ratio 5",		USER->FILECREDITRATIO5),FIELD("Lines per signature",		USER->LINESPERSIG),
	FIELD("Byte credit ratio 5",		USER->BYTECREDITRATIO5),FIELD("Daily pfile minutes",		USER->DAILYPFILESMIN),
	FIELD("File credit ratio 6",		USER->FILECREDITRATIO6),FIELD("Send log to user#",			USER->SENDLOGTOUSER),
	FIELD("Byte credit ratio 6",		USER->BYTECREDITRATIO6),NULL
)

MENU_TERM = MENU(MENUTAG_COLS, 2, MENUTAG_AUTOFORMAT,
	PRINT("User account number",		USER->USERID),				PRINT("Handle",						USER->USERNAME),
	PRINT("User IP number",				USER->USERIP),				NULL,
	NULL,																		NULL,
	LINK("Exit",							MENU_EXIT),					NULL,
	LINK("Main menu",						MENU_MAIN),					NULL,
	NULL,																		NULL,
	FIELD("Logon macro",					USER->LOGONMACRO),		NULL,
	FIELD("Control-E macro",			USER->CTRLEMACRO),		NULL,
	FIELD("Control-F macro",			USER->CTRLFMACRO),		FIELD("Private Name",				USER->PRIVATENAME),
	FIELD("Respose pausing",			USER->RESPOSEPAUSING),	FIELD("Private Age",					USER->PRIVATEAGE),
	FIELD("Default protocol",			USER->TRANSFERPROTOCOL) FIELD("Private Address",			USER->PRIVATENAME),
	FIELD("Help level",					USER->HELPLEVEL),			FIELD("Private Voice",				USER->PRIVATEVOICE),
	FIELD("Time format",					USER->TIMEFORMAT),		FIELD("Private Data",				USER->PRIVATEDATA),
	FIELD("Date format",					USER->DATEFORMAT),		FIELD("Private FAX",					USER->PRIVATEFAX),
	FIELD("Text locale",					USER->LOCALE),				FIELD("Yank ARCHIVE method",		USER->ARCMETHOD),
	FIELD("Yank EOL sequence",			USER->EOLSEQUENCE),		FIELD("Graphics set",				USER->GRAPHICSSET),
	FIELD("Computer type",				USER->COMPUTERTYPE),		FIELD("Time zone",					USER->TIMEZONE),
	FIELD("Auto hide/muffle",			USER->AUTOHIDE),			FIELD("Mail box forward to",		USER->MAILFORWARD),
	FIELD("Mail box open",				USER->MAILBOXOPEN),		FIELD("Mail copy forward to",		USER->MAILCOPY),
	NULL,																		FIELD("Forward uucp-mails to",	USER->UUCPFWDADDRESS),
	FIELD("ANSI support",				USER->ANSISUPPORT),		FIELD("ANSI tabs",					USER->ANSITABS),
	FIELD("ANSI colors",					USER->ANSICOLORS),		FIELD("Line feeds",					USER->LINEFEEDS),
	FIELD("Screen width",				USER->SCREENWIDTH),		FIELD("Screen height",				USER->SCREENHEIGHT),
)

MENU_EXIT = MENU(MENUTAG_COLS, 3,
	NULL, NULL, NULL,
	NULL, PRINT("Save changes", NULL), NULL,
	NULL, NULL, NULL,
	RETURN("Save",		TRUE),
	RETURN("Exit without save",		FALSE),
	LINK("Cancel"							MENU_MAIN)
)


JUMP MENU_MAIN

IF MENU_EXIT = TRUE THEN SAVEUSER(USER)

EXIT