ENTRY = LOADCOMMANDENTRY(ARGSTRING)

MENU_MAIN = MENU(MENUTAG_COLS, 2, MENUTAG_AUTOFORMAT,
	RETURN("Save",		TRUE),									RETURN("Exit without save",		FALSE),
	NULL,																NULL,
	PRINT("IDNumber",				ENTRY->IDNUMBER),			PRINT("Serial IP",			ENTRY->IPNUMBER),
	FIELD("Title",					ENTRY->TITLE),				NULL,
	FIELD("Filename",				ENTRY->FILENAME),			NULL,
	FIELD("Comment",				ENTRY->COMMENT),			NULL,
	FIELD("Size",					ENTRY->SIZE), 				FIELD("Blocks",				ENTRY->NUMBEROFBLOCKS),
	FIELD("Protection",			ENTRY->PROTECTION),		NULL,
	FIELD("UserID",				ENTRY->UID),				FIELD("GroupID",				ENTRY->GID),
	FIELD("LastChange",			ENTRY->LASTCHANGE),		FIELD("by User",				ENTRY->LASTCHANGEUSERIP), 
	FIELD("Send Date",			ENTRY->SENDDATE), 		FIELD("by User",				ENTRY->CREATEUSERIP),
	FIELD("Create From",			ENTRY->FROM),				FIELD("Create RealName",	ENTRY->FROMREALNAME),
	FIELD("Alias",					ENTRY->ALIAS),				NULL,
	FIELD("Version",				ENTRY->VERSION), 			FIELD("Arc transform",		ENTRY->ARCTRANSFORM), 
	FIELD("Expiration Date",	ENTRY->EXPIRATIONDATE), FIELD("Expiration Days",	ENTRY->EXPIRATIONDAYS), 
	FIELD("Network Type",		ENTRY->NETWORKTYPE),		NULL,
	FIELD("Internal CMD",		ENTRY->INTERNAL),			FIELD("Internal CMD-ID",	ENTRY->COMMANDID), 
	FIELD("Deleted",				ENTRY->DELETED),			FIELD("Closed",				ENTRY->CLOSED),
	FIELD("Defauld Droped",		ENTRY->DEFDROPED),		FIELD("No Items",				ENTRY->NOITEMS),
	FIELD("Access",				ENTRY->ACCESSLEVEL),		FIELD("Post Access",			ENTRY->POSTACCESS),
	FIELD("Upload Access",		ENTRY->UPLOADACCESS),	FIELD("Download Access",	ENTRY->DOWNLOADACCESS),
	FIELD("Reply Access",		ENTRY->REPLYACCESS),		FIELD("Computertype",		ENTRY->COMPUTERTYPES),
	FIELD("Mins. enter",			ENTRY->MINENTER),			FIELD("Max Mins",				ENTRY->MAXMINS),
	FIELD("Youngest",				ENTRY->YOUNGEST),			FIELD("Oldest",				ENTRY->OLDEST),
	FIELD("Gender",				ENTRY->GENDER),			NULL,
	FIELD("Realnames",			ENTRY->REALNAMES),		FIELD("Private msgs.",		ENTRY->PRIVATEMAILS),
	FIELD("Anonymous",			ENTRY->ANONYMOUS),		NULL,
	FIELD("No signatures",		ENTRY->NOSIGNATURES),	FIELD("Overwrite",			ENTRY->OVERRIDE),
	FIELD("Down Bytes",			ENTRY->DOWNBYTES),		FIELD("Down Files",			ENTRY->DOWNFILES),
	FIELD("Free Days",			ENTRY->FREEDAYS),			NULL,
	FIELD("Time Credit",			ENTRY->TIMECREDIT),		NULL,
)

JUMP MENU_MAIN

IF MENU_MAIN = TRUE THEN SAVECOMMANDENTRY(ENTRY)

EXIT