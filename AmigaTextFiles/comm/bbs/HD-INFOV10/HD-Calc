Start:

Options Results
transmit "\f1\z4\c6 Hard-Drive Information Calculator \q1"
transmit "\z4\c6         V1.0 by Blowfly           \q1\n1 "
transmit "Which value do you need  ?\n1 "
transmit "\z4\c6 1: Cylinders    2: Heads    \q1"
transmit "\z4\c6 3: Sectors      4: Capacity \q1"
query "\q1\n1Which value \c4[\c61,2,3 or 4\c4]\q1? " ; va = result
If va = 1 then do
query "\n1How many Heads     ? " ; heads = result
query "How many Sectors   ? " ; secs = result
query "Capacity (in MB)   ? " ; cap = result
cap = cap * 1000000
cyl = cap / (heads * secs * 512)
transmit "This drive has \z4\c6"abs(cyl)"\q1 cylinders !"; End
If va = 2 then do
query "\n1How many Cylinders ? " ; cyl = result
query "How many Sectors   ? " ; secs = result
query "Capacity (in MB)   ? " ; cap = result
cap = cap * 1000000
heads = cap / (cyl * secs * 512)  
transmit "This drive has \z4\c6"left(heads,3)"\q1 Heads ! "; End
If va = 3 then do
query "\n1How many Cylinder ? " ; cyl = result
query "How many Heads    ? " ; heads = result
query "Capacity (in MB)  ? " ; cap = result
cap = cap * 1000000
secs = cap / (heads * cyl * 512) 
transmit "\n1This drive has \z4\c6"left(secs,2)"\q1 Sectors ! "; end
If va = 4 then do
query "\n1How many Cylinders ? " ; cyl = result
query "How many Heads     ? " ; heads = result
query "How many Sectors   ? " ; secs = result
cap = heads * secs * 512 * cyl
cap1 = cap / 1000000
Transmit "The capacity of this drive is :\z4\c6"left(cap1,6)"\q1 MB or \z4\c6"cap"\q1 KB"  ; end
Sendstring "\n1Again \c4[\c6Y/N\c4]\q1?"
getchar ; xx=upper(result)
if xx ~="Y" then do exit ; end ; call start