; BUBBLES
;
IDL_HELP_SYSOPNAME (//)
Place here\nyour name
;
IDL_HELP_ENABLEHTTP (//)
Enable WWW pages
;
IDL_HELP_ENABLEFTP (//)
Enable FTP
;
IDL_HELP_ENABLEIRC (//)
Enable IRC
;
IDL_HELP_ENABLEMAIL (//)
Enable Mail
;
IDL_HELP_SERVERIP (//)
IP Address of your server.\nPlace here a string as:\n130.240.230.1
;
IDL_HELP_CLIENTIP (//)
IP Address of the user.\nPlace here a string as:\n130.240.230.2
;
IDL_HELP_MAINSERVERNAME (//)
Left part of the\nserver address
;
IDL_HELP_HTTPSERVERNAME (//)
Left part of the\nHTTP address
;
IDL_HELP_FTPSERVERNAME (//)
Left part of the\nFTP address
;
IDL_HELP_DOMAIN (//)
Right part of\nyour addresses
;
IDL_HELP_DEVICE (//)
Device used to access\nyour serial port
;
IDL_HELP_UNIT (//)
Device unit\nto be used
;
