##INFO_INTROLINE
Download
##MSG_MERKEN
$(NORMAL)Folgende Nachrichten sind gemerkt:$(NORMAL)\n
$(UNDERLINE) Nr. Brett                                   Bytes Filename      $(NORMAL)\n
##MSG_NEWS
$(NORMAL)$(COL{3})%4ld %-35.35s %9ld $(BOLD)$(COL{5})%-15.15s\n
##MSG_DOWNLOAD
$(NORMAL)Schicke File Nr. %ld.\n
##MSG_NOMERKEN
$(NORMAL)\n$(COL{1})Keine Files gemerkt ( Merken mit $(BOLD)MERKEN$(NORMAL)$(COL{1}) )\n\n
##MSG_DOWNLOADJN
$(NORMAL)Download? ($(BCOL{4})$(BOLD)j$(NORMAL)$(BCOL{0}))a, ($(BCOL{4})$(BOLD)N$(NORMAL)$(BCOL{0}))ein, ($(BCOL{4})$(BOLD)L$(NORMAL)$(BCOL{0}))öschen.
##MSG_LOGOUT
$(NORMAL)Nach dem Download Verbindung beenden? ($(BCOL{4})$(BOLD)j$(NORMAL)$(BCOL{0}))a, ($(BCOL{4})$(BOLD)N$(NORMAL)$(BCOL{0}))ein.
##MSG_DELETE
$(NORMAL)Löschen. Nummern:
##MSG_RATIO
$(NORMAL)$(COL{1})$(BOLD)Für diesen Download reichen deine freien Files nicht.$(NORMAL)\n
##MSG_SIZE
$(NORMAL)$(COL{5})Insgesamt gemerkt: $(COL{3})$(BOLD)%ld Bytes.\n
