; - restore the last installation -------------------------------------------

(procedure RESTORE

	(message #str_info_restore
		(all)
	)

; restore main-files

	(if (exists (tackon #backup #src_main))
		(copyfiles
			(prompt #str_restore)
			(help @copyfiles-help)
			(source (tackon #backup #src_main))
			(dest #dst_main)
			(all)
			(confirm)
		)
	)

; restore preferences

	(if (exists #backup_prefs)
		(copyfiles
			(prompt #str_restore)
			(help @copyfiles-help)
			(source #backup_prefs)
			(dest #dst_prefs)
			(all)
			(infos)
			(confirm)
		)
	)

; restore catalogs

	(if (exists #backup_catalog)
		(copyfiles
			(prompt #str_restore)
			(help @copyfiles-help)
			(source #backup_catalog)
			(dest #dst_catalog)
			(all)
			(confirm)
		)
	)

; restore docs

	(if (exists #backup_doc)
		(copyfiles
			(prompt #str_restore)
			(help @copyfiles-help)
			(source #backup_doc)
			(dest #dst_doc)
			(all)
			(infos)
			(confirm)
		)
	)

; replace the batches

	(if (exists (tackon #backup_first #src_batch))
		(copyfiles
			(prompt #ask_rep_newbatch)
			(help @copyfiles-help)
			(source (tackon #backup #src_batch))
			(dest #dst_batch)
			(all)
			(confirm)
		)
	)
)

; - uninstall filecheck -----------------------------------------------------

(procedure UNINSTALL

	(message #str_info_uninst1
		(all)
	)

	(DELETEALL)

; replace the batches

	(if (exists (tackon #backup_first #src_batch))
		(copyfiles
			(prompt #ask_rep_oldbatch)
			(help @copyfiles-help)
			(source (tackon #backup_first #src_batch))
			(dest #dst_batch)
			(all)
			(confirm)
		)
	)

; delete backup dirs

	(if (exists #backup_save)
		(delete #backup_save
			(prompt (cat (cat #ask_deldir1 #backup_save) #ask_deldir2))
			(help @delete-help)
			(all)
			(confirm)
		)
	)

	(if (exists #backup)
		(delete #backup
			(prompt (cat (cat #ask_deldir1 #backup) #ask_deldir2))
			(help @delete-help)
			(all)
			(confirm)
		)
	)

	(if (exists #backup_first)
		(delete #backup_first
			(prompt (cat (cat #ask_deldir1 #backup_first) #ask_deldir2))
			(help @delete-help)
			(all)
			(confirm)
		)
	)

	(message #str_info_uninst2
		(all)
	)
)

