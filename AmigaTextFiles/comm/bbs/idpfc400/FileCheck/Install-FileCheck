; ===========================================================================

; - delay xx seconds --------------------------------------------------------

(procedure DELAY #secs
	(run (cat "Wait " #secs))
)

; - check if amms has already started ---------------------------------------

(procedure CHECKAMMSUP
	(= (run #cl_check_amms) 0)
)

; - get version and check if to old -----------------------------------------

(procedure GETVER

	(set #ver 0)
	(set #rev 0)

	(if (exists (tackon #dst_main "FileCheck"))
		(
			(set #fu_ver (getversion (tackon #dst_main "FileCheck")))
			(set #ver (/ #fu_ver 65536))
			(set #rev (- #fu_ver (* #ver 65536)))
		)		
	)

	(if (< #ver 4)
		(
			(abort #str_info_noupdate)
		)
	)
)

; - backup the last installation --------------------------------------------

(procedure BACKUP #mode

	(message #str_info_backup
		(all)
	)

; delete the old backup-dir, copy the current backup-dir to the old
; backup-dir and create a new-backup-dir

	(delete #backup_save)
	(rename #backup #backup_save)
	(makedir #backup)

; copy main-files to the backup-dir

	(makedir #backup_main)

	(if (exists #dst_main)
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source #dst_main)
			(dest #backup_main)
			(all)
		)
	)

; copy preferences to the backup-dir

	(makedir #backup_prefs)

	(if (exists (tackon #dst_prefs #src_name_prefs))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (tackon #dst_prefs #src_name_prefs))
			(dest #backup_prefs)
			(pattern "#?")
			(files)
			(infos)
		)
	)

	(if (exists (cat #dst_prefs ".info"))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (cat #dst_prefs ".info"))
			(dest (tackon #backup_prefs "/"))
			(pattern "#?")
			(files)
		)
	)

; copy catalogs to the backup-dir

	(makedir (tackon #backup_catalog @language))

	(if (exists (tackon (tackon #dst_catalog @language) #src_name_catalog))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (tackon (tackon #dst_catalog @language) #src_name_catalog))
			(dest (tackon #backup_catalog @language))
			(pattern "#?")
			(files)
		)
	)

; copy docs to the backup-dir

	(makedir #backup_doc)
	(makedir #backup_doc_data)

	(if (exists #dst_doc_data)
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source #dst_doc_data)
			(dest #backup_doc_data)
			(pattern "#?")
			(files)
		)
	)

	(if (exists (tackon #dst_doc #dst_doc_main))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (tackon #dst_doc #dst_doc_main))
			(dest #backup_doc)
			(pattern "#?")
			(files)
			(infos)
		)
	)

	(if (exists (tackon #dst_doc #dst_doc_prefs))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (tackon #dst_doc #dst_doc_prefs))
			(dest #backup_doc)
			(pattern "#?")
			(files)
			(infos)
		)
	)

	(if (exists (cat #dst_doc ".info"))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (cat #dst_doc ".info"))
			(dest (tackon #backup_doc "/"))
			(pattern "#?")
			(files)
		)
	)

; copy batches to the backup-dir

	(makedir (tackon #backup_batch #src_name_upload))

	(if (exists (tackon #dst_batch #src_name_upload))
		(copyfiles
			(prompt #str_backup)
			(help @copyfiles-help)
			(source (tackon #dst_batch #src_name_upload))
			(dest (tackon #backup_batch #src_name_upload))
			(all)
		)
	)

	(if (AND (= #mode #mode_new) (NOT (exists #backup_first)))
		(
			(copyfiles
				(prompt #str_backup)
				(help @copyfiles-help)
				(source #backup)
				(dest #backup_first)
				(all)
			)
		)
	)
)

; - delete all old files ----------------------------------------------------

(procedure DELETEALL

; delete main-files

	(delete #dst_main
		(all)
	)

; delete preferences

	(delete (tackon #dst_prefs #src_name_prefs)
		(infos)
	)

; delete catalogs

	(delete (tackon (tackon #dst_catalog @language) #src_name_catalog))

; delete docs

	(delete #dst_doc_data
		(all)
	)

	(delete (tackon #dst_doc #dst_doc_main)
		(infos)
	)

	(delete (tackon #dst_doc #dst_doc_prefs)
		(infos)
	)
)

; - install filecheck -------------------------------------------------------

(procedure INSTALL

; copy filecheck-mainfiles

	(makedir #dst_main)
	(copyfiles
		(prompt #str_inst_main)
		(help @copyfiles-help)
		(source #src_main)
		(dest #dst_main)
		(pattern "#?")
		(files)
		(confirm)
	)

	(copyfiles
		(prompt #str_inst_config)
		(help @copyfiles-help)
		(source #src_main_config)
		(dest #dst_main_config)
		(pattern "#?")
		(files)
		(confirm)
	)

	(copyfiles
		(prompt #str_inst_define)
		(help @copyfiles-help)
		(source #src_main_define)
		(dest #dst_main_define)
		(pattern "#?")
		(files)
		(confirm)
	)

	(copyfiles
		(prompt #str_inst_language)
		(help @copyfiles-help)
		(source #src_main_language)
		(dest #dst_main_language)
		(pattern "#?")
		(files)
		(confirm)
	)

; copy example-batches for filecheck

	(copyfiles
		(prompt #str_inst_batch)
		(help @copyfiles-help)
		(source #src_batch)
		(dest #dst_batch)
		(all)
		(confirm)
	)

; copy prefs-programm

	(copyfiles
		(prompt #str_inst_prefs)
		(help @copyfiles-help)
		(source #src_prefs)
		(dest #dst_prefs)
		(pattern "#?")
		(files)
		(infos)
		(confirm)
	)

; copy catalogs for the prefs-programm

	(copyfiles
		(prompt #str_inst_catalog)
		(help @copyfiles-help)
		(source #src_catalog)
		(dest #dst_catalog)
		(all)
		(confirm)
	)

; copy documentations

	(copyfiles
		(prompt #str_inst_doc)
		(help @copyfiles-help)
		(source (tackon #src_doc #src_doc_main))
		(dest #dst_doc)
		(newname #dst_doc_main)
		(pattern "#?")
		(files)
		(infos)
		(confirm)
	)

	(copyfiles
		(prompt #str_inst_doc)
		(help @copyfiles-help)
		(source (tackon #src_doc #src_doc_prefs))
		(dest #dst_doc)
		(newname #dst_doc_prefs)
		(pattern "#?")
		(files)
		(infos)
		(confirm)
	)

	(if (exists #dst_doc)
		(copyfiles
			(prompt #str_inst_doc_data)
			(help @copyfiles-help)
			(source #src_doc_data)
			(dest #dst_doc_data)
			(pattern "#?")
			(files)
			(confirm)
		)
	)

; copy fonts

	(copyfiles
		(prompt #str_inst_font)
		(help @copyfiles-help)
		(source #src_font)
		(dest #dst_font)
		(all)
		(fonts)
		(confirm)
	)

; copy additional commands

	(copyfiles
		(prompt #str_inst_command)
		(help @copyfiles-help)
		(source #src_command)
		(dest #dst_command)
		(pattern "#?")
		(files)
		(confirm)
	)

; install the batch-commands

	(set #quest
		(askbool
			(prompt #ask_inst_amms)
			(help @askbool-help)
		)
	)

	(if #quest
		(
			(set #i 0)

			(if (NOT (CHECKAMMSUP))
				(
					(set #name_port
						(askstring
							(prompt #ask_amms_start)
							(help @askstring-help)
							(default #name_amms)
						)
					)

					(working #str_run_amms)
					(set @execute-dir (pathonly #name_amms))
					(execute #name_amms)

					(while (AND (NOT (CHECKAMMSUP)) (< #i 30))
						(DELAY 1)
						(set #i (+ #i 1))
					)
				)
			)

			(if (CHECKAMMSUP)
				(
; copy comtab-files

					(copyfiles
						(prompt #str_inst_amms)
						(help @copyfiles-help)
						(source #src_comtab)
						(dest #dst_comtab)
						(pattern "#?")
						(files)
					)

; ask for port + username and join the command-line

					(set #name_port
						(askstring
							(prompt #ask_port)
							(help @askstring-help)
							(default #name_port)
						)
					)

					(set #name_user
						(askstring
							(prompt #ask_user)
							(help @askstring-help)
							(default #name_user)
						)
					)

					(working #str_inst_amms)

					(set #cl_inst_amms
					(cat #cl_inst_amms1
					(cat #name_port
					(cat #cl_inst_amms2
					(cat #name_user
					(cat #cl_inst_amms3))))))

; install comtab-files and if fail display a error-message

					(if (NOT (= (run #cl_inst_amms) 0))
						(message #err_inst_amms
							(all)
						)
					)

					(delete #dst_comtab
						(all)
					)
				)
			)
		)
	)
)

