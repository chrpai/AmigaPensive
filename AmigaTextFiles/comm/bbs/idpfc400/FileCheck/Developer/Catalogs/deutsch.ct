\033cWählt die zu bearbeitende\n\
FileBatch aus.
;
MSG_BH_CH_batch_check
\033cPrüft Dateien auf Fehler.
;
MSG_BH_CH_batch_add
\033cHängt Werbung an die Dateien.
;
MSG_BH_CH_batch_strip
\033cLöscht Werbung aus Dateien.
;
MSG_BH_CH_batch_diz
\033cExtrahiert die File_ID.
;
MSG_BH_CH_batch_convert
