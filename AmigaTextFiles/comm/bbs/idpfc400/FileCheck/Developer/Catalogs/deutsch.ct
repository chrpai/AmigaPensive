;
MSG_BH_CH_batch_save
\033cSpeichert die File_ID zurück.
;
MSG_BH_CH_batch_exdiz
\033cBenutzt eine externe File_ID, wenn\n\
in der Datei keine gefunden wurde.
;
MSG_BH_CH_batch_cstrip
\033cLöscht Zeichen aus der File_ID.
;
MSG_BH_CH_batch_ladd
\033cHängt eine Zeile an die File_ID an.
;
MSG_BH_CH_batch_lstrip
\033cLöscht Zeilen aus der File_ID.
;
MSG_BH_CH_batch_dup
\033cSucht nach doppelten Dateien.
;
MSG_BH_CH_batch_tdup
\033cBenutzt den TurboModus zur Suche\n\
von doppelten Dateien.
;
MSG_BH_CH_batch_move
\033cVerschiebt Dateien zum\n\
Sysop-Verzeichnis, wenn\n\
Fehler auftreten.
;
MSG_BH_CH_batch_lha
\033cErlaubt oder verbietet\n\
LHA-Dateien.
;
MSG_BH_CH_batch_lzx
\033cErlaubt oder verbietet\n\
LZX-Dateien.
;
MSG_BH_CH_batch_zip
\033cErlaubt oder verbietet\n\
ZIP-Dateien.
;
MSG_BH_CH_batch_arj
\033cErlaubt oder verbietet\n\
ARJ-Dateien.
;
MSG_BH_CH_batch_rar
\033cErlaubt oder verbietet\n\
RAR-Dateien.
;
MSG_BH_CH_batch_dms
