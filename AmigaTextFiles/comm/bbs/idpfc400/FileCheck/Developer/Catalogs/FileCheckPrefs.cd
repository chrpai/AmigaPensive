\033cActivate LHA-files.
;
MSG_BH_CH_batch_lzx (//)
\033cActivate LZX-files.
;
MSG_BH_CH_batch_zip (//)
\033cActivate ZIP-files.
;
MSG_BH_CH_batch_arj (//)
\033cActivate ARJ-files.
;
MSG_BH_CH_batch_rar (//)
\033cActivate RAR-files.
;
MSG_BH_CH_batch_dms (//)
\033cActivate DMS-files.
;
MSG_BH_CH_batch_gif (//)
\033cActivate GIF-files.
;
MSG_BH_CH_batch_jpg (//)
\033cActivate JPG-files.
