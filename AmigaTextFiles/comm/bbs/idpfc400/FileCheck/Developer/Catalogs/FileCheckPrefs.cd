;
MSG_BH_CH_batch_strip (//)
\033cStrip something out of the files.
;
MSG_BH_CH_batch_diz (//)
\033cExtract the File_ID.
;
MSG_BH_CH_batch_convert (//)
\033cConvert the File_ID.
;
MSG_BH_CH_batch_save (//)
\033cSave the File_ID back.
;
MSG_BH_CH_batch_exdiz (//)
\033cUse an external File_ID,\n\
if no File_ID exists.
;
MSG_BH_CH_batch_cstrip (//)
\033cStrip chars out of File_IDs.
;
MSG_BH_CH_batch_ladd (//)
\033cAdd a line to the File_ID.
;
MSG_BH_CH_batch_lstrip (//)
\033cStrip a line out of the File_ID.
;
MSG_BH_CH_batch_dup (//)
\033cCheck for duplicates.
;
MSG_BH_CH_batch_tdup (//)
\033cUse the TurboMode for the\n\
duplicate-checker.
;
MSG_BH_CH_batch_move (//)
\033cMove files to the Sysop-Dir, if\n\
there are some errors.
;
