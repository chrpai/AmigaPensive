MSG_BH_PA_advert_lhalzx (//)
\033cSelect a file or pattern\n\
for LHA/LZX adverts.
;
MSG_BH_PA_advert_zip (//)
\033cSelect a file or pattern\n\
for ZIP adverts.
;
MSG_BH_PA_advert_zipcom (//)
\033cSelect a file for\n\
ZIP comments.
;
MSG_BH_PA_advert_txtfront (//)
\033cSelect a file for the\n\
top of the text.
;
MSG_BH_PA_advert_txtend (//)
\033cSelect a file for the\n\
end of the text.
;
MSG_BH_CH_advert_lhalzx (//)
\033cEnable or disable\n\
LHA/LZX adverts.
;
MSG_BH_CH_advert_zip (//)
\033cEnable or disable\n\
ZIP adverts.
;
MSG_BH_CH_advert_zipcom (//)
\033cEnable or disable\n\
ZIP comments.
;
MSG_BH_CH_advert_txtfront (//)
\033cEnable or disable adverts\n\
for the top of the text.
;
MSG_BH_CH_advert_txtend (//)
\033cEnable or disable adverts\n\
for the end of the text.
;
MSG_BH_STR_fileid_ladd (//)
\033cDefine a line which will\n\
be add to the file_id.
;
MSG_BH_STR_fileid_cstrip (//)
\033cDefine chars which will\n\
be stripped out of file_ids.\n\
\n\
Example: 13 42\n\
will strip CR and *.
;
MSG_BH_STR_fileid_amicon (//)
\033cDefine chars which will be convert\n\
in file_ids saved with a amiga.\n\
\n\
Example: 65=97 66=98\n\
will convert A->a and B->b.
;
MSG_BH_STR_fileid_ibmcon (//)
\033cDefine chars which will be convert\n\
in file_ids saved with a pc.\n\
\n\
Example: 65=97 66=98\n\
will convert A->a and B->b.
;
MSG_BH_CH_fileid_ladd (//)
\033cEnable or disable line-adds\n\
for file_ids.
;
MSG_BH_CH_fileid_cstrip (//)
\033cEnable or disable chars which will be\n\
stripped out of file_ids.
;
MSG_BH_CH_fileid_amicon (//)
\033cEnable or disable chars which will\n\
be converted in amiga-file_ids.
;
MSG_BH_CH_fileid_ibmcon (//)
\033cEnable or disable chars which will\n\
be converted in pc-file_ids.
;
MSG_BH_BT_fileid_lstrip (//)
\033cEdit the lines which will be\n\
stripped out of file_ids.
;
MSG_BH_BT_board_noadd (//)
\033cEdit the boards where FileCheck\n\
add nothing to the files.
;
MSG_BH_BT_board_nodup (//)
\033cEdit the boards where FileCheck\n\
don't check for duplicate files.
;
MSG_BH_BT_board_nostrip (//)
\033cEdit the boards where FileCheck\n\
don't strip files.
;
MSG_BH_BT_user_nodup (//)
\033cEdit the user where FileCheck\n\
don't check for duplicates.
;
MSG_BH_CH_mapusadd_front (//)
\033cAdd a Front-Banner\n\
to DMS-Files.
;
MSG_BH_CH_mapusadd_tail (//)
\033cAdd a Tail-Banner\n\
to DMS-Files.
;
MSG_BH_CH_mapusadd_track (//)
\033cAdd a Track-Banner\n\
to DMS-Files.
;
MSG_BH_CH_mapuskill_front (//)
\033cRemove the Front-Banner\n\
from DMS-Files.
;
MSG_BH_CH_mapuskill_tail (//)
\033cRemove the Tail-Banner\n\
from DMS-Files.
;
MSG_BH_CH_mapuskill_track (//)
\033cRemove the Track-Banner\n\
from DMS-Files.
;
MSG_BH_BT_mapuscreate_front (//)
\033cCreate a Front-Banner\n\
for DMS-Files.
;
MSG_BH_BT_mapuscreate_tail (//)
\033cCreate a Tail-Banner\n\
for DMS-Files.
;
MSG_BH_BT_mapuscreate_track (//)
\033cCreate a Track-Banner\n\
for DMS-Files.
;
MSG_BH_STR_setreturn_fileid (//)
\033cThis is the outputstring for SetReturn,\n\
if a File_ID was found.
;
MSG_BH_STR_setreturn_nofileid (//)
\033cThis is the outputstring for SetReturn,\n\
if none File_ID was found.
;
MSG_BH_STR_setreturn_duplicate (//)
\033cThis is the outputstring for SetReturn,\n\
if a duplicate file was found.
;
MSG_BH_STR_setreturn_duplicatemove (//)
\033cThis is the outputstring for SetReturn,\n\
if a duplicate file was found\n\
and the file was moved.
;
MSG_BH_STR_setreturn_corrupt (//)
\033cThis is the outputstring for SetReturn,\n\
if the file was corrupt.
;
MSG_BH_STR_setreturn_corruptmove (//)
\033cThis is the outputstring for SetReturn,\n\
if the file was corrupt\n\
and the file was moved.
;
MSG_BH_CH_setreturn_fileid (//)
\033cActivate SetReturn for\n\
an existing File_ID.
;
MSG_BH_CH_setreturn_nofileid (//)
\033cActivate SetReturn for\n\
a nonexisting File_ID.
;
MSG_BH_CH_setreturn_duplicate (//)
\033cActivate SetReturn for\n\
duplicate files.
;
MSG_BH_CH_setreturn_duplicatemove (//)
\033cActivate SetReturn for\n\
duplicate files which\n\
will be moved.
;
MSG_BH_CH_setreturn_corrupt (//)
\033cActivate SetReturn for\n\
corrupt files.
;
MSG_BH_CH_setreturn_corruptmove (//)
\033cActivate SetReturn for\n\
corrupt files which\n\
will be moved.
;
