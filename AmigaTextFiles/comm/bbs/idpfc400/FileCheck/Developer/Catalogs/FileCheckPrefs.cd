;
MSG_BH_LV_language (//)
\033cSelect a language for FileCheck.
;
MSG_BH_BT_batch_edit (//)
\033cEdit the selected language.
;
MSG_BH_CH_batch_tsonly (//)
\033cIgnore ALL options and ONLY scan\n\
for the files are needed for\n\
the turbo-duplicate-checker.
;
MSG_BH_CH_batch_saonly (//)
\033cIgnore the most options and ONLY save\n\
an external File_ID.
;
MSG_BH_PA_batch_exdiz (//)
\033cSelect the external File_ID which will\n\
be used, if no file_id exists.
;
MSG_BH_BT_batch_edit_head (//)
\033cEdit the head of the FileBatch.
;
