;MaxonCPP-Project

<Project-Options>
-dir "" -args "" -stack 10 -pri 0
<End>


<Linker-Options>
-gD -gl -gh50 -w1024 
-j "PROGDIR:amiga/mcpp-libs/" 
<End>

<C-Options>
-wACEFNMOPRTV -pc -g00 -g80 -gO -gb0 -gM -bs0 -a0 -t -pX -b0 -mX 
-i "PROGDIR:amiga/c-inc/" 
-i "PROGDIR:amiga/easyobjects/" 
<End>

<ASM-Options>
-c cWSElMo0F -0xff 
<End>


<CSources>
"PROGDIR:projects/MultiDesc/MultiDesc.c" "PROGDIR:projects/MultiDesc/MultiDesc.o"
	<Dependencies>
		"PROGDIR:projects/MultiDesc/MultiDesc.c"
	<End>
<End>

<Executable>
<closed>
"PROGDIR:projects/MultiDesc/MultiDesc"
	<Options>
		-autowrite
	<End>
<End>

<LinkLibs>
<closed>
"PROGDIR:amiga/c-libs/amiga.lib"
<End>

