;
; AddCommand-Batch for FileCheck
;

 dst_comtab = "T:ComTab/"

 name = "FCHECK KILL"
_gosub ADD_COMMAND

 name = "FCHECK LIST"
_gosub ADD_COMMAND

 name = "FCHECK SET"
_gosub ADD_COMMAND

 name = "FCHECK SHOW"
_gosub ADD_COMMAND

_eod


ADD_COMMAND:
_check command 'name' ADD_COMMAND_NEW
_edit command/noreq/load="'dst_comtab''name'" 'name'
_return

ADD_COMMAND_NEW:
_edit command/add/noreq/load="'dst_comtab''name'"
_return
