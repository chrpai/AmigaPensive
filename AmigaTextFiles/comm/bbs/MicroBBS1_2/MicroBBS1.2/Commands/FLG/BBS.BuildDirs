.key SOURCEDIR/A,TARGETDIR/A,FLGDIR/A,CONFIGNAME/A
.bra {
.ket }

S:PCD {SOURCEDIR}

C:Echo "Scanning dirs..."
C:Failat 99

C:Echo "( Menus" >BBS:MicroBBS.temp

{FLGDIR}FLG.BuildDir "" {SOURCEDIR} {TARGETDIR} {FLGDIR}
{FLGDIR}BBS.BuildFileDir "" BBS:MicroBBS.temp {SOURCEDIR} {TARGETDIR} {FLGDIR}

C:Echo ")" >>BBS:MicroBBS.temp
C:Move BBS:MicroBBS.temp {CONFIGNAME}

S:PCD
