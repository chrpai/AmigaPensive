;Installationsscript für Amiga Installer

(set @default-dest "Prometheus:SkyTools")
(transcript "Installation von SkyLastCaller V1.3")

(set sourc "install/")
(set desti (tackon @default-dest "SkyLastCaller"))

(message
  "\n\n\n\nWillkommen bei der SkyLastCaller V1.3 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)

(working)

(if (= (exists @default-dest) 0 (makedir @default-dest (infos) )))
(if (= (exists (tackon @default-dest "SkyLastCaller")) 0 (makedir (tackon @default-dest "SkyLastCaller") (infos) )))

(complete 20)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "SkyLastCaller" "SkyLastCaller.guide" "SkyLastCaller.cfg" "NetzAntrag.txt")
  (source sourc)
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 80)

(makeassign "SkyTools" "Prometheus:SkyTools")

(startup "SkyTools"
  (prompt "\n\n\n\nDas SkyTools-Assign wird nun Ihrer User-Startup zugefügt.")
  (help @startup-help)
  (command "Assign SkyTools: \"" @default-dest "\"\n")
)

(complete 100)

(message
  "\n\n\nZur weiteren Installation und Konfiguration von SkyLastCaller schauen "
  "Sie bitte in die Anleitung.\n\n"
)

(Message
  "\n\n\nFür alle SkyTools existiert ein eigenes Support-Netz, das SkyNetz, in dem Sie Informationen, Hilfestellung, Diskussionen und natürlich die neusten Versionen der Programme erhalten."
)
