/* Launch Script for TAAreaExclude
   Written by Juergen A.Lamers on Wuivend Riet +49-(0)-241-573145
   You should only change the Priority, the Path and the Options
   for TAAreaExclude, please never decrease the stack !!
 */

options results
signal on error

systeminfo '8' ; line = result

call pragma('stack',50000)
call pragma('priority',2)
newline
address command 'bbs:bin/TAAreaExclude LINE 'line
exit 0
