/* Launch Script for TAFileTagger
   Written by Juergen A.Lamers on Wuivend Riet +49-(0)-241-573145
   You should only change the Priority, the Path and the Options
   for TAFileTagger, please never decrease the stack !!
 */

options results
signal on error

systeminfo '8' ; line = result

call pragma('stack',50000)
call pragma('priority',2)

address command "bbs:bin/TAFileTagger" " CONFIG bbs:Configs/tafiletagger.cfg LINE "||line

shutdown
exit $RC

error:
shutdown
exit $RC

