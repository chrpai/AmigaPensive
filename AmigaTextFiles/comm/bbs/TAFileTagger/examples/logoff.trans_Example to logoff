/* Ergänzung zum normalen LogOff-Script, damit TAFileTagger einwandfrei
   läuft. */
options results

/* What BBSline was this session on? */
systeminfo '8'
line = result


/* Die nachfolgenden Zeilen sind zu ergaenzen falls mit TAFileIndex
   gearbeitet wird. Sie schauen nach ob ein Upload geschehen ist. */

docheck = 0
Upload = "env:TAUpload"

  if open(check, Upload, r) then docheck = readln(check)
  close(check)

IF docheck then
  ADDRESS COMMAND 'run execute s:UpdateTAIndex'

ADDRESS COMMAND 'SETENV TAUpload 0'


