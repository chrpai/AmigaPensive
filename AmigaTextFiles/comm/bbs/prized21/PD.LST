PROCEDURE instruct
  ' ************
  '
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  in%=9
  il%=1
  modout%=1
  o$=ansi$(5)+"    ษอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออป"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ                      "+ansi$(1)+"Prize Door Instructions                          "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ                      "+ansi$(3)+"~~~~~~~~~~~~~~~~~~~~~~~                          "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    ฬอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออน"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"This is a very simple program where you are asked to choose a number "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"from 1 to whatever the sysop sets. If you guess the number that the  "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"computer selects, you can get to choose a PRIZE! The amounts awarded "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"are also set by the sysop, but you will have a choice of receiving   "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"credits for messages posted, files uploaded or minutes of extra time "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"for this call. The credits you select will show up on the stats door "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(3)+"next time the midnight event is run (ie tomorrow!!)                  "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ                                                                       บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    บ  "+ansi$(1)+"              You can only play this door ONCE a day!                "+ansi$(5)+"บ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  o$=ansi$(5)+"    ศอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออผ"+cr$
  GOSUB 2
  IF abort%=1 OR car%>0
    GOTO instructexit
  ENDIF
  '
  instructexit:
  modout%=0
  abort%=0
  GOSUB press
  GOSUB 1
RETURN
