'
MODE 1
DIM hold$(20)
DIM ansi$(10)
DIM dat$(20)
'
' rem the next line when compiling the final door !!!
' test%=1
'
cr$=CHR$(13)+CHR$(10)
de$=CHR$(8)+" "+CHR$(8)
esc$=CHR$(27)
screenclr$=cr$+cr$+CHR$(12)
'
IF (test%=1) AND (NOT EXIST("Ram:Userdata"))
  ' setup dummy names, etc
  rtime$="300"
  uname$="PETER DEANE"
  id$="1"
  lev$="1"
  bd$="2400"
  ring$="0"
  ansi%=1
  path$="BBS:Doorfiles1/Door207/"
ELSE
  IF EXIST("ram:doordata")
    OPEN "I",#2,"RAM:USERDATA"
    LINE INPUT #2,rtime$
    LINE INPUT #2,uname$
    LINE INPUT #2,id$
    LINE INPUT #2,lev$
    LINE INPUT #2,bd$
    LINE INPUT #2,ring$
    LINE INPUT #2,path$
    CLOSE #2
  ELSE
    '
    ' THIS door WON'T work without doordata!!
    '
    ' END
  ENDIF
ENDIF
'
' Investigate our working environment from the config file...
'
'
IF EXIST("S:Metro.cfg")
  config$="S:Metro.cfg"
ELSE IF EXIST("BBS:Metro.cfg")
  config$="BBS:Metro.cfg"
ELSE IF EXIST("Metro.cfg")
  config$="Metro.cfg"
ELSE
  config$="XXX"
ENDIF
'
' Defaults
'
bbsname$="The OzMetro BBS"
sfd$="BBS:"
sysopname$="The Sysop"
winw$="640"
winh$="200"
'
IF config$<>"XXX"
  '
  OPEN "I",#2,config$,128
  DO WHILE (NOT EOF(#2))
    LINE INPUT #2,xx$
    xx$=TRIM$(xx$)
    xxu$=UPPER$(xx$)
    '
    IF xxu$="" OR LEFT$(xxu$,1)=";"
      ' Do nothing
    ELSE IF LEFT$(xxu$,7)="BBSNAME"
      xx$=MID$(xx$,8,255)
      xx$=TRIM$(xx$)
      bbsname$=xx$
    ELSE IF LEFT$(xxu$,9)="SYSOPNAME"
      xx$=MID$(xx$,10,255)
      xx$=TRIM$(xx$)
      sysopname$=xx$
    ELSE IF LEFT$(xxu$,11)="WINDOWWIDTH"
      xx$=MID$(xx$,12,255)
      xx$=TRIM$(xx$)
      winw$=xx$
    ELSE IF LEFT$(xxu$,12)="WINDOWHEIGHT"
      xx$=MID$(xx$,13,255)
      xx$=TRIM$(xx$)
      winh$=xx$
    ENDIF
    '
  LOOP UNTIL EOF(#2)
  CLOSE #2
ENDIF
'
' integer conversion for system variables
'
tpc%=VAL(rtime$)
id%=VAL(id$)
lev%=VAL(lev$)
ring%=VAL(ring$)
bd%=VAL(bd$)
timeon%=CINT(TIMER/200)
'
sw%=VAL(winw$)
sh%=VAL(winh$)
sx%=0
sy%=0
ww%=sw%
wh%=sh%-12
wx%=0
wy%=11
OPENS 1,sx%,sy%,sw%,sh%,3,32768
OPENW #1,wx%,wy%,ww%,wh%,0,0,1
'
' Hack these settings if you like: format &Hxxx
' the xxx is the HEX value of the RGB register
'
SETCOLOR 0,&H141
SETCOLOR 1,&HD62
SETCOLOR 2,&H2D2
SETCOLOR 3,&HCB2
SETCOLOR 4,&H56C
SETCOLOR 5,&HB6B
SETCOLOR 6,&H5DC
SETCOLOR 7,&HFEF
'
title$="The Prize Door  ID: "+id$+" ("+uname$+") Lev: "+lev$+" Baud: "
IF ring%=0
  ~ActivateWindow(WINDOW(1))
  title$=title$+"Local"
ELSE
  BACKS 1
  title$=title$+bd$
ENDIF
'
'
TITLEW #1,title$,"Written by Peter F Deane - 1994 V 2.1"
TITLES #1,"Written by Peter F Deane - 1994 V 2.1"
'
' modem need not be opened if it's a local login!
' then you can test em standalone with the BBS running, among other things...
'
IF ring%<>0
  GOSUB modem.o
ENDIF
'
' Figure out the page pause setting!
'
flnm$=sfd$+"BBSFILES/userlog"
IF EXIST(flnm$)
  OPEN "R",#2,flnm$,125
  FIELD #2,25 AS un$,10 AS pa$,1 AS le$,25 AS fr$,12 AS ph$,10 AS dl$,6 AS lm$,6 AS lf$,10 AS ind$,3 AS tc$,3 AS td$,1 AS sw$,1 AS pr$,1 AS mo$,5 AS cn$,4 AS dm1$,2 AS dm2$
  GET #2,id%
  page%=VAL(dm2$)
  CLOSE #2
ELSE
  page%=21
ENDIF
IF page%>5
  scrnht%=page%-1
ELSE
  scrnht%=22
ENDIF
IF ring%=0
  scrnht%=(wh%/8)-4
ENDIF
'
'
' ======================================================================
'
' We're in, hit em hard and good!
'
' reset terminal
o$=esc$+"[0;40;37m"+CHR$(12)
GOSUB 2
o$=cr$+cr$+"              Prize Door"
GOSUB 2
o$=cr$+cr$+"                By PFD"
GOSUB 2
o$=cr$+cr$+"             Version 2.1"
GOSUB 2
o$=cr$+cr$+"             25 Nov 1994"+cr$
GOSUB 2
o$=cr$+cr$+"Written in GFA Basic (Compiler V3.51)"
GOSUB 2
'
flnm$=path$+"pd.config"
OPEN "I",#2,flnm$,1024
LINE INPUT #2,sysop1$
LINE INPUT #2,sysop2$
LINE INPUT #2,sysop3$
LINE INPUT #2,win$
win%=VAL(win$)
LINE INPUT #2,min$
min%=VAL(min$)
LINE INPUT #2,up$
up%=VAL(up$)
LINE INPUT #2,msgs$
msgs%=VAL(msgs$)
LINE INPUT #2,hinum$
hinum%=VAL(hinum$)
LINE INPUT #2,lastdate$
CLOSE #2
'
winnings%=0
GOSUB dateconv
'
' Check last time the door was run, if yesterday, reset the players file.
'
IF pd.date$<>lastdate$
  file$=path$+"pd.played"
  OPEN "O",#2,file$,20
  PRINT #2,"N-o-t-a-s-o-u-l!:-)"
  CLOSE #2
  file$=path$+"pd.config"
  OPEN "O",#2,file$,1024
  PRINT #2,sysop1$
  PRINT #2,sysop2$
  PRINT #2,sysop3$
  PRINT #2,win$
  PRINT #2,min$
  PRINT #2,up$
  PRINT #2,msgs$
  PRINT #2,hinum$
  PRINT #2,pd.date$
  CLOSE #2
ENDIF
'
GOSUB setansi
'
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
o$=cr$+cr$+CHR$(12)
GOSUB 2
o$=ansi$(3)+"     ษอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออป"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"ษออออป                     "+ansi$(2)+"ษอออป                                 "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"บ    ศป     ฮ              "+ansi$(2)+"บ   ศป                     บ          "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"บ    ษผ                    "+ansi$(2)+"บ    ศป                    บ          "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"ฬออออผ  ษออ ห อออป ษอออป   "+ansi$(2)+"บ     บ  ษออป ษออป  ษออ    บ          "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"บ      ษผ   บ  ษอผ ฬอออผ   "+ansi$(2)+"บ    ษผ  บ  บ บ  บ ษผ      บ          "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"บ      บ    บ ษผ   บ       "+ansi$(2)+"บ   ษผ   บ  บ บ  บ บ                  "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ  "+ansi$(5)+"ส      ส    ส ศอออ ศอออ    "+ansi$(2)+"ศอออผ    ศออผ ศออผ ส       ฮ          "+ansi$(3)+"บ"+cr$
GOSUB 2
o$=ansi$(3)+"     วฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤถ"+cr$
GOSUB 2
o$=ansi$(3)+"     บ   "+ansi$(6)+"Written for "+ansi$(2)+"The Metro BBS "+ansi$(6)+"by "+ansi$(1)+"Peter Deane."+ansi$(6)+"  Copyright (c) 1991"+ansi$(3)+"   บ"+cr$
GOSUB 2
o$=ansi$(3)+"     ศอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออผ"+cr$
GOSUB 2
o$=cr$+ansi$(6)+"     Welcome to the Prize Door on "+bbsname$
GOSUB 2
o$=cr$+ansi$(5)+"     Your Prizemaster is "+sysopname$
GOSUB 2
o$=cr$+ansi$(1)+"     "+sysop3$
GOSUB 2
'
GOSUB press
GOSUB 1
IF car%>0
  GOTO bye
ENDIF
'
'
' ======================================================================
main:
' ======================================================================
'
o$=cr$+cr$+CHR$(12)
GOSUB 2
'
GOSUB prntmn
'
IF car%>0
  GOTO bye
ENDIF
IF cmd%=1
  cmd%=0
ELSE
  GOSUB tchk
  o$=cr$+cr$+ansi$(2)+"     ("+ansi$(3)+STR$(rtime%)+" min"+ansi$(2)+")  "+ansi$(5)+"Commands: <Q>-<I>-<S>-<P>-<W>-<R> ? "
  in%=0
  il%=1
  GOSUB 1
ENDIF
'
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
' ======================================================================
IF in$="Q"
  GOTO bye
ENDIF
'
' ======================================================================
IF in$="R"
  ' re-configure details
  o$=CHR$(12)
  GOSUB 2
  GOSUB setansi
  IF car%>0
    GOTO bye
  ENDIF
  GOSUB setpagepause
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="S"
  GOSUB status
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="I"
  GOSUB instruct
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
' ======================================================================
IF in$="P"
  GOSUB play
  IF car%>0
    GOTO bye
  ENDIF
  in$=""
ENDIF
'
' ======================================================================
IF in$="W"
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  o$=ansi$(2)+"------------------------------------------------------------"+cr$
  GOSUB 2
  o$=ansi$(1)+"Winner's Name                 Date Won      Prize Chosen"+cr$
  GOSUB 2
  o$=ansi$(2)+"------------------------------------------------------------"+cr$+ansi$(5)
  GOSUB 2
  file$=path$+"pd.win"
  IF EXIST(file$)
    GOSUB seq.o
  ELSE
    o$=cr$+ansi$(3)+"No-one has won a prize yet. Will YOU be the first?"
    GOSUB 2
  ENDIF
  GOSUB press
  GOSUB 1
  in$=""
ENDIF
'
' ======================================================================
' final check before looping.
'
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
in$=""
GOTO main
' ======================================================================
'
bye:
cs$="The Metro Prize Door was written by Peter Deane."
GOSUB center
o$=screenclr$+cr$+ansi$(6)+lcs$+cr$
GOSUB 2
cs$="Brought to you on "+bbsname$
GOSUB center
o$=cr$+cr$+ansi$(2)+lcs$
GOSUB 2
cs$="by "+sysopname$
GOSUB center
o$=cr$+cr$+ansi$(5)+lcs$
GOSUB 2
cs$="See you next time."
GOSUB center
o$=cr$+cr$+ansi$(3)+lcs$+cr$
GOSUB 2
IF EXIST("ram:userdata")
  KILL "RAM:USERDATA"
ENDIF
DELAY 2
CLOSES 1
GOSUB modem.c
CLEAR
END
'
'
'
'
' **************
PROCEDURE status
  ' ************
  '
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  o$=ansi$(7)+"ออออออออออออออออออออออออออออออออออออออออออออออออออออออออ"+cr$
  GOSUB 2
  o$=ansi$(1)+"     The Sysop has set these values in the program: "+cr$
  GOSUB 2
  o$=ansi$(7)+"ออออออออออออออออออออออออออออออออออออออออออออออออออออออออ"+cr$
  GOSUB 2
  o$=cr$+ansi$(2)+"    Number chosen will be from     :  "+ansi$(1)+"1 - "+hinum$
  GOSUB 2
  o$=cr$+cr$+ansi$(3)+"    Number of Message Posts awarded:  "+ansi$(1)+msgs$
  GOSUB 2
  o$=cr$+cr$+ansi$(5)+"    Number of Upload Credits awarded: "+ansi$(1)+up$
  GOSUB 2
  o$=cr$+cr$+ansi$(6)+"    Number of Extra Minutes awarded:  "+ansi$(1)+min$
  GOSUB 2
  IF lev%>8 THEN
    o$=cr$+cr$+ansi$(1)
    GOSUB 2
    IF win%=0
      o$="The game IS winnable"
    ELSE
      o$="NO-ONE can win this game"
    ENDIF
    GOSUB 2
  ENDIF
  GOSUB press
  GOSUB 1
RETURN
'
'
' **************
PROCEDURE play
  ' ************
  '
  '
  playentrance:
  '
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  IF lev%=9
    GOTO sysopjump
  ENDIF
  '
  file$=path$+"pd.played"
  '
  IF EXIST(file$)
    OPEN "I",#2,file$,1024
    WHILE NOT EOF(#2)
      LINE INPUT #2,played$
      IF played$=uname$
        CLOSE #2
        o$=cr$+cr$+ansi$(3)+"You have already played today. You can only play once/day."
        GOSUB 2
        GOSUB press
        GOSUB 1
        GOTO playexit
      ENDIF
    WEND
    CLOSE #2
    OPEN "A",#2,file$,1024
  ELSE
    OPEN "O",#2,file$,1024
  ENDIF
  PRINT #2,uname$
  CLOSE #2
  '
  sysopjump:
  '
  o$=cr$+ansi$(7)+"Okay then, I am thinking of a number from 1 to "+hinum$
  GOSUB 2
  '
  lab3:
  '
  o$=cr$+cr$+ansi$(6)+"Well, what do you think it is? "
  in%=4
  il%=2
  GOSUB 1
  IF car%>0
    GOTO playexit
  ENDIF
  '
  picked%=VAL(in$)
  o$=cr$+cr$+ansi$(2)+"Are you sure (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  '
  GOSUB tchk
  IF car%>0
    GOTO playexit
  ENDIF
  '
  IF in$="NO"
    GOTO lab3
  ENDIF
  '
  o$=cr$+cr$+ansi$(1)+"Here Goes: "
  GOSUB 2
  FOR k%=1 TO 50
    o$=ansi$(RANDOM(7)+1)+"*"
    GOSUB 2
    PAUSE 5
  NEXT k%
  '
  o$=cr$+cr$+cr$+ansi$(2)+"AND........."
  GOSUB 2
  '
  lab4:
  thatsit%=RANDOM(hinum%)+1
  IF win%<>0 AND thatsit%=picked%
    GOTO lab4
  ENDIF
  '
  IF thatsit%<>picked%
    o$=" Nah, You lost."
    GOSUB 2
    o$=cr$+cr$+ansi$(3)+"The number I picked was "+STR$(thatsit%)
    GOSUB 2
    o$=cr$+cr$+ansi$(1)+"Hope you can play again tomorrow!"+cr$
    GOSUB 2
  ELSE
    o$=" WOW!!!!!!! You Won!"
    GOSUB 2
    lab5:
    o$=cr$+cr$+ansi$(3)+"Now you get to pick your prize."
    GOSUB 2
    o$=cr$+cr$+ansi$(1)+"<"+ansi$(6)+"1"+ansi$(1)+"> "+min$+" Minutes of extra time"
    GOSUB 2
    o$=cr$+cr$+ansi$(1)+"<"+ansi$(5)+"2"+ansi$(1)+"> "+up$+" Uploads"
    GOSUB 2
    o$=cr$+cr$+ansi$(1)+"<"+ansi$(2)+"3"+ansi$(1)+"> "+msgs$+" Messages"
    GOSUB 2
    o$=cr$+cr$+ansi$(1)+"What's it to be? "
    in%=4
    il%=1
    GOSUB 1
    IF car%>0
      GOTO playexit
    ENDIF
    pick%=VAL(in$)
    IF pick%<1 OR pick%>3
      GOTO lab5
    ELSE IF pick%=1 AND test%<>1
      got$=min$+" Minutes"
      OPEN "I",#2,"ram:doordata",1024
      k%=0
      WHILE NOT EOF(#2)
        INC k%
        LINE INPUT #2,dat$(k%)
      WEND
      CLOSE #2
      dd.lines%=k%
      secs%=VAL(dat$(5))
      addon%=60*min%
      secs%=secs%+addon%
      dat$(5)=STR$(secs%)
      KILL "ram:doordata"
      OPEN "O",#2,"ram:doordata"
      FOR k%=1 TO dd.lines%
        PRINT #2,dat$(k%)
      NEXT k%
      CLOSE #2
      winnings%=winnings%+min%
    ELSE IF pick%=2
      got$=up$+" Uploads"
      file$=sfd$+"BBSFILES/log"
      IF EXIST(file$)
        OPEN "A",#2,file$,1024
      ELSE
        OPEN "O",#2,file$,1024
      ENDIF
      FOR k%=1 TO up%
        PRINT #2,"Uploaded        <---- Prize from Prize Door"
      NEXT k%
      CLOSE #2
    ELSE IF pick%=3
      got$=msgs$+" Message Posts"
      file$=sfd$+"BBSFILES/log"
      IF EXIST(file$)
        OPEN "A",#2,file$,1024
      ELSE
        OPEN "O",#2,file$,1024
      ENDIF
      FOR k%=1 TO msgs%
        PRINT #2,"Posted A Public <---- Prize from Prize Door"
      NEXT k%
      CLOSE #2
    ENDIF
    '
    ' Update winners list
    '
    GOSUB dateconv
    file$=path$+"pd.win"
    '
    IF EXIST(file$)
      FOR k%=1 TO 20
        dat$(k%)=""
      NEXT k%
      k%=0
      OPEN "I",#2,file$,2056
      WHILE NOT EOF(#2)
        INC k%
        LINE INPUT #2,dat$(k%)
        EXIT IF k%>19
      WEND
      CLOSE #2
      '
      FOR k%=1 TO 15
        IF LEN(dat$(k%))<5
          dat$(k%)=uname$+SPACE$(30-LEN(uname$))+pd.date$+"     "+got$
          k%=20
        ENDIF
      NEXT k%
      '
      IF k%<20
        dat$(16)=uname$+SPACE$(30-LEN(uname$))+pd.date$+"     "+got$
        startk%=2
        endk%=16
      ELSE
        startk%=1
        endk%=15
      ENDIF
      '
      OPEN "O",#2,file$,2056
      FOR k%=startk% TO endk%
        PRINT #2,dat$(k%)
      NEXT k%
      CLOSE #2
      '
    ELSE
      OPEN "O",#2,file$,500
      PRINT #2,uname$;SPACE$(30-LEN(uname$));pd.date$;"     ";got$
      CLOSE #2
    ENDIF
    '
    o$=cr$+cr$+ansi$(6)+"Okay, you've just been credited with "+got$
    GOSUB 2
    o$=cr$+"Enjoy yourself! Hope you had fun!"
    GOSUB 2
  ENDIF
  '
  GOSUB press
  GOSUB 1
  in$=""
  playexit:
RETURN
'
'
'
PROCEDURE 1
  GOSUB 2
  GOSUB 3
RETURN
'
'
PROCEDURE 2
  '
  IF ring%=1
    PRINT #1,o$;
  ENDIF
  IF icon%=0
    PRINT o$;
  ENDIF
  IF (modout%=1)
    GOSUB 3
  ENDIF
  2.1:
  o$=""
RETURN
'
'
PROCEDURE 3
  idle%=CINT(TIMER/200)
  key$=""
  in$=""
  in1$=""
  a%=0
  keyy%=0
  b%=0
  car%=0
  DO
    IF MOUSEK=3
      ALERT 0,"Really kill the Door?",2,"Yes|No",pdq%
      IF pdq%=1
        END
      ENDIF
      ' reset idle timer after returning from Alert
      idle%=CINT(TIMER/200)
    ENDIF
    IF ring%=1
      cd%=0
      cd%=LPEEK(12570624)
      cd%=cd% AND 8192
      IF cd%<>0
        car%=1
        keyy%=1
      ENDIF
    ENDIF
    key$=INKEY$
    IF key$<>""
      GOTO mod.in1
    ENDIF
    '
    IF ring%=1
      IF LOC(#1)>0
        in1$=INPUT$(1,#1)
        key$=in1$
        in1$=""
      ENDIF
    ENDIF
    '
    mod.in1:
    IF key$=CHR$(19)
      pau$=""
      hold%=CINT(TIMER/200)
      WHILE CINT(TIMER/200)<hold%+45
        pau$=INKEY$
        IF pau$<>""
          key$=""
          pau$=""
          GOTO mod.in1.1
        ENDIF
        IF ring%=1
          IF LOC(#1)>0
            key$=""
            pau$=""
            GOTO mod.in1.1
          ENDIF
        ENDIF
      WEND
      key$=""
      pau$=""
      GOTO mod.in1.1
    ENDIF
    '
    mod.in1.1:
    IF modout%=1 AND key$=""
      keyy%=1
    ENDIF
    IF modout%=1 AND key$=CHR$(32)
      abort%=1
      GOTO 2.1
    ENDIF
    IF modout%=1 AND key$<>CHR$(32)
      keyy%=1
    ENDIF
    IF key$=""
      GOTO mod.in2
    ENDIF
    mod.in1.5:
    a%=ASC(key$)
    b%=LEN(in$)
    IF a%=13
      GOTO mod.in1.6
    ENDIF
    IF (a%=8 OR a%=127) AND LEN(in$)>=1
      in$=LEFT$(in$,b%-1)
      DEC b%
      o$=de$
      GOSUB 2
    ENDIF
    IF b%=il%
      GOTO mod.in2
    ENDIF
    IF in%=0
      IF a%>31 AND a%<127
        IF cmd%=1
          cmdmenu%=0
          dismsg%=0
        ENDIF
        key$=UPPER$(key$)
        o$=key$+cr$
        GOSUB 2
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    mod.in1.6:
    IF in%=1 AND a%>31 AND a%<127
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=2 AND a%>31 AND a%<127
      key$=UPPER$(key$)
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=3
      IF a%=13 AND yes%=1
        o$="YES"
        GOSUB 2
        in$="YES"
        keyy%=1
      ENDIF
      IF a%=13 AND yes%=0
        o$="NO"
        GOSUB 2
        in$="NO"
        keyy%=1
      ENDIF
      IF a%=89 OR a%=121
        o$="YES"+cr$
        GOSUB 2
        in$="YES"
        keyy%=1
      ENDIF
      IF a%=78 OR a%=110
        o$="NO"+cr$
        GOSUB 2
        in$="NO"
        keyy%=1
      ENDIF
    ENDIF
    IF in%=4 AND a%>47 AND a%<58
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=5
      IF (a%=8 OR a%=127) AND LEN(ln$(ln%))>=1
        ln$(ln%)=LEFT$(ln$(ln%),LEN(ln$(ln%))-1)
        o$=de$
        GOSUB 2
        keyy%=1
      ENDIF
      IF a%=13
        in$=key$
        keyy%=1
      ENDIF
      IF a%=9
        o$="     "
        GOSUB 2
        in$="     "
        keyy%=1
      ENDIF
      IF a%>26 AND a%<127
        o$=key$
        GOSUB 2
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    '
    ' new one: no echoing of input at all! Good for More (Y/n)? stuff, etc...
    '
    IF in%=9
      IF a%>31 AND a%<127
        key$=UPPER$(key$)
        in$=key$
        cmd%=1
        keyy%=1
      ENDIF
    ENDIF
    '
    mod.in1.7:
    IF a%=13
      IF (in%<>5 AND in%<>7 AND in%<>9)
        o$=cr$
        GOSUB 2
        keyy%=1
      ENDIF
      IF in%=9
        keyy%=1
      ENDIF
    ENDIF
    mod.in2:
    IF CINT(TIMER/200)>idle%+300
      IF lev%>7 AND CINT(TIMER/200)>idle%+600
        car%=1
        keyy%=1
      ENDIF
      IF lev%<8
        car%=1
        keyy%=1
      ENDIF
    ENDIF
    mod.in2.0:
  LOOP UNTIL keyy%=1
  '
  mod.in2.1:
RETURN
'
'
PROCEDURE seq.o
  '
  IF NOT EXIST(file$)
    o$=cr$+cr$+ansi$(1)+"File Not Found..."+ansi$(7)
    GOSUB 2
    GOSUB press
    GOSUB 1
    GOTO seq.o9
  ENDIF
  lncount%=0
  modout%=1
  in%=9
  il%=1
  OPEN "I",#2,file$,4096
  '
  DO UNTIL EOF(#2)
    LINE INPUT #2,text$
    INC lncount%
    o$=text$+cr$
    GOSUB 2
    IF contin%=0
      IF lncount%>=scrnht%
        GOSUB pagepause
      ENDIF
    ENDIF
    IF car%>0
      GOTO seq.o9
    ENDIF
    IF abort%=1
      abort%=0
      GOTO seq.o9
    ENDIF
  LOOP
  seq.o9:
  CLOSE #2
  modout%=0
  contin%=0
  o$=ansi$(0)
  GOSUB 2
RETURN
'
'
PROCEDURE center
  lcs%=LEN(cs$)
  lcs$=SPACE$(38-lcs%/2)+cs$
RETURN
'
PROCEDURE press
  o$=cr$+cr$+ansi$(0)+"{Tap a key} "
  in%=0
  il%=1
RETURN
'
PROCEDURE correct
  ' not sure if this is used??
  o$=cr$+cr$+"Is This Correct? (Y/n) "
  yes%=1
  in%=3
  il%=1
RETURN
'
PROCEDURE pagepause
  modout%=0
  o$="More (Y/n/c)?"
  GOSUB 2
  in%=9
  il%=1
  GOSUB 3
  IF car%>0
    GOTO pagepause9
  ENDIF
  o$=de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$
  GOSUB 2
  IF in$=" " OR in$="N"
    abort%=1
  ENDIF
  IF in$="C"
    contin%=1
  ENDIF
  lncount%=0
  modout%=1
  pagepause9:
RETURN
'
PROCEDURE time1
  t.t%=FRE(0)
  time1$=TIME$
  t.t%=VAL(LEFT$(time1$,2))
  IF t.t%>11
    a$=" PM"
  ELSE
    a$=" AM"
  ENDIF
  IF t.t%=0
    t.t%=12
    time1$=RIGHT$(STR$(t.t%),2)+RIGHT$(time1$,6)
  ELSE IF t.t%<10
    time1$=RIGHT$(STR$(t.t%),1)+RIGHT$(time1$,6)
  ELSE IF t.t%>21
    t.t%=t.t%-12
    time1$=RIGHT$(STR$(t.t%),2)+RIGHT$(time1$,6)
  ELSE IF t.t%>12
    t.t%=t.t%-12
    time1$=RIGHT$(STR$(t.t%),1)+RIGHT$(time1$,6)
  ENDIF
  GOSUB dateconv
  pd.time$=time1$+a$
  time1$=pd.time$+"  "+pd.date$
RETURN
'
PROCEDURE tchk
  GOSUB time1
  timenow%=CINT(TIMER/200)
  ctime%=(timenow%-timeon%)
  ctime%=CINT(ctime%/60)
  rtime%=tpc%-ctime%+winnings%
  IF rtime%<=0
    o$=cr$+cr$+"Sorry, Time Limit Exceeded!"
    GOSUB 2
    DELAY 2
    car%=2
  ENDIF
RETURN
'
PROCEDURE modem.c
  CLOSE #1
RETURN
'
PROCEDURE modem.o
  OPEN "",#1,"COM1:"+bd$+",n,8,1",4096
RETURN
'
PROCEDURE setpagepause
  oldscrnht%=scrnht%
  o$=cr$+cr$+ansi$(2)+"Current Screen Height: "+ansi$(5)+STR$(oldscrnht%)
  GOSUB 2
  o$=cr$+cr$+ansi$(3)+"Change Screen Height (y/N)? "
  in%=3
  il%=1
  yes%=0
  GOSUB 1
  IF in$="NO" OR car%>0
    GOTO pauseexit
  ENDIF
  o$=cr$+ansi$(2)+"New Screen Height: "+ansi$(1)
  in%=4
  il%=2
  GOSUB 1
  IF in$="" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=VAL(in$)
  o$=cr$+ansi$(3)+"Are "+ansi$(1)+STR$(scrnht%)+ansi$(3)+" lines okay (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF in$="YES" OR car%>0
    GOTO pauseexit
  ENDIF
  scrnht%=oldscrnht%
  o$=cr$+cr$+ansi$(1)+"No Change"
  GOSUB 2
  GOSUB press
  GOSUB 1
  '
  pauseexit:
RETURN
'
PROCEDURE setansi
  '
  o$=cr$+cr$+"Do you want ANSI (Y/n)? "
  in%=3
  il%=1
  yes%=1
  GOSUB 1
  IF car%>0
    GOTO setansi9
  ENDIF
  '
  IF in$="YES"
    ansi%=1
    ansi$(1)=esc$+"[31m"
    ansi$(2)=esc$+"[32m"
    ansi$(3)=esc$+"[33m"
    ansi$(4)=esc$+"[34m"
    ansi$(5)=esc$+"[35m"
    ansi$(6)=esc$+"[36m"
    ansi$(7)=esc$+"[37m"
    ansi$(8)=esc$+"[1m"
    ansi$(9)=esc$+"[3m"
    ansi$(10)=esc$+"[4m"
  ELSE
    ansi%=0
    FOR kk%=1 TO 10
      ansi$(kk%)=""
    NEXT kk%
  ENDIF
  setansi9:
  ' regardless of setting, this is needed for safety!
  ansi$(0)=esc$+"[0;37;40m"
  o$=ansi$(0)
  GOSUB 2
RETURN
'
'
'   **************
PROCEDURE dateconv
  ' **************
  ' converts date to Fido style DD-Mmm-YY
  ' string to use is pd.date$
  pd.temp$=DATE$
  pd.date1$=LEFT$(pd.temp$,2)
  pd.date2$=MID$(pd.temp$,4,2)
  pd.date3$=RIGHT$(pd.temp$,2)
  pd.month%=VAL(pd.date1$)
  pd.month$="Xxx"
  IF pd.month%=1
    pd.month$="Jan"
  ELSE IF pd.month%=2
    pd.month$="Feb"
  ELSE IF pd.month%=3
    pd.month$="Mar"
  ELSE IF pd.month%=4
    pd.month$="Apr"
  ELSE IF pd.month%=5
    pd.month$="May"
  ELSE IF pd.month%=6
    pd.month$="Jun"
  ELSE IF pd.month%=7
    pd.month$="Jul"
  ELSE IF pd.month%=8
    pd.month$="Aug"
  ELSE IF pd.month%=9
    pd.month$="Sep"
  ELSE IF pd.month%=10
    pd.month$="Oct"
  ELSE IF pd.month%=11
    pd.month$="Nov"
  ELSE IF pd.month%=12
    pd.month$="Dec"
  ENDIF
  pd.date$=pd.date2$+"-"+pd.month$+"-"+pd.date3$
RETURN
