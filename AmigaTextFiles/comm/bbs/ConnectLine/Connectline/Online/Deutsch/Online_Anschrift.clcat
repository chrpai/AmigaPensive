##INFO_INTROLINE
Anschrift ändern
##MSG_REALNAME
$(NORMAL)   Name:$(BOLD)$(COL{3})%s$(NORMAL)\n
##MSG_STREET
$(NORMAL) Straße:
##MSG_COUNTRY
$(NORMAL)PLZ+Ort:
##MSG_TELEFON
$(NORMAL)Telefon:
##MSG_NOCHANGE
$(NORMAL)\nEs hat sich nichts geändert.\n
##MSG_SYSOPINFO
-+*+- NEUE ANSCHRIFT -+*+-\n\nDer User %s (%s) hat seine Anschrift geändert.\n\nVorher:\nAnschrift: %s, Telefon: %s\n\nNeu:\nAnschrift: %s, Telefon: %s\n
##MSG_CHANGED
$(NORMAL)\nDie Anschrift wurde geändert, und der Sysop darüber informiert.\n
##MSG_BETREFF
*** ANSCHRIFT von %s ***
