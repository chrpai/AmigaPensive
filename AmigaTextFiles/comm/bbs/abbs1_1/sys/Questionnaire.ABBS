/* Example Questionnaire script for abbs
   This file should be called abbs:Questionnaire.abbs */

options results

finished = "no"

DO WHILE finished = "no"
aq
	writetext '"Please enter your computer type : "' ; breakoutimage
	getline 30
	IF RC > 0 THEN EXIT
	computer = RESULT

	writetext '"Please enter your modem type : "' ; breakoutimage
	getline 30
	IF RC > 0 THEN EXIT
	modem = RESULT

	tekst = '"Computer : '||computer||'"'
	writetext tekst ; outimage
	IF RC > 0 THEN EXIT

	tekst = '"Modem    : '||modem||'"'
	writetext tekst ; outimage
	IF RC > 0 THEN EXIT

	writetext '"Is this OK (Y/n) : "' ; breakoutimage
	getline 1
	IF RC > 0 THEN EXIT

	IF RESULT ~= "N" & RESULT ~= "n" THEN DO
		finished = "yes"
	END
END
