.key file,atr
.bra {
.ket }

failat 21

if {atr} EQ ".ARC"
sys:cc/arc t {file} >nil:
 IF WARN
  echo "Invalid arc arcive"
  quit 10
 ENDIF
quit
ENDIF

IF {atr} EQ ".LHA"
sys:cc/lha t {file} >nil:
 IF WARN
  echo "Invalid lha arcive"
  quit 10
 ENDIF
quit
ENDIF

IF {atr} EQ ".LZH"
sys:cc/lha t {file} >nil:
 IF WARN
  echo "Invalid lzh arcive"
  quit 10
 ENDIF
quit
ENDIF

IF {atr} EQ ".ZOO"
failat 1
sys:cc/zoo l {file} >nil:
 IF WARN
  echo "Invalid zoo arcive"
  quit 10
 ENDIF
quit
ENDIF

IF {atr} EQ ".ZIP"
echo "Sorry, no ZIP extracter"
quit 5
ENDIF

IF {atr} EQ ".ARJ"
echo "Sorry, no ARJ extracter"
quit 5
ENDIF

echo "Unknown arcive type"
quit 8
