/* Example Arexx login script for abbs
   This file should be called abbs:LogoutScript.abbs
*/

options results

outimage
if RC >= 1 THEN EXIT	/* Exit if no carrier, or user didn't want more text */

username
if RC >= 5 THEN EXIT	/* Exit if there is no user online */

tekst = '"Thanx for dialing ABBS Support, '||result||'. Hope you enjoyed the stay!"'
writetext tekst
outimage
/* Here we exit anyways, so.. */

exit
