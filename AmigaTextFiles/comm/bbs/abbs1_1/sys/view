.key file,atr
.bra {
.ket }

failat 21

if {atr} EQ ".ARC"
sys:cc/arc l {file}
ENDIF

IF {atr} EQ ".LHA"
sys:cc/lha l {file}
ENDIF

IF {atr} EQ ".LZH"
sys:cc/lha l {file}
ENDIF

IF {atr} EQ ".ZOO"
sys:cc/zoo l {file}
ENDIF

IF {atr} EQ ".ZIP"
echo "Sorry, no ZIP lister"
ENDIF

IF {atr} EQ ".ARJ"
echo "Sorry, no ARJ lister"
ENDIF

IF {atr} EQ ""
echo "Unknown filetype"
ENDIF

