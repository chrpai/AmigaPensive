/* Filelist posting script for Spot by Anthony Brice */

/* $Ver 1.0 - 27/6/96 */

/* Designed for use as an afterlist command from within BlitzList V1.0 Beta +

   For the AfterList command within BlitzList configure like this :-

   AFTERLIST <path>:FileList.Spot <AreaName>
   NEWTEXTARGUMENT

   and make sure the executable and script bits are set on this script!   */

Spot_Path = 'Workbench:Spot/Spot'
Quit=0

If ~SHOW('ports','SPOT') then Do
  Address Command 'Run 'Spot_Path
  'WaitForPort SPOT'
  Quit=1
End

ADDRESS spot

Parse Arg AreaName TextPath
AreaName=Strip(AreaName)
TextPath=Strip(TextPath)

OPTIONS results

If TextPath='' Then Do
  Say
  Say 'Ooops! What file would you like me to act on? :-)'
  Say
  Exit 5
End

/* Configuration Section */

Name='All'
Title='BackYard BBS Filelist Report'

/* End of Configuration */

Origin='BlitzList V1.0, (C) Anthony Brice, 1996'

'spot2front'
'messages'
'gotoarea '||AreaName
'write TO "'||name||'" SUBJECT "'||title||'" FILE "'||TextPath||'" ORIGIN "'||origin||'" REFLOW=ON NOEDIT NOGUI'
'export CLOSEWIN'
'iconify'
If Quit=1 then Do
  'quit'
End
Exit 0

