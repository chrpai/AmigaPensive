/* Allfiles.trans */

options results

bbsidentify term
bbsline=strip(word(result,4))

befehl="host=show('P','FILELISTER."||bbsline||"')"
interpret befehl

if ~host then do
  address command 'run BBS:bin/FileLister '||bbsline
  address command 'waitforport FILELISTER'||bbsline
end

befehl="address 'FILELISTER."||bbsline||"' 'LISTFILES'"
interpret befehl

exit
