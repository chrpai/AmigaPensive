

   ECHO "DO NOT USE THIS PROGRAM UNTIL YOU HAVE USED THE INSTALLERS"

   ECHO "TO CREATE YOUR OWN SOURCE AND DESTINATION FILE YOU MUST FIRST DELETE"
   ECHO "THE FILE THAT WAS INSTALLED IN YOUR SYS:T DIRECTORY CALLED AUTO_KPREFS."
   ECHO " "
   ASK "PRESS A <RET>"
   requestchoice >env:ch "ABFDIK" "DELETE AUTO_KPREFS FILE FROM SYSTEM ?" "YES" "NO"

   IF $CH EQ "1"
    IF NOT EXISTS SYS:T/AUTO_K_PREFS
       ECHO "CAN'T FIND SYS:T/AUTO_K_PREFS"
       ASK "PRESS A <RET>"
       SKIP FIN
    ENDIF
       DELETE SYS:T/AUTO_K_PREFS
   ENDIF

LAB FIN

