/* FLST_Downloader.apt
**
** $VER: flst_downloader 0.0.3 (8.4.95)
**
** ARexx program for controlling ApT-BBS by ApT-Design.
**
** Copyright � 1993 ApT-Design All Rights Reserved,AG,DM
**
** Allows the user to download file-lists pertaining to the areas
** that he has access to, with or without archiving.
**
*/

parse arg lineno basenumber .

options results

portname = 'APTREXX'lineno
address value portname


ANSI_COL_FLG = 0 	/* Ansi Colour Flag	*/
ANSI_POS_FLG = 1	/* Ansi Positioning 	*/
ANSI_FLG_FLG = 2	/* ANSI at all!?		*/
ANSI_SCR_FLG = 3	/* Ansi Scrolling		*/
ANSI_CUR_FLG = 4	/* Ansi Cursor			*/
SCRN_CLR_FLG = 7	/* Screen Clears		*/

banks=0

CR = 'A'x

'INFORM' "User entering filelist generator"

/*
** Read in the FileData.ascii information
**/
if(open('Data_ascii','FLIST:FileData.ascii','R')) then do
	LastUpdated	= READLN('Data_ascii')
	RecentDays	= READLN('Data_ascii')
	call CLOSE('Data_ascii')
end


'SETSIG' "NEWSIG=0" ; old_sig = result

/*
** Menu:
**/
DO FOREVER


/* script version of menu - use a template instead */

	'msg' "%CLS."
	'msg' "\n"
	'msg' "\b1\c2[\c31\c2] \c7RECENT.LHA   \c6<-- Full "RecentDays" days old list,combining all areas you have access to\n"
	'msg' "\c2[\c32\c2] \c7SINGLE.LHA   \c6<-- Full File list of *this area*\n"
	'msg' "\c2[\c33\c2] \c7GLOBAL.LHA   \c6<-- Full File list combining all areas you have access to\n"
	'msg' "\c3-----------------------------------------------------------------------------\n"
	'msg' "\c2[\c3Q\c2]  \c7Quit Menu\n"
	'msg' "\c3-----------------------------------------------------------------------------\n"
	'msg' "\b0"

/*	'SHOWFILE' "menus/FLST_MENU"	*/

	'HOTKEY' "" ; key=upper(result)

	'ISDROP'		; if(result=1) then LEAVE

	'TEST_GFX_FLAG' ANSI_COL_FLG; ansicol=result
	'TEST_GFX_FLAG' ANSI_POS_FLG; ansipos=result
	'TEST_GFX_FLAG' ANSI_FLG_FLG; ansiflg=result

	if(ansicol & ansipos & ansiflg) then DO; ansi=1; SELECT
		when key="1" then do ; call ___ANSIRECENT ; call ___ANSIDOWNLOAD ; leave ; end
		when key="2" then do ; call ___ANSISINGLE ; call ___ANSIDOWNLOAD ; leave ; end
		when key="3" then do ; call ___ANSIGLOBAL ; call ___ANSIDOWNLOAD ; leave ; end
		when key="Q" then do ; leave ; end
		otherwise
	END; END
	else DO; ansi=0; SELECT
		when key="1" then do ; call ___RECENT ; call ___DOWNLOAD ; leave ; end
		when key="2" then do ; call ___SINGLE ; call ___DOWNLOAD ; leave ; end
		when key="3" then do ; call ___GLOBAL ; call ___DOWNLOAD ; leave ; end
		when key="Q" then do ; leave ; end
		otherwise
	END; END
END

'SETSIG' "NEWSIG="old_sig
EXIT

/*
** ___RECENT
**
** Takes care of the 'joining' of all of the RECENT
** ascii-file-lists that the user has access too.
**/

___RECENT: procedure expose CR LastUpdated RecentDays lineno

base = -1

DstFile = "ram:FileList."lineno

/*
** Write out our banner and such ,.
**/
if(open('bigfile',DstFile,Write)) then do
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"; Report for: Chiba City")
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"; Recent uploads to all areas accessable to you, within the last "RecentDays" days.")
	call WRITELN('bigfile',"; Oldest files displayed first, ..")
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"; Last updated on "LastUpdated".")
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"")
	call WRITELN('bigfile',"")
	call CLOSE('bigfile')
end


DO FOREVER
	'NEXTFILEBASE' base	; base=result
	if(base=-1) then return
	'msg' "Joining Recent base list #"base"...."

	SrcFile = "FLIST:REC-"base".lst"

	/*
	** At each new base we write out our
	** cut-lines and such, .. along with the actual base
	** number and the area name.
	**/
	if(exists(SrcFile)) then do
		'GETLIST' 'DATA "'SrcFile'"'
		'GETLIST' "AREA"	; areaname		= result
		'GETLIST' "TOTAL" ; listedfiles	= result

		if(OPEN('bigfile',DstFile,Append)) then do
		call WRITELN('bigfile',"Num  File           Size  Description of "areaname" [Area #"base"]")
		call WRITELN('bigfile',"---- -------------- ----  ----------------------------------------------------")
		call CLOSE('bigfile')
		end

	   'JOIN' 'FROM "'SrcFile'" TO "'DstFile'"'

		if(OPEN('bigfile',DstFile,Append)) then do
			call WRITELN('bigfile',"")
			call WRITELN('bigfile',"Files within area "listedfiles)
			call WRITELN('bigfile',"")
			call CLOSE('bigfile')
	   end
   end
	'msg' "Done..."CR
END
return

/*
** ___ANSIRECENT              ansi version of ___RECENT (procedure)
**
** Takes care of the 'joining' of all of the RECENT
** ascii-file-lists that the user has access too.
**/

___ANSIRECENT: procedure expose CR LastUpdated RecentDays lineno

base = -1

DstFile = "ram:FileList."lineno

/*
** Write out our banner and such ,.
**/
if(open('bigfile',DstFile,Write)) then do
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"; Report for: Chiba City")
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"; Recent uploads to all areas accessable to you, within the last "RecentDays" days.")
	call WRITELN('bigfile',"; Oldest files displayed first, ..")
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"; Last updated on "LastUpdated".")
	call WRITELN('bigfile',";")
	call WRITELN('bigfile',"")
	call WRITELN('bigfile',"")
	call CLOSE('bigfile')
end

FullPerBase = CountAreas();

call progress(INIT 1 '� File bases')

/*'msg' "%CPOS=8,0.%TC=7.%BC=0.     [FileBase:     ]"*/

i=1
DO FOREVER
	'NEXTFILEBASE' base	; base=result
	if(base=-1) then DO
		call progress(CLOCK 1 '%100')
		'msg' "%CPOS=8,0.                       \n\n\n\n"
		return
	END
	/*'msg' "%CPOS=8,17."base*/
	full = Progress(CLOCK 1 '%'||i*FullPerBase)
	i=i+1
	SrcFile = "FLIST:REC-"base".lst"

	/*
	** At each new base we write out our
	** cut-lines and such, .. along with the actual base
	** number and the area name.
	**/
	if(exists(SrcFile)) then do
		'GETLIST' 'DATA "'SrcFile'"'
		'GETLIST' "AREA"	; areaname		= result
		'GETLIST' "TOTAL" ; listedfiles	= result

		if(OPEN('bigfile',DstFile,Append)) then do
		call WRITELN('bigfile',"Num  File           Size  Description of "areaname" [Area #"base"]")
		call WRITELN('bigfile',"---- -------------- ----  ----------------------------------------------------")
		call CLOSE('bigfile')
		end

	   'JOIN' 'FROM "'SrcFile'" TO "'DstFile'"'

		if(OPEN('bigfile',DstFile,Append)) then do
			call WRITELN('bigfile',"")
			call WRITELN('bigfile',"Files within area "listedfiles)
			call WRITELN('bigfile',"")
			call CLOSE('bigfile')
	   end
   end
END
return

