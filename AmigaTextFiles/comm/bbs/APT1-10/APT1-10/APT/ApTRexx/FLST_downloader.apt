/*
** ___DOWNLOAD
**
**/

___DOWNLOAD: procedure expose CR LastUpdated RecentDays lineno

SrcFile = "ram:FileList."lineno

if(exists(SrcFile)) then do

archive = "address command 'LHA -x0 -f -u -m -P-1 a ram:flist"lineno".lha ram:FileList."lineno"'"

'msg' "\nArchive File [y/N] => "

'HOTKEY' "" ; ans=upper(result)

'ISDROP' ; if result=1 then break

'msg' "\n\n"

if ans ~= 'Y' then filename=SrcFile
else DO; 'msg' "Archiving (please wait...)"; interpret archive; filename="ram:flist"lineno".lha"; end

'msg' "\nContinue with Download [y/N]"

'HOTKEY' "" ; ans=upper(result)

'ISDROP' ; if result=1 then break

'msg' "\n\n"

if ans = 'Y' then 'XFEROPTS' 'CLEARLIST TAGFILE "'filename'" SENDFILES'

'REMOVEFILE' filename
if SrcFile ~= filename then 'REMOVEFILE' SrcFile

return

'SETSIG' "NEWSIG="old_sig
EXIT

/*
** ___ANSIDOWNLOAD    - progress indicator, colour, etc..
**
**/

___ANSIDOWNLOAD: procedure expose CR LastUpdated RecentDays lineno

SrcFile = "ram:FileList."lineno

if(exists(SrcFile)) then do

archive = "address command 'LHA -x0 -f -u -m -P-1 a ram:flist"lineno".lha ram:FileList."lineno"'"

'msg' "\n%TC=7.Archive File [%TC=2.y%TC=7./%TC=1.N%TC=7.] => "

'HOTKEY' "" ; ans=upper(result)

'ISDROP' ; if result=1 then break

if ans ~= 'Y' then DO; 'msg' "%TC=1.No%TC=7.\n"; filename=SrcFile; end
else DO; 'msg' "%TC=2.Yes%TC=7.\nArchiving (please wait...)"; interpret archive; filename="ram:flist"lineno".lha"; end

'msg' "\nContinue with Download [%TC=2.y%TC=7./%TC=1.N%TC=7.] => "

'HOTKEY' "" ; ans=upper(result)

'ISDROP' ; if result=1 then break

if ans = 'Y' then DO; 'msg' '%TC=2.Yes%TC=7.\n' ; 'XFEROPTS' 'CLEARLIST TAGFILE "'filename'" SENDFILES'; end
else 'msg' "%TC=1.No%TC=7.\n"

'REMOVEFILE' filename
if SrcFile ~= filename then 'REMOVEFILE' SrcFile

return
'SETSIG' "NEWSIG="old_sig
EXIT


/*
**
** CountAreas, a slow method of finding how many areas there are :)
**
** Returns, well, pretty obvious aint it .. 
**
*/

CountAreas: procedure

TotalBases=0	/* Does this business take up much time I wonder.. */
base=-1
DO FOREVER
	'NEXTFILEBASE' base; base=result
	TotalBases=TotalBases+1
	if base = -1 then break
END

return 100/TotalBases

/* ######################## Progress() related procedures ##################### */


/*
**
**	Progress(<RESET num | INIT num | CLOCK num>	<num | %num | TEXT>)
**
** returns 1 if bar is FULL or BARNUMBER INVALID, else 0.
**
*/

Progress: procedure expose info barnum info.1 info.2 info.3 info.4 data

parse arg com barnum data

RetC=0

com=upper(com)

SELECT
	when com="RESET"	then call Progress_Reset
	when com="INIT"	then call Progress_Init
	when com="CLOCK"	then RetC = Progress_Advance(barnum data)
		otherwise 'msg' "Unknown command: "com"\n"

END

return RetC



/*
**
**	Progress_Init
**
** Progress support routine: Initiate new bar associated with bar number
**
*/

Progress_Init:	procedure	expose barnum data info.1 info.2 info.3 info.4

data=right(data, length(data)-1)
DO while(length(data) < 15);	data=data||' ';	END
bar="%CPOS="||5+barnum||",1."||data||"[                                        ]   [   /]"
'msg' bar
call Progress_Reset
return


/*
**
**	Progress_Reset
**
**	Progress support routine: Fill up the bar with 'unset' characters
**
*/

Progress_Reset: procedure	expose barnum info.1 info.2 info.3 info.4

refresh="%CPOS="||5+barnum||",17.%TC=4.%BC=0.같같같같같같같같같같같같같같같같같같같같%TC=7.%BC=0.%CPOS="||5+barnum||",62.%TC=4.000%TC=7."
info.barnum=0
'msg' refresh
return


/*
**
**	Progress_Advance
**
**	Progress support routine: Advance a bar either one notch or to '%' full
**
**	NOTE:- If % is lower than present, reset and build back to %-full
**
*/

Progress_Advance: procedure	expose info.1 info.2 info.3 info.4

parse upper arg barnum data .

if left(data,1)='%' then do		/* setting to a percentage */
                          			/* Useful if you are precalculating the progression */
	per = right(data,length(data)-1)
	bars = 0.4 * per					/* (bar length / 100% * %) */
	if bars < info.barnum then call Progress_Reset
											/* BAGH! going backwards are we?! */
	data = bars - info.barnum		/* treat it as a normal CLOCK <TICS> command */
END

update=1

do while update ~> data
	if info.barnum >= 40 then return 1		/* also returns 1 if info.barnum not available */
	newpos="%CPOS="5+barnum||","||17+info.barnum||".%CURSOR=0.%TC=1.%BC=4."
		/* work out position and contents of percentage box */
		per = 2.5 * (info.barnum+1)
		if index(per, '.') > 0 then per = left(per, index(per, '.')-1)
		do while length(per) < 3; per='0'||per; END
		per="%CPOS="5+barnum",62."per"%TC=7."
	'msg' newpos||"�%TC=1.%BC=0."per
	update= update+1
	info.barnum=info.barnum+1
end

return 0
