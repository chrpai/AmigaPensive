*/

parse arg lineno
options results

portname = 'APTREXX'lineno

address value portname

'GETSTR' 0 		; name=result
'GETUSERDIR' name	; UserDir = result ; name=space(name,1,'_')
'msg' "\o1"

	CR = '0A'x
	green = '%TC=2.'
	yellow = '%TC=3.'
	magenta = '%TC=5.'
	cyan = '%TC=6.'
	white = '%TC=7.'
	italics = '%ITALICS=1.'
	bold = '%BOLD.'
	normal = '%ANSIRESET.'
	inverse = '%RVIDEO=1.'
	CLS = '%CLS.'


'MSG' green"\n\nA thought for today...\n\n" yellow
'DAVE_CMD' "GETQUOTE"
testit=(RESULT)
'MSG' testit
'HOTKEY' cyan"Press a key to continue: " white
EXIT

