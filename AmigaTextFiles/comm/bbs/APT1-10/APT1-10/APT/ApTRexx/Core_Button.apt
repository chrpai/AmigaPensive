/*
** PICTURE Menu
**
**/

/* PICTURE_BUTTONS: procedure expose CR */

PICTURE_BUTTONS:
refresh=1
reload=1
buttonnumber=0
F1 = getclip(F1)
F2 = getclip(F2)
F3 = getclip(F3)
F4 = getclip(F4)
F5 = getclip(F5)
F6 = getclip(F6)
'BUTTONOPTS' 'LOADBANK="tplates:button/PICTURE.bank" INITBANK'
'BUTTONOPTS' "SETPOS=0"
'SETSIG' "NEWSIG=5"


DO FOREVER

	if(reload) then do
		CALL REFRESH_BUTTONS "PICTURE"
		reload=0
	end

	if(refresh) then do
	'INFORM' "At PICTURE Menu."
	'MSG' "%CURSOR=0."
	'SETBREAK' "FMCLPDQWGN"
	'SHOWGLOBALFILE' "tplates:menus/menu_PICTURE.tpl"
	'BUTTONOPTS' "SETPOS="buttonnumber
	refresh=0
	end

	'BUTTONOPTS' "USEBANK" ; rawkey=result ; key=upper(rawkey)
	'BUTTONOPTS' "GETPOS"  ; buttonnumber = result

	'ISDROP'	 ; if(result=1) then break

	select
		when key=CR THEN DO
			/*
			** Another select within a select..
			**/
			select


			when buttonnumber=0 then do
		'INFORM' "Entering PICTURE File area..."
		call FILES_MENU 5
		refresh=1 ; end
			when buttonnumber=1 then do
				'INFORM' "Entering PICTURE Mail area..."
				'MAILLIST' 5	; refresh=1 ; end
			when buttonnumber=2 then do ; 'PAGESYSOP'					 ; refresh=1 ; end
			when buttonnumber=3 then do
				'INFORM' "Leaving Feedback."
				'SHOWGLOBALFILE' "tplates:menus/FeedBack.tpl"
				'MAIL_CMD' "FEEDBACK" ; refresh=1 ; end
			when buttonnumber=4 then do ; call PREFS_MENU 5			 ; refresh=1 ; reload=1  ; end
			when buttonnumber=5 then do ; call GAME_BUTTONS			 ; refresh=1 ; reload=1 ; end 
			when buttonnumber=6 then signal MAIN_MENU
			when buttonnumber=7 then do
				'INFORM' "Checking for waiting mail."
				'MAIL_CMD' "SHOWMAIL"	; refresh=1 ; end
			when buttonnumber=8 then do
				TX=2 ; TY=2
				CALL TERMINATE_BUTTONS
				'ISDROP' ; if(result=1) then break
				'BUTTONOPTS' 'LOADBANK="tplates:button/PICTURE.bank" INITBANK'
				'BUTTONOPTS' "SETPOS="buttonnumber
				end
			when buttonnumber=9 then do
				'INFORM' "PICTURE New File scan."
				'MSG' CLS
				'MSG' "%CURSOR=1."
				CALL NEWSCAN_SINCE_DATE
				refresh=1 ; end

			otherwise
			END
		END

		when key='F' then do ; 'BUTTONOPTS' "SETPOS=0"  ;  end
		when key='M' then do ; 'BUTTONOPTS' "SETPOS=1"  ;  end
		when key='C' then do ; 'BUTTONOPTS' "SETPOS=2"  ;  end
		when key='L' then do ; 'BUTTONOPTS' "SETPOS=3"  ;  end
		when key='P' then do ; 'BUTTONOPTS' "SETPOS=4"  ;  end
		when key='D' then do ; 'BUTTONOPTS' "SETPOS=5"  ;  end
		when key='Q' then do ; 'BUTTONOPTS' "SETPOS=6"  ;  end
		when key='W' then do ; 'BUTTONOPTS' "SETPOS=7"  ;  end
		when key='G' then do ; 'BUTTONOPTS' "SETPOS=8"  ;  end
		when key='N' then do ; 'BUTTONOPTS' "SETPOS=9"  ;  end
		when rawkey='F0'x then do ; 'CHATMODE' ;  CALL REFRESH_BUTTONS "PICTURE" ; end

		otherwise
		END
	END
EXIT
END


/*
** PROCEDURE: YESNO
**
** Used whenever requesting a [Y/n] [y/N] style hotkey input
**
** Flag = 1 for Default to YES, 0 for Default to NO on return
**
** RETURNS: 1 for YES and 0 for NO
*/

YESNO: procedure

parse arg Flag

'HOTKEY' ""
Key=upper(result)
if(Flag=0) THEN DO
	if(Key='Y') THEN DO
		'MESSAGE' "%BOLD=1.%TC=7.Yes%BOLD=0.%TC=7."
		Flag = 1
	END
	ELSE DO
		'MESSAGE' "%BOLD=1.%TC=7.No%BOLD=0.%TC=7."
		Flag = 0
	END
END
ELSE
if(Key='N') THEN DO
	'MESSAGE' "%BOLD=1.%TC=7.No%BOLD=0.%TC=7."
	Flag = 0
END
ELSE DO
	'MESSAGE' "%BOLD=1.%TC=7.Yes%BOLD=0.%TC=7."
	Flag = 1
END
	return Flag


