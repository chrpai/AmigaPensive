/* TogDisplay
**
** $VER: TogDisplay 0.0.1 (30.1.94)
**
** ARexx program for Toggling over BBS Display mode by ApT-Design.
**
** Copyright © 1994 ApT-Design All Rights Reserved,DM
**
** Demonstrates use of the new Arexx command "DISPLAY"
**
*/

parse arg lineno
options results
portname = 'APTREXX'lineno
address value portname

	'DISPLAY' ""		/* Null command will simply return Display
				status. 				*/
	status=(RESULT)
	if status = "On" then 'DISPLAY' "HIDE"
	else if status = "Off" then 'DISPLAY' "VIEW ACTIVATE"

EXIT

