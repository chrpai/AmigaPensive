/*
** PREFS_MENU:
**
**/
PREFS_MENU: procedure
F1 = getclip(F1)
F2 = getclip(F2)
F3 = getclip(F3)
F4 = getclip(F4)
F5 = getclip(F5)
F6 = getclip(F6)

parse arg prefarg

DO FOREVER
	'SHOWFILE' "pref/prf_choice"
	'HOTKEY' "  Choose an option: " ; rawkey=result ; key=upper(rawkey)
	'ISDROP' ; if(result=1) then return

	select
		when key="Q" then do
		return 0
		end
		when key="P" then do
		'EDITSTATS' 0
		end

		when key="B" then do
		var=getclip(MENUSET_VAR) ; 'SETVAR' var	1
		var=getclip(MENUSET_VAR) ; 'GETVAR' var	; menuset=result
 		return 1
		end
		when key="C" then do
		var=getclip(MENUSET_VAR) ; 'SETVAR' var	3
		return 3
		end
		when key="H" then do
		var=getclip(MENUSET_VAR) ; 'SETVAR' var	2
		return 2
		end

		when key="S" then do
		'EDITSTATS' 1
		end

		when key="M" then do
		'DAVE_CMD' "MAILSELECT" prefarg
		end

		when rawkey='F0'x then do ; 'CHATMODE' ; end

		otherwise
		end
	end

	'ISDROP' ; if(result=1) then return 0

END
return 0

/*
** AMIGA_MENU:
**
**/
AMIGA_MENU: procedure
F1 = getclip(F1)
F2 = getclip(F2)
F3 = getclip(F3)
F4 = getclip(F4)
F5 = getclip(F5)
F6 = getclip(F6)
DO FOREVER
	'SHOWFILE' "menus/MENU_AMIGA-HK"
	'HOTKEY' "%TC=7.  Your choice? " ; rawkey=result ; key=upper(rawkey)
	'ISDROP' ; if(result=1) then return
	var=getclip(MENUSET_VAR) ; 'GETVAR' var	; menuset=result ; if(result~=2) then return

	select
		when key="Q" then do
		return 0
		end
		when key="C" then do
			'PAGESYSOP'
		end
		when key="D" then do
			call GAMES_MENU
		end
		when key="F" then do
		'INFORM' "Entering file areas..."
		call FILES_MENU 1
		end
		when key="G" then do
			'CHAINAPT' "Logoff"
			'ISDROP' ; if(result=1) then return
		end
		when key="L" then do
			'MAIL_CMD' "FEEDBACK"
		end
		when key="M" then do
			'MAILLIST' 1
		end
		when key="P" then do
			call PREFS_MENU 1
		end
		when key="W" then do
			'MAIL_CMD' "SHOWMAIL"
		end

		when key="B" then do
		'INFORM' "Running QWK Bundler."
		'CHAINAPT' "QWKbuttons 1"
		end

		when key="N" then do
		'INFORM' "Doing NewFile Scan."
		'MSG' CLS
		CALL NEWSCAN_SINCE_DATE
		end

		when rawkey='F0'x then do ; 'CHATMODE' ; end

		otherwise	'MSG' "Rawkey was = "rawkey

		end

	end

	'ISDROP' ; if(result=1) then return

END
return

/*
** IBM_MENU:
**
**/
IBM_MENU: procedure
F1 = getclip(F1)
F2 = getclip(F2)
F3 = getclip(F3)
F4 = getclip(F4)
F5 = getclip(F5)
F6 = getclip(F6)
DO FOREVER
	'SHOWFILE' "menus/MENU_IBM-HK"
	'HOTKEY' "%TC=7.  Your choice? " ; rawkey=result ; key=upper(rawkey)
	'ISDROP' ; if(result=1) then return
	var=getclip(MENUSET_VAR) ; 'GETVAR' var	; menuset=result ; if(result~=2) then return

	select
		when key="Q" then do
		return 0
		end
		when key="C" then do
			'PAGESYSOP'
		end
		when key="D" then do
			call GAMES_MENU
		end
		when key="F" then do
		'INFORM' "Entering file areas..."
		call FILES_MENU 2
		end
		when key="G" then do
			'CHAINAPT' "Logoff"
			'ISDROP' ; if(result=1) then return
		end
		when key="L" then do
			'MAIL_CMD' "FEEDBACK"
		end
		when key="M" then do
			'MAILLIST' 2
		end
		when key="P" then do
			call PREFS_MENU 2
		end
		when key="W" then do
			'MAIL_CMD' "SHOWMAIL"
		end

		when key="B" then do
		'INFORM' "Running QWK Bundler."
		'CHAINAPT' "QWKbuttons 2"
		end

		when key="N" then do
		'INFORM' "Doing NewFile Scan."
		'MSG' CLS
		CALL NEWSCAN_SINCE_DATE
		end

		when rawkey='F0'x then do ; 'CHATMODE' ; end

		otherwise
		end
	end

	'ISDROP' ; if(result=1) then return

END
return

			/*
			** FILES_MENU:
			**/
			FILES_MENU: procedure

			parse arg new_sig

			Finished = 0
			F1 = getclip(F1)
			F2 = getclip(F2)
			F3 = getclip(F3)
			F4 = getclip(F4)
			F5 = getclip(F5)
			F6 = getclip(F6)

			'INITFILEAREA'

			'SETSIG' "NEWSIG="new_sig ; old_sig = result

			'SELECTAREA' ; selected_area = result
			if( selected_area == -1 ) then Finished = 1
			else 'TOUCHINDEX'

			'FILESTYLE' "RESET"

			DO WHILE Finished~=1

				'SHOWFILE' "file/fmenu"

				'HOTKEY' "" ; rawkey=result ; key=upper(rawkey)

				'ISDROP' ; if(result=1) then Finished = 1

				select
					when key="A" then do
						'SELECTAREA' ; selected_area = result
						if(selected_area == -1) then Finished=1
						else 'TOUCHINDEX'
					end
					when key="S" then						'SCANAREA'
					when key="=" then						'GLOBALNEWSCAN'
					when key='N' then						'LOCALNEWSCAN'
					when key='D'x | key='A'x then		'CONTINUESCAN'
					when key='M' then						'MARKFILE'
					when key='R' then						'REMOVEMARKED'
					when key='U' then						'UPLOAD'
					when key='D' then						'DOWNLOAD'
					when key='L' then						'LISTMARKED'
					when key='>' | key='.' then		'NEXTAREA'
					when key='<' | key=',' then		'PREVAREA'
					when key='V' then						'VIEWARCHIVE'
					when key='F' then						'FILTERMENU'
					when key='O' then						'FILTERSOFF'
					when key='-' then do 
						'FILEAREAINFO' "AREANUMBER" ; selected_area = result
						'CHAINAPT' "FLST_Downloader "selected_area
					end
					when key="Q" then do
						/*
						** As the user may wish to QUIT, he may, unknowingly
						** have forgot that they have files 'marked' for
						** download. We should be kind and remind them of this,
						** and give them the chance of sticking around.
						**/
						'MARKFILE' "QUERY" ; got_any_files = result
						if( got_any_files==1 ) then do
							'SHOWFILE' "file/filesmarked"	/* Inform of marked files	*/
							call YESNO 1						/* default to YES				*/
							if(result) THEN Finished=1		/* If TRUE, then finish.	*/
						end
						else Finished=1						/* Otherwise simply Quit	*/
					end
					when rawkey='F0'x then do ; 'CHATMODE' ; end
					otherwise
				end

				'ISDROP' ; if(result=1) then Finished = 1
			END

			'FREEFILEAREA'

			'SETSIG' "NEWSIG="old_sig ; old_sig = result

			'msg' "\z4\b1\c7Leaving File Area...\b0\z0\c7"

			return old_sig


			/*
			** NewScan:
			**
			** Takes care of doing all of the "file scanning since date"
			** functions without the need to have pre-accessed a file
			** area.. Example, shortly after logon ask the user if they
			** wish to scan for new files since last on.
			**/

NEWSCAN_SINCE_DATE: procedure

				'INFORM' "Scanning for files since date.."

				'FILESTYLE' "RESET"

				'INITFILEAREA'

				'FINDDEFAULTBASE' ; first_base = result

				if( first_base ~= -1) then do
					'TOUCHINDEX' first_base
					'GLOBALNEWSCAN'
				end

				/*
				** As the user may have ABORTED scanning, but STILL
				** have marked files, one needs to do the obvious
				** and check..
				**/
				'MARKFILE' "QUERY" ; got_any_files = result
				if( got_any_files==1 ) then do
					'SHOWFILE' "file/downnsmarked"
					call YESNO 1
					if(result) THEN 'DOWNLOAD'
				end

				'FREEFILEAREA'

			return


/*
** PICTURE_MENU:
**
**/
PICTURE_MENU: procedure
F1 = getclip(F1)
F2 = getclip(F2)
F3 = getclip(F3)
F4 = getclip(F4)
F5 = getclip(F5)
F6 = getclip(F6)
DO FOREVER
	'SHOWFILE' "menus/MENU_PICTURE"
	'HOTKEY' "%TC=7.  Your choice? " ; rawkey=result ; key=upper(rawkey)
	'ISDROP' ; if(result=1) then return
	var=getclip(MENUSET_VAR) ; 'GETVAR' var	; menuset=result ; if(result~=2) then return

	select
		when key="Q" then do
		return 0
		end
		when key="C" then do
			'PAGESYSOP'
		end
		when key="D" then do
			call GAMES_MENU
		end
		when key="F" then do
		'INFORM' "Entering file areas..."
		call FILES_MENU 5
		end
		when key="G" then do
			'CHAINAPT' "Logoff"
			'ISDROP' ; if(result=1) then return
		end
		when key="L" then do
			'MAIL_CMD' "FEEDBACK"
		end
		when key="M" then do
			'MAILLIST' 5
		end
		when key="P" then do
			call PREFS_MENU 5
		end
		when key="W" then do
			'MAIL_CMD' "SHOWMAIL"
		end

		when key="N" then do
		'INFORM' "Doing NewFile Scan."
		'MSG' CLS
		CALL NEWSCAN_SINCE_DATE
		end

		when rawkey='F0'x then do ; 'CHATMODE' ; end

		otherwise	'MSG' "Rawkey was = "rawkey

		end
	end

	'ISDROP' ; if(result=1) then return

END
return



/*
** PROCEDURE: YESNO
**
** Used whenever requesting a [Y/n] [y/N] style hotkey input
**
** Flag = 1 for Default to YES, 0 for Default to NO on return
**
** RETURNS: 1 for YES and 0 for NO
*/

YESNO: procedure

parse arg Flag

'HOTKEY' ""
Key=upper(result)
if(Flag=0) THEN DO
	if(Key='Y') THEN DO
		'MESSAGE' "%BOLD=1.%TC=7.Yes%BOLD=0.%TC=7."
		Flag = 1
	END
	ELSE DO
		'MESSAGE' "%BOLD=1.%TC=7.No%BOLD=0.%TC=7."
		Flag = 0
	END
END
ELSE
if(Key='N') THEN DO
	'MESSAGE' "%BOLD=1.%TC=7.No%BOLD=0.%TC=7."
	Flag = 0
END
ELSE DO
	'MESSAGE' "%BOLD=1.%TC=7.Yes%BOLD=0.%TC=7."
	Flag = 1
END
	return Flag


