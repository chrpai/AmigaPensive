**
** This is mearly to act as a very basic example of how you may wish
** to do things, or at least get started in the right direction.
**
** Editor TABS = Size of 3.
**
** NOTE: It is down to each of you to do your own 'LINE DROPPING' checks.
** If your scripts fail to pick a dropped carrier then you have to debug
** your own scripts, ... yourself :)
**
*/

/* ######################################################################### */

/*
** TABLE LIST AND DEFINES:
**
** Version 0.0.2
**
** The following block of code should remain untouched by 3rd party
** programmers. The block will be updated at times and all that will
** be required from you is to paste the new block in. You may
** alter code only when told specified.
*/

		/* Used within the CALLFUNCTION calls */

COMPUTERTYPE_CALL	= 0
COUNTRY_CALL		= 1
BIRTHDAY_CALL		= 2
PROTOCOL_CALL		= 3
ARCHIVER_CALL		= 4
SHOW_PASSWORD_AND_NAME_CALL = 5


		/* This block is used in the SET GFX FLAG  function ONLY */

ANSI_COL_FLG = 0 	/* Ansi Colour Flag	*/
ANSI_POS_FLG = 1	/* Ansi Positioning 	*/
ANSI_FLG_FLG = 2	/* ANSI at all!?		*/
ANSI_SCR_FLG = 3	/* Ansi Scrolling		*/
ANSI_CUR_FLG = 4	/* Ansi Cursor			*/
SCRN_CLR_FLG = 7	/* Screen Clears		*/

	/* This block is used in the GET VAR and  SET VAR ONLY */

ACCESSLEVEL_VAR 	= 0
VALID_VAR			= 1
CALLSMADE_VAR		= 2
MSGSLEFT_VAR		= 3
MSGSREC_VAR			= 4
UPLOADS_VAR			= 5
DNLOADS_VAR			= 6
BYTESUP_VAR			= 7
BYTESDN_VAR			= 8
BYTESLEFT_VAR		= 9
FILERATIO_VAR		= 10
BONUSRATIO_VAR		= 11
HOTKEY_VAR			= 12
EDITOR_VAR			= 13
COMPTYPE_VAR		= 14
SCRLENGTH_VAR		= 15
SCRWIDTH_VAR		= 16
GENDER_VAR			= 17
MORE_VAR				= 18
PROTOCOL_VAR		= 19
ARCHIVER_VAR		= 20
/* MENUSET_VAR			= 21 */

	/* This block is used in the GET STR and SET STR functions ONLY */

USERNAME_STR 		= 0
ADDR1_STR			= 1
ADDR2_STR			= 2
ADDR3_STR			= 3
POSTCODE_STR		= 4
COUNTRY_STR			= 5
VOICENO_STR			= 6
DATANO_STR			= 7
PASSWORD_STR		= 8
HANDLE_STR			= 9

FIRELEN_OPT 		= 0
FIRECASE_OPT		= 1
FIREFILT_OPT		= 2

LETTER_FLT			= 1
NUMBER_FLT			= 2
ASCII_FLT			= 4
UPFIRST_FLT			= 8
PUNCT_FLT			= 16

FILE 					= 0
STRING 				= 1

USER_MEMBER			= 0	/* For the MOVEUSER function */
USER_NEW				= 1
USER_REVIEW			= 2

DAYS2REVIEW_STVAR		= 0
DAYSLASTCALL_STVAR	= 1

LASTDATECALL_STSTR		= 0
LASTTIMECALL_STSTR		= 1

F1 = getclip(F1)
F2 = getclip(F2)
F3 = getclip(F3)
F4 = getclip(F4)
F5 = getclip(F5)
F6 = getclip(F6)

CR = 'A'x
CLS = '%CLS.'

/* ######################################################################### */

parse arg lineno justlog .

options results

portname = 'APTREXX'lineno
address value portname

'SETMORE' 0

'RETURNCODE' 0

'GETSTATICVAR' 2 ; ansidetect=result
CALL TIME 'R'	/* Reset Elapsed time counter */

'GETVAR' ACCESSLEVEL_VAR	; level=result
'GETVAR' CALLSMADE_VAR 		; callsmade = result /* how many calls made */
'GETVAR' MSGSLEFT_VAR  		; msgsleft = result  /* How many msgs left  */
'GETSTR' USERNAME_STR  		; username = result  /* username				*/
var=getclip(MENUSET_VAR) ; 'GETVAR' var	; menuset=result

'SETMORE' 1

/*
** If the user is accessing here on 'default menu' syle, then we
** might as well remember which the real number of the menu and
** set it.
**/
if(menuset=0) then do
var=getclip(MENUSET_VAR) ; 'SETVAR' var	2
end

'MAIL_CMD'	"HASMAIL"
if result=1 then do
 'MSG' "%NL. You have waiting mail!%NL."
 'HOTKEY' "%NL. Press a key to continue: => "
END
ELSE DO
 'MSG' "%NL. A thought for the Day...%NL."
 'DAVE_CMD' "GETQUOTE"
 'MSG' "%TC=6." RESULT
 'HOTKEY' "%TC=7. Press a key to continue: => "
END

'MSG' "%NL."
'SMALLCMD' "SCANNEWS"
'msg' "Please press a key to continue =>%WAITKEY=1000."


/*
** MAIN_MENU:
**
**/
DO FOREVER
	var=getclip(MENUSET_VAR) ; 'GETVAR' var	; menuset=result ; if(result~=2) then break
	'INFORM' "At Main Menu."
	'SETBREAK' "FMCLPDXWGB12345"
/*	'SHOWFILE' "menus/main-HK"  */
	'SHOWFILE' "menus/mainbutton"
	'HOTKEY' "%TC=7. Ok What Now? " ;  rawkey=result ; key=upper(rawkey)
	'ISDROP'		; if(result=1) then break

	select
		when key="C" then do
			'PAGESYSOP'
		end
		when key="D" then do
			call GAMES_MENU
		end
		when key="B" then do
			'SHOWGLOBALFILE' "tplates:txt/apt-bbs.tpl"
			'HOTKEY' "%TC=7.Press a key =>"
		end
		when key="F" then do
		'INFORM' "Entering file areas..."
		call FILES_MENU 0
		end
		when key="G" then do
			'CHAINAPT' "Logoff"
			'ISDROP' ; if(result=1) then break
		end

			  when key="X" then do
			'INFORM' "CDROM Script."
			'CHAINAPT' "Aminet-CDROM"
			'ISDROP' ; if(result=1) then break
		end

		when key="L" then do
			'MAIL_CMD' "FEEDBACK"
		end
		when key="M" then do
			'MAILLIST' 0
		end
		when key="P" then do
			call PREFS_MENU 0	; if(result~=2) then break

		end
		when key="W" then do
			'MAIL_CMD' "SHOWMAIL"
		end
		when key="1" then do
			call AMIGA_MENU
		end
		when key="2" then do
			call IBM_MENU
		end

		when key="3" then do
		'INFORM' "Running QWK Bundler."
		'CHAINAPT' "QWKbuttons 0"
		end

		when key="4" then do
		'INFORM' "Doing NewFile Scan."
		'MSG' CLS
		CALL NEWSCAN_SINCE_DATE
		end

		when key="5" then do
			call PICTURE_MENU
		end

		when rawkey='F0'x then do ; 'CHATMODE' ; end

		otherwise
		  end

END
EXIT

/* ######################################################################### */

/*
