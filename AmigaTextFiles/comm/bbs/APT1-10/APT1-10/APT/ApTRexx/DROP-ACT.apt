/* TogDisplay
**
** $VER: DropUser 0.0.1 (30.11.95)
**
** ARexx program for Initiating Immediate Line Drop for User
**
** Copyright © 1995 ApT-Design All Rights Reserved,DM
**
** Demonstrates method of Arexx line drop (How Nasty of you!)
**
*/

parse arg lineno
options results
portname = 'APTREXX'lineno
address value portname

   'SMALLCMD' "REMOVEDLG"
   'SHOWFILE' "sys/sys_forcedoff"
   'msg' "%WAITKEY=250."
   'SHOWFILE' "review/review_day"
   'FLUSHACCOUNT'
   'DROPLINE'
	EXIT

