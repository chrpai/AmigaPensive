/* FSED.apt
**
** $VER: FSED.apt 0.0.3 (20.9.95)
**
** ARexx program for running a external FullScreen Editor.
**
** Copyright © 1995 ApT-Design All Rights Reserved,AG,DMc
**
*/

parse arg lineno msgbody msghead msgreply .

options results

portname = 'APTREXX'lineno
address value portname

'GETSTR' 0 		; name=result
'GETUSERDIR' name	; UserDir = result ; name=space(name,1,'_')
'msg' "\o1"

address value portname
'RUNEASYDOS' "%RAW. DOORS:FSED/FSEDIT L="lineno" N=%UNAME. b="msgbody" h="msghead" q=t:MSGREP>"lineno".TXT r=%SCRLENGTH."
EXIT

