**
*/

parse arg lineno
options results

portname = 'APTREXX'lineno

address value portname

'GETSTR' 0 		; name=result
'GETUSERDIR' name	; UserDir = result ; name=space(name,1,'_')
'msg' "\o1"

CR		= '0A'x
Game	 	= 'DOORS:H&S/HSclient 'name
Path		= 'T:H&S2-startup'lineno
block		= 	'failat 1000'	CR,
			'stack 20000'	CR,
			Game		CR,
			'endcli'	CR
	green = '%TC=2.'
	yellow = '%TC=3.'
	magenta = '%TC=5.'
	cyan = '%TC=6.'
	white = '%TC=7.'
	italics = '%ITALICS=1.'
	bold = '%BOLD.'
	normal = '%ANSIRESET.'
	inverse = '%RVIDEO=1.'
	CLS = '%CLS.'


'SHOWGLOBALFILE' "Doors:H&S/ChibaCity.txt"

DO
'MSG' ""
'MSG' cyan"Press Enter to continue "yellow||CR
'HOTKEY' "> "
Choice=UPPER(RESULT)
'ISDROP'		; if(result=1) then break

address command
call open 'temp',Path,write
call writeln('temp',block)
call close('temp')
address value portname
'RUNDOS' "%RAW. %CTRL_C. run >nil: newshell >nil: %HANDLER. from "Path
address command "delete "Path

END
EXIT

