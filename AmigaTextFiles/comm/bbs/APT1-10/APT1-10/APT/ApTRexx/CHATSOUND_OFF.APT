/* Standard ApTX header  -   Don't require the huge equates bit */

options results

parse arg lineno

portname = 'APTREXX'lineno

address value portname

/*------------------------------------------------------------------*/

if ~show('Libraries', 'rexxsupport.library') then do
 if ~addlib('rexxsupport.library', 0, -30, 0) then exit
end

/*------------------------------------------------------------------*/

if ~show('PORTS','RXTRACKER') then do;'APTXEND';exit;end /* Hmm!? */

address 'RXTRACKER' 'UNLOAD'

'APTXEND'	/* Normal ending */
exit

