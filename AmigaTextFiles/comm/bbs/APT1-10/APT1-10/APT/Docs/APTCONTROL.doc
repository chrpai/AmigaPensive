    if(HasAccess("5,10,15,20"))
    {
      DMsg("Your level must be either 5,10,15 or 20!");
    }

    if(HasAccess("20-50,255"))
    {
      DMsg("Your level must be in the range of 20-50 or 255!");
    }

    if(HasAccess("10,90-100,63,29"))
    {

