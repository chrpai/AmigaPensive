/*
** Zeus Shortcut Script
**
** MEBBS/Users.zsc
**
**   - This script will read a report generated by MEBBSue and add the
**     users to the Zeus user data base.
**
** $VER: Users.zsc 1.0 (19.02.96)
** Zeus Bulletin Board System (c)1992-1996 Alex May & Nick Loman
*/

Options Results
Address 'ZEUS'

say ''
say 'Zeus Bulletin Board System (c)1992-1996 Alex May & Nick Loman'
say 'MEBBS User Data Conversion Script - written by Nick Loman'
say ''

FirstUser = 1
User      = ''

options prompt 'Enter path to MEBBSue Report file, e.g. [1mRAM:MEBBSUE.Report[0m: '
pull Report
if Report ~= '' then do
	say ''
	if ~open( 'cfg', Report, 'R' ) then do
		say 'Cannot open 'Report'!'
		exit
		end

	do until eof( 'cfg' )
		ln = readln( 'cfg' );
		if length( ln ) > 0 then do
			select
				when Left( ln, 5 ) = 'Name:' then do
					/*
					** New User
					*/
					if FirstUser = 0 then do
						Call DoSave
						User = ''
						end

					UserName = Right( ln, Length( ln ) - 6 );
					say 'Adding new user 'UserName'...'

					MakeNewUser '"'UserName'"'
					if RC = 0 then do
						User = RESULT

						FirstUser = 0	

						SetUserFlag 'CRLF' User
						SetUserFlag 'ANSICOLOUR' User
						SetUserFlag 'ANSICOMP' User
						SetUserFlag 'ANSIPOS' User
						SetUserData 'ScrWidth' '"80"' User
						SetUserData 'ScrHeight' '"24"' User
						ClrUserFlag 'NO8BIT' User
						end
					end

				when Left( ln, 7 ) = 'Handle:' then do
					Alias = Right( ln, Length( ln ) - 8 );
					SetUserData 'ALIAS' '"'Alias'"' User
					end

				when Left( ln, 9 ) = 'Password:' then do
					Password = Right( ln, Length( ln ) - 10 );
					SetUserData 'PASSWORD' '"'Password'"' User
					end

				when Left( ln, 7 ) = 'Access:' then do
					Access = Right( ln, Length( ln ) - 8 )

					/* MEBBS SysOp = Zeus SysOp */
					if Access = 31 then Access = 255
					SetUserData 'ACCESS' '"'Access'"' User
					end

				when Left( ln, 6 ) = 'Calls:' then do
					Calls = Right( ln, Length( ln ) - 7 )

					SetUserData 'NUMCALLS' '"'Calls'"' User
					end

				when Left( ln, 10 ) = '  Address:' then do
					Street = readln( 'cfg' );
					NiceLine '"'Street'"'
					Street = RESULT

					SetUserData 'STREET' '"'Street'"' User

					MoreAddress = readln( 'cfg' );
					SetUserData 'TOWN' '"'MoreAddress'"' User
					end

				when Left( ln, 12 ) = '  Telephone:' then do
					Phone = Right( ln, Length( ln ) - 13 )

					SetUserData 'VOICEPHONE' '"'Phone'"' User			
					end

				otherwise	nop
				end
			end
		end

	if User ~= '' then Call DoSave

	call close( 'cfg' )
	end
else
	say 'Exiting...'

exit

DoSave:

	CopyTemplateLimits User
	SaveUser User
	UnloadUser User

	Return

