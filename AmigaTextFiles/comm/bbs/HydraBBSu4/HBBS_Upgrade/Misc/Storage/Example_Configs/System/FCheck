;

FileTypeDesc_LZX=LZX Archive
CheckerCMD_LZX=LZX
CheckerParams_LZX=t -m -F @F@
Error_LZX_1=BAD CRC
Error_LZX_2= BAD ]
Error_LZX_3=Operation failed
