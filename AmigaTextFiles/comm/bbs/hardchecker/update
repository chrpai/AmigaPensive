; $VER: hardcheker v1.8 installerscript v1.2update
;

(complete 0)

(set prg-version "1.8")

;====================================================================
; Einige Initialisierungen
;====================================================================


(set _prg                               "filechecker/checker")
(set _text                              "filechecker.guide")

(set #intro
(cat " Dieses Script kopiert das Update v1.8.2beta auf ihre Festplatte. Sie benötigen eine bereits Installierte version (mindestens v1.8)"
))



(set #select_Hadir_help
(cat "Bitte geben sie den pfad zum Checker an."
))

(set #select1_help
(cat "In diesem Menu koennen sie waehlen, ob sie die jeweilige version des programmteiles installieren wollen"
))

(message #intro)

(set destdir
        (askdir
                (prompt "Wohin soll das Update v1.8.2beta kopiert werden? \n")
                (help #select_hadir_help)
                (default "prometheus:extern")
        )
)

(copyfiles
          (prompt "Hardschecker v1.8.2beta kopieren?\n")
          (help "Die alte Checkerversion wird ueberschrieben")
          (source _prg)
          (dest destdir)
          (confirm)
)

(copyfiles
          (prompt "Neue Filechecker.guide kopieren?\n")
          (help "Die alte anleitung wird überschrieben!!")
          (source _text)
          (dest destdir)
 (confirm)
)

(set #extro
(cat "Die Installation vom hardchecker "prg-Version" ist nun beendet. Weitere Infos entnehmen sie bitte dem Filechecker.Guide im Verzeichniss "destdir"\n\nBitte starten sie als erstes Online den Hardchecker KonfigEditor um ihre konfig an evntl. Änderungen anzupassen!!"
))

(complete 100)
(message #extro)
