##MSG_CHANGENODEL
$(NORMAL)$(COL{5})Verändere Nr.  : $(COL{3})%3ld  %20s$(COL{5})   ( lösche Löschflag )\n
##MSG_NOACCESS
$(NORMAL)$(COL{5})Überspringe Nr.: $(COL{3})%3ld  %20s  $(NORMAL)$(COL{1})$(BOLD)Du bist hier kein Brettverwalter.$(NORMAL)\n$(NORMAL)$(COL{1})                                              Deswegen darfst Du nur eigene\n$(NORMAL)$(COL{1})                                              Files loeschen.\n\n
##MSG_FREEDEL
\n$(NORMAL)$(COL{7})Freiraum für das File auch abziehen ? 
##MSG_FREEDELHOWMANY
\n\n$(NORMAL)$(COL{7})  Filegrösse            Rate            Abzug\n $(COL{7})------------------------------------------------\n  $(COL{3})%-5ld$(COL{5}) kByte             $(COL{3})%-2ld         %-5ld$(COL{5}) kByte\n
##MSG_FREEADD
\n$(NORMAL)$(COL{7})Freiraum für das File auch wieder Gutschreiben ? 
##MSG_FREEADDHOWMANY
\n\n$(NORMAL)$(COL{7})  Filegrösse            Rate         Gutschrift\n $(COL{7})------------------------------------------------\n  $(COL{3})%-5ld$(COL{5}) kByte             $(COL{3})%-2ld         %-5ld$(COL{5}) kByte\n
