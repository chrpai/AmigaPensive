  Specifications of commands used in the PREFERENCES file for node setup
-----------------------------------------------------------------------------

ANSI_COLOR_NODE(n)              : DEFAULT: OFF
                                : Select use of AnsiColors on the nodescreen
                                  This will have no effect on windows on
                                  public screens

CARRIERWAIT(n)           (pn)   : DEFAULT: 60
                                : Number of seconds before the node will
                                  disconnect, when system picked up
                                  and answered phone, after receiving an
                                  RING indication.
                                  This has no effect if settings in
                                  modem is lower than specified here.

COLORS_NODE(n)           (pn)   : DEFAULT: 8

CHAT_ON(n)                      : DEFAULT: OFF
                                : Enable paging of system operator.

CAPITOL_FILES(n)                : DEFAULT: IGNORE
                                : Filenames in the directory files will
                                  be made uppercase. (FILENAME.LHA)

CONNECT_ID(n)            (pt)   : DEFAULT: CONNECT
                                : Set the CONNECT identification string
                                  sent by the modem when a carrier is
                                  received.

CALLERSLOG(n)                   : DEFAULT: OFF
                                : Select use of callerslog file.
                                  Activity on the node is reported in a
                                  file called CALLERSLOG.
                                  An exception:
                                   Errors which are of high importance to
                                   the system operator will be written to
                                   the callerslog ignoring selection.

DISABLE_QUICK_LOGONS(n)         : DEFAULT: OFF
                                : If you enable this, the quick logon option
                                  will be disabled.
                                  Quick logon option are selected at login
                                  on the bbs.

DEBUGLOG(n)                     : DEFAULT: OFF
                                : All errors occured when starting the system
                                  or while running, will be reported to a
                                  file called DEBUGLOG.

GUESTNAME(n)             (pt)   : NO DEFAULT
                                : If you specify a GUESTNAME, then it will
                                  be possible to log on the system with
                                  the selected name, and skipping the
                                  password request.
                                  GUEST account is default set to
                                  accesslevel 1.

FONT_NODE(n)             (pt)   : DEFAULT: SYSTEM FONT (normally Topaz)
                                : If you select another fonttype, it will be
                                  used in a nodewindow.
                                  If specified font is not located the server
                                  will report this back to you.
                                  You can only select fonts of 8 inches
                                  in size.

ICONIFYNODE(n)                  : DEFAULT: OFF
                                : Select this command if you want the node
                                  to start without opening a window.

INACTIVITYWAIT(n)        (pn)   : DEFAULT: 300
                                : Number of seconds before the system will
                                  disconnect the user if he is showing no
                                  activity.

IDLENODE(n)                     : DEFAULT: OFF
                                : Do not start node.
                                  Not will not initiate and await logon,
                                  Node will stay closed, until selected.

LACE_NODE(n)                    : DEFAULT: NORMAL
                                : Nodescreen will appear in INTERLACED mode.

LOCATION_NODE(n)         (pt)   : DEFAULT: SERVER SYSTEM SETTING
                                : If you want another geographic location
                                  for this node, use this command to select
                                  new location.

LOCALNODE(n)                    : DEFAULT: OFF
                                : If you do not want this node to use
                                  any serial driver.
                                  (normally a node used by the sysop only)

OWNSCREEN_NODE(n)        (pt)   : DEFAULT: OFF
                                : Set this if you want the nodewindow
                                  to appear on its own screen.

MODEM_INIT(n)            (pt)   : NO DEFAULT
                                : Set initialize string for modem.
                                  Init string is sent to the modem
                                  when node is started.

MODEM_ANSWER(n)          (pt)   : DEFAULT: ATA 
                                : Set Answer string
                                  When a RING is received, the modem
                                  will pick up the line using this command
                                  to answer the call.

MODEM_RING(n)            (pt)   : DEFAULT: RING
                                : This is the string the modem will compare
                                  with, to detect an incoming call.

MODEM_RESET(n)           (pt)   : NO DEFAULT
                                : Reset modem string
                                : This string is sent to the modem after each
                                  call. String should hold the settings which
                                  disables Autoanswer mode.

MODEM_OFFHOOK(n)         (pt)   : DEFAULT: ATH0
                                : String to put modem OFFHOOK

NAME_NODE(n)             (pt)   : DEFAULT: SERVER SYSTEM SETTING
                                : Name of this node, normally its the
                                  default name of bbs system selected in your
                                  server settings

NEWUSER_PASSWORD(n)      (pt)   : NO DEFAULT
                                : New User Password
                                : Password to be entered when a user
                                  continues to login on the system as new.

NAME_PROMPT(n)           (pt)   : DEFAULT: Enter your name:
                                : String prompt used at login.

NO_TIMEOUT(n)                   : NO DEFAULT
                                : Ignore inactivity timeout
                                  If you enable this for a node, there
                                  will be no checking for inactivity timeouts.

NO_QRS_MSG(n)                   : NO DEFAULT
                                : QRS codes disable
                                  If you want to prevent users from using
                                  QRS codes anywhere in the system set this
                                  command.

NOLASTCALLERS(n)                : DEFAULT: NOT USED
                                : Do not add user to lastcallers logfile.
                                : If you do not want users logged onto a node
                                  to be added to the system lastcallersfile
                                  enable this command.

PRIORITY_NODE(n)         (pn)   : DEFAULT: ServerPriority-1
                                : Set node priority
                                  Set priority for selected node,
                                  beware: Incorrect settings for priority
                                  will affect performance online and users
                                  transfering files.

PATH_NODE(n)             (pt)   : DEFAULT: SERVER SYSTEM SETTING
                                : Select path to where BBS SYSTEM is located
                                  If you want to start a node which will use
                                  different userdata and default txt files
                                  set path to location of new system.

PWHIDDENCHAR(n)          (pt)   : DEFAULT: *
                                : Change Hide character
                                  This character is repeated back to remote
                                  screen, when a string is entered, such as
                                  password.

QUIETNODE(n)                    : DEFAULT: OFF
                                : Hide node activity from WHO bbscommand.
                                  If you do not want others to view actions
                                  and user on a specific node, when they
                                  use the WHO bbscommand.

QPRESET(n)               (pn)   : DEFAULT: 1
                                : Select default preset.
                                  Used with function key -Shift F6-,
                                  when you give access to a newuser.


REMOTEPASSWORD(n)        (pt)   : DEFAULT: NOT USED
                                : Select REMOTE PASSWORD

RINGCOUNT(n)             (pn)   : DEFAULT: 1
                                : Number of rings before the node accepts
                                  a call. You can set the system to accept
                                  a call after a (pn) of times.

STEALTH_MODE(n)                 : DEFAULT: OFF
                                : Show Systempassword information first.
                                  You can select that a node will show
                                  user the systempassword information before
                                  the welcome message. And if he fails to
                                  enter the right password he will be
                                  disconnected.

SYSTEMPASSWORD(n)        (pt)   : DEFAULT: NOT USED
                                : System password for this node.
                                  If you want a node to be private and not
                                  allowing all calls to go through, set
                                  a password to be entered.


SCRWIDTH_NODE(n)         (pn)   : DEFAULT: 640
                                : Set nodescreen width
                                  You can alter default settings of screen width
                                  if you want to work with a wider screen.

SCRHIGHT_NODE(n)         (pn)   : DEFAULT: 256 (on NTSC=200)
                                : Set nodescreen height
                                  You can alter default screen height for the
                                  nodescreen.

SYSOPNAME(n)             (pt)   : DEFAULT: SERVER SYSTEM SETTING
                                : Set SYSOP name for this node.
                                  If you want a specific node to work with a
                                  different sysop, you can do it with this
                                  command.

SYSOP_CHAT_COLOR(n)      (pn)   : DEFAULT: 2
                                : Set Sysop chat color

SERIAL_BUFFER(n)         (pn)   : DEFAULT: 16384
                                : Change the serial drivers internal
                                  buffering. If you work with faster modems
                                  you might want to change the internal
                                  buffer for the serial driver.

SERIAL_DRIVER(n)         (pt)   : NO DEFAULT
                                : Set serial driver name
                                  Name of serial driver to be used with this
                                  node.
                                  NOTE: name is case-sensitive, meaning
                                        if the devicename is spelled with
                                        lowercase letters, you must write
                                        it in the same way.
                                        WRONG  : SERIAL.DEVICE
                                        CORRECT: serial.device
                                  It is seen, that some device names is not
                                  using the correct standard for device names
                                  so to allow use of those drivers, YOU must
                                  be the one to be aware of this.
                                  A way of finding out is viewing the
                                  serial driver with a text viewer and search
                                  for the device name.

SERIAL_UNIT(n)           (pn)   : NO DEFAULT
                                : Set serial unit number

SERIAL_BAUD(n)           (pn)   : NO DEFAULT
                                : Set serial initialize baud
                                  Init baud is a number between 300-230400

SYSOPENTER(n)            (pt)   : DEFAULT: [37mSysop breakin[37m
                                : Set string for sysop entering chat.
                                  NOTE: You can use QRS codes in this string,
                                  So you will be able to type a textfile, or
                                  use the username in the string.

SYSOPLEAVE(n)            (pt)   : DEFAULT: [37mSysop is leaving[37m
                                : Set string for sysop entering chat.
                                  NOTE: You can use QRS codes in this string,
                                  So you will be able to type a textfile, or
                                  use the username in the string.

USEREDITWINDOW_PUBLIC(n)        : DEFAULT: OFF
                                : Edituser window opened on your public screen
                                  or server screen if used.

USERNUMBER_LOGIN(n)             : DEFAULT: OFF
                                : Allow users to login with their account-
                                  number/slot number.


USER_CHAT_COLOR(n)       (pn)   : DEFAULT: 1
                                : Set User chat color. Can be 1-7

UDLOG(n)                        : DEFAULT: OFF
                                : Make log files for upload/download
                                  activities.
                                  This file will hold information about
                                  all uploads/downloads made on this node
                                  file is called: UDLOG

VIEW_PASSWORD(n)                : DEFAULT: OFF
                                : View password when being entered.
                                  This will allow you and the user to view
                                  the password being entered.

WINWIDTH_NODE(n)         (pn)   : DEFAULT: 640
                                : Select Nodewindow width

WINHIGHT_NODE(n)         (pn)   : DEFAULT: 256 (NTSC=200)
                                : Select Nodewindow height

---------------------------------
SERIAL_QUEUEDBRK(n)             : DEFAULT: OFF
SERIAL_PARITYODD(n)             : DEFAULT: OFF
SERIAL_PARITYON(n)              : DEFAULT: OFF
SERIAL_STARTBIT(n)       (pn)   : DEFAULT: 8
SERIAL_STOPBIT(n)        (pn)   : DEFAULT: 1
SERIAL_BREAK(n)          (pn)   : DEFAULT: 250000
ENABLE_XON_XOFF(n)              : DEFAULT: OFF
DISABLE_RADBOOGIE(n)            : DEFAULT: ON		;Highspeed mode
DISABLE_RTSCTS_HANDSHAKE(n)     : DEFAULT: ON
SERIAL_SHARED(n)                : DEFAULT: OFF
