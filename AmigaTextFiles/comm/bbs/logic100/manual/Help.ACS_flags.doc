-----------------------------------------------------------------------------




         Setup commands used in the USERTYPE / ACCESSLEVEL files
-----------------------------------------------------------------------------


ACS_ATTACH_FILE                 : DEFAULT: OFF
                                : User will be able to attach files to
                                  messages

ACS_FILE_LISTINGS               : DEFAULT: OFF
                                : User will be able to list files with
                                  the internal commands

ACS_ACCOUNT_EDITING             : DEFAULT: OFF
                                : Edit accounts using the "U" bbscommand.
                                  from mail.

ACS_BREAKCHAT                   : DEFAULT: OFF
                                : User can exit chatting with sysop using
                                  CTRL-C.

ACS_COMMENTSYSOP                : DEFAULT: OFF
                                : User can leave a comment to sysop using
                                  the internal "C" bbscommand.

ACS_DOWNLOAD                    : DEFAULT: OFF
                                : User can use the internal "D" bbscommand
                                  to transfer files.

ACS_DISPLAY_USER_STATS          : DEFAULT: OFF
                                : User can view his current status using
                                  the internal "S" bbscommand.

ACS_DELETE_MESSAGE              : DEFAULT: OFF
                                : User can delete mail not written by him

ACS_EDIT_USER_NAME              : DEFAULT: OFF
                                : User can alter his name/handle

ACS_EDIT_USER_LOCATION          : DEFAULT: OFF
                                : User can alter his location

ACS_EDIT_PHONE_NUMBER           : DEFAULT: OFF
                                : User can alter his phonenumbers

ACS_EDIT_PASSWORD               : DEFAULT: OFF
                                : User can change password(s)

ACS_ENTER_MESSAGE               : DEFAULT: OFF
                                : User can write messages using the internal
                                  "E" bbscommand

ACS_EALL_MESSAGES               : DEFAULT: OFF
                                : User can enter messages which will be sent
                                  to all users on the bbs as "important"

ACS_JOIN_CONFERENCE             : DEFAULT: OFF
                                : User can join another conference using the
                                  internal "J" bbscommand.

ACS_MCI_MESSAGE                 : DEFAULT: OFF
                                : User can enter QRS codes in a message

ACS_OLM                         : DEFAULT: OFF
                                : User can send messages to other nodes
                                  using the internal "OLM" bbscommand.

ACS_OVERRIDE_CHAT               : DEFAULT: OFF
                                : Users timelimit in multichat will be ignored

ACS_OVERRIDE_TIMES              : DEFAULT: OFF
                                : Users daily timelimit online will be ignored

ACS_PAGE_SYSOP                  : DEFAULT: OFF
                                : User will be able to Page to sysop using the
                                  internal "O" bbscommand.

ACS_QUIET_NODE                  : DEFAULT: OFF
                                : User will be able to use the internal
                                  bbscomand "Q" to quiet his node, from being
                                  showed in the WHO command.

ACS_READ_BULLETINS              : DEFAULT: OFF
                                : User will be able to view the bulletins section
                                  using the internal bbscommand "B"

ACS_READ_MESSAGE                : DEFAULT: OFF
                                : User will be able to read messages with the
                                  internal bbscommand "R".

ACS_RELOGON                     : DEFAULT: OFF
                                : User will be able to relogon the system using
                                  the internal "RL" bbscommand.

ACS_REMOTE_SHELL                : DEFAULT: OFF
                                : User will be able to go into shell from remote

ACS_SYSOP_READ                  : DEFAULT: OFF
                                : User will be able to read mail which is
                                  written as private mail to others than himself.

ACS_SYSOP_VIEW                  : DEFAULT: OFF
                                : User will be able to use the internal "VS"
                                  bbscommand

ACS_SYSOP_DOWNLOAD              : DEFAULT: OFF
                                : User will be able to download files directly
                                  from the disk/harddrive, using full path to
                                  file.

ACS_SYSOP_COMMANDS              : DEFAULT: OFF
                                : User can use sysop functions

ACS_UPLOAD                      : DEFAULT: OFF
                                : User will be able to use the internal
                                  bbscommand "U" to transfer a file.

ACS_WHO_IS_ONLINE               : DEFAULT: OFF
                                : User will be able to use the internal
                                  bbscommand "WHO" to view users on other nodes

ACS_VIEW_A_FILE                 : DEFAULT: OFF
                                : User will be able to use the internal
                                  bbscommand "V" to view textfiles in the
                                  file directories.

ACS_ZIPPY_TEXT_SEARCH           : DEFAULT: OFF
                                : User will be able to use the internal "Z"
                                  command.

