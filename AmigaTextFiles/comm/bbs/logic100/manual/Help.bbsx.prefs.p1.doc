-----------------------------------------------------------------------------




  Specifications of commands used in the PREFERENCES file for server setup
-----------------------------------------------------------------------------


BBS_LOCATION             (pt)   : DEFAULT: BBS:
                                : Path to where system is located
                                : ie.  BBS:

BBS_NAME                 (pt)   : NO DEFAULT
                                : Name of this system.
                                : This is the default name of the bbs.

BBS_GEOGRAPHIC           (pt)   : NO DEFAULT
                                : Location of system.
                                : This is the default geographic location
                                  of this system.

CAPTUREBUFFER            (pn)   : DEFAULT: 4096
                                : Set size of capture buffer allocated
                                  When capture mode is used.

CENTERWINDOW                    : DEFAULT: OFF
                                : Select server to be centered on you screen.

COSYSOPACCLEVEL          (pn)   : DEFAULT: 240
                                : Select CoSysop default accesslevel on
                                  the system.

DISKCACHE                (pn)   : DEFAULT: 8092
                                : Internal diskcache size.
                                  Used with loading setupfiles and
                                  pre-loading of textfiles.

DISPLAYFCHECKRESULT             : DEFAULT: OFF
                                : Display output from file checkers to
                                  user online.

FCHECKAFTERUL			: DEFAULT: DURING TRANSFER
				: Choose checking of files after a user
                                : is finished uploading, and check
                                : each file as they are being described.


HYDRACACHE                      : DEFAULT: OFF
                                : Select use of hydracache read/write buffers
                                  If you select cache off, then remember to
                                  disable the below parameters as well, as
                                  the selected buffer sizes will be allocated
                                  ignoring the cache on/off flag.

HYDRACACHEREAD           (pn)   : DEFAULT: 2048
                                : Hydra readcache buffersize

HYDRACACHEWRITE          (pn)   : DEFAULT: 2048
                                : Hydra writecache buffersize

ICONIFIED                       : DEFAULT: OFF
                                : Start server in iconified state
                                  If you started server from Workbench,
                                  you will see an application icon, and
                                  if you start from shell you will get
                                  a small status bar.

ICONIFYX                 (pn)   : DEFAULT: 0
                                : Select server iconifywindow X position
                                  Used in combination with shell startup.

ICONIFYY                 (pn)   : DEFAULT: 0
                                : Select server iconifywindow Y position
                                  Used in combination with shell startup.

LASTCALLERS              (pn)   : DEFAULT: OFF
                                : Select number of lastcalls to be saved
                                  in the lastcallers file.

LOCALDEFCONNECT          (pt)   : DEFAULT: CONNECT 14400/ARQ/V32
                                : Select the LOCAL connect string to
                                  sent to the node when a local login
                                  is made.

LONG_WHO                        : DEFAULT: OFF
                                : Select split viewing of other nodes,
                                  with the WHO BBScommand.

MIN_DISKSPACEFREE        (pn)   : DEFAULT: 1048576
                                : Select minimum space needed for
                                  uploading.

NEWUSERACCLEVEL          (pn)   : DEFAULT: 5
                                : Select NewUser accesslevel.
                                  When a user logs onto the system as newuser
                                  the account is given a default accesslevel.

NUMBER_CONFS             (pn)   : NO DEFAULT
                                : Specify number of conferences used with
                                  this system.

NODES                    (pn)   : NO DEFAULT
                                : Specify number of nodes used with this
                                  system.

NODESONLY                       : DEFAULT: OFF
                                : Select Server to start up with viewing
                                  nodes only.

OLM_PAGES                (pn)   : DEFAULT: 8
                                : Select the number of OnLine Messages the
                                  user can send to other nodes for each call.


PRIORITY                 (pn)   : DEFAULT: 5
                                : Specify the priority the server runs
                                  at.
                                  NOTE: The server must have the highest
                                        priority.
                                        If you DO set a node priority
                                        higher than the server,
                                        it will be detected and lowered
                                        to serverpriority-1.

PUBLICSCREEN                    : DEFAULT: OFF
                                : Start server windown on the public screen

REALNODENUMBER           (pn)   : DEFAULT: 1
                                : If you wish, you can set starting number
                                  for first node.
                                  This is only meant to be used with multiply
                                  servers started. (Future versions)
                                  If you select 0, then remember to setup a
                                  node config for a node 0, correctly.

RELATIVECONFS                   : DEFAULT: OFF
                                : Select conference numbers shown in
                                  order 1,2,3,....
                                  This will only affect a user which do not
                                  have access to conference 1 and up.
                                  So if they have access to conf 2,4 it will
                                  be shown as conf 1,2 .

RINGDELAY                (pn)   : DEFAULT: 5
                                : Specify the delay between each RING
                                  received from the modem.
                                  The delay between a detected RING
                                  may vary from country to country.

SYSOP                    (pt)   : DEFAULT: SysOp
                                : Select name of the SystemOperator for this
                                  system.

SUPPRESSTEXTSEARCH              : DEFAULT: OFF
                                : Deselect search of accesslevel dependent
                                  textfiles, and look only for files
                                  which have their access and if it is not
                                  found, look for the default (no acc.level)
                                  textfile.

SUPPRESS_OKCANCELREQ            : DEFAULT: OFF
                                : Suppress the OK/CANCEL requester shown
                                  if a directory is not found.
                                  This is only a help for those which
                                  have set the paths incorrectly
                                  and is not aware of this,
                                  Or if someone from remote tries to access
                                  paths which do not exsist.
                                  Normally this would hang the node and
                                  would not return until someone press
                                  the OK or CANCEL button.

SHARECONFDATA                   : DEFAULT: OFF
                                : Share conference information.
                                  This disables all information which
                                  would be selectable for each conference.
                                  such as: RATIO, ACCESSLEVEL,
                                           UPLOAD-DOWNLOAD BYTES
                                           etc...

SPLITNODES                      : DEFAULT: OFF
                                : Show nodes in server window, split up
                                  in seperate small windows.

STATUSBAR                       : DEFAULT: OFF
                                : Show "TODAYS STATUS" when server is being
                                  started.

SERVERX                  (pn)   : DEFAULT: 0
                                : Select Serverwindow X position when started

SERVERY                  (pn)   : DEFAULT: 0
                                : Select Serverwindow Y position when started

SERVERH                  (pn)   : DEFAULT: 0
                                : Select Serverscreen height, if you are
                                  running it with ownscreen.

SERVERW                  (pn)   : DEFAULT: 0
                                : Select Serverscreen width, if you are running
                                  it with ownscreen.

SCREENCOLORS             (pn)   : DEFAULT: 4
                                : Select number of colors serverscreen will
                                  be opened with.

SYSOPACCLEVEL            (pn)   : DEFAULT: 255
                                : Select the accesslevel of the SystemOperator
                                  This will also be used when a temporary
                                  sysop accesslevel is given.

SYSOP_PAGES              (pn)   : DEFAULT: 3
                                : Set number of times a user can page the
                                  system operator for one call.
