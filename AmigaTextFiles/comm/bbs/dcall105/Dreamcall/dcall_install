(complete 5)

(message "\nDreamcall v1.05\n\n"
         "Installer\n\n"
         "-+- Digital Design Production 1996-7 -+-"
)

(complete 10)

(set rexxdir
		  (askdir
					 (prompt "Where is your BBS Rexx Directory located?")
					 (help @askdir-help)
					 (default "BBS:Rexx")
		  )
)

(complete 20)

(set docsdir
		  (askdir
					 (prompt "Where is your BBS Docs Directory located?")
					 (help @askdir-help)
					 (default "BBS:Docs")
		  )
)

(complete 30)

					 (copyfiles (source "rexx") (dest (rexxdir)) (all))

(complete 40)

					 (copyfiles (source "docs/dreamcall.guide") (dest (docsdir)))

(complete 50)

(message "\n\n Now take a look at the docs please :-)")
					 (run "c/guide docs/dreamcall.guide")

(complete 60)

(message "\n\n Please edit logoff.trans to include an entry for Dreamcall\n"
			"Similair To:\n\n"
			"call 'bbs:rexx/dreamcall.trans\n"
)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:rexx/logoff.trans")
	)
)

(complete 70)

					 (run edline)

(complete 75)

(message "\n\n Please edit Main.rx to include an entry for\n"
			"viewing the days callers:\n\n"
			"e.g.\n\n"
			"| View Callers            10 -------- dreamview.trans"
)
(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Configs/main.rx")
	)
)

					 (run edline)

(complete 80)

(message "\n\n Please edit logon.trans to include an entry for\n"
			"viewing the days callers:\n\n"
			"e.g.\n\n"
			"call 'bbs:rexx/dreamdisp.trans'"
)
(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:rexx/logon.trans")
	)
)

(complete 85)

					 (run edline)

(complete 90)

(message "\n\n Please edit the .trans files and alter the\n"
			"variables to suite your needs:\n"
)
(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Rexx/dreamcall.trans")
	)
)

					 (run edline)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Rexx/dreamdisp.trans")
	)
)

(complete 95)

					 (run edline)

(complete 100)

(message "\n\n\n\n-<*>- Dreamcall Is Now Installed - Enjoy! -<*>-\n"
         "-<*>- Thanx For Choosing Digital Design -<*>-\n"
)
