/**/
Options Results

/* Change to suite your needs. */

_text="BBS:Text/"

/* ======================================================================== */

systeminfo '8'
bbsline=result

if ~exists(_text'dreamcall_'bbsline) then address command 'copy '_text'dreamcall_new '_text'dreamcall_'bbsline' >NIL:'
if ~exists(_text'dreamcall_'bbsline'.ansi') then address command 'copy '_text'dreamcall_new.ansi '_text'dreamcall_'bbsline'.ansi >NIL:'

sendfile "bbs:Text/dreamcall_"bbsline

newline
continue
exit
