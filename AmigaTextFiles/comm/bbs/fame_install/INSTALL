	(set #famelib								"\nNow copying FAME.Library...")
	(set #famelib_hlp		(cat		"The FAME.library is absolutly required to let FAME\n"
															"work, because some parts of FAME are integrated\n"
															"into this library. Also this library is required\n"
                              "to program additional FAME doors.\n\n" @ copylib-help))
	(set #fifolib								"\nNow copying FIFO.Library...")
	(set #fifolib_hlp		(cat		"FIFO (First In, First Out) library is used to allow\n"
