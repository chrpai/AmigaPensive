;=======================================================
;= PROCEDURE TO CHECK RETURNVALUE OF EXTERNAL PROGRAMS =
;=======================================================

(procedure p_checkit #checkvalue #name
	(
	(if (<> #checkvalue 0)
		(
		(set errline (#ERROR #name @ioerr))
		(abort errline)))
	)
)


;===============================================
;= FIRST SYSTEM-CHECKS TO DETERMINE USED AMIGA =
;===============================================

(if (< (/ (getversion) 65536) 37) ( (ABORT #bad-kick)))
(if (< (/ @installer-version 65536) 42) (abort #bad-installer))

(set used_cpu (database "cpu"))						;	CPU-Check for 020er Processors

(complete 0)
(user 2)
(message #introduction)
(complete 1)
(user 1)
(welcome)
(complete 5)
(set old_level @user-level)
(set fame_path (getassign fame_search))		; Check for FAME: assign
(if (<> fame_path "")											; Found FAME, ask if it should be
	(																				; replaced by this new Version
  (message #FameFound)
	(set @default-dest fame_path)
  (set laenge (strlen(fame_path)))
	(set laenge (- laenge 5))
  (set @default-dest (substr fame_path 0 laenge ))
	))
(complete 10)

;==================================================
;= CHECK FOR FREE SPACE AND VALID PATH TO INSTALL =
;==================================================


(set dirokay 0)
(set continue 1)
(while (= dirokay 0)
	(
	(set fame_path															; Get the FAME Destination
		(askdir (prompt 	#AskLocation)
						(help 		#AskLocHelp)
						(default 	@default-dest)))
	(if (= fame_path "") (abort #NO_LOCATION))	; No path given, aborting...
	(set bytes (getdiskspace(fame_path)))
	(set fame_path (tackon fame_path "FAME"))
	(if (< bytes min_bytes)
		(
		(set checkdev (getdevice(fame_path)))
		(if (<> checkdev "RAM")
			(
			(message (#NO_FREE_STORE checkdev))
      (set dirokay 0)
			(set continue 0)
     	)
			(
			(set continue 1)
			))
		)
		(
		(set continue 1)
		)
	)
	(complete 15)
	(if (= continue 1)
		(
	  (set dirokay
			(askbool (prompt (#Fame_Okay fame_path))	; Check if Drawer is okay
		           (help #Fame_Okay_Help)
							 (default 1)))
		))
	))

;==========================================
;= SET MAIN GLOBAL VARS TO CURRENT PATHES =
;==========================================

(set @default-dest fame_path)
(set fame_modules (tackon fame_path "Modules"))
(set fame_mainpart (tackon fame_modules "MainPart"))
(set fame_filecheck (tackon fame_modules "FAMEFileChecker"))
(set fame_hydra (tackon fame_path "DOORS/FAME/FAMEHydra/FAMEHydra.FIM"))

;=============================================================
;= CHECK FOR ASSIGN AND ASK HOW THE ASSIGN SHOULD BE HANDLED =
;=============================================================

(complete 20)

(makedir fame_path)														; Create some dirs
(makedir fame_modules)
(makeassign fame_search fame_path)						; Set assign + write to the
(set dummy (getassign fame_search))						; S:User-Startup file if needed
(if (= dummy "") (abort #NO_ASSIGN))

(complete 22)

(set autoassign
	(askchoice	(prompt	#askAssign)
							(help		#askassignhelp)
							(choices 	#user_startup
												#auto_assign)
							(default	1)))

(if (= autoassign 0)
	(
	(complete 24)

	(set commandline ("ASSIGN >NIL: FAME: %s" fame_path))
  (startup 	"FAME-BBS"
						(prompt	(#nowwriting commandline))
            (help		@startup-help)
            (command commandline))
	(set writeit 1)
  )
)

;===========================================================
;= INSTALL SERVER AND IT'S ICON TO USER-DEFINABLE LOCATION =
;===========================================================

(complete 26)

(set server_loc "")

(while (= server_loc "")											; Check out Dest. for Server
	(
	(set server_loc
		(AskDir (prompt		#AskForServerLoc)
						(help			#AskForServerHlp)
						(default  "Sys:WBStartup")))								; Replace Sys:WBStartup/
	)
)

(complete 28)
(copyfiles	(prompt #copyserver)							; Copy Server to destination
            (help		#copyserverhlp)
						(source "FAME_Install:bin/Server")
						(dest		server_loc)
						(infos))

(if (= autoassign 1)
	(
	(complete 29)
  (set newtt (tackon server_loc "Server"))
	(tooltype (dest newtt)
						(settooltype "BBSLOCATION" fame_path)
						(settooltype "AUTOASSIGN" ""))
	(set writeit 1)
	)
)

;===========================================
;= INSTALL REQUIRED LIBRARIES AND HANDLERS =
;===========================================

(complete 30)

(set fame_libs																; Ask for Library Path (i.e. LIBS:)
	(AskDir	(prompt #asklibdir)
					(help		#asklibdirhelp)
          (default "LIBS:")))									; Replace with LIBS:

(copylib	(prompt	#famelib)										; Install FAME.library
					(help		#famelib_hlp)
					(source "FAME_Install:libs/FAME.library")
					(dest		fame_libs)
          (confirm))

(complete 32)

(copylib	(prompt	#fifolib)										; Install fifo.library
					(help		#fifolib_hlp)
					(source "FAME_Install:libs/fifo.library")
					(dest		fame_libs)
          (confirm))

(complete 34)

(copyfiles	(prompt #fifohandler)								; Install fifo-handler
						(help		@copyfile-help)
						(source	"FAME_Install:l/fifo-handler")
						(dest		"l:"))

(complete 36)

(set commandline "run >NIL: <NIL: L:Fifo-Handler")
(set FIFOYES
	(askbool 	(prompt	(#askforfifo commandline))
						(help		#askforfifohlp)
						(default 1)))

(if (= FIFOYES 1)
	(
	(complete 37)

  (startup 	"FIFO"                            ; Write FIFO Start to User-startup
					 	(prompt	(#writefifo commandline))
            (help		@startup-help)
	          (command commandline))
	)
)

(complete 38)

(copylib	(prompt	#fileidlib)                 ; Install FileID.library
					(help		#fileidlib_hlp)
					(source "FAME_Install:libs/FileID.library")
					(dest		fame_libs)
          (confirm))

(complete 40)

(copylib	(prompt	#xprzlib)										; Install xprzmodem.library
					(help		#xprzlib_hlp)
					(source "FAME_Install:libs/xprzmodem.library")
					(dest		fame_libs)
           (confirm))

(complete 42)

(copyfiles	(prompt	#shellstart)							; FAME Shell Startup -> S:
						(help		#shellstarthlp)
						(source	"FAME_Install:s/FAME-Startup")
						(dest		"S:")										; Replace with S:
						(confirm))

(copyfiles  (Prompt 	"")											; Copy lha to RAM: to allow
						(help			"")											; diskchanging while depacking
            (source 	"FAME_Install:c/")
						(choices 	"lha"
											"FAMEDataPatcher"
											"TxtAdd")
            (dest 		"RAM:")
						(nogauge))



;===============================================================
;= EXTRACT THE MAIN ARCHIVES COMMING FROM DISK "FAME_MAINFILES =
;===============================================================

(complete 44)

(set dummy (#insertdisk1 "FAME_MainFiles:"))
(askdisk 		(prompt dummy)										; Check for right disk to continue
						(help		#insertdisk1help)
						(dest		"FAME_MainFiles")
						(assigns))

(complete 50)																	; Installing FAMEMain.lha

(working #ARCHIVE1)
(set 	cmdline ("RAM:LHA -q x FAME_MainFiles:FAMEMain.lha %s" fame_assign))
(set myerr
	(run 	cmdline
    	  (prompt	#ARCHIVE1)
				(help		#ARCHIVE1HLP)))
(p_checkit myerr "LHA")

(complete 55)																	; Installing FAMEMods.lha

(working #ARCHIVE2)
(set 	cmdline ("RAM:LHA -q x FAME_MainFiles:FAMEMods.lha %s" fame_assign))
(set  myerr
	(run 	cmdline
      	(prompt	#ARCHIVE2)
				(help		#ARCHIVE2HLP)))
(p_checkit myerr "LHA")

;======================================================
;= CHECK IF DOCS AND FILECHECKERS SHOULD BE INSTALLED =
;======================================================

(complete 56)

(set miscchoice
	(AskOptions (prompt #askformisc)
							(help		#askformischelp)
							(choices  #englishdocu
												""
												"Archiver")))
(set dummy 0)

(if (IN miscchoice 0) (set dummy 1))
(if (IN miscchoice 2) (set dummy 1))

(if (= dummy 1)
	(
	(set dummy (#insertdisk1 "FAME_Docs_and_Misc:"))
	(askdisk 		(prompt dummy)										; Check for disk to continue
							(help		#insertdisk1help)
							(dest		"FAME_Docs_and_Misc")
							(assigns))

	(if (IN miscchoice 0)
		(
		(set #dummy2 (#EXTARCHIVE "FAMEDocu.lha"))
		(working #dummy2)
		(set #cmdline ("RAM:lha -q x FAME_Docs_and_Misc:FAMEDocu.lha %s" fame_assign))
		(set  #myerr
			(run 	#cmdline
		      	(prompt	(#dummy2))
						(help		#DOCARCHIVEHELP)))
		(p_checkit #myerr "LHA")
		))
	(if (IN miscchoice 2)
		(
		(set #dummy2 (#EXTARCHIVE "FAMEMisc.lha"))
		(working #dummy2)
		(set cmdline ("RAM:lha -q x FAME_Docs_and_Misc:FAMEMisc.lha %s" fame_assign))
		(set  #myerr
			(run 	cmdline
		      	(prompt	(#dummy2))
						(help		#DOCARCHIVEHELP)))
		(p_checkit #myerr "LHA")
		))

	))

;==================================================================
;= NOW LET THE USER CHOOSE WHICH FILES OF FAME SHOULD BE RESIDENT =
;==================================================================

(complete 60)

(set	fame_set (tackon fame_path "Settings/"))
(set resprg
	(AskOptions	(prompt	#resprompt)							; Enter resident Programs
							(help		#resprompthlp)
							(choices	"MainPart        370 kb"
												"FAMEFileChecker   5 kb"
												"FAMEHydra        55 kb")))

	(set res0 ("Resident %s PURE" fame_mainpart))
	(set res1	("Resident %s PURE" fame_filecheck))
	(set res2	("Resident %s PURE" fame_hydra))
	(set bat  (tackon fame_set "FAMEStart.BAT"))
	(set patchnode 0)
	(set patchmods 0)

(complete 62)

(if (IN resprg 0)
	(
	(set #cmdline ("RAM:TxtAdd %s %s" bat res0))			; MainPart resident
	(set myerr
		(run	#cmdline
					(prompt (#writefile res0))
					(help		#writefilehelp)))
	(p_checkit myerr "TxtAdd")												; Check for error
	(set patchnode 1)
))

(complete 64)

(if (IN resprg 1)
	(
	(set #cmdline ("RAM:TxtAdd %s %s" bat res1))			; FileChecker resident
	(set myerr
		(run	#cmdline
			(prompt (#writefile res1))
			(help		#writefilehelp)))
	(p_checkit myerr "TxtAdd")
	(set patchmods 1)
))

(complete 66)

(if (IN resprg 2)
	(
	(set 	#cmdline ("RAM:TxtAdd %s %s" bat res2))	; Hydra resident
	(set  myerr
		(run	#cmdline
			(prompt (#writefile res2))
			(help		#writefilehelp)))
	(p_checkit myerr "TxtAdd")
))

(protect bat "+s")

(complete 68)

(message #systeminfotext1)										; Info about SystemEditor

(complete 70)

(set sysedloc (tackon fame_modules "SystemEditor"))
(set cmdline ("%s BBSLOCATION=%s CREATE JUMP=1 WINCLOSEQUIT" sysedloc fame_assign))
(set myerr
	(run cmdline																			; Start SystemEditor
  	  (prompt #sysedstart1)
			(help		#systeminfotext1)))
(p_checkit myerr "SystemEditor")

(complete 76)

(if (= patchnode 1)             							; Patch Resident Mainpart
	(
	(set nodeloc (tackon fame_path "Settings/Node0/Node.dat"))
	(set cmdline ("RAM:FAMEDataPatcher %s 0 MainPart" nodeloc))
	(set myerr
		(run cmdline
				(prompt "Patching...")
				(help		"Patching Node.dat...")))
	(p_checkit myerr "FAMEDataPatcher")
	)
)

(complete 78)

(if (= patchmods 1)                           ; Patch Resident FileChecker
	(
	(set modsloc (tackon fame_path "Modules/FAMEModules.dat"))
	(set cmdline ("RAM:FAMEDataPatcher %s 1 FAMEFileChecker" modsloc))
	(set myerr
		(run cmdline
				(prompt "Patching...")
				(help		"Patching FAMEModules.dat...")))
	(p_checkit myerr "FAMEDataPatcher")
	)
)

(complete 80)

(set batchcopy																; Ask for Multi-Top/Lastcallers
	(AskBool	(prompt #askbatch)
						(help   #batchhelp)
						(default	1)))

(complete 82)

(if (= batchcopy 1)														; Copy batchfiles
	(

	(complete 84)

	(set whichone
		(AskOptions	(prompt		#choosebatch)				; Select the Batches
								(help			#batchhelp)
								(choices  "Multi-Top"
													"LastCallers")))

	(set nodedir (tackon fame_path "Node0/NodeBatches/LogoffBatches/"))

	(complete 86)

  (if (IN whichone 0)													; Install Multi-Top
		(
		(set multi	(tackon nodedir "MULTI-TOP"))
		(set entry	(tackon fame_path "Modules/ExternModules/Multi-Top"))
		(textfile	(prompt "Creating Multi-Top script...")
	            (help	#batchhelp)
							(dest	multi)
							(append entry))
		(protect multi "+s")))

		(complete 88)

		(if (IN whichone 1)												; Install LastCallers
    	(
			(set multi (tackon nodedir "LASTCALLERS"))
			(set entry	(tackon fame_path "Modules/ExternModules/LastCallers"))
			(set clog	(tackon fame_path "NODE<node>/CALLERS.LOG"))
			(set addy	(".key node\n.bra <\n.ket >\n%s %s <node> 10 BULLETINS:LASTCALLERS.TXT" entry clog))
			(textfile	(prompt	"Creating LastCallers script...")
								(help	#batchhelp)
								(dest	multi)
								(append addy))
			(protect multi "+s")
			))
		))

(complete 99)

(delete "RAM:LHA")                            ; Clean Up after install
(delete "RAM:FAMEDataPatcher")
(delete "RAM:TxtAdd")

(complete 100)

(exit)
