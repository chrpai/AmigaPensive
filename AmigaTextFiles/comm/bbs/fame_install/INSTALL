;= INITIALISATION OF MAIN GLOBAL VARS =
;======================================

(set fame_search "FAME")		; FAME Searchname for Devices
(set fame_assign "FAME:")		; FAME Assign
(set fame_path "")					; FAME Path (if FAME exists, will be initialised!)
(set fame_modules "")				; FAME Path to Modules directory
(set fame_libs "")					; FAME Libraries drawer
(set fame_mainpart "")      ; MainPart path
(set fame_filecheck "")			; FileChecker Path
(set fame_hydra "")					; FAME Hydra Path
(set min_bytes 5500000)			; Minimum amount of Bytes free for Installation!
(set writetostartup 0)			; 1 = Was written to S:user-startup, 0 = not written
(set FIFOYES 0)							; 0 = not written to user-startup, 1 = was written

