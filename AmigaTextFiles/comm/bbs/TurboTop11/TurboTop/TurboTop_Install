(complete 5)

(message "I'm a FiRE STARTER\n"
         " TWiSTED FiRE STARTER!\n"
         "\n"
         "TurboTop v1.1\n"
         "Ultimate Top 10 TransAmiga Tool\n"
         "\n\n"
         "Installer\n\n"
         "-+- Digital Design Production 1996 -+-"
)

(complete 15)

(set cdir
		  (askdir
					 (prompt "Where do you want the executable copying?")
					 (help @askdir-help)
					 (default "BBS:Bin/")
		  )
)
(complete 25)

(set rxdir
		  (askdir
					 (prompt "Where is your BBS Rexx Dir located?")
					 (help @askdir-help)
					 (default "BBS:Rexx/")
		  )
)
(complete 35)

(set docsdir
		  (askdir
					 (prompt "Where do you want the guide file copying?")
					 (help @askdir-help)
					 (default "AmigaGuide:")
		  )
)

(complete 45)

(set txtdir
		  (askdir
					 (prompt "Where is your BBS Text Dir located?")
					 (help @askdir-help)
					 (default "BBS:Text")
		  )
)

(complete 50)

					 (copyfiles (source "text/TurboTop") (dest (txtdir)))
					 (copyfiles (source "text/TurboTop.ANSI") (dest (txtdir)))

(complete 55)

					 (copyfiles (source "bin/TurboTop") (dest (cdir)))

(complete 60)

					 (copyfiles (source "docs/TurboTop.guide") (dest (docsdir)))

(complete 65)

					 (copyfiles (source "rexx/TurboTop.Trans") (dest (rxdir)))
					 (copyfiles (source "rexx/TTDisplay.Trans") (dest (rxdir)))

(complete 70)

(message "\n\n Now take a look at the docs please :-)")
					 (run "c/guide docs/TurboTop.guide")

(complete 75)

(message "\n\n Please edit Main.Rx to include an entry for TurboTop Display\n"
			"Similair To:\n\n"
			"| View Top 10     10 -------- TTDisplay.Trans"
)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Configs/main.rx")
	)
)

(run edline)

(complete 80)

(message "\n\n Please edit your download.trans to activate TurboTop\n"
			"Add this line to your script:\n\n"
			"call 'BBS:Rexx/TurboTop.Trans'"
)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Rexx/Download.Trans")
	)
)

(run edline)

(complete 90)

(message "\n\n Please edit your upload.trans to activate TurboTop\n"
			"Add this line to your script:\n\n"
			"call 'BBS:Rexx/TurboTop.Trans'"
)

(set edline
	(askstring
		(prompt "\nPlease Enter Command Line To Run\n")
		(help "")
		(default "ced BBS:Rexx/Upload.Trans")
	)
)

(run edline)

(complete 100)

(message "\n\n\n\n-<*>- TurboTop Is Now Installed - Enjoy! -<*>-"
         "\n-<*>- Thanx For Choosing Digital Design -<*>-\n\n"
         "NOTE: You may need to edit TurboTop.Trans & TTDisplay.Trans"
         " To Suite Your System's Setup!\n"
)

(exit (quiet))
