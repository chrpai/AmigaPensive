/* Next User Message by Lord Adrenaline from Inorix Scripts!
   A little and nice door, to write a message to the 
   next user(s) ! :)
   This is the file to GET the message!
   Greetz to JAVE and /Y\orpheus!
   $VER: Next User Message v1.0 by Inorix Scripts
*/
;OPTIONS RESULTS;Version='Next User Message v1.0';CHANGEWHAT 'NUM';CHANGEWHERE 'GoodBye!';PATH='Doors:NUM/';GU=GETUSER;TR=TRANSMIT;SS=SENDSTRING;QU=QUERYN;QE=QUERY;/* It starts! ;) */;CLS;GU 1;alias=RESULT;QU '\c3Do you \c7REALLY\c3 want to logoff [y/N] ? ';Uh=RESULT;CALL CHECKPANIC uh;IF uh=Yes THEN CALL YO;ELSE IF uh=No THEN CALL NEE;EXIT;END;YO:;TR '\!3\c7=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=';TR '\c2             'version' \c6by \c3Lord Adrenaline \c6/ \c3Inorix Scripts';TR '\c7=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=';LOOP FOREVER;QU '\c3Wanna leave a message to the next user (y/N) ? ';x=RESULT;CALL CHECKPANIC x;IF x=Yes THEN CALL YES;ELSE IF x=No THEN CALL NOPE;EXIT;YES:;TR '\!2\c7Now it is time to write your message ! (Max 70 chars!)';QE '\c3Message =->\c6 ';mesg=RESULT;TR '\!2\c2Please wait, saving message...\w2';OPEN(file1,path||'Message.num',W);WRITELN(file1,alias);WRITELN(file1,mesg);CLS;TR '\c2'version' by \c6Inorix Scripts';TR '\c3Cyborg BBS fridays 21-24h CET +31(0)33-4804065';TR '\n1\c7You are about to leave \Vr\w3';CLOSEFILE(file1);CALL HANGEN;HANGEN:;HANGUP;END;CHECKPANIC:procedure;input=arg(1);if input="###PANIC" then;do;BUFFERFLUSH;SHUTDOWN;EXIT;end;RETURN;NOPE:;CLS;TR '\c3Ok m8, maybe next time!\w2';CLS;TR '\c3'version' by \c6Inorix Scripts';TR '\c7Cyborg BBS fridays 21-24h CET +31(0)33-4804065';TR '\n1\c2Thanx for calling to \Vr !!\w3';HANGUP;EXIT;NEE:;CLS;TR '\c3'version' by \c6Inorix Scripts';TR '\c2Cyborg BBS fridays 21-24h CET +31(0)33-4804065';TR '\n1\c7Returning to \Vr !!\w3';EXIT;END