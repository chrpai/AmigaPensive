;Installationsscript für Commodore Installer

(set @default-dest "Prometheus:SkyTools")
(transcript "Installation von SkyWall V2.0")

(set sourc "install/")
(set desti (tackon @default-dest "SkyWall"))
(set destkonf (tackon desti "BeispielKonfig"))

(message
  "\n\n\n\nWillkommen bei der SkyWall V2.0 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)

(working)

(if (= (exists @default-dest) 0 (makedir @default-dest (infos) )))
(if (= (exists (tackon @default-dest "SkyWall")) 0 (makedir (tackon @default-dest "SkyWall") (infos) )))

(complete 30)

(copyfiles
  (prompt "Kopiere Files...\nDer Pfadname muß beibehalten werden!")
  (choices "SkyWall" "SkyWall.guide" "NetzAntrag.txt")
  (source sourc)
  (dest desti)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 70)

(makeassign "SkyTools" "Prometheus:SkyTools")

(startup "SkyTools"
  (prompt "\n\n\n\nDas SkyTools-Assign wird nun Ihrer User-Startup zugefügt.\n\n")
  (help @startup-help)
  (command "Assign SkyTools: \"" @default-dest "\"\n")
)

(complete 100)

(message
  "\n\n\nZur weiteren Installation und Konfiguration von SkyWall schauen Sie bitte in die Anleitung."
)

(Message
  "\n\n\nFür alle SkyTools existiert ein eigenes Support-Netz, das SkyNetz, in dem Sie Informationen, Hilfestellung, Diskussionen und natürlich die neusten Versionen der Programme erhalten."
)
