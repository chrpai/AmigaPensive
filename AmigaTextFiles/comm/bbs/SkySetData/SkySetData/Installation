;Installationsscript für Commodore Installer

(set @default-dest (cat "prometheus:SkyTools/SkySetData/"))
(transcript "Installation von SkySetData V1.0")

(set #source (cat "install/"))
(set #dest (cat "prometheus:SkyTools/SkySetData/"))

(message
  "\n\n\n\nWillkommen bei der SkySetData V1.0 Installation.\n\n"
  "Die Installation wird automatisch ausgeführt.\n"
)  

(working)
(complete 0)

(makedir "prometheus:SkyTools"
  (infos)
)

(makedir "prometheus:SkyTools/SkySetData"
  (infos)
)

(complete 10)

(copyfiles
  (prompt "Kopiere Files...")
  (choices "SkySetData" "SkySetData.guide" "NetzAntrag.txt")
  (source #source)
  (dest #dest)
  (help @copyfiles-help)
  (infos)
  (confirm)
)

(complete 100)
