  '
  whatis$=type$(7)
  GOSUB headprint
  ERASE sorted()
  DIM sorted(51,2)
  ERASE ratio()
  DIM ratio(hiuser%)
  thing1%=2
  thing2%=0
  thing1$="  PriMsg"
  thing2$="  Calls "
  GOSUB ratiothings
RETURN
'
