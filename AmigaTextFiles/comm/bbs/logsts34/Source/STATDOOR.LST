  '
  whatis$=type$(11)
  GOSUB headprint
  ERASE sorted()
  DIM sorted(51,2)
  ERASE ratio()
  DIM ratio(hiuser%)
  thing1%=4
  thing2%=3
  thing1$="  UpLds "
  thing2$="  DnLds "
