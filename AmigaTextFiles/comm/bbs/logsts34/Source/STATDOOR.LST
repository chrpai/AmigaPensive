'
'
PROCEDURE 1
  GOSUB 2
  GOSUB 3
RETURN
'
'
PROCEDURE 2
  '
  IF ring%=1
    PRINT #1,o$;
  ENDIF
  IF icon%=0
    PRINT o$;
  ENDIF
  IF (modout%=1)
    GOSUB 3
  ENDIF
  2.1:
  o$=""
RETURN
'
'
PROCEDURE 3
  idle%=CINT(TIMER/200)
  key$=""
  in$=""
  in1$=""
  a%=0
  keyy%=0
  b%=0
  car%=0
  DO
    IF MOUSEK=3
      ALERT 0,"REALLY kill "+doorname$+" ?",2,"Yes|No",xx%
      IF xx%=1
        CLOSES 1
        IF ring!=TRUE
          @close_serial
        ENDIF
        END
      ENDIF
    ENDIF
    IF ring%=1
      cd%=0
      cd%=LPEEK(12570624)
      cd%=cd% AND 8192
      IF cd%<>0
        car%=1
        keyy%=1
      ENDIF
    ENDIF
    key$=INKEY$
    IF key$<>""
      GOTO mod.in1
    ENDIF
    '
    IF ring%=1
      IF LOC(#1)>0
        in1$=INPUT$(1,#1)
        key$=in1$
        in1$=""
      ENDIF
    ENDIF
    '
    mod.in1:
    IF key$=CHR$(19)
      pau$=""
      hold%=CINT(TIMER/200)
      WHILE CINT(TIMER/200)<hold%+45
        pau$=INKEY$
        IF pau$<>""
          key$=""
          pau$=""
          GOTO mod.in1.1
        ENDIF
        IF ring%=1
          IF LOC(#1)>0
            key$=""
            pau$=""
            GOTO mod.in1.1
          ENDIF
        ENDIF
      WEND
      key$=""
      pau$=""
      GOTO mod.in1.1
    ENDIF
    '
    mod.in1.1:
    IF modout%=1 AND key$=""
      keyy%=1
    ENDIF
    IF modout%=1 AND key$=CHR$(32)
      abort%=1
      GOTO 2.1
    ENDIF
    IF modout%=1 AND key$<>CHR$(32)
      keyy%=1
    ENDIF
    IF key$=""
      GOTO mod.in2
    ENDIF
    mod.in1.5:
    a%=ASC(key$)
    b%=LEN(in$)
    IF a%=13
      GOTO mod.in1.6
    ENDIF
    IF (a%=8 OR a%=127) AND LEN(in$)>=1
      in$=LEFT$(in$,b%-1)
      DEC b%
      o$=de$
      GOSUB 2
    ENDIF
    IF b%=il%
      GOTO mod.in2
    ENDIF
    IF in%=0
      IF a%>31 AND a%<127
        IF cmd%=1
          cmdmenu%=0
          dismsg%=0
        ENDIF
        key$=UPPER$(key$)
        o$=key$+cr$
        GOSUB 2
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    mod.in1.6:
    IF in%=1 AND a%>31 AND a%<127
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=2 AND a%>31 AND a%<127
      key$=UPPER$(key$)
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=3
      IF a%=13 AND yes%=1
        o$="YES"
        GOSUB 2
        in$="YES"
        keyy%=1
      ENDIF
      IF a%=13 AND yes%=0
        o$="NO"
        GOSUB 2
        in$="NO"
        keyy%=1
      ENDIF
      IF a%=89 OR a%=121
        o$="YES"+cr$
        GOSUB 2
        in$="YES"
        keyy%=1
      ENDIF
      IF a%=78 OR a%=110
        o$="NO"+cr$
        GOSUB 2
        in$="NO"
        keyy%=1
      ENDIF
    ENDIF
    IF in%=4 AND a%>47 AND a%<58
      o$=key$
      GOSUB 2
      in$=in$+key$
    ENDIF
    IF in%=5
      IF (a%=8 OR a%=127) AND LEN(ln$(ln%))>=1
        ln$(ln%)=LEFT$(ln$(ln%),LEN(ln$(ln%))-1)
        o$=de$
        GOSUB 2
        keyy%=1
      ENDIF
      IF a%=13
        in$=key$
        keyy%=1
      ENDIF
      IF a%=9
        o$="     "
        GOSUB 2
        in$="     "
        keyy%=1
      ENDIF
      IF a%>26 AND a%<127
        o$=key$
        GOSUB 2
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    '
    ' new one: no echoing of input at all! Good for More (Y/n)? stuff, etc...
    '
    IF in%=9
      IF a%>31 AND a%<127
        key$=UPPER$(key$)
        in$=key$
        keyy%=1
      ENDIF
    ENDIF
    '
    mod.in1.7:
    IF a%=13
      IF (in%<>5 AND in%<>7 AND in%<>9)
        o$=cr$
        GOSUB 2
        keyy%=1
      ENDIF
      IF in%=9
        keyy%=1
      ENDIF
    ENDIF
    mod.in2:
    IF CINT(TIMER/200)>idle%+300
      IF lev%>7 AND CINT(TIMER/200)>idle%+600
        car%=1
        keyy%=1
      ENDIF
      IF lev%<8
        car%=1
        keyy%=1
      ENDIF
    ENDIF
    mod.in2.0:
  LOOP UNTIL keyy%=1
  '
  mod.in2.1:
RETURN
'
'
PROCEDURE press
  o$=cr$+cr$+ansi$(0)+"[Any_Key]"
  in%=0
  il%=1
  GOSUB 1
RETURN
'
'
PROCEDURE pagepause
  o$="More (Y/n)?"
  in%=9
  il%=1
  GOSUB 1
  IF car%>0
    GOTO pagepause9
  ENDIF
  o$=de$+de$+de$+de$+de$+de$+de$+de$+de$+de$+de$
  GOSUB 2
  IF in$=" " OR in$="N"
    abort%=1
  ENDIF
  lines%=0
  pagepause9:
RETURN
'
'
PROCEDURE tchk
  GOSUB time1
  timenow%=CINT(TIMER/200)
  ctime%=(timenow%-timeon%)
  ctime%=CINT(ctime%/60)
  rtime%=tpc%-ctime%-depsnow%+withsnow%+winnings%
  IF rtime%<=0
    o$=cr$+cr$+"Sorry, Time Limit Exceeded!"
    GOSUB 2
    DELAY 2
    car%=2
  ENDIF
RETURN
'
'
PROCEDURE time1
  t.t%=FRE(0)
  time1$=TIME$
  t.t%=VAL(LEFT$(time1$,2))
  IF t.t%>11
    a$=" PM"
  ELSE
    a$=" AM"
  ENDIF
  IF t.t%=0
    t.t%=12
    time1$=RIGHT$(STR$(t.t%),2)+RIGHT$(time1$,6)
  ELSE IF t.t%<10
    time1$=RIGHT$(STR$(t.t%),1)+RIGHT$(time1$,6)
  ELSE IF t.t%>21
    t.t%=t.t%-12
    time1$=RIGHT$(STR$(t.t%),2)+RIGHT$(time1$,6)
  ELSE IF t.t%>12
    t.t%=t.t%-12
    time1$=RIGHT$(STR$(t.t%),1)+RIGHT$(time1$,6)
  ENDIF
  GOSUB dateconv
  pd.time$=time1$+a$
  time1$=pd.time$+"  "+pd.date$
RETURN
'
'
'   **************
PROCEDURE dateconv
  ' **************
  ' converts date to Fido style DD-Mmm-YY
  ' string to use is pd.date$
  pd.temp$=DATE$
  pd.date1$=LEFT$(pd.temp$,2)
  pd.date2$=MID$(pd.temp$,4,2)
  pd.date3$=RIGHT$(pd.temp$,2)
  pd.month%=VAL(pd.date1$)
  pd.month$="Xxx"
  IF pd.month%=1
    pd.month$="Jan"
  ELSE IF pd.month%=2
    pd.month$="Feb"
  ELSE IF pd.month%=3
    pd.month$="Mar"
  ELSE IF pd.month%=4
    pd.month$="Apr"
  ELSE IF pd.month%=5
    pd.month$="May"
  ELSE IF pd.month%=6
    pd.month$="Jun"
  ELSE IF pd.month%=7
    pd.month$="Jul"
  ELSE IF pd.month%=8
    pd.month$="Aug"
  ELSE IF pd.month%=9
    pd.month$="Sep"
  ELSE IF pd.month%=10
    pd.month$="Oct"
  ELSE IF pd.month%=11
    pd.month$="Nov"
  ELSE IF pd.month%=12
    pd.month$="Dec"
  ENDIF
  pd.date$=pd.date2$+"-"+pd.month$+"-"+pd.date3$
RETURN
'
'
PROCEDURE modem.c
  CLOSE #1
RETURN
'
PROCEDURE modem.o
  OPEN "",#1,"COM1:"+bd$+",n,8,1",4096
  DELAY 1
RETURN
