'
PROCEDURE topthings
  '
  FOR k%=1 TO hiuser%
    IF stats%(k%,thing%)>sorted%(15,1)
      sorted%(15,1)=stats%(k%,thing%)
      sorted%(15,2)=k%
      FOR l%=15 DOWNTO 2
        IF sorted%(l%,1)>sorted%(l%-1,1) THEN
          SWAP sorted%(l%,1),sorted%(l%-1,1)
          SWAP sorted%(l%,2),sorted%(l%-1,2)
        ENDIF
      NEXT l%
    ENDIF
    '
  NEXT k%
  '
  mcol(33)
  mprint(cr$+"ÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄ")
  mcol(32)
  mprint(cr$+"Rank  User #  Name                       "+thing1$+"  % All  Last Called")
  mcol(33)
  mprint(cr$+"ÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄ")
  '
  FOR ct%=1 TO 15
    GOSUB userlogprep
    IF sorted%(ct%,2)<1 OR sorted%(ct%,2)>hiuser%
      GOTO top15jump
    ENDIF
    GET #3,sorted%(ct%,2)
    mcol(33)
    mprint(cr$+STR$(ct%)+SPACE$(5-LEN(STR$(ct%))))
    mcol(35)
    mprint(SPACE$(5-LEN(STR$(sorted%(ct%,2))))+STR$(sorted%(ct%,2))+"    ")
    mcol(32)
    mprint(un$+" ")
    mcol(36)
    mprint(SPACE$(10-LEN(STR$(sorted%(ct%,1))))+STR$(sorted%(ct%,1)))
    mcol(37)
    mprint("   ")
    IF ring%=1
      PRINT #1,USING "##.##",(sorted%(ct%,1))*100/allbbs%(thing%);
    ENDIF
    PRINT USING "##.##",(sorted%(ct%,1))*100/allbbs%(thing%);
    mcol(31)
    mprint("  "+dl$)
    top15jump:
    CLOSE #3
  NEXT ct%
  mprint(cr$)
  '
  GOSUB press
  '
RETURN
'
PROCEDURE allthings
  '
  mcol(33)
  mprint(cr$+"ÄÄÄÄÄÄ   ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄ")
  mcol(32)
  mprint(cr$+"User #   Name                       "+thing1$+"  % All  Last Called")
  mcol(33)
  mprint(cr$+"ÄÄÄÄÄÄ   ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄ")
  lines%=6
  '
  FOR ct%=1 TO hiuser%
    GOSUB userlogprep
    GET #3,ct%
    IF LEFT$(un$,5)="     "
      CLOSE #3
      GOTO allthingsjump
    ENDIF
    mcol(35)
    mprint(cr$+SPACE$(5-LEN(STR$(ct%)))+STR$(ct%)+"    ")
    mcol(32)
    mprint(un$+" ")
    mcol(36)
    mprint(SPACE$(10-LEN(STR$(stats%(ct%,thing%))))+STR$(stats%(ct%,thing%)))
    mcol(37)
    mprint("   ")
    IF ring%=1
      PRINT #1,USING "##.##",(stats%(ct%,thing%))*100/allbbs%(thing%);
    ENDIF
    PRINT USING "##.##",(stats%(ct%,thing%))*100/allbbs%(thing%);
    mcol(31)
    mprint("  "+dl$)
    CLOSE #3
    INC lines%
    IF (lines% MOD page%)=0 THEN
      mprint(cr$)
      GOSUB pagepause
      lines%=3
      IF abort%=1 OR car%>0
        ct%=hiuser%+42
        abort%=0
      ELSE
        IF ct%<hiuser%+1
          mcol(33)
          mprint(cr$+"ÄÄÄÄÄÄ   ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄ")
          mcol(32)
          mprint(cr$+"User #   Name                       "+thing1$+"  % All  Last Called")
          mcol(33)
          mprint(cr$+"ÄÄÄÄÄÄ   ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ  ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄ")
        ENDIF
      ENDIF
    ENDIF
    '
    allthingsjump:
  NEXT ct%
RETURN
'
'
PROCEDURE ratiothings
  '
  ' sorted#(51,2)     - where they finally get put: stat,Usernumber
  ' ratio#(hiuser%)   - where they are calculated into
  ' thing1% & thing1$ - Numerator
  ' thing2% & thing2$ - Denominator
  '
  mcol(33)
  mprint(cr$+"ÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ")
  mcol(32)
  mprint(cr$+"Rank  User #  Name                       "+thing1$+thing2$+"   Ratio")
  mcol(33)
  mprint(cr$+"ÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ"+cr$)
  lines%=6
  '
  FOR k%=1 TO hiuser%
    IF stats%(k%,thing2%)=0
      ratio(k%)=0
      IF (thing2%=4) AND (stats%(k%,thing1%)>0)
        ratio(k%)=stats%(k%,thing1%)
      ENDIF
    ELSE
      ratio(k%)=stats%(k%,thing1%)/stats%(k%,thing2%)
    ENDIF
    '
    IF ratio(k%)>sorted(50,1)
      sorted(50,1)=ratio(k%)
      sorted(50,2)=k%
      FOR l%=50 DOWNTO 2
        IF sorted(l%,1)>sorted(l%-1,1)
          SWAP sorted(l%,1),sorted(l%-1,1)
          SWAP sorted(l%,2),sorted(l%-1,2)
        ENDIF
      NEXT l%
    ENDIF
  NEXT k%
  '
  FOR ct%=1 TO 50
    IF sorted(ct%,1)>0 THEN
      mcol(37)
      mprint(STR$(ct%)+SPACE$(5-LEN(STR$(ct%))))
      mcol(36)
      mprint(SPACE$(5-LEN(STR$(sorted(ct%,2))))+STR$(sorted(ct%,2))+"    ")
      mcol(35)
      GOSUB userlogprep
      GET #3,(sorted(ct%,2))
      mprint(un$+"  ")
      CLOSE #3
      mcol(32)
      mprint(SPACE$(8-LEN(STR$(stats%(sorted(ct%,2),thing1%))))+STR$(stats%(sorted(ct%,2),thing1%)))
      mcol(33)
      mprint(SPACE$(8-LEN(STR$(stats%(sorted(ct%,2),thing2%))))+STR$(stats%(sorted(ct%,2),thing2%)))
      mprint("  ")
      mcol(31)
      IF ring%=1
        PRINT #1,USING "###.####",sorted(ct%,1);
      ENDIF
      PRINT USING "###.##",sorted(ct%,1);
      mprint(cr$)
      INC lines%
      IF (lines% MOD page%)=0 THEN
        GOSUB pagepause
        lines%=3
        IF abort%=1 OR car%>0
          ct%=99
          abort%=0
        ELSE
          IF ct%<51 THEN
            mcol(33)
            mprint(cr$+"ÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ")
            mcol(32)
            mprint(cr$+"Rank  User #  Name                       "+thing1$+thing2$+"   Ratio")
            mcol(33)
            mprint(cr$+"ÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄ  ÄÄÄÄÄÄÄÄ"+cr$)
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  NEXT ct%
  GOSUB press
RETURN
'
PROCEDURE headprint
  '
  o$=cr$+cr$+CHR$(12)
  GOSUB 2
  mcol(36)
  mprint("ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿")
  mprint(cr$+"³")
  mcol(31)
  mprint("Metro Stats (by PD) - "+whatis$+"Start: "+startdate$+SPACE$(19-LEN(startdate$)))
  mcol(36)
  mprint("³"+cr$+"ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ")
RETURN
