REM ******************************************************************
'
REM Program- StatDoor
REM    Date- 31 October 1991
REM  Author- Peter Francis Deane
REM
REM Version- 3.3 (GFA)
'
'  3.3 - bug fix for where HiUser and OldHiuser were different.
'  3.4 - dusted it off for OzMetro (after over 3 years)
'
'  Finally started to get extra users added to the log, and it hit me!
'
REM ******************************************************************
'
versnum$="3.4"
versdate$="08-Dec-94"
doorname$="StatDoor"
'
MODE 1
DIM ansi$(10)
ON ERROR GOSUB woops
'
cr$=CHR$(13)+CHR$(10)
de$=CHR$(8)+" "+CHR$(8)
esc$=CHR$(27)
'
IF NOT EXIST("RAM:userdata")
  ' setup dummy names, etc
  rtime$="300"
  uname$="PETER DEANE"
  id$="1"
  lev$="9"
  bd$="2400"
  ring$="0"
  ansi%=99
  path$=""
ELSE
  OPEN "I",#2,"RAM:USERDATA",1024
  LINE INPUT #2,rtime$
  LINE INPUT #2,uname$
  LINE INPUT #2,id$
  LINE INPUT #2,lev$
  LINE INPUT #2,bd$
  LINE INPUT #2,ring$
  LINE INPUT #2,path$
  CLOSE #2
  '
  ' DoorData check
  '
  IF NOT EXIST("ram:doordata")
    ansi%=99
  ELSE
    OPEN "I",#2,"Ram:doordata",1024
    FOR k%=1 TO 7
      LINE INPUT #2,fred$
    NEXT k%
    CLOSE #2
    ansi%=VAL(fred$)
  ENDIF
ENDIF
'
' Investigate our working environment from the NEW config file...
'
'
IF EXIST("S:Metro.cfg")
  config$="S:Metro.cfg"
ELSE IF EXIST("BBS:Metro.cfg")
  config$="BBS:Metro.cfg"
ELSE IF EXIST("Metro.cfg")
  config$="Metro.cfg"
ELSE
  config$="XXX"
ENDIF
'
' Defaults
'
bbsname$="The OzMetro BBS"
mbd$="19200"
sfd$="BBS:"
udfd$="BBS:"
sysopname$="The Sysop"
winw$="640"
winh$="200"
'
IF config$<>"XXX"
  '
  OPEN "I",#2,config$,128
  DO WHILE (NOT EOF(#2))
    LINE INPUT #2,xx$
    xx$=TRIM$(xx$)
    xxu$=UPPER$(xx$)
    '
    IF xxu$="" OR LEFT$(xxu$,1)=";"
      ' Do nothing
    ELSE IF LEFT$(xxu$,7)="BBSNAME"
      xx$=MID$(xx$,8,255)
      xx$=TRIM$(xx$)
      bbsname$=xx$
    ELSE IF LEFT$(xxu$,7)="MAXBAUD"
      xx$=MID$(xx$,8,255)
      xx$=TRIM$(xx$)
      mbd$=xx$
    ELSE IF LEFT$(xxu$,9)="SYSOPNAME"
      xx$=MID$(xx$,10,255)
      xx$=TRIM$(xx$)
      sysopname$=xx$
    ELSE IF LEFT$(xxu$,11)="WINDOWWIDTH"
      xx$=MID$(xx$,12,255)
      xx$=TRIM$(xx$)
      winw$=xx$
    ELSE IF LEFT$(xxu$,12)="WINDOWHEIGHT"
      xx$=MID$(xx$,13,255)
      xx$=TRIM$(xx$)
      winh$=xx$
    ENDIF
    '
  LOOP UNTIL EOF(#2)
  CLOSE #2
ENDIF
'
bbspath$=sfd$+"BBSFiles/"
'
sw%=VAL(winw$)
sh%=VAL(winh$)
sx%=0
sy%=0
ww%=sw%
wh%=sh%-12
wx%=0
wy%=11
'
' integer conversion for system variables
'
tpc%=VAL(rtime$)
id%=VAL(id$)
lev%=VAL(lev$)
ring%=VAL(ring$)
bd%=VAL(bd$)
timeon%=CINT(TIMER/200)
'
wtype%=258+4096
'
'
OPENS 1,sx%,sy%,sw%,sh%,3,32768
' IF ring%=1
'   BACKS 1
' ENDIF
OPENW #1,wx%,wy%,ww%,wh%,0,wtype%,1
'
' Hack these settings if you like: format &Hxxx
' the xxx is the HEX value of the RGB register
'
SETCOLOR 0,&H0
SETCOLOR 1,&HF11
SETCOLOR 2,&H1F1
SETCOLOR 3,&HFF1
SETCOLOR 4,&H11F
SETCOLOR 5,&HF1F
SETCOLOR 6,&H1FF
SETCOLOR 7,&HFFF
'
title$="Stats Door  ID: "+id$+" ("+uname$+") Lev: "+lev$+" Baud: "
IF ring%=0
  title$=title$+"Local Login"
ELSE
  title$=title$+bd$
ENDIF
TITLEW #1,title$,"Written by Peter F Deane (c) "+versdate$+" [V "+versnum$+" - GFA]"
TITLES #1,"Written by Peter F Deane (c) "+versdate$+" [V "+versnum$+" - GFA]"
'
' modem need not be opened if it's a local login!
' then you can test em standalone with the BBS running, among other things...
'
IF ring%<>0
  GOSUB modem.o
ENDIF
'
' Figure out the page pause setting
'
flnm$=sfd$+"BBSFILES/userlog"
IF EXIST(flnm$)
  GOSUB userlogprep
  GET #3,id%
  page%=VAL(dm2$)
  CLOSE #3
ELSE
  page%=23
ENDIF
IF page%>5
  page%=page%-1
ELSE
  page%=22
ENDIF
IF ring%=0
  page%=(wh%/8)-3
ENDIF
'
' ======================================================================
'
' We're in, hit em hard and good!
'
' reset terminal
o$=esc$+"[0;40;37m"+CHR$(12)
GOSUB 2
o$=cr$+cr$+"           Metro Stats Door"
GOSUB 2
o$=cr$+cr$+"                By PFD"
GOSUB 2
o$=cr$+cr$+"        Version "+versnum$+" - GFA BASIC"
GOSUB 2
o$=cr$+cr$+"               "+versdate$+cr$
GOSUB 2
GOSUB press
IF car%>0
  GOTO bye
ENDIF
'
'
' Bright points of the program
DIM sorted%(5)
DIM sorted(5)
DIM allbbs%(10)
' /\ the above few are erased and re-dimensioned later.
DIM temp%(10)
DIM ratio(10)
'
' add the strings to the type list
DIM type$(12)
type$(0)=" Number of Calls         "
type$(1)=" Public Messages Posted  "
type$(2)=" Private Messages Posted "
type$(3)=" Downloads Received      "
type$(4)=" Uploads Sent            "
type$(5)=" Games/Doors Entered     "
type$(6)=" Public Msgs Per Call    "
type$(7)=" Private Msgs Per Call   "
type$(8)=" Downloads Per Call      "
type$(9)=" Uploads Per Call        "
type$(10)=" Games/Doors Per Call    "
type$(11)=" Uploads By Downloads    "
type$(12)=" Pub. Msgs By Priv. Msgs "
'
'
' set config variables
lines%=1
IF ansi%>2
  GOSUB checkansi
ENDIF
'
GOSUB setansi
'
'
' find Hi User #
flnm$=bbspath$+"hiuser"
OPEN "I",#2,flnm$,10
LINE INPUT #2,hiuser$
hiuser%=VAL(hiuser$)
CLOSE #2
' find old hiuser number
flnm$=bbspath$+"logstats.oldhi"
IF NOT EXIST(flnm$)
  oldhiuser%=hiuser%-10
  ' Take a lucky guess  ??
ELSE
  OPEN "I",#2,flnm$,10
  LINE INPUT #2,oldhiuser$
  oldhiuser%=VAL(oldhiuser$)
  CLOSE #2
ENDIF
'
' Grab the weightings from the config
DIM weight%(5)
conferror%=0
flnm$=path$+"StatDoor.config"
OPEN "I",#2,flnm$,1024
LINE INPUT #2,garb$
IF UPPER$(LEFT$(garb$,3))<>"CAL"
  conferror%=1
ENDIF
LINE INPUT #2,garb$
weight%(0)=VAL(garb$)
LINE INPUT #2,garb$
IF UPPER$(LEFT$(garb$,3))<>"PUB"
  conferror%=1
ENDIF
LINE INPUT #2,garb$
weight%(1)=VAL(garb$)
LINE INPUT #2,garb$
IF UPPER$(LEFT$(garb$,3))<>"PRI"
  conferror%=1
ENDIF
LINE INPUT #2,garb$
weight%(2)=VAL(garb$)
LINE INPUT #2,garb$
IF UPPER$(LEFT$(garb$,3))<>"DOW"
  conferror%=1
ENDIF
LINE INPUT #2,garb$
weight%(3)=VAL(garb$)
LINE INPUT #2,garb$
IF UPPER$(LEFT$(garb$,3))<>"UPL"
  conferror%=1
ENDIF
LINE INPUT #2,garb$
weight%(4)=VAL(garb$)
LINE INPUT #2,garb$
IF UPPER$(LEFT$(garb$,3))<>"DOO"
  conferror%=1
ENDIF
LINE INPUT #2,garb$
weight%(5)=VAL(garb$)
'
' get the starting date -
' for THIS version I've added it at the end of the config!
'
LINE INPUT #2,startdate$
IF LEN(startdate$)>19
  startdate$=LEFT$(startdate$,19)
ENDIF
'
CLOSE #2
'
IF conferror%=1
  o$=cr$+cr$+ansi$(1)+"There is a problem with the config file."
  GOSUB 2
  o$=cr$+"Please inform your sysop. This program cannot run!"
  GOSUB 2
  GOSUB press
  GOTO bye
ENDIF
'
' Set the Selections Array
DIM sel$(25)
sel$(0)=""
sel$(1)="C"
sel$(2)="P"
sel$(3)="S"
sel$(4)="D"
sel$(5)="U"
sel$(6)="G"
sel$(7)="A"
sel$(8)="F"
sel$(9)="T"
sel$(10)="1"
sel$(11)="2"
sel$(12)="3"
sel$(13)="4"
sel$(14)="5"
sel$(15)="6"
sel$(16)="7"
sel$(17)="!"
sel$(18)="@"
sel$(19)="#"
sel$(20)="$"
sel$(21)="%"
sel$(22)="^"
sel$(23)="Q"
sel$(24)="8"
sel$(25)=""
'
'
'
' Read in all the stats from the sequential file
'
o$=cr$+cr$+CHR$(12)
GOSUB 2
mcol(32)
mprint(cr$+cr$+"Loading the statistical data...")
mcol(35)
mprint(cr$+cr$+"There are "+hiuser$+" users on the system.")
mprint(cr$+cr$+"We have stats on "+oldhiuser$+" of them.")
mprint(cr$+cr$+SPACE$(6))
'
DIM stats%(hiuser%,5)
DIM weighted%(hiuser%)
'
IF bd%>2000
  progress%=25
ELSE
  progress%=50
ENDIF
'
flnm$=bbspath$+"Logstats"
OPEN "I",#2,flnm$,4096
FOR k%=1 TO oldhiuser%
  FOR l%=0 TO 5
    INPUT #2,stats%(k%,l%)
    weighted%(k%)=weighted%(k%)+(stats%(k%,l%)*weight%(l%))
  NEXT l%
  ' show em we ARE doing something!
  IF (k% MOD progress%)=0 THEN
    mprint(de$+de$+de$+de$+de$+de$)
    mprint(SPACE$(6-LEN(STR$(k%)))+STR$(k%))
  ENDIF
NEXT k%
CLOSE #2
mcol(31)
mprint(cr$+cr$+"Computing the totals...")
'
'
FOR j%=0 TO 5
  FOR k%=1 TO hiuser%
    allbbs%(j%)=allbbs%(j%)+stats%(k%,j%)
  NEXT k%
  IF allbbs%(j%)=0
    allbbs%(j%)=1
  ENDIF
NEXT j%
'
' calculate an idle time for the main command line:
'
IF lev%>7
  allowidle%=480
ELSE
  allowidle%=240
ENDIF
