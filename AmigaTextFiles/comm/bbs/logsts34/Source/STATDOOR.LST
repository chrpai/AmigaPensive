PROCEDURE checkhotkey
  '
  gotone%=0
  modout%=1
  GOSUB 3
  '
  IF in$=""
    GOTO checkhotexit
  ENDIF
  '
  count%=0
  '
  DO
    INC count%
    IF sel$(count%)=in$
      gotone%=1
    ENDIF
    EXIT IF gotone%=1
  LOOP UNTIL count%>24
  '
  checkhotexit:
  modout%=0
  '
RETURN
