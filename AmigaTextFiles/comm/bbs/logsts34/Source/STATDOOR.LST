mprint("ÈÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼")
'
'
' Menu printed, print command line
'
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
mcol(32)
mprint(cr$+cr$+"       "+pd.time$+"   ")
mcol(35)
mprint(pd.date$)
mcol(33)
mprint("   (Time Left: "+STR$(rtime%)+")")
mcol(31)
mprint("    Your Choice? ")
'
' wait eternally for a valid keypress (until idle timer, anyway)
pdidle%=TIMER/200
WHILE gotone%=0
  GOSUB tchk
  GOSUB checkhotkey
  IF ((TIMER/200)>pdidle%+allowidle%) OR car%>0
    GOTO bye
  ENDIF
WEND
'
' Got a keypress, direct control to correct part..
'
gotsel:
'
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
keyin$=in$
'
IF keyin$="Q"
  GOTO bye
ELSE IF keyin$="C"
  GOSUB topcallers
ELSE IF keyin$="P"
  GOSUB toppubmsgs
ELSE IF keyin$="S"
  GOSUB topprimsgs
ELSE IF keyin$="D"
  GOSUB topdloaders
ELSE IF keyin$="U"
  GOSUB topuloaders
ELSE IF keyin$="G"
  GOSUB topgamers
ELSE IF keyin$="A"
  GOSUB anyone
ELSE IF keyin$="F"
  GOSUB fulldisplay
ELSE IF keyin$="T"
  GOSUB top50
ELSE IF keyin$="1"
  GOSUB pubpercall
ELSE IF keyin$="2"
  GOSUB pripercall
ELSE IF keyin$="3"
  GOSUB dlpercall
ELSE IF keyin$="4"
  GOSUB ulpercall
ELSE IF keyin$="5"
  GOSUB gamespercall
ELSE IF keyin$="6"
  GOSUB ulperdl
ELSE IF keyin$="7"
  GOSUB pubperpri
ELSE IF keyin$="8"
  GOSUB dlperul
ELSE IF keyin$="!"
  GOSUB allcallers
ELSE IF keyin$="@"
  GOSUB allpubmsgs
ELSE IF keyin$="#"
  GOSUB allprimsgs
ELSE IF keyin$="$"
  GOSUB alldloads
ELSE IF keyin$="%"
  GOSUB alluloads
ELSE IF keyin$="^"
  GOSUB allgames
ENDIF
'
GOSUB tchk
IF car%>0
  GOTO bye
ENDIF
'
GOTO topmenu
'
'
bye:
'
mprint(cr$+cr$+CHR$(12))
mcol(35)
mprint("Hope you found this door quite useful."+cr$)
mcol(32)
mprint(cr$+"If you did, then leave a message to ")
mcol(33)
mprint(sysopname$)
mcol(32)
mprint(" asking him"+cr$)
mprint("to support the shareware concept and register the program."+cr$)
mcol(36)
DELAY 1
mprint(cr$+"The Metro Stats Door was written by Peter Deane"+cr$)
mprint("Inquestor BBS, Newcastle, NSW, Australia"+cr$+cr$)
mcol(31)
mprint("011-61-49-721647 from the USA"+cr$)
mprint("(049) 72-1647 from Australia"+cr$)
DELAY 3
o$=ansi$(0)
GOSUB 2
mprint(cr$+cr$+"Hope to see you back soon!")
CLOSES 1
IF EXIST("ram:userdata")
  KILL "RAM:USERDATA"
ENDIF
GOSUB modem.c
CLEAR
END
'
'
PROCEDURE woops
  '
  mprint(cr$+cr$+"Woops! We've had a crash. Returning you to the BBS!"+cr$+cr$)
  DELAY 3
  RESUME bye
  '
RETURN
'
'
'
PROCEDURE topcallers
  '
  whatis$=type$(0)
  GOSUB headprint
  ERASE sorted%()
  DIM sorted%(16,2)
  thing%=0
  thing1$="  Calls   "
  GOSUB topthings
RETURN
'
PROCEDURE toppubmsgs
  '
  whatis$=type$(1)
  GOSUB headprint
  ERASE sorted%()
  DIM sorted%(16,2)
  thing%=1
  thing1$="  Pub Msgs"
  GOSUB topthings
RETURN
'
PROCEDURE topprimsgs
  '
  whatis$=type$(2)
  GOSUB headprint
  ERASE sorted%()
  DIM sorted%(16,2)
  thing%=2
  thing1$="  Pri Msgs"
  GOSUB topthings
RETURN
'
PROCEDURE topdloaders
  '
  whatis$=type$(3)
  GOSUB headprint
  ERASE sorted%()
  DIM sorted%(16,2)
  thing%=3
  thing1$="  DnLoads "
  GOSUB topthings
RETURN
'
PROCEDURE topuloaders
  '
  whatis$=type$(4)
  GOSUB headprint
  ERASE sorted%()
  DIM sorted%(16,2)
  thing%=4
  thing1$="  UpLoads "
  GOSUB topthings
RETURN
'
PROCEDURE topgamers
  '
  whatis$=type$(5)
  GOSUB headprint
  ERASE sorted%()
  DIM sorted%(16,2)
  thing%=5
  thing1$="  Doors   "
  GOSUB topthings
RETURN
'
PROCEDURE anyone
  anyoneentrance:
  '
  whatis$=" Any User's Statistics   "
  GOSUB headprint
  mcol(37)
  mprint(cr$+cr$+"This option lets you get stats on any one user, or for the BBS in total.")
  mcol(33)
  mprint(cr$+cr$+"To get stats on the BBS, enter 'BBS' as the username.")
  mcol(32)
  mprint(cr$+cr$+"You can enter the UserName or UserNumber - the Number is found quicker.")
  mcol(35)
  mprint(cr$+cr$+"Which user interests you [Return=Quit] ? ")
  '
  in%=2
  il%=25
  GOSUB 3
  '
  IF in$=""
    GOTO anyoneexit
  ENDIF
  '
  ' stats for the BBS as a whole
  IF in$="BBS"
    GOSUB headprint
    mcol(32)
    mprint(cr$+cr$+"Totals for "+bbsname$+cr$)
    mcol(35)
    mprint(cr$+"          Calls           : "+STR$(allbbs%(0)))
    mcol(36)
    mprint(cr$+"          Public Messages : "+STR$(allbbs%(1)))
    mcol(37)
    mprint(cr$+"          Private Messages: "+STR$(allbbs%(2)))
    mcol(31)
    mprint(cr$+"          Downloads       : "+STR$(allbbs%(3)))
    mcol(32)
    mprint(cr$+"          Uploads         : "+STR$(allbbs%(4)))
    mcol(33)
    mprint(cr$+"          Games/Doors     : "+STR$(allbbs%(5)))
    mcol(35)
    mprint(cr$+cr$+"          Public Messages Per Call  : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(1)/allbbs%(0);
    ENDIF
    PRINT USING "##.#####",allbbs%(1)/allbbs%(0);
    mcol(36)
    mprint(cr$+"          Private Messages Per Call : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(2)/allbbs%(0);
    ENDIF
    PRINT USING "##.#####",allbbs%(2)/allbbs%(0);
    mcol(37)
    mprint(cr$+"          Downloads Per Call        : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(3)/allbbs%(0);
    ENDIF
    PRINT USING "##.#####",allbbs%(3)/allbbs%(0);
    mcol(31)
    mprint(cr$+"          Uploads Per Call          : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(4)/allbbs%(0);
    ENDIF
    PRINT USING "##.#####",allbbs%(4)/allbbs%(0);
    mcol(32)
    mprint(cr$+"          Games/Doors Per Call      : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(5)/allbbs%(0);
    ENDIF
    PRINT USING "##.#####",allbbs%(5)/allbbs%(0);
    mcol(33)
    mprint(cr$+"          Pub Msgs Per Private Msg  : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(1)/allbbs%(2);
    ENDIF
    PRINT USING "##.#####",allbbs%(1)/allbbs%(2);
    mcol(35)
    mprint(cr$+"          Uploads Per Download      : ")
    IF ring%=1
      PRINT #1,USING "##.#####",allbbs%(4)/allbbs%(3);
    ENDIF
    PRINT USING "##.#####",allbbs%(4)/allbbs%(3);
    GOSUB press
    GOTO anyoneexit
  ENDIF
  '
  ' User entered, check for:
  ' if a name, search for the user number
  '
  IF VAL(in$)<1
    snoop$=in$+SPACE$(25-LEN(in$))
    GOSUB userlogprep
    count%=0
    snoopname$=""
    mcol(36)
    mprint(cr$+cr$+"Standby . . . Searching Userlog.")
    WHILE snoop$<>snoopname$
      INC count%
      EXIT IF count%>hiuser%
      GET #3,count%
      snoopname$=un$
    WEND
    CLOSE #3
    IF count%>hiuser%
      mcol(31)
      mprint(cr$+cr$+"Sorry, not a user on the system (yet?). Try Again!"+cr$)
      GOSUB press
      IF car%>0
        GOTO anyoneexit
      ENDIF
      GOTO anyoneentrance
    ENDIF
    '
    seluser%=count%
    ' if not a name, it's gotta be a number...
  ELSE
    snoop%=VAL(in$)
    IF (snoop%>hiuser%)
      mcol(31)
      mprint(cr$+cr$+"Sorry, not a user on the system (yet?). Try Again!"+cr$)
      GOSUB press
      IF car%>0
        GOTO anyoneexit
      ELSE
        GOTO anyoneentrance
      ENDIF
    ENDIF
    seluser%=snoop%
    GOSUB userlogprep
    GET #3,seluser%
    snoopname$=un$
    CLOSE #3
  ENDIF
  '
  ' Check to see if it's been deleted from the userlog
  IF LEFT$(snoopname$,10)="          "
    mcol(31)
    mprint(cr$+cr$+"Sorry, not a user on the system (yet?). Try Again!"+cr$)
    GOSUB press
    IF car%>0
      GOTO anyoneexit
    ELSE
      GOTO anyoneentrance
    ENDIF
  ENDIF
  '
  ' We have the usernumber (seluser%), get details...
  FOR k%=0 TO 5
    temp%(k%)=stats%(seluser%,k%)
  NEXT k%
  GOSUB headprint
  '
  ' output details
  mcol(35)
  mprint(cr$+"          User Name       : "+snoopname$+cr$)
  mcol(32)
  mprint("          User Number     : "+STR$(seluser%))
  GOSUB userlogprep
  GET #3,seluser%
  mcol(33)
  mprint(cr$+"          Date Last Called: "+dl$+cr$)
  CLOSE #3
  mcol(35)
  mprint(cr$+"          Calls           : "+STR$(temp%(0))+SPACE$(6-LEN(STR$(temp%(0)))))
  mcol(31)
  mprint("   (")
  IF ring%=1
    PRINT #1,USING "##.####",(temp%(0)*100)/allbbs%(0);
  ENDIF
  PRINT USING "##.####",(temp%(0)*100)/allbbs%(0);
  mprint("% of all)")
  mcol(36)
  mprint(cr$+"          Public Messages : "+STR$(temp%(1))+SPACE$(6-LEN(STR$(temp%(1)))))
  mcol(31)
  mprint("   (")
  IF ring%=1
    PRINT #1,USING "##.####",(temp%(1)*100)/allbbs%(1);
  ENDIF
  PRINT USING "##.####",(temp%(1)*100)/allbbs%(1);
  mprint("% of all)")
  mcol(37)
  mprint(cr$+"          Private Messages: "+STR$(temp%(2))+SPACE$(6-LEN(STR$(temp%(2)))))
  mcol(31)
  mprint("   (")
  IF ring%=1
    PRINT #1,USING "##.####",(temp%(2)*100)/allbbs%(2);
  ENDIF
  PRINT USING "##.####",(temp%(2)*100)/allbbs%(2);
  mprint("% of all)")
  mcol(31)
  mprint(cr$+"          Downloads       : "+STR$(temp%(3))+SPACE$(6-LEN(STR$(temp%(3)))))
  mcol(31)
  mprint("   (")
  IF ring%=1
    PRINT #1,USING "##.####",(temp%(3)*100)/allbbs%(3);
  ENDIF
  PRINT USING "##.####",(temp%(3)*100)/allbbs%(3);
  mprint("% of all)")
  mcol(32)
  mprint(cr$+"          Uploads         : "+STR$(temp%(4))+SPACE$(6-LEN(STR$(temp%(4)))))
  mcol(31)
  mprint("   (")
  IF ring%=1
    PRINT #1,USING "##.####",(temp%(4)*100)/allbbs%(4);
  ENDIF
  PRINT USING "##.####",(temp%(4)*100)/allbbs%(4);
  mprint("% of all)")
  mcol(33)
  mprint(cr$+"          Games/Doors     : "+STR$(temp%(5))+SPACE$(6-LEN(STR$(temp%(5)))))
  mcol(31)
  mprint("   (")
  IF ring%=1
    PRINT #1,USING "##.####",(temp%(5)*100)/allbbs%(5);
  ENDIF
  PRINT USING "##.####",(temp%(5)*100)/allbbs%(5);
  mprint("% of all)"+cr$)
  IF temp%(0)=0
    temp%(0)=1
  ENDIF
  mcol(35)
  mprint(cr$+"          Public Messages Per Call  : ")
  IF ring%=1
    PRINT #1,USING "##.#####",temp%(1)/temp%(0);
  ENDIF
  PRINT USING "##.#####",temp%(1)/temp%(0);
  mcol(36)
  mprint(cr$+"          Private Messages Per Call : ")
  IF ring%=1
    PRINT #1,USING "##.#####",temp%(2)/temp%(0);
  ENDIF
  PRINT USING "##.#####",temp%(2)/temp%(0);
  mcol(37)
  mprint(cr$+"          Downloads Per Call        : ")
  IF ring%=1
    PRINT #1,USING "##.#####",temp%(3)/temp%(0);
  ENDIF
  PRINT USING "##.#####",temp%(3)/temp%(0);
  mcol(31)
  mprint(cr$+"          Uploads Per Call          : ")
  IF ring%=1
    PRINT #1,USING "##.#####",temp%(4)/temp%(0);
  ENDIF
  PRINT USING "##.#####",temp%(4)/temp%(0);
  mcol(32)
  mprint(cr$+"          Games/Doors Per Call      : ")
  IF ring%=1
    PRINT #1,USING "##.#####",temp%(5)/temp%(0);
  ENDIF
  PRINT USING "##.#####",temp%(5)/temp%(0);
  mcol(33)
  mprint(cr$+"          Pub Msgs Per Private Msg  : ")
  IF temp%(2)<>0 THEN
    IF ring%=1
      PRINT #1,USING "##.#####",temp%(1)/temp%(2);
    ENDIF
    PRINT USING "##.#####",temp%(1)/temp%(2);
  ELSE
    mprint(" N/A")
  ENDIF
  mcol(35)
  mprint(cr$+"          Uploads Per Download      : ")
  IF temp%(3)<>0 THEN
    IF ring%=1
      PRINT #1,USING "##.#####",temp%(4)/temp%(3);
    ENDIF
    PRINT USING "##.#####",temp%(4)/temp%(3);
  ELSE
    mprint(" N/A")
  ENDIF
  GOSUB press
  '
  anyoneexit:
RETURN
'
PROCEDURE fulldisplay
  fullentrance:
  '
  whatis$=" Full Stats Display      "
  GOSUB headprint
  '
  mcol(33)
  mprint(cr$+"ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ")
  mcol(32)
  mprint(cr$+"User#  Name                        Calls  PubMsg PriMsg DnLoad UpLoad Doors ")
  mcol(33)
  mprint(cr$+"ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ"+cr$)
  lines%=6
  '
  FOR ct%=1 TO hiuser%
    '
    GOSUB userlogprep
    GET #3,ct%
    username1$=un$
    CLOSE #3
    IF LEFT$(username1$,5)="     "
      GOTO fulljump
    ENDIF
    '
    mcol(35)
    mprint(SPACE$(5-LEN(STR$(ct%)))+STR$(ct%)+"  ")
    mcol(32)
    mprint(username1$+" ")
    mcol(36)
    mprint(SPACE$(7-LEN(STR$(stats%(ct%,0))))+STR$(stats%(ct%,0)))
    mcol(37)
    mprint(SPACE$(7-LEN(STR$(stats%(ct%,1))))+STR$(stats%(ct%,1)))
    mcol(33)
    mprint(SPACE$(7-LEN(STR$(stats%(ct%,2))))+STR$(stats%(ct%,2)))
    mcol(31)
    mprint(SPACE$(7-LEN(STR$(stats%(ct%,3))))+STR$(stats%(ct%,3)))
    mcol(32)
    mprint(SPACE$(7-LEN(STR$(stats%(ct%,4))))+STR$(stats%(ct%,4)))
    mcol(35)
    mprint(SPACE$(7-LEN(STR$(stats%(ct%,5))))+STR$(stats%(ct%,5))+cr$)
    INC lines%
    IF (lines% MOD page%)=0 THEN
      GOSUB pagepause
      lines%=3
      IF abort%=1 OR car%>0
        ct%=hiuser%+42
        abort%=0
      ELSE
        mcol(33)
        mprint(cr$+"ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ")
        mcol(32)
        mprint(cr$+"User#  Name                        Calls  PubMsg PriMsg DnLoad UpLoad Doors ")
        mcol(33)
        mprint(cr$+"ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ"+cr$)
      ENDIF
    ENDIF
    '
    fulljump:
  NEXT ct%
  GOSUB press
  fullexit:
RETURN
'
'
PROCEDURE top50
  '
  whatis$=" Top 50 BBS Users        "
  GOSUB headprint
  '
  mcol(33)
  mprint(cr$+"ÄÄ ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ")
  mcol(32)
  mprint(cr$+"No User#  Name                       Calls  PubMsg PriMsg DnLoad UpLoad Doors ")
  mcol(33)
  mprint(cr$+"ÄÄ ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ"+cr$)
  lines%=6
  '
  ERASE sorted%()
  DIM sorted%(51,2)
  '
  FOR k%=1 TO hiuser%
    IF weighted%(k%)>sorted%(50,1) THEN
      sorted%(50,1)=weighted%(k%)
      sorted%(50,2)=k%
      FOR l%=50 DOWNTO 2
        IF sorted%(l%,1)>sorted%(l%-1,1)
          SWAP sorted%(l%,1),sorted%(l%-1,1)
          SWAP sorted%(l%,2),sorted%(l%-1,2)
        ENDIF
      NEXT l%
    ENDIF
  NEXT k%
  '
  FOR ct%=1 TO 50
    unum%=sorted%(ct%,2)
    IF unum%<1 OR unum%>hiuser%
      GOTO top50jump
    ENDIF
    '
    IF ct%<10
      mprint(" ")
    ENDIF
    '
    mcol(37)
    mprint(STR$(ct%)+" ")
    mcol(35)
    mprint(SPACE$(5-LEN(STR$(unum%)))+STR$(unum%)+"  ")
    mcol(32)
    GOSUB userlogprep
    GET #3,unum%
    mprint(un$)
    CLOSE #3
    mcol(36)
    mprint(SPACE$(7-LEN(STR$(stats%(unum%,0))))+STR$(stats%(unum%,0)))
    mcol(37)
    mprint(SPACE$(7-LEN(STR$(stats%(unum%,1))))+STR$(stats%(unum%,1)))
    mcol(33)
    mprint(SPACE$(7-LEN(STR$(stats%(unum%,2))))+STR$(stats%(unum%,2)))
    mcol(31)
    mprint(SPACE$(7-LEN(STR$(stats%(unum%,3))))+STR$(stats%(unum%,3)))
    mcol(32)
    mprint(SPACE$(7-LEN(STR$(stats%(unum%,4))))+STR$(stats%(unum%,4)))
    mcol(35)
    mprint(SPACE$(7-LEN(STR$(stats%(unum%,5))))+STR$(stats%(unum%,5))+cr$)
    INC lines%
    IF (lines% MOD page%)=0 THEN
      GOSUB pagepause
      lines%=3
      IF abort%=1 OR car%>0
        abort%=0
        ct%=99
      ELSE
        IF ct%<51
          mcol(33)
          mprint(cr$+"ÄÄ ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ")
          mcol(32)
          mprint(cr$+"No User#  Name                       Calls  PubMsg PriMsg DnLoad UpLoad Doors ")
          mcol(33)
          mprint(cr$+"ÄÄ ÄÄÄÄÄ  ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ ÄÄÄÄÄÄ"+cr$)
        ENDIF
      ENDIF
    ENDIF
    top50jump:
  NEXT ct%
  '
  GOSUB press
  top50exit:
RETURN
'
'
PROCEDURE pubpercall
  '
  whatis$=type$(6)
  GOSUB headprint
  ERASE sorted()
  DIM sorted(51,2)
  ERASE ratio()
  DIM ratio(hiuser%)
  thing1%=1
  thing2%=0
  thing1$="  PubMsg"
  thing2$="  Calls "
  GOSUB ratiothings
RETURN
'
'
