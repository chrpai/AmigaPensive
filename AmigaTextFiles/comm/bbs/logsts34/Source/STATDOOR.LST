'
'
PROCEDURE pubperpri
  '
  whatis$=type$(12)
  GOSUB headprint
  ERASE sorted()
  DIM sorted(51,2)
  ERASE ratio()
  DIM ratio(hiuser%)
  thing1%=1
  thing2%=2
  thing1$="  PubMsg"
  thing2$="  PriMsg"
  GOSUB ratiothings
RETURN
