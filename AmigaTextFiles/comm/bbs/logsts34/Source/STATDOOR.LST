  GOSUB headprint
  ERASE sorted()
  DIM sorted(51,2)
  ERASE ratio()
  DIM ratio(hiuser%)
  thing1%=3
  thing2%=0
  thing1$="  DnLds "
  thing2$="  Calls "
  GOSUB ratiothings
