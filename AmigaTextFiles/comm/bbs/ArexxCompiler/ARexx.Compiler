options results

transmit '\n1Please enter the FILENAME (including COMPLETE PATH) to BE COMPILED:'
query'>';FileR=result
transmit '\n1Please enter the FILENAME (including COMPLETE PATH) of DESTINATION FILE:'
query'>';FileW=result
if ~exists(FileR) then transmit '\n3 SOURCE FILE NOT FOUND !!!'
else do
 call open(read,filer,'R');transmit ''
 call open(write,filew,'W')
 bytes=0;total=0;do until eof(read)
  inn=readln(read);a=length(inn);inn=strip(inn);total=total+a
  b=a-length(inn);Bytes=Bytes+b
  if length(inn)>1 then do
   Jv=writeln(write,inn);transmit 'Total Bytes   : 'total
   transmit 'Bytes Compiled: 'right(Bytes,length(total))'\^2'
  end
 end
 call close write
 call close read;transmit '\n3All DONE!'
end
exit
