/* Global War Startup Script - The Next Generation 
   Features:
   1) It works!!
   2) It prevents people doing CTRL-C/D/E at any time
   3) It will load the latest version of Global War

Thanks go to Gordon Hart, Wicked City BBS, +44 (0)1827 875613,
who got this to work at all, and made it unbreakable */

options failat 9999          /* Keeps users out of your shell! */
options results
call pragma('stack',10000)
UserInfo 'a' ; Name = result
SystemInfo 'm' ; Time = result
SystemInfo '8' ; Line = result
Userinfo 'o' ; access=result
userinfo 'v' ; slength=result
id=time(s)
Transmit

path='t:gwar'line   /* change this to reflect your directory path */

quoteusername='"'||name||'"'

open('temp',path,'W')
writeln('temp','failat 9999')
writeln('temp','stack 10000')
writeln('temp','doors:Globalwar/globalwar NAME 'quoteusername' ACCESS 'access' TIMELEFT 'time'  PAGELENGTH 'slength)

writeln('temp','endcli')
close('temp')

address command 'NewShell from 'path' FIFO:gwar'id'/rwkes'
address command 'BBS:Bin/TrShell -n'line' -d -e -c -fgwar'id 

address command 'Delete 'path' quiet'
delay 100
exit
