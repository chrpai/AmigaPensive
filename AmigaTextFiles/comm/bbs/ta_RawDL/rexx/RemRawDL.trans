/* RawDownLoad.trans sendet jedes erreichbare File. */
options results
userinfo 'x'
ansi = result
cls
if ansi = 'ON' then do
   ESC = '1B'X
   ANSI_BRIGHT = ESC||'[1m'
   NO_ANSI = ESC||'[0m'
   BLACK = ESC||'[30m'
   RED = ESC||'[31m'
   GREEN = ESC||'[32m'
   YELLOW = ESC||'[33m'
   BLUE = ESC||'[34m'
   VIOLET = ESC||'[35m'
   CYAN = ESC||'[36m'
   WHITE = ESC||'[37m'
end
else if ansi = 'OFF' then do
   ANSI_BRIGHT = ''
   NO_ANSI = ''    
   BLACK = ''      
   RED = ''        
   GREEN = ''      
   YELLOW = ''
   BLUE = ''
   VIOLET = ''
   CYAN = ''
   WHITE = ''
end
transmit ''
transmit ANSI_BRIGHT||YELLOW||'               ษอออออออออออออออออออออออออออออออออออออออออออป'||NO_ANSI
transmit ANSI_BRIGHT||YELLOW||'               บ                                           บ'||NO_ANSI
transmit ANSI_BRIGHT||YELLOW||'               บ         '||ANSI_BRIGHT||VIOLET||'  RemoteRawDownLoad V1.0          '||ANSI_BRIGHT||YELLOW||'บ'||NO_ANSI
transmit ANSI_BRIGHT||YELLOW||'               บ       '||ANSI_BRIGHT||CYAN||'(c) 7/97 by Hartmut Meiering        '||ANSI_BRIGHT||YELLOW||'บ'||NO_ANSI
transmit ANSI_BRIGHT||YELLOW||'               บ          '||ANSI_BRIGHT||GREEN||'Fido-Address 2:2476/266          '||ANSI_BRIGHT||YELLOW||'บ'||NO_ANSI
transmit ANSI_BRIGHT||YELLOW||'               บ                                           บ'||NO_ANSI
transmit ANSI_BRIGHT||YELLOW||'               ศอออออออออออออออออออออออออออออออออออออออออออผ'||NO_ANSI
transmit '' 
senden:
transmit ''
transmit ANSI_BRIGHT||CYAN||'           Bitte den ganzen Pfad des zu sendenden Files angeben: '||NO_ANSI
transmit ''
query ANSI_BRIGHT||VIOLET||'   >'||ANSI_BRIGHT||YELLOW||' ' ; filename = result
if RESULT = "###PANIC" then exit 10
if filename = "RESULT" then do
  transmit ''
  transmit ANSI_BRIGHT||CYAN||'               Es wurde kein File angewaehlt! '||NO_ANSI
  call delay(150)
end 
else do
  PRAGMA('W', 'N')
  if exists(filename) then  do
    transmit ''
    queryy ANSI_BRIGHT||CYAN||'                         Transfer starten? '||NO_ANSI
    if Upper(Left(RESULT,1)) ~= "N" then do
       PROTOCOLSEND filename
    end
  end
  else do                                                                     
    transmit ''                                                               
    transmit ANSI_BRIGHT||RED||'                         Dieses File existiert nicht! '||NO_ANSI
  end 
  transmit ''
  queryn ANSI_BRIGHT||GREEN||'                         Noch ein File senden? '
  if RESULT = "###PANIC" then exit 10
  if Upper(Left(RESULT,1)) ~= "N" then call senden
end    
exit 0
