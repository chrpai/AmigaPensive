if ~show('L','cl_rexx.library') then;do;if ~addlib('cl_rexx.library',0,-30,0) then exit;end;if ~show('L','rexxsupport.library') then;do;if ~addlib('rexxsupport.library',0,-30,0) then;do;say 'rexxsupport.library konnte nicht geöffnet werden!';say 'Bitte kopieren Sie die Library von ihren Workbench-';say 'disketten nach LIBS:.';exit 10;end;end;if ~show('L','rexxsyslib.library') then;do;if ~addlib('rexxsyslib.library',0,-30,0) then;do;say 'rexxsyslib.library konnte nicht geöffnet werden!';say 'Bitte kopieren Sie die Library von ihren Workbench-';say 'disketten nach LIBS:.';exit 10;end;end;tageanz=CL_GETTEXT('Connectline:Prefs/DH-Delete_Kopien.para',tage);tage=tage.4;janus=CLGET_PathJANUS();systemanzahl=clget_systemnumberof();do s=1 to systemanzahl;system.s=clget_systemname(s);clkop=janus||system.s||'/';call pragma 'D',clkop;liste=showdir(clkop,'F','¤');call testfiles;verz=showdir(clkop,'D');do i=1 to words(verz);dir=word(verz,i);call pragma 'D',clkop||dir;liste=showdir("",'F','¤');call testfiles;end;end;EXIT;testfiles:;do all=0 while liste ~="";parse var liste dsn '¤' liste;select;when pos('Out',dsn)>15 then;do;x=pos('Out',dsn);hold= date('I')-tage;created=substr(dsn,x-14,4)||substr(dsn,x-10,2)||substr(dsn,x-8,2);call testdate;end;when pos('In',dsn)>15 then;do;x=pos('In',dsn);hold= date('I')-tage;created=substr(dsn,x-14,4)||substr(dsn,x-10,2)||substr(dsn,x-8,2);call testdate;end;otherwise NOP;end;end;return;testdate:;if date('I',created,'S')<hold then;do;address command;'delete >NIL: "'clkop||dsn'"';end;else;do;end;return