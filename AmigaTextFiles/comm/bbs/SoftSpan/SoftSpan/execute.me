; Just some assigns that Soft Span needs.
; Execute this file before you run SoftSpan, or add it to your
;  startup-sequence.

; Assign bbs_data: to the directory where you have your configuration files
assign bbs_data: Soft_Span:data

; Assign bbs_log: to the directory where you have your userlog
assign bbs_log: Soft_Span:log

; Assign bbs_text: to where you have your text directory
; (The menus, sysop bulletin, help directory, etc...)
assign bbs_text: Soft_Span:text
