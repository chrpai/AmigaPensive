(complete 15)

(message "I'm a FiRE STARTER\n"
         " TWiSTED FiRE STARTER!\n"
         "\n"
         "Tag v1.1\n"
         "Ultimate AmigaGuide Creator\n"
         "\n\n"
         "Installer\n\n"
         "-+- Digital Design Production 1996 -+-"
)

(complete 20)

(set cdir
		  (askdir
					 (prompt "Where do you want the executable copying?")
					 (help @askdir-help)
					 (default "C:")
		  )
)
(complete 40)

(set docsdir
		  (askdir
					 (prompt "Where do you want the guide file copying?")
					 (help @askdir-help)
					 (default "AmigaGuide:")
		  )
)

(complete 70)

					 (copyfiles (source "bin/Tag") (dest (cdir)))

(complete 80)

					 (copyfiles (source "docs/Tag.guide") (dest (docsdir)))

(complete 95)

(message "\n\n Now take a look at the docs please :-)")
					 (run "c/guide docs/Tag.guide")

(complete 100)

(message "\n\n\n\n-<*>- Tag Is Now Installed - Enjoy! -<*>-"
         "\n-<*>- Thanx For Choosing Digital Design -<*>-"
)

(exit (quiet))
