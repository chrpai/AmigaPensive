;
;       LOGOUT : AMMS-Script fuer Deluxe-Wall-Logout
;
;       VERSION : $VER: 1.00 / 19.08.1995
;
;       Mit diesem Script werden alle noetigen Verzeichnisse & Files fuer
;       einen neuen Port angelegt.
;
;
;       Das Script sollte so eingebunden werden, dass es ueber Level und
;       Flags auf die folgende Befehle zugreifen kann :
;
;	ADWALL
;	EOD
;	GOTO
;	IF
;	SYSTEMLOGOUT
;

;
;	Option /FAST abfragen
;

if O1 == "T" then goto LOGOUT		; Wenn Option /Fast, sofort Logout

;
;	WALL aufrufen
;

adwall					; Wall aufrufen

;
;	System-Logout
;
LOGOUT:
systemlogout/fast			; Schneller Logout

;
;	Rueckkehrlabel des Programm WALL
;
KEIN_LOGOFF:
eod					; Batchende (Rueckkehr ins Programm)
