;
;       NAME : BATCH UPLOAD
;
;       VERSION : $VER: 1.02 / 24.05.1995
;
;       FUNKTION : Batch Upload
;
;       AUFRUF : BATCH UPLOAD <FILEBRETT>
;
;       AUTOR : Michael Scheler
;
;       Diese Batchdatei benutzt folgende Befehle :
;       -------------------------------------------
;       BATCH UPLOADPRG
;       CHECK FILE
;       DISK EXECUTE
;       PARSE
;
;       Konstanten :
;       ------------
PATH="files:uploads/'{port}'/"          ; TMP-Dir auf Disk fuer die Files

;
;       Programm :
;


;       Lade sprachspezifische Texte

LANG={DEFLANGUAGE}
_check file "mbbatch:com/'{ALANGUAGE}'/batch_upload.bat" GETTEXT
LANG={ALANGUAGE}
GETTEXT:
_disk execute/keep "mbbatch:com/'LANG'/batch_upload.bat"

;       Lese Parameter ein

_parse "Batch Upload" P0 "N/'T_TARGET'" BOARD
_if BOARD == "" then _eod

;       Start Batch-Upload

_batch uploadprg 200 "'PATH'" "'BOARD'" "'BOARD'"

;       Ende

_eod

