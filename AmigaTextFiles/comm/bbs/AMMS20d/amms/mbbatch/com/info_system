;
;	NAME : INFO SYSTEM
;
;	VERSION : $VER: 2.01 / 29.01.1995
;
;	FUNKTION : Zeigt Systeminformationen an
;
;	AUFRUF : INFO SYSTEM
;
;	AUTOR : Michael Scheler
;
;	Diese Batchdatei benutzt folgende Befehle :
;	-------------------------------------------
;	CHECK FILE
;	DISK EXECUTE
;	DISK TEXT
;	ECHO
;	EXTERN
;
;	Folgende Amiga-Dos-Befehle benutzt diese Batch :
;	------------------------------------------------
;	AVAIL
;	COPY
;	DELETE
;	ECHO
;	INFO
;

;
;	Programm :
;

; Texte einbinden

LANG={DEFLANGUAGE}
_check file "mbbatch:com/'{ALANGUAGE}'/info_system.bat" GETTEXT
LANG={ALANGUAGE}
GETTEXT:
_disk execute/keep "mbbatch:com/'LANG'/info_system.bat"

;	System-Informationen in ein File umleiten

_echo/nolf T_CHECK
_extern copy "mbbatch:com/'LANG'/info_system.txt" "mbtmp:'{port}'"
_echo/nolf "."
_extern avail >>"mbtmp:'{port}'"
_echo/nolf "."
_extern echo >>"mbtmp:'{port}'" "*n'T_MSGS'"
_extern echo >>"mbtmp:'{port}'" "*n'T_FILES'"
_echo/nolf "."
_extern info >>"mbtmp:'{port}'"

;	System-Informationen anzeigen, File danach loeschen

_disk text "mbtmp:'{port}'"
_extern delete "mbtmp:'{port}'" quiet
