;
;	NAME : FMAIL
;
;	VERSION : $VER: 1.07 / 15.05.1995
;
;	FUNKTION : Zeigt Privatfiles aus dem Privat-Filebrett an.
;
;	Diese Batchdatei benutzt folgende Befehle :
;	-------------------------------------------
;	ECHO
;	ON ERROR
;	FILES
;	CHECK FBOARD
;
;	Aufruf durch User : FMAIL
;
;	Konstanten :
;
FBOARD=":System/Privat"			; Name des Privat-Filebretts

;
;       Programm :
;

;	Texte einbinden

LANG={DEFLANGUAGE}
_check file "mbbatch:com/'{ALANGUAGE}'/fmail.bat" GETTEXT
LANG={ALANGUAGE}
GETTEXT:
_disk execute/keep "mbbatch:com/'LANG'/fmail.bat"

;	Pruefe auf Privatfiles

_check fboard/all "'FBOARD'" NOFILE	; Pruefe auf Privatfiles

;	Privatfiles gefunden -> Privatfiles anzeigen

_files/Action=320 "'FBOARD'"		; Privatfile anzeigen
_echo T_End				; Endtext ausgeben
_goto END				; -> Ende

;	Keine privaten Files vorhanden

NOFILE:
_echo T_NoFile				; Keine File vorhanden ausgeben

;	Ende

END:
_eod					; Ende
