;
;	FAX-CHECK-SCRIPT
;
;	$VER: 1.00 / 12-09-1994
;
;	Script zum Testen ob Faxe empfangen wurden
;
check file mbdat:fax.log END			; LogFile vorhanden ?

echo "Fax received on :^J"
disk text mbdat:fax.log
menu "^JDelete log ? Y#left#" "Y^M" DEL_LOG "N" END

DEL_LOG:
extern delete mbdat:fax.log quiet

END:
