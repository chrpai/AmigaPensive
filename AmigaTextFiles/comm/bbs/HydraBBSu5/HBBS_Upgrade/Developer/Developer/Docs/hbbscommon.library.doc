  struct Node __asm __saveds *HBBS_FindNode(register __a0 struct List *list,register __a1 char *str)

    Description

      returns the node in the "list" who's ln_Name field is set to "str"

    Inputs

      list - a list of nodes.
      str - a string

    Returns

      the node that had it's ln_Name field set to "str" or NULL otherwise

  V_BIGNUM __asm __saveds HBBS_FindNodeNum(register __a0 struct List *list, register __a1 char *str)

    Description

      returns the number of the node in the "list" who's ln_Name field was set to "str"

    Returns

      the index of the node in the "list" that had it's ln_Name field set to "str" or NULL otherwise
      starting at 0 for the first node.

      -1 if node was not found.

  void __asm __saveds HBBS_InitUserData(register __a0 struct UserData *User,register __d0 V_BIGNUM AccessLevel,register __d1 V_BIGNUM ConfNum)

    Description

      Initialises a struct UserData structure.

      Use this before calling HBBS_AddUser() after filling out somne of the other fields.

    Inputs

      User - pointer to some allocated memory the size of sizeof(struct UerData)
      AccessLevel - the access level to set the user to, this must be a valid access level
                    that has been defined in HBBS:Access/Levels/Level_List
      ConfNum - the default conference to start the user in.

  void __asm __saveds strNcpy(register __a0 UBYTE *dest,register __a1 UBYTE *source,register __d0 int chars)

    Description

      same as strncpy() but DOES null terminate the destination string.
      unlike the normal ANSI/SAS-C version.

  char __asm __saveds *HBBS_ListName(register __a0 V_STRINGLIST ListName,register __d0 V_SMALLNUM ItemNum)

    Description

      Returns a pointer to the ln_Name field of node "ItemNum" in list "ListName"

    Notes

      ItemNum must be in the list.

      Index starts at 0 (0 is the first node in the list)


  void __asm __saveds FreeFileTags( register __a0 struct NodeData *N_ND )

    Description

      Free's all tagged files that the user might have.

    Inputs

      N_ND - The node to free the tagged files on.

    Notes

      A user must be online.



  struct List __asm __saveds *HBBS_LoadFile(register __a0 char *filename)

    Description

      Loads a text file into a linked list, with the ln_Name of each node
      in the list being a line of the file.

    Inputs

      filename - the name of the file to load

    Returns

      NULL if file could not be opened or if we ran out of memory
      otherwise a pointer to a linked list.

    Notes

      The nodes and the list are allocated using AllocVec so you can use
      FreeStrList() to free all the nodes and the list itself.

  BOOL __asm __saveds HBBS_SaveFile( register __a0 char *file_name, register __a1 struct List *list)

    Description

      Saves the ln_Name fields of each node in a linked list to a standard text file.
      Each line of the file contains a single ln_Name field.

    Inputs

      filename - the name of the file to save the linked list as.
      list - the linked list of nodes

    Returns

      TRUE if sucessful.

    Notes

      not all nodes in the "list" need have a ln_Name defined, nodes with an ln_Name value of
      NULL will be omited from the file.

      make sure you've got enough disk space as no Write() error checking is done.

  struct List __asm __saveds *HBBS_CreateList( void )

    Description

      Allocated a new struct List and initalises it.

    Returns

      the pointer to the empty list or NULL if failure

    Notes

      Free the list using FreeVec() or FreeStrList() if appropriate

  strftcpy(register __a0 char *dest,register __a1 char *source,register __d0 int from,register __d1 int topos)

    Description

      Copies a source string to a destination string starting for charater "from" ending at character "topos"

    Inputs

      dest - pointer to buffer to hold destination string.
      source - pointer to a string
      from - index to start copying chars from source to dest, starting at 0.
      topos - index to stop copying chars from soure to dest, starting at 0.

    Example

        char *mystr="moocow's are great";
        char buffer[10];

        strftcpy(buffer,mystr,3,5);

        // buffer would now contain the null terminated string "cow"

  void __asm __saveds RemoveSpaces(register __a0 char *string)

    Description

      removes spaces from the start and end of a string.

    Inputs

      string - a string to modify

    Example

      char *mystr="   spaces   ";

      RemoveSpaces(mystr);

      // mystr would now contain the null terminated string "spaces"

  void __asm __saveds HBBS_SaveUserData(register __a0 struct UserData *User)

    Description

      Saves specified user information back to the user.data file.

    Inputs

      User - pointer to a correctly filled out struct UserData

    Notes

      The user specified must already be present in the user.data file.
      Location of the existing user is done via User->UserID. so you cannot
      and must not ever change this value.

  void __asm __saveds HBBS_GetDate(register __a0 char *datestr)

    Description

      stores the date in a string which must be LEN_DATESTR+1 characters or longer

    Inputs

      datestr - place to store the datestring

    Notes

      datestr will be in the format DD-MMM-YYYY and will be null terminated.

    Example

      char mydate[LEN_DATESTR+1];

      HBBS_GetDate(mydate);

  void __asm __saveds HBBS_SaveCallsData( void )

    Description

      ** PRIVATE **  DO NOT USE!

  void __asm __saveds HBBS_LoadCallsData( void )

    Description

      ** PRIVATE **  DO NOT USE!

  void __asm __saveds HBBS_GetTime(register __a0 char *timestr)

    Description

      stores the time in a string which must be LEN_TIMESTR+1 characters or longer

    Inputs

      timestr - place to store the datestring

    Notes

      timestr will be in the format HH:MM:SS and will be null terminated.

    Example

      char mytime[LEN_TIMESTR+1];

      HBBS_GetTime(mytime);

  void __asm __saveds HBBS_GetDateString(register __a0 char *datestr,register __d0 ULONG AmigaTime)

    Description

      Converts the date in "AmigaTime" to "datestr" using the format DD-MMM-YYYY

    Inputs

      datestr - a string of length LEN_DATESTR+1
      AmigaTime - a packed date, e.g like the ones returned by ReadBattClock() or HBBS_GetAmigaTime()
                  or N_ND->User.NormalData.LastCalledDate (UserData->LastCalledDate)

  ULONG __asm __saveds HBBS_DateStrToAmigaTime(register __a0 char *datestr)

    Description

      Convert a date string "datestr" in the format DD-MMM-YYYY to an AmigaTime value.

      This is the opposite of HBBS_GetDateString().

    Notes

      See the file HBBS:Source/Doors_User/FileLister/Main.c for an example usage.

  V_BOOL __asm __saveds HBBS_CopyFile(register __a0 char *fromfile, register __a1 char *tofile,register __d0 ULONG BufSize)

    Description

      Copy a file from one location to another.

    Inputs

      fromfile - filename to copy
      tofile - file to create
      BufSize - 0 for default buffer size or any user specified size more than 10 bytes

    Returns

      TRUE if sucessful

  V_BOOL __asm __saveds HBBS_AppendStrToFile(register __a0 UBYTE *FileName, register __a1 UBYTE *String)

    Description

      Appends a string to a file.  Great for creating log files etc..

    Inputs

      Filename - filename to add the string to
      String - the string to add to the end of the file.

    Returns

      TRUE if sucess.

    Notes

      Try not to call this function multiple times in sucession using the same file. Instead
      open() your file, seek() to the end of it and write() your data normally as it will be faster.

  struct Node __asm __saveds *HBBS_CreateNode(register __a0 char *namestr,register __d0 ULONG nodesize)

    Description

      Creates a node and returns a pointer to it.

      if "namestr" is not NULL then the a new string will be allocated and
      copy if namestr will be placed the ln_Name field.

      if you specify 0 for the nodesize, then the size of the node allocated
      will be the sizeof(struct Node), otherwise it'll allocate however many bytes
      you specify.

      All the data will be zero'd, so all your other fields will be intialized to NULL
      or 0!

    Returns

      pointer to the newly created node or NULL if it ran out of memory

      Use FreeVec() on the ln_Name field and the node itself.  Or pass to HBBS_FreeNode()

  void __asm __saveds HBBS_FreeNode(register __a0 struct Node *node,register __d0 V_BOOL RemoveIt)

    Description

      Free's a node created with NewStrNode() or HBBS_CreateNode()

      Can remove the node from whatever list it may be in too.

    Inputs

      node - the node to free, if the ln_Name field is not NULL then it will be FreeVec()'d
      RemoveIt - if TRUE the node will be removed from whatever list it is in.

    Notes

      Don't pass it nodes that had an ln_Name field allocated in a way other than AllocVec()

  void __asm __saveds HBBS_FreeListNodes(register __a0 struct List *list)

    Description

      Free's all the nodes in the "list" specified using but does not free the list
      itself.  It just leaves you with an empty list.

    Notes

      Make sure the nodes were allocated using AllocVec() ot HBBS_CreateNode() or
      NewStrNode().  Each node is freed along with it's ln_Name field.

  V_BOOL __asm __saveds HBBS_SendOLM(register __d0 V_SMALLNUM FromNode,register __a0 UBYTE *FromPRG,register __d1 V_SMALLNUM ToNode,register __a1 UBYTE *MessageStr,register __d2 BYTE Pri)

    Description

      Sends an OLM (OnLine Message) to another node.

    Inputs

      FromNode - 0 unless you are calling this from a door that has been started by the a node
                 in which case set this to N_ND->NodeNum+1
      FromPRG - the name of your door or program in a null terminated string.
      ToNode - the node to send the message to, starting at 0.
      MessageStr - the string to send to the other node.
      Pri - 0, for a normal priority message. or 1 for a higher priority message.

    Returns

      TRUE if an OLM was sent.

    Notes

      The OLM will only be sent to the node specified if that node exists and if a user
      is online.

      Doors can delay the reception of OLM's by using the DOOR_GetLine() flag of GL_NOOLM

      OLM's are only displayed on other nodes when the other nodes place a call
      to DOOR_GetLine(). So an OLM will never be displayed (say) during the middle
      of a file listing.  This is so that the user will ALWAYS see each OLM.


  BOOL __asm __saveds FGetsR(register __a0 BPTR FH,register __a1 UBYTE *Buffer,register __d0 LONG BufferLen)

    Description

      same as the dos.library FGets() only it works backwards from the current file position.

    Inputs

      FH - an Open()'ed file.
      Buffer - pointer to buffer location to store the line of text in.
      BufferLen - size of the buffer.

    Returns

      TRUE if a line of text was read.

    Example

      Use this to read a text file backwards!

      say you had a text file containing the following lines.

      line one
      line two
      line three
      line four
      line five

      and you Open()'d that file

      the called FGetsR() 5 times and printed each buffer to the screen, the
      output would be

      line five
      line four
      line three
      line two
      line one


    Notes


      See the file HBBS:Source/Doors_User/FileLister/Main.c for an example usage.
      as it uses it to reverse scan a filelist!

      This routine is not particualy fast as quite alot of Seek()ing has to be
      done, but good enough for most purposes. (it uses a 255 byte buffer)


  V_BOOL __asm __saveds HBBS_HandleNameOK(register __a0 char *checkstr)

     Description

       checks to see if the users handle contains any invalid characters that might
       cause HBBS problems.

       Currently the characters not allowed are ,;:()|#*?

       I might add / and \ to this list at a later date.

     Inputs

       checkstr - the string to check for invalid characters.

     Returns

       TRUE if the handle is OK for HBBS to use.

  V_BIGNUM __asm __saveds HBBS_GetFileSize(register __a0 char *filename)

    Description

      Returns the filesize of a given file in bytes.

  V_BOOL __asm __saveds HBBS_FindConfFile(register __d0 V_BIGNUM ConfNum,register __a0 char *filename,register __a1 char *fullname)

    Description

      searches the download paths of the conf for the filename specified
      and returns TRUE if the file is found.  The full path and filename
      are then stored in fullname if fullname is not a null pointer


  BPTR __asm __saveds HBBS_LockUserData( register __d0 ULONG LockMode );

    Inputs

      LockMode - see dos.library/Lock() for valid lock modes (normally
                 either ACCESS_READ or ACCESS_WRITE)

    Description

      When a door needs to access the user data file, they should call
      this function, which returns a lock to the user data file.  They
      can then manipulate the file (use OpenFromLock().)

      Must be paired with HBBS_UnLockUserData().

      This function will wait until a lock is established, so use it with
      care, if you want to see if the file is already locked by another
      program/door, then check BBSGlobal->UserDataLocked (boolean) first.

      The lock obtained from this function must be treated just as if
      you did Lock(filename).  So read the autodocs on dos.library/Lock()!

      When accessing the user data file, make sure that you keep the file
      open/locked for the shortest amount of time possible because other
      doors/utils may want access to it at the same time.

      If possible, copy the items from the datafile you need, then close
      the file and call HBBS_UnLockUserData() then, if you have to write
      back to the file, call the function again.

  void __asm __saveds HBBS_UnLockUserData( void );

    Description

      Call when you've finished accessing the userdata file.

      If you don't, other doors and the bbs will not be able to access the user
      data file.

      See HBBS_LockUserData().

  void __asm __saveds HBBS_ApplyAccountDefaults( register __a0 struct UserData *User );

    Description

      Call this to have account defaults applied to a user account.

    Inputs

      User - pointer to an allocated and initialised user data structure

      The User->Access record must be correct and verified for this function
      to work.


  LONG __asm __saveds HBBS_DosCommand(register __a0 char *command,register __d0 ULONG Flags,register __a1 char *outputfilename)

    Description

      runs a program (script or executable, path is the same as the system path)

    Inputs

      command - name of a command to run with paramaters (e.g. "DIR HBBS:")
      FLAGS - Specifiy one of the following flags:

              RDC_NONE - None specified

              RDC_ASYNC - use this flag if you want to have your program run
                          in the background.

              RDC_DEFAULTOUTPUT - HBBS will not attempt to open a new console window
                                  for the output of your program.

      outputfilename - filename of a file (will be overwritten) to send your command's
                       output to, the file will be opened and closed by HBBS, do NOT
                       use RDC_ASYNC or RDC_DEFAULTOUTPUT if you specify this.
                       Set this to NULL if you don't want a file opened for you.

                       * remember to remove any output files that are created for you
                         if you do not want them.

    Notes

      stacksize if 16384 by default (or HBBS's configured default stacksize for
      external programs)

      if your command string contains @S@ it is replaced with the pub screen name that
      the control gui is open on.

    See Also

      HBBS_RunDOSCMD().

  V_BOOL __asm __saveds HBBS_OkToUpload(register __a0 char *filename)

    Description

      this checks to see if the filename in question (filepart only) is currently
      being uploaded on another node, or is in another open node's playpen directory,
      waiting to be checked.

    Returns

      TRUE if it is OK to upload this file, FALSE otherwise.

  void __asm __saveds HBBS_ClearCommentsFromList(register __a0 struct List *list)

    Description

      This routine takes a list of nodes and removes the comments and
      trailing spaces and begining of line spaces from each node->ln_Name in
      the list.  No memory is freed, you still need to free each node->ln_Name
      the same way you allocated it.

