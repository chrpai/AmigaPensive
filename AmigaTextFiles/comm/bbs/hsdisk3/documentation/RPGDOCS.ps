/bd {bind def}bind def
/ld {load def}bd
/ed {exch def}bd
/FF {gsave showpage grestore}bd
/n /newpath ld
/cp /currentpoint ld
/clp /closepath ld
/st /stroke ld
/sh /show ld
/tr /translate ld
/m /moveto ld
/rm /rmoveto ld
/l /lineto ld
/rl /rlineto ld
