CD MB:
Stack 50000

If EXISTS FONTS:xen.font
	If EXISTS FONTS:xen/8
		SetFont xen.font 8
	EndIf
EndIf

Echo "Starting daemons ... " NOLINE

If "`status command=MB:C/EazyCommDaemon`" EQ ""
	;Echo "Starting EazyCommDaemon"
	Run MB:C/EazyCommDaemon
EndIf

If "`status command=MB:C/EazyLogfileDaemon`" EQ ""
	;Echo "Starting EazyLogfileDaemon"
	Run MB:C/EazyLogfileDaemon
EndIf

If "`status command=MB:C/EazyInOutDaemon`" EQ ""
	;Echo "Starting EazyInOutDaemon"
	Run MB:C/EazyInOutDaemon
EndIf

If "`status command=MB:C/EazyMsgFileDaemon`" EQ ""
	;Echo "Starting EazyMsgFileDaemon"
	Run MB:C/EazyMsgFileDaemon
EndIf

If "`status command=MB:C/EazyUserDaemon`" EQ ""
	;Echo "Starting EazyUserDaemon"
	Run MB:C/EazyUserDaemon 183
EndIf

;Echo "*E[4D, done."
Echo "done."

EndCli
