; Skript for Port 1 only!
; copy to "EazyBBS Port3" (etc.) for additional ports

Echo "Starting EazyBBS demo ... please wait!"

; setting temporary assignments
;
Assign MB:		""
Assign MB_DATA:		Data
Assign MB_USER:		User
Assign MB_BOARD:	Board
Assign MB_FILES:	Files
Assign MB_TMP:		TMP

; DOS search path
;
Path MB:C ADD

; more LIBS:
;
Assign LIBS: MB:Libs ADD

; stack, stack, stack
;
Stack 50000

; launching daemons if not already running
;
MB:C/StartDaemons

; give daemons some time to initialize
;
Wait 3

; call EazyBBS with the appropriate port number
; (NEVER "run" EazyBBS from here!)
;
MB:C/EazyBBS 1

Echo "Done."
