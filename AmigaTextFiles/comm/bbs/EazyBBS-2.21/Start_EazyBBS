.key dest1
.bra {
.ket }

FailAt 21
;Set dest2 `cd`
Echo "*N Welcome to *E[1mEazyBBS Mailbox *E[0m!*N"

Echo "EazyBBS is very easy to start ...*N"
Echo "First of all, launch the Daemons.  They must be running"
Echo "before you can start the main program EazyBBS. And don't"
Echo "forget, you'll need at least 50000 bytes stack.*N"
Echo "        Run EazyInOutDaemon"
Echo "        Run EazyLogfileDaemon"
Echo "        Run EazyMsgFileDaemon"
Echo "        Run EazyUserDaemon"
Echo "        Run EazyCommDaemon"

Stack 50000

Run >nil: EazyInOutDaemon
Run >nil: EazyLogfileDaemon
Run >nil: EazyMsgFileDaemon
Run >nil: EazyUserDaemon
Run >nil: EazyCommDaemon

Echo "*NPress [RETURN] for more!" NOLINE
Echo ? >nil:
Echo "*EM*E[K" NOLINE

Echo "*NOk, eazy.  And now start the main program EazyBBS.*N"
Echo "        Run EazyBBS 0"
Echo "*N('0' means that EazyBBS searches for the next free port,"
Echo " but feel free to supply EazyBBS with a port number like '1'"
Echo " or higher, port 2 is configured for local logins)*N"

;Run >nil: EazyBBS 0
Run >nil: EazyBBS 2

Echo "*NPress [RETURN] for more!" NOLINE
Echo ? >nil:
Echo "*EM*E[K" NOLINE

Echo "*N*N Yeah... done.  You got it.  EazyBBS is running!!*N"

Quit

