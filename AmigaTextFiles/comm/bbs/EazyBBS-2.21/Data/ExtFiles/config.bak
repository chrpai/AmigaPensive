#
# InitialDir Inc:modules
# Initial directory when user starts external files shell
#
InitialDir	i:gif

#
# Allow access to these directories
#
 AllowedCD	(inc:gif|inc:modules)*

#
# Text files viewable to the user
#
 AllowedMore	(*.readme|*.txt|*.doc|*.dok)

#
# Show these files in directories
#
 AllowedLS	~(.message|.initmessage)

#
# Allow these files for transmission
#
 AllowedSZ	*

#
# Extension (incl. period) for packed directories
#
 PackExtension	.lzh


# Thanks for all the fish...
