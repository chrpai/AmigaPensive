
#
# Config file für EazyLog für Version 1.6
#
#
#
# Allgemeine Configs
#

# Wieviele Tag zurück berücksichtigen (default = 5)

DaysAgo		31

# Welche Ports berücksichtigen        (default = 1)

Ports		1,2,4

# Filename des Transferlogs           (default = MB:EazyBBS.TransferLog) 

LogName		MB:Intern/log.transfer

# File Areas die nicht dargestellt werden sollen

HiddenArea	Amiga/Group

# Boards die nicht dargestellt werden sollen

HiddenBoard	System/News Amiga/Group

# User die dieses Programm mit dieser Config benutzen dürfen
#
# * steht für alle User. Default = *

#AllowedUser	sysop

# User die dieses Programm mit dieser Config nicht benutzen dürfen
#
# Default = keiner

ForbiddenUser	<guest>

# Text der dargestellt wird wenn der User das Programm nicht benutzen darf
#
# Default = "\n\\1Sorry you are not allowed to use this Userprogramm.\n"

Forbiddentext	"\n\\1Du bist nicht berechtig dieses Programm zu benutzen.\n"




#-----------------------------------------------------------------------------
#
# Configs für die Top Files
#
#

# Anzahl Der TopFiles                 (default = 10)

TopFiles	30

# Intro Text für den Platz 1          (default = \9\1)

FileIntro1st	\1\7\!

# Intro Text für die anderen Plätzte  (default = \7)

FileIntroNext	\6\1

# Header Text Filename                (default = Interner Header Text)

FileHeader	MB_DATA:UserPrograms/EazyLog/EazyLog.Header_TopFiles

# Footer Text Filename                (default = Interner Footer Text)

FileFooter		MB_DATA:UserPrograms/EazyLog/EazyLog.Footer_TopFiles

# Header Footer Darstellen            (default = Header ja, Footer nein)

# ShowFileHeader	nein
ShowFileFooter		ja



#-----------------------------------------------------------------------------
#
# Configs für die Top Boards
#
#

# Anzahl der TopBoards                (default = 10)

TopBoards		12

# Intro Text für den Platz 1          (default = \9\1)

BoardIntro1st		\1\7\!

# Intro Text für die anderen Plätzte  (default = \7)

BoardIntroNext		\6\1

# Header Text Filename                (default = Interner Header Text)

BoardHeader		MB_DATA:UserPrograms/EazyLog/EazyLog.Header_TopBoards

# Footer Text Filename                (default = Interner Footer Text)

BoardFooter		MB_DATA:UserPrograms/EazyLog/EazyLog.Footer_TopBoards

# Header Footer Darstellen            (default = Header ja, Footer nein)

# ShowBoardHeader	nein
ShowBoardFooter		ja



#-----------------------------------------------------------------------------
#
# Configs für die Area/User Stats
#
#

# Anzahl der Area Stat Plätze         (default = 99)

TopAreaStat		10

# Intro Text für den Platz 1          (default = \9\1)

AreaStatIntro1st	\1\7\!

# Intro Text für die anderen Plätzte  (default = \7)

AreaStatIntroNext	\6\1

# Header Text Filename                (default = Interner Header Text)

AreaStatHeader		MB_DATA:UserPrograms/EazyLog/EazyLog.Header_AreaStat

UserStatHeader		MB_DATA:UserPrograms/EazyLog/EazyLog.Header_UserStat

# Header Darstellen                   (default = ja)

#ShowAreaStatHeader	nein
#ShowUserStatHeader	nein

# User Stat liste nach größe sortieren (default = ja)
# 
# andernfalls wird nach Datum Sortiert ausgegeben

SortUserStat		no

