echo ""
echo ""
echo "(*) TradeWars 2.3! (*)"
echo "By Chris Cowan"
echo "(c) 1992,1993 Outlaw Technology"
echo "" 
echo "Updating TradeWars..."
echo ""
if not exists pfiles:
  echo "Please assign the pfiles: directory!"
endif
if exists pfiles:
  if not exists pfiles:tradewars/ports
    echo "Creating pfiles:tradewars/ports directory..."
    makedir "pfiles:tradewars/ports"
  endif
  echo "Copying files..."
  copy tw.uniconvert2.2 pfiles:
  copy TradeWars! pfiles:tradewars
  copy twmain pfiles:tradewars
  copy TwNightlyMaint pfiles:tradewars
  copy text2.3.lha pfiles:tradewars/text
  copy universe2.2.lha pfiles:tradewars/universe
  copy uni_add2.lha pfiles:tradewars/universe
  copy ports2.2.lha pfiles:tradewars/ports
  copy tap.data pfiles:tradewars/universe
  if exists pfiles:TradeWars!
    echo "Deleting pfiles:TradeWars!..."
    delete pfiles:TradeWars!
  endif
  if exists pfiles:tradewars/TwMaint
    echo "Deleting pfiles:tradewars/TwMaint..."
    delete pfiles:tradewars/TwMaint
  endif
  if exists pfiles:tradewars/_scenario1
    echo "Deleting pfiles:tradewars/_scenario1..."
    delete pfiles:tradewars/_scenario1
  endif
  if exists pfiles:tradewars/_scenario2
    echo "Deleting pfiles:tradewars/_scenario2..."
    delete pfiles:tradewars/_scenario2
  endif
  if exists pfiles:tradewars/_title.pic
    echo "Deleting pfiles:tradewars/_title.pic..."
    delete pfiles:tradewars/_title.pic
  endif
  if not exists c:lha
    echo "Missing LHA...cannot break down TradeWars .LHA files!"
  endif
  if exists c:lha
    echo "Unarc'ing text2.3.lha file..."
    cd pfiles:tradewars/text 
    lha -m x text2.3.lha
    cd pfiles:
  endif
  echo ""
  echo "Update complete!"
  echo ""
  echo "Things to Do (if updating from 2.1):"
  echo ""
  echo "	o  Add and run 'tw.uniconvert2.2'"
  echo "           (see 'tw.README!' for details!)"
  echo ""
  echo "	o  Change the path of the game from pfiles:TradeWars! to"
  echo "           pfiles:tradewars/TradeWars!"
  echo ""
  echo "If updating from 2.2, no further changes will be necessary!"
  echo ""
  echo ""
endif