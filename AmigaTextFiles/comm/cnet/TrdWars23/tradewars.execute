echo ""
echo ""
echo "(*) TradeWars 2.3! (*)"
echo "By Chris Cowan"
echo "(c) 1992,1993 Outlaw Technology"
echo "" 
echo "Setting up TradeWars..."
echo ""
if not exists pfiles:
  echo "Please assign the pfiles: directory!"
endif
if exists pfiles:
  if not exists pfiles:tradewars
    echo "Creating pfiles:tradewars directory..."
    makedir "pfiles:tradewars"
  endif
  if not exists pfiles:tradewars/text
    echo "Creating pfiles:tradewars/text directory..."
    makedir "pfiles:tradewars/text"
  endif
  if not exists pfiles:tradewars/universe
    echo "Creating pfiles:tradewars/universe directory..."
    makedir "pfiles:tradewars/universe"
  endif
  if not exists pfiles:tradewars/players
    echo "Creating pfiles:tradewars/players directory..."
    makedir "pfiles:tradewars/players"
  endif
  if not exists pfiles:tradewars/planets
    echo "Creating pfiles:tradewars/planets directory..."
    makedir "pfiles:tradewars/planets"
  endif
  if not exists pfiles:tradewars/teams
    echo "Creating pfiles:tradewars/teams directory..."
    makedir "pfiles:tradewars/teams"
  endif
  if not exists pfiles:tradewars/messages
    echo "Creating pfiles:tradewars/messages directory..."
    makedir "pfiles:tradewars/messages"
  endif
  if not exists pfiles:tradewars/ports
    echo "Creating pfiles:tradewars/ports directory..."
    makedir "pfiles:tradewars/ports"
  endif
  echo "Copying files..."
  copy TradeWars! pfiles:tradewars
  copy twmain pfiles:tradewars
  copy TwNightlyMaint pfiles:tradewars
  copy tradewars.lha pfiles:tradewars
  copy text2.3.lha pfiles:tradewars/text
  copy universe2.2.lha pfiles:tradewars/universe
  copy players.lzh pfiles:tradewars/players
  copy teams.lzh pfiles:tradewars/teams
  copy ports2.2.lha pfiles:tradewars/ports
  if not exists c:lha
    echo "Missing LHA...cannot break down TradeWars .LHA files!"
  endif
  if exists c:lha
    echo "Unarc'ing tradewars.lha file..."
    cd pfiles:tradewars
    lha -m x tradewars.lha
  endif
  if exists c:lha
    echo "Unarc'ing text2.3.lha file..."
    cd pfiles:tradewars/text 
    lha -m x text2.3.lha
  endif
  if exists c:lha
    echo "Unarc'ing players.lzh file..."
    cd pfiles:tradewars/players 
    lha -m x players.lzh
  endif
  if exists c:lha
    echo "Unarc'ing teams.lzh file..."
    cd pfiles:tradewars/teams 
    lha -m x teams.lzh
  endif
  if exists c:lha
    echo "Unarc'ing universe2.2.lha file..."
    cd pfiles:tradewars/universe 
    lha -m x universe2.2.lha
    cd pfiles:
  endif
  if exists c:lha
    echo "Unarc'ing ports2.2.lha file..."
    cd pfiles:tradewars/ports 
    lha -m x ports2.2.lha
    cd pfiles:
  endif
  echo ""
  echo "Setup complete!"
  echo ""
  echo "Things to Do:"
  echo ""
  echo "	o  Add 'pfiles:tradewars/TwNightlyMaint' to your BBSEVENT0 file."
  echo "           (see 'tw.README!' file for correct event settings!)"
  echo ""
  echo "	o  Run TwNightlyMaint once to initialize the game.
  echo "           (again, see 'tw.README!' for details!)"
  echo ""
  echo "	o  Add 'TradeWars!' to your Pfiles listing as an AREXX file."
  echo ""
  echo ""
endif