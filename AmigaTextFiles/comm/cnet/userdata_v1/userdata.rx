/*         G A M E L I N E  P R O G R A M  F I L E S  F O R  C N E T
      --------------------------------------------------------------------
    This is a program which displays a users access to certain areas of the
    system you operate. All variables can be changed to meet your system
    needs.   */

options results
bufferflush

transmit '\f1              \z7\c4  (*)\c1  GameLine User Area Access Display  \c4(*)  \z0'

getuser 1;us=result 
getuser 3;nm=result
getuser 15;ac=result
getuser 16;gr=result
sa="Public Access Boards"         /* You may change the names of any of these*/
sb="AquariNet Subboards"
sc="IBM/Clone Subboards"
sd="MacIntosh Subboards"
se="C64/C128 Subboards"
sf="Amiga Subboards"
sg="Special Forum Boards"
sh="A.K.A. Subboards"
si="Private Club Boards"
sj="Cnet Support Boards"
sk="Adult Subboards"
sl="Subscriber Subboards"
sm="Syndicate Subboards"
sz="SysOp Subboards"            /* To this point */
call ACCESS

ACCESS:
if ac>19 then ma="\c2Yes";      /* These determine access to maintenance */
if ac<20 then ma="\c1No ";       
if ac<2 then pf="\c1No ";       /* These determine access to pfiles, gfiles */
if ac>1 then pf="\c2Yes";
if ac>1 then ul="\c2Yes";       /* These determine access to U/Dloads */
if ac<2 then ul="\c1No ";
if ac>15 then dn="\c2Yes";      /* These determine access to Special areas */
if ac<16 then dn='\c1No';
if ac>15 then bt='\c2Yes';      /* These determine beta testing levels */
if ac<16 then bt='\c1No';
if ac>1 then cf='\c2Yes';       /* These determine conferencing access */
if ac<2 then cf='\c1No';
bl='\c2Yes';                    /* This is the bulletins Flag */
em='\c2Yes';                    /* This is the E-mail Flag */
call Main

ACC:
transmit '\n1\c1Checking Your Subboard access\c7\w1 . \w1. \w1.\w1\c2\p4                                    \p0'
getuser 15;ac=result
y='\c2Full\c5'      /* y is the full access for the section/subboard */
n='\c1None\c5'      /* n is no access to the section/subboard */
p='\c6Ltd.\c5'      /* p is restricted access to section/sub */
if ac=0 then nz=n; na=y; nb=n; nc=n; nd=n; ne=n; nf=n; ng=n; nh=n; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=0 then call main2
if ac=2 then nz=n; na=y; nb=y; nc=n; nd=n; ne=y; nf=n; ng=n; nh=n; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=2 then call main2
if ac=6 then nz=n na=y; nb=y; nc=n; nd=n; ne=y; nf=n; ng=y; nh=y; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=6 then call main2
if ac=10 then nz=n na=y; nb=n; nc=n; nd=n; ne=y; nf=n; ng=y; nh=n; ni=y; nj=n; nk=y; nl=n; nn=n
if ac=10 then call main2
if ac=16 then nz=n; na=y; nb=n; nc=n; nd=n; ne=y; nf=n; ng=y; nh=n; ni=n; nj=n; nk=p; nl=y; nn=n
if ac=16 then call main2
if ac=3 then nz=n; na=y; nb=y; nc=y; nd=n; ne=n; nf=n; ng=n; nh=n; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=3 then call main2 
if ac=8 then nz=n na=y; nb=y; nc=y; nd=n; ne=n; nf=n; ng=n; nh=y; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=8 then call main2
if ac=12 then nz=n; na=y; nb=n; nc=y; nd=n; ne=n; nf=n; ng=y; nh=n; ni=y; nj=n; nk=p; nl=n; nn=n
if ac=12 then call main2
if ac=18 then nz=n; na=y; nb=n; nc=y; nd=n; ne=n; nf=n; ng=y; nh=n; ni=n; nj=n; nk=p; nl=y; nn=n
if ac=18 then call main2
if ac=4 then nz=n; na=y; nb=y; nc=n; nd=n; ne=n; nf=y; ng=n; nh=n; ni=n; nj=n; nk=p; nl=n; nn=n
if ac=4 then call main2
if ac=7 then nz=n; na=y; nb=y; nc=n; nd=n; ne=n; nf=y; ng=n; nh=y; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=7 then call main2
if ac=11 then nz=n; na=y; nb=y; nc=n; nd=n; ne=n; nf=y; ng=y; nh=n; ni=y; nj=n; nk=p; nl=n; nn=n
if ac=11 then call main2
if ac=17 then nz=n; na=y; nb=y; nc=n; nd=n; ne=n; nf=y; ng=y; nh=n; ni=n; nj=n; nk=p; nl=y; nn=n
if ac=17 then call main2
if ac=5 then nz=n; na=y; nb=y; nc=n; nd=y; ne=n; nf=n; ng=n; nh=n; ni=n; nj=n; nk=n; nl=n; nn=n
if ac=5 then call main2
if ac=9 then nz=n; na=y; nb=y; nc=n; nd=y; ne=n; nf=n; ng=n; nh=y; ni=n; nj=n; nk=y; nl=n; nn=n
if ac=9 then call main2
if ac=13 then nz=n; na=y; nb=n; nc=n; nd=y; ne=n; nf=n; ng=y; nh=n; ni=y; nj=n; nk=p; nl=n; nn=n
if ac=13 then call main2
if ac=14 then nz=n; na=y; nb=y; nc=n; nd=n; ne=n; nf=y; ng=y; nh=n; ni=n; nj=y; nk=y; nl=n; nn=n
if ac=14 then call main2
if ac=15 then nz=n; na=y; nb=y; nc=y; nd=y; ne=y; nf=y; ng=y; nh=n; ni=n; nj=n; nk=y; nl=n; nn=y
if ac=15 then call main2
if ac>19 then nz=y; na=y; nb=y; nc=y; nd=y; ne=y; nf=y; ng=y; nh=y; ni=y; nj=y; nk=y; nl=y;  nn=y
Call Main2

MAIN:
  transmit '\n1 User: \c7'nm
  transmit '                         \^1\c1Handle: \c7'us
  transmit '                                                     \^1\c1Access: \c7'ac', 'gr'\n1'
  transmit '\c3   Online Games:  'pf
  transmit '                             \^1\c3Text Libraries:  'pf
  transmit '                                                        \^1\c3File Xfer:    'ul
  transmit '\c3   Private Mail:  'em
  transmit '                             \^1\c3Network Mail:    'dn
  transmit '                                                        \^1\c3Voting Booth: 'pf
  transmit '\c3   Subscriber:    'dn
  transmit '                             \^1\c3JoinLink Conf.:  'dn
  transmit '                                                        \^1\c3Maintenance:  'ma
  transmit '\c3   Conferences:   'cf
  transmit '                             \^1\c3News Bulletins:  'bl
  transmit '                                                        \^1\c3Beta Testing: 'bt
  call ACC

main2:
transmit '\^1\c6     Subboard               Access         Subboard              Access'
transmit '\c7  -----------------------------------------------------------------------'
transmit '  \c5\w1   'sa ': \c2'
transmit '                             \^1\w1'na '\w1'
transmit '                                          \c5\^1 'sb ': '
transmit '                                                                  \^1\w1'nb
transmit '  \w1   'sc ': '
transmit '                             \^1\w1'nc '\w1'
transmit '                                          \^1 'sd ': '
transmit '                                                                  \^1\w1'nd
transmit '  \w1   'se ': '
transmit '                             \^1\w1'ne '\w1'
transmit '                                          \^1 'sf ': '
transmit '                                                                  \^1\w1'nf
transmit '  \w1   'sg ': '
transmit '                             \^1\w1'ng '\w1'
transmit '                                          \^1 'sh ': '
transmit '                                                                  \^1\w1'nh
transmit '  \w1   'si ': '
transmit '                             \^1\w1'ni '\w1'
transmit '                                          \^1 'sj ': '
transmit '                                                                  \^1\w1'nj
transmit '  \w1   'sk ': '
transmit '                             \^1\w1'nk '\w1'
transmit '                                          \^1 'sl ': '
transmit '                                                                  \^1\w1'nl
transmit '  \w1   'sm ': '
transmit '                             \^1\w1'nn '\w1'
transmit '                                          \^1 'sz ': '
transmit '                                                                  \^1\w1'nz '\w1'
call end

END:                      
transmit '\n1            \z7\c1 (*)  Another Great Pfile from \c4The GameMaster!\c1  (*) \z0'
transmit '\n1 Press any key: \g1'
bufferflush
exit
