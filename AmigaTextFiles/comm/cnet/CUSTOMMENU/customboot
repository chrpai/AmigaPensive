/* Custom Menu Booter */
options results
bufferflush

getuser 12;date = result
getuser 1; user_name = result
open(log,'system:log.cm','A')
writeln(log,'\cd'date'\c6: \ca'user_name' entered the Custom Menu')
close(log)
default_menu = 'main'            /* Default menu file */
open(file,'ram:cm.def','W')      /* Temp default file - can be relocated */
writeln(file,default_menu)
writeln(file,user_name)
close(file)
exit
