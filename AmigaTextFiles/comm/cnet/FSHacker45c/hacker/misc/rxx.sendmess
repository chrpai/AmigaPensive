tr '\f1\caSend a user a message\c9:\n1'
txt='\cnSend a message to';call listusers;if toget='###' then signal main
tr '\f1\cbPlease enter up to \c33\cb lines of transmissions\q1:'
tr '\cbHit RETURN(s) when your are done sending your message\c1.\n1'
tr '\c3This is your margin\c9:\n1'
tr '\c7:----:----:----:----:----:----:----:----:----:----:----:----:----:----:----:'
do i = 1 to 3;call rndc;Query'\cf';ans=result;line.i=left(ans,77);end
ss '\n1\c3Send the above message? \c1(y/\c7N\c1)? \c7'
getchar;ans = result;call nc
if ans ~= 'N' then ss 'Yes';else do;tr 'No.';boom=1;signal main;end
call mailmessage;tr '\h3\caSent\c9.';signal main
