tr 'Mainframes'
if ~exists(phones'MAINFRAMES') then do;tr '\c2There is not a Mainframe telephone book. Tell the SysOp\c1!\n1';Query RETURN;boom=1;signal dial;end
call open file, (PHONES'MAINFRAMES'), 'R'
telnum=readln(file)
do i=1 to telnum;MAINFNAME.i=readln(file);MAINFNUM.i=readln(file);MAINFMEGS.i=readln(file);MAINFWINS.i=readln(file);MAINFLOSS.i=readln(FILE);end
call close file
tr '\f1\c3Megs\>6Number\>9WINS\>6LOSS\>6Mainframe'
tr '\c1----\>6------\>9----\>6----\>6---------\c7'
p=0;t=telnum
do i=1 to t;p=p+1;mnum=left(MAINFNUM.i,15);mmeg=left(MAINFMEGS.i,10);mnam=left(MAINFNAME.i,25);mwin=left(MAINFWINS.i,10);mloss=left(MAINFLOSS.i,10);tr mmeg''mnum''mwin''mloss''mnam;if p>20 then do;Query RETURN;p=0;tr CLS;end;end
tr '\n1\c2End of MainFrame List\c1.\n1'
Query RETURN