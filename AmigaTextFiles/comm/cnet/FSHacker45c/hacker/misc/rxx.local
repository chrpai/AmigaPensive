tr 'Local'
if ~exists(phones'LOCAL') then do;tr '\c2There is not a local telephone book. Tell the SysOp\c1!\n1';Query RETURN;boom=1;signal dial;end
call open file, (PHONES'LOCAL'), 'R'
telnum = readln(file)
do i=1 to telnum;locnm.i=readln(file);LOCALNUM.i=readln(file);locmg.i=readln(file);locwin.i=readln(file);loclos.i=readln(FILE);end
call close file
tr '\f1 \c3Megs\>6Number\>9WINS\>9LOSS\>6BBS Name '
tr ' \c1----\>6------\>9----\>9----\>6--------\c7'
p=0;t=telnum
do i=1 to t;p=p+1;lnum=left(LOCALNUM.i,15);lmeg=left(locmg.i,10);lnam=left(locnm.i,25);lwin=left(locwin.i,10);lloss=left(loclos.i,10);tr ' 'lmeg''lnum''lwin''lloss''lnam;if p>20 then do;Query RETURN;p=0;tr CLS;end;end
tr '\n1\c2End of Local BBS List\c1.\n1'
Query RETURN
