TEX = left(xrp,20);TMO = left(MONEY,10);TDT = left(drty,10)
TTT = left(ttyp,10);TST = left(MEGS,10);TSC = left(SCA,10)
TBW = left(BW,10);TTR = left(TROJ,10);UTR = left(TROJUSED,10)
UBW = left(BWUSED,10);USC = left(SCAUSED,10);UMK = left(MKUSED,10)
TMK = left(MK,10);TLN = left(LEVNAME,25);tlv = left(LEVEL,10)
tr '\f1\n1\c3Stats for 'name'\c1, \c3   Alias \c1"\c7'alias'\c1":\n1'
tr '\cb    Money\c1: $\c3'TMO'   \cbExperience\c1: \c3'TEX
tr '\cb    Level\c1: \c3'tlv'    \cbLevel Name\c1: \c3'TLN
tr '\cbDrivetype\c1: \c3'TDT'    \cb  Terminal\c1: \c3'TTT
tr '\cb  Storage\c1: \c3'TST'\h1\cbMB Lost/Crashed\c1: \c3'megslost'\c1/\c3'totmgcr
tr '\n1\cd    Virus Statistics\c1:\n1'
tr '\cb           SCAs\c1: \c3'TSC'   \cbUsed\c1: \c3'USC
tr '\cb  Byte Warriors\c1: \c3'TBW'   \cbUsed\c1: \c3'UBW
tr '\cb        Trojans\c1: \c3'TTR'   \cbUsed\c1: \c3'UTR
tr '\cbMemory  Killers\c1: \c3'TMK'   \cbUsed\c1: \c3'UMK
Query'\n1'RETURN
LFI = left(LASTFIGHT,20);TPL = left(TOTALPLAYS,20);TWI = left(TOTALWINS,20)
TLO = left(TOTALLOSS,20)
tr '\f1   \cdWIN/LOSS/PLAY Statistics\c1:\n1'
tr '\cb       Last Fight\c1: \c3'LFI
tr '\cb        Last Play\c1: \c3'DATE
tr '\cb      Total Plays\c1: \c3'TPL
tr '\cb       Total Wins\c1: \c3'TWI
tr '\cb     Total Losses\c1: \c3'TLO'\n1'
QUery RETURN
