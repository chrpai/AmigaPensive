tr '\f1\cd Users currently playing Hacker\c1:\n1'
call open file, (play'ALIASES'), 'R'
do i=1 to TOTALUSERS;tempa=readln(file);tempb=readln(file);temp=i'.';if access ~=23 then lala='';else lala='\c1(\c2'tempb'\c1)';tr '\c1'left(temp,3)' \cb'tempa'  'lala;end
call close file
Query '\n1'RETURN
sf play'TOP15'
