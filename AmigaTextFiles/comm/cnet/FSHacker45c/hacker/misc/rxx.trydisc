tr '\n1\c7You try to disconnect\c1...\n1'
HIT = random(1,2,time('s'))
if HIT = 1 then do;tr '+++\n1\w2NO CARRIER';signal dial;end
tr '\c2You fail\c1!\n1'
DAM = random(1,fndmeg,time('s'))
oldmegs = megs
megs = megs - dam
if megs < 0 then megs = 0
if megs = 0 then do;tr '\c4You are trashed TOTALLY\c1!\n1';megslost = megslost + oldmegs;end
if megs > 0 then do;tr '\c4He did 'DAM' megs of damage\c1!\n1';megslost = megslost + dam;end
Query RETURN;totalloss = totalloss + 1
WINFLAG = 1
