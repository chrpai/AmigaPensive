options results
getuser 41
serial = result
getuser 22
cals = result
path = "ram:time.data/"
path1 = path||serial||'dep'cals
path2 = path||serial||'wdr'cals
 options results
    if ~show('L',"RexxSupport.Library") then do
     if addlib('RexxSupport.Library',0,-30,0) then nop
     else do
     logentry 'TIMEBANK - I need the RexxSupport.Library in the L directory!'
     exit
    end  
  end
if exists(path1) then do 
 address command "Delete > nil: "path1
say path1' Deleted by KillBank'
end
if exists(path2) then do 
 address command "Delete > nil: "path2
say path2' Deleted by KillBank'
end
exit
