echo ""
echo ""
echo "(*) TradeWars 2.0! (*)"
echo "By Chris Cowan"
echo "(c) 1992 Outlaw Technology"
echo "" 
echo "Setting up TradeWars..."
echo ""
if not exists pfiles:
  echo "Please assign the pfiles: directory!"
endif
if exists pfiles:
  if not exists pfiles:tradewars
    echo "Creating pfiles:tradewars directory..."
    makedir "pfiles:tradewars"
  endif
  if not exists pfiles:tradewars/text
    echo "Creating pfiles:tradewars/text directory..."
    makedir "pfiles:tradewars/text"
  endif
  if not exists pfiles:tradewars/universe
    echo "Creating pfiles:tradewars/universe directory..."
    makedir "pfiles:tradewars/universe"
  endif
  if not exists pfiles:tradewars/players
    echo "Creating pfiles:tradewars/players directory..."
    makedir "pfiles:tradewars/players"
  endif
  if not exists pfiles:tradewars/planets
    echo "Creating pfiles:tradewars/planets directory..."
    makedir "pfiles:tradewars/planets"
  endif
  if not exists pfiles:tradewars/teams
    echo "Creating pfiles:tradewars/teams directory..."
    makedir "pfiles:tradewars/teams"
  endif
  if not exists pfiles:tradewars/messages
    echo "Creating pfiles:tradewars/messages directory..."
    makedir "pfiles:tradewars/messages"
  endif
  echo "Copying files..."
  copy TradeWars! pfiles:
  copy TwMaint pfiles:
  copy TwNightlyMaint pfiles:
  copy tradewars.lzh pfiles:tradewars
  copy text.lzh pfiles:tradewars/text
  copy universe.lzh pfiles:tradewars/universe
  copy players.lzh pfiles:tradewars/players
  copy teams.lzh pfiles:tradewars/teams
  if not exists c:lz
    echo "Missing LZ...cannot break down TradeWars .LZH files!"
  endif
  if exists c:lz
    echo "Unarc'ing tradewars.lzh file..."
    cd pfiles:tradewars 
    lz -m x tradewars.lzh
  endif
  if exists c:lz
    echo "Unarc'ing text.lzh file..."
    cd pfiles:tradewars/text 
    lz -m x text.lzh
  endif
  if exists c:lz
    echo "Unarc'ing players.lzh file..."
    cd pfiles:tradewars/players 
    lz -m x players.lzh
  endif
  if exists c:lz
    echo "Unarc'ing teams.lzh file..."
    cd pfiles:tradewars/teams 
    lz -m x teams.lzh
  endif
  if exists c:lz
    echo "Unarc'ing universe.lzh file..."
    cd pfiles:tradewars/universe 
    lz -m x universe.lzh
    cd pfiles:
  endif
  echo ""
  echo "Setup complete!"
  echo ""
  echo "Now add 'TradeWars!' to your Pfiles list!"
  echo ""
  echo "Be sure to add TwMaint & TwNightlyMaint to your BBSEVENT0 file!"
  echo "     (see 'tw.README!' file for correct event settings!)"
  echo ""
  echo ""
  echo ""
endif