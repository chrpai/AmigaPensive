options results
signal on syntax
tr = transmit; gu = getuser ; ss = sendstring
path='Pfiles:BOX/'
path1='Pfiles:BOX/Boxers/'
path10='Pfiles:Box/Base'
path11='Pfiles:Box/SysOp/'
tr 'Updating Great Boxers'
call open(faler,path||'srnk.1','R')
address command MAKEDIR path10
do until eof(faler)
NAMEU=readln(faler)
call SAVES
end
call close(faler)
tr 'Updating user boxers'
tota=200
if exists(path||'total.data') then do
signal off error; call open(files,path||'total.data','R')
tota=readln(files)
call close files; signal on error
end
do i=1 to tota
NAMEU=i
if exists(path1||i) then call SAVES
end
exit

SAVES:
if NAMEU='' then return
signal off error;call open(file,path1||NAMEU,'A')
writeln(file,0)
call close(file)
return

SYNTAX:
Tr 'Error:' errortext(rc) 'in line 'SIGL'.';shutdown;end;exit
