/* ShorDesc.rexx v1.0 by mUb. - External Module for FPDIZ          */
/* Extracts info from .readme files off the aminet, and use as File_Id.DIZ */

options results
parse arg ar1'|'ar2;call pragma('P',-5)
fn=left(ar1,lastpos('.',ar1))'readme'
call open(input,fn,r)
temp=readln(input)
call close(input)
parse var temp short':' desc
desc=strip(desc)





/* Uncomment the next line if you wish to delete the .readme file after use */
/* Address Command 'C:Delete 'fn */






/* ============== Writes the "DESC" variable to the temp file. ============== */
call open(fp,ar2,'W')
call writeln(fp,desc)
call close(fp)
exit
