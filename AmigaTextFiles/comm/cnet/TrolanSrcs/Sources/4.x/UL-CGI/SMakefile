all: userlist

userlist: userlist.c SCOPTIONS
	sc $@

arc: aws/cgi-bin/userlist userlist-cgi.doc aws/conf/userlist.footer aws/conf/userlist.conf \
     aws/conf/userlist.header
	lha u -x userlist-cgi.lha $?

install: userlist
	copy $? aws:cgi-bin

package:
	@copy userlist aws/cgi-bin
	@smake arc
	@copy userlist-cgi.lha /CNet-INetPackages/.Base
