PROJECT = bbgopher

DEST4 = /CINS/.Contrib4.x/bbgopher-cnet/

all:
    Smake all4
    Smake clean

all4:
    Smake clean
    Copy SCOPTIONS4 SCOPTIONS
    Smake files
    Copy $(PROJECT)      $(DEST4)
    Copy $(PROJECT).conf $(DEST4)
    Copy $(PROJECT).help $(DEST4)

files: $(PROJECT).o
    SC $(PROJECT)

$(PROJECT).o: $(PROJECT).c $(PROJECT).h
    SC $(PROJECT) NOLINK

clean:
    -Delete \#?.o
    -Delete \#?.lnk
    @Avail Flush >NIL:
