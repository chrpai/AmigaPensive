options results

signal on error
signal on syntax

GETCARRIER
if result = "FALSE" then exit

sendstring d2c(12)

maxmsg  = 10               /* number of messages to choose from */
path    = "pfiles:chat/"
name    = "chatmsg"
file    = path||name
msg#    = random(1,maxmsg,time('s'))
mname   = right('00'||msg#,3)
filename= file||mname
if ~exists(filename) then exit
sendfile filename

exit

ERROR:
SYNTAX:
line = sigl
err = rc
transmit "Error in line "line" type "rc" "errortext(rc)
logentry "Error in ChatRanQuote.v2"
logentry "Error in line "line" type "rc" "errortext(rc)
exit
