options results

getuser 39;uucp=result
path1 = 'PFiles:Zregistry/'      /* <-- path for Zregistry files  (change) */
path2 = 'mail:users/'            /* <-- path for Mail dirs                 */

MAIN:
	if ~exists(path2''uucp'/_zreg') then call NOPE
	exit

NOPE:
	sendstring '\ce-\c6> \cfYou do not have a user registry, type ER from main to get one!'
	exit