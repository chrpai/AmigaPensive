   Do not modify unless you get permission from Zachariah Johnson first!  */

options results

bufferflush

changewhere 'View Registry'

path2 = 'mail:users/'            /* <-- path for Mail dirs                 */
ver = 'v4.0'                     /* <-- version # (do not change)          */

sendstring 'View Registry 'ver': Enter the users handle.\n1\c6-\ce> \q1'
query
Ohandle = result
if Ohandle = '###PANIC' then call QUIT
if Ohandle = '' then call QUIT
findaccount Ohandle
Osernum = result
if Osernum = '###PANIC' then call QUIT
if Osernum = '' then call QUIT
loadscratch Osernum
getscratch 39;Ouucp = result
getscratch 1;Ohandle = result
if ~exists(path2||Ouucp'/_zreg') then call NOTAV

call open(user,path2''Ouucp'/_zreg','R')
do i=1 to 33
	en.i=readln(user)
	end
call close user
en.40=strip(en.40)
sendstring left(' \ce1\c6) Name/Company       -\cf 'en.1,67)
transmit left('  \ce2\c6) Age     -\cf 'en.2,30)
sendstring left(' \ce3\c6) City/State/Phone   -\cf 'en.3,67)
transmit left('  \ce4\c6) B/day   -\cf 'en.4,30)
sendstring left(' \ce5\c6) Computer Comment   -\cf 'en.5,67)
transmit left('  \ce6\c6) Sex     -\cf 'en.6,30)
sendstring left(' \ce7\c6) Occupation         -\cf 'en.7,67)
transmit left('  \ce8\c6) Height  -\cf 'en.8,30)
sendstring left(' \ce9\c6) Your Birthplace    -\cf 'en.9,67)
transmit left(' \ce10\c6) Weight  -\cf 'en.10,30)
sendstring left('\ce11\c6) Foreign Language   -\cf 'en.11,67)
transmit left(' \ce12\c6) Hair    -\cf 'en.12,30)
sendstring left('\ce13\c6) This BBS           -\cf 'en.13,67)
transmit left(' \ce14\c6) Eyes    -\cf 'en.14,30)
sendstring left('\ce15\c6) I Am Looking for   -\cf 'en.15,67)
transmit left(' \ce16\c6) Race    -\cf 'en.16,30)
sendstring left('\ce17\c6) Sexual Preference  -\cf 'en.17,55)
transmit left(' \ce18\c6) Marital State -\cf 'en.18,42)
sendstring left('\ce19\c6) Attractive?        -\cf 'en.19,55)
transmit left(' \ce20\c6) Children      -\cf 'en.20,42)
sendstring left('\ce21\c6) Intelligence       -\cf 'en.21,55)
transmit left(' \ce22\c6) Do You Smoke  -\cf 'en.22,42)
sendstring left('\ce23\c6) Schooling          -\cf 'en.23,55)
transmit left(' \ce24\c6) TV Viewed     -\cf 'en.24,42)
sendstring left('\ce25\c6) Do You Drink       -\cf 'en.25,55)
transmit left(' \ce26\c6) Upbringing    -\cf 'en.26,42)
sendstring left('\ce27\c6) Dating/Available?  -\cf 'en.27,88)
sendstring left('\ce28\c6) I love...          -\cf 'en.28,88)
sendstring left('\ce29\c6) I hate...          -\cf 'en.29,88)
sendstring left('\ce30\c6) What type of Music do you like?  -\cf 'en.30,88)
sendstring left('\ce31\c6) Attitude on Recreational Drugs   -\cf 'en.31,88)
sendstring left('\ce32\c6) Activities/Interests  -\cf 'en.32,88)
sendstring left('\ce33\c6) Summary  -\cf 'en.33,88)
sendstring '\cb*END*'
exit

NOTAV:
	transmit '\cb'Ohandle 'has not completed a Registry.'
	exit

QUIT:
	exit
