
; *** United Forces TopMessy Formats Configuration ***

; here is the format for the left column (private messages)
;  <num>  <name> <messies>
"\c1許c3  %2d.  %-20s %6ld   "

; here is the format for the right column (public messages)
;    <name> <messies>
"      %-20s %6ld   \c1許c3"

; here is the format for an empty left column (no writer in chart)
"\c1許c3  %2d.                                "

; here is the format for an empty right column (no writer in chart)
"                                    \c1許c3"
