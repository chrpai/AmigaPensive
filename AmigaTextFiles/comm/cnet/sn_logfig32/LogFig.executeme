echo ""
echo "SN LoginConfig v3.2 (02/06/95)"
echo "© 1994-95, Spectral Neurologix, Midnight"
echo "Contact SN/AHI 910.326.3804 C-Link! 911:6380/7 & Fido 1:3614/118 28.8k"
echo ""
echo "Installing LoginConfig v3.2..."
echo ""
if not exists SN:
  echo "Please assign the SN: directory to an area you want to place SN PFiles!"
  echo "Preferably in their own (clean) directory..."
  echo ""
  echo "This script creates the directory for LogFig."
  echo ""
endif
if exists SN:
  if not exists SN:LogFig
    echo "Creating SN:LogFig directory..."
    makedir "SN:LogFig"
  endif
  echo ""
  echo "Moving files..."
  copy _#? SN:LogFig/
  copy Login#? SN:LogFig/
  copy MBNScan SN:LogFig/
  copy SysText:sys.welcome SysText:sys.welcome.bak
  copy SysText:sys.welcome SN:LogFig/_Config.All-YOURS
  rename SN:LogFig/_Config.All SN:LogFig/_Config.All-MINE
  copy NEW.sys.welcome SysText:sys.welcome
  copy SN_LogFig#?.LHA SN:LogFig/
  delete _#? NEW.#? Login#? MBNScan FILE-ID.DIZ SN_LogFig#?.LHA #?.executeme QUIET
  cd SN:LogFig
  echo ""
  echo "Installation complete!"
  echo ""
  echo "You should now read 'Setting Things Up' in LoginConfig.guide to configure"
  echo "SN LoginConfig for your BBS."
  echo ""
endif
