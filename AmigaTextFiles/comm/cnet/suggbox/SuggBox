options results

sendstring '\c1: \c3Do You Wish To Make A Suggestion? \c1: \c6'
getchar
yesno = upper(result)
if yesno ~= 'Y' then do
 sendstring 'No'
 exit
end

transmit 'Yes'
bufferflush
getuser 28
urk=result
if urk = 0 then call ask:
sendstring '\^2'

ASK:

transmit '\n1\c1: \c5Enter Up To \c710\c5 Lines.  Press \c1RETURN\c5 On A Blank'
transmit '\c1: \c5Line To Save (\c3Incase You Do Not Fill Up All 10 Lines\c5)\n1'

GETUSER 1;Uname=result;GETUSER 12;Date=result
logentry'Suggestion By 'uname

do i = 1 to 10
 query"\c1: \c3"
 text.i = result
 if text.i = "" then call done
end

DONE:  /* Save Their Suggestion */

call open file, ('system:log.sugg'), 'A'
call writeln file, '\c5Suggestion By:\cd 'uname'\c5 On \cd'date'\c1...\n1\c3'

do f = 1 to i - 1
 call writeln file, text.f
end

call writeln file, '\c1\n1Key->\g1\h5'
call close file

transmit "\n1\c1: \c2Thankyou For Your Suggestion! \c3The Sysops Will Get Back"
sendstring "\c1: \c3To You In The Next Couple Of Days."
exit
