/* Convert v6.40 to v6.41 Script; Used by Installer */
options results

call open(f1,"pfiles:WoFortune.Config","r")
  do 3;dfile=readln(f1);end
  do i=1 to 10;co.i=readln(f1);end i
call close(f1)

address command 'setenv WOFPath "'strip(dfile)'"'
address command "delete "dfile"Graphics/#? all"
address command "delete "dfile"Game.A*"
address command "delete "dfile"Game.I*"
address command "delete "dfile"Docs.A*"
address command "delete "dfile"Docs.I*"
address command "delete "dfile"Log.*"
address command "delete "dfile"GameData"

if exists(dfile"Reg.Key") then
  address command "rename "dfile"PuzData "dfile"PuzData2000"

call open(f1,"pfiles:WoFortune.Config","w")
  call writeln(f1,"; v6.41 August 6, 1995")
  call writeln(f1,";                               WOF CONFIG FILE, Supports ALL THREE Modules!")
  call writeln(f1,dfile)
  do i=1 to 10 ; call writeln(f1,co.i) ; end i
call close(f1)
