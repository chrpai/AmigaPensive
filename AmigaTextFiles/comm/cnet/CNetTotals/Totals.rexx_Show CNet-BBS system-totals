/********* Start of SysOp-settable variables **********/

indent     = 3    /* Indent whole display by x spaces                */

kilo       = 1024 /* Compute megabytes based on K=1000 or K=1024?    */
PhoneLines = 2    /* Number of phone lines installed (0-99)          */

                  /* Total free megabytes of HD-space that   */
FreeMegs   = 0    /* you want shown for future U/L space.    */
                  /* (Or set to "0" for real-time checking.) */

                              /* If "FreeMegs" space is set to 0, then */
parts = "dh3: dh4: dh5: dh6:" /* check these partitions for free-space */
                              /* that is available for future U/Ls.    */

da_files  = 0   /* Number of files in all direct-access subs */
da_megs   = 0   /* Total size (in megs) of files in all direct-access subs */

         /* Text to display before and after showing totals from CLI */
CLIheader = "Amiga ShareWare HeadQuarters BBS, 1-810-473-2020, 1:2410/207 ..."
CLIfooter = "*** EOF (Now running CNet-BBS) ***"

          /* Text to display before and after showing totals while online */
BBSheader = ""
BBSfooter = ""

/********** End of SysOp-settable variables *********/

subboardSize = 488      /* Do NOT edit.  CNet v3.05c needs "488" here. */

options results
parse arg port

YES  = (1==1)
NO   = (1==0)
vers = "v1.7"              /* !!! Bill, remember to update this variable !!! xxx */

if( port ="" ) then        /* Run from online w/o port #  */
do
   cli = NO
   LF  = "n1"
end
else
do                          /* Run from CLI using port #n */
   cli = YES
   LF  = '0a'x
   address value "CNETREXX" || port
end

if( ~show('LIBRARY', "rexxsupport.library") ) then
   if( ~addlib('rexxsupport.library', 0, -30) ) then     /* add to library list */
   do
      call prt(LF "*** libs:rexxsupport.library is unavailable." LF)
      exit
   end

if( freeMegs<1 ) then freeMegs=GetFree()     /* Get actual free HD-space */

'getUser' 2400092; ActUsers       = commas(RESULT)
'getUser' 2400096; TotalUsers     = commas(RESULT)

'getUser'      95; TotalCalls     = commas(RESULT) /* or 2400100 */

'getUser' 2400888; DoorsRun       = commas(RESULT)
'getUser' 2400948; DoorsOnline    = commas(RESULT)

'getUser'      96; FilesULed      = commas(RESULT)
'getUser'      97; MegsULed       = commas(RESULT%kilo)

'getUser'      98; FilesDLed      = commas(RESULT)
'getUser'      99; MegsDLed       = commas(RESULT%kilo)

'getUser' 2400956; fol= (RESULT+ da_files    )       ; FilesOnline = commas(fol)
'getUser' 2400960; mol= (RESULT+(da_megs*kilo)) %kilo; MegsOnline  = commas(mol)

'getUser' 2400876; a=RESULT
'getUser' 2400880; PubMsgsPost    = commas(a+RESULT)
'getUser' 2400936; a=RESULT
'getUser' 2400940; PubMsgsOnline  = commas(a+RESULT)

'getUser' 2400868; EmailsSent     = commas(RESULT)
'getUser' 2400928; EmailsOnline   = commas(RESULT)

'getUser' 2400884; TextItemsRead  = commas(RESULT)
'getUser' 2400944; TextItemsOnline= commas(RESULT)

avgMsize  = (mol-da_megs) / (fol-da_files)
FilesRoom = commas(freeMegs%avgMsize)                 /* Room for x more U/Ls  */
MegsRoom  = commas(freeMegs)                          /* Room for x more megs  */
PercRoom  = trunc( (freeMegs*100) / (mol-da_megs+freeMegs) )  /* Wow, what great math! */
SubCount  = CountSubs()

col1 = MaxLen(ActUsers, TotalUsers, DoorsRun, DoorsOnline, FilesULed, FilesDLed, FilesOnline, FilesRoom)
col2 = MaxLen(MegsULed, MegsDLed, MegsOnline, MegsRoom)
col3 = MaxLen(TotalCalls, PubMsgsPost, PubMsgsOnline, EmailsSent, EmailsOnline, TextItemsRead, TextItemsOnline, PhoneLines, SubCount)

ActUsers       = right(ActUsers       , col1)
TotalUsers     = right(TotalUsers     , col1)
TotalCalls     = right(TotalCalls     , col3)

DoorsRun       = right(DoorsRun       , col1)
DoorsOnline    = right(DoorsOnline    , col1)

FilesULed      = right(FilesULed      , col1)
MegsULed       = right(MegsULed       , col2)

FilesDLed      = right(FilesDLed      , col1)
MegsDLed       = right(MegsDLed       , col2)

FilesOnline    = right(FilesOnline    , col1)
MegsOnline     = right(MegsOnline     , col2)

PubMsgsPost    = right(PubMsgsPost    , col3)
PubMsgsOnline  = right(PubMsgsOnline  , col3)

EmailsSent     = right(EmailsSent     , col3)
EmailsOnline   = right(EmailsOnline   , col3)

TextItemsRead  = right(TextItemsRead  , col3)
TextItemsOnline= right(TextItemsOnline, col3)

PhoneLines     = right(PhoneLines     , col3)
SubCount       = right(SubCount       , col3)

FilesRoom      = right(FilesRoom      , col1)
MegsRoom       = right(MegsRoom       , col2)

/******************** Not yet in use **********************************
loport  =  0     /* The lowest  port # that should be counted (0)  */
hiport  = 30     /* The highest port # that should be counted (99) */

TDlines = 1      /* Increase the port-count by X.                      */
                 /* (For lines that are loaded/unloaded with TrapDoor) */
loaded=TDlines; used=0; freeports=0;
do port=loport to hiport
   address value "CNETREXX" || port
   if() then loaded=loaded+1
   if() then used  =used+1
   if() then freeports  =freeports+1
end
**********************************************************************/

if(cli) then
do
   call prt(" ")
   if( CLIheader~="" ) then call prt(CLIheader LF)
end
else
do
   call prt("@4")           /* Turn off "MORE?" prompts */
   if( BBSheader~="" ) then call prt(BBSheader LF)
end

dat = left(date('WEEKDAY'), 3) || "," left(date('MONTH'), 3) left(date(), 2) || "," left(date('SORTED'), 4)
call prt("Totals" vers ": As of" dat Spc3() "Total System Calls:" TotalCalls LF)

call prt("Total Users :" TotalUsers Spc1() "Public Msgs Posted:" PubMsgsPost)
call prt("Active Users:" ActUsers   Spc1() "Public Msgs Online:" PubMsgsOnline LF)

call prt("Doors Run   :" DoorsRun    Spc1() "Email Msgs Sent   :" EmailsSent)
call prt("Doors Online:" DoorsOnline Spc1() "Email Msgs Online :" EmailsOnline LF)

call prt("Files U/Led :" FilesULed   "@" MegsULed   "megs" Spc2() "Text Items Read   :" TextItemsRead)
call prt("Files D/Led :" FilesDLed   "@" MegsDLed   "megs" Spc2() "Text Items Online :" TextItemsOnline LF)
call prt("Files Online:" FilesOnline "@" MegsOnline "megs" Spc2() "Phone Lines       :" PhoneLines)

call prt("Space Remain:" FilesRoom   "@" MegsRoom   "megs" "(" || right(PercRoom,2) || "%)" Spc4() "File and Msg Areas:" SubCount)

if(cli) then
do
   call prt(" ")
   if( CLIfooter~="" ) then call prt(CLIfooter LF)
end
else
do
   if( BBSfooter ~="" ) then do; call prt(" "); call prt(BBSfooter); end
end

exit     /******** End of main ********/

Commas:     PROCEDURE
   parse arg num
   num = right(num, 30)    /* pad the left with spaces to inc of 3 */
   str = ""

   len=length(num)
   do i=len-2 to 1 by -3             /* 94577 94,577 */
      a = substr(num, i, 3)          /* 12345        */
      if(a="") then leave
      str = a || "," || str
   end
return strip(left(str, length(str)-1))   /* remove trailing "," */

Spc0: return copies(" ", indent)
Spc1: return copies(" ", 27-col1)
Spc2: return copies(" ", 19-col1-col2)
Spc3: return copies(" ", 4)
Spc4: return copies(" ", 19-col1-col2-6)

Prt:
   parse arg str
   if(cli) then
      say        Spc0() || str
   else
      'transmit' Spc0() || str
return

MaxLen:  PROCEDURE         /* How many chars in the longest variable? */
   parse arg v.1, v.2, v.3, v.4, v.5, v.6, v.7, v.8 .
   len=0
   do i=1 to 8
      l=length(v.i)
      if( l>len ) then len=l
   end
return len

CountSubs:         /* Check size of SysData:Subboards3 */
   subCount = word(statef("SysData:Subboards3"), 2) / subboardSize
return commas(SubCount)

GetFree:
   freeMegs=0
   parts=upper(parts)
   tmpfname   = "t:Totals" || pragma('ID') || ".tmp"   /* A temporary filename */
   address command "Info >" || tmpfname
   if( open(fp, tmpfname, 'READ') ) then
   do
      dummy=readLN(fp); dummy=readLN(fp); dummy=readLN(fp)
      w=words(parts)
      do i=1 to 40         /* Check each line of c:Info's output */
         buf = readLN(fp)
         if( buf="" ) then leave
         w1  = upper(word(buf, 1))   /* Look at first word for part name */
         do j=1 to w                 /* See if match is found anywhere   */
            w2=subword(parts, j, 1)
            if( w1=w2 ) then         /* Found match */
            do
               freeMegs = freeMegs+(word(buf,4)*512/kilo/kilo)
               /* 'transmit' xxx w1 xxx w2 xxx freeMegs xxx */
            end
         end
      end
      call close(fp)
      address command "Delete >nil: <nil:" tmpfname
   end
   else
   do
      call prt(LF "*** Can't open" tmpfname "for reading." LF)
      exit
   end
   if( freeMegs<1 ) then freeMegs=1
return trunc(freeMegs)

