money = money - take
if fix = 1 then do        
   damage*10 = cost      
   if money > cost then do
      money = money - cost
      damage = 0          
   end                    
end
if computer = 1 then do
   computer = 0
   call open file, ('PFiles:botz/'obotname'.compubot'),'R'
   do i = 1 to 9;junk.i=readln(file);end;call close file
   call open(file,('pfiles:botz/'obotname'.compubot'),'W')        
   call writeln(file,omoney)                                   
   do i = 2 to 7;call writeln file, junk.i;end             
