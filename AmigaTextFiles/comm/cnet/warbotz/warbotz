end
call MAINMENU
/* Save money in bank */
BANK:
turns = turns + 1
transmit "\f1\n1"
transmit "                               \c6Bank"
transmit ""
transmit "                         \c1[\c2D\c1] \c7Deposit Money"
transmit "                         \c1[\c2W\c1] \c7Withdraw Money"
transmit ""
sendstring "                           \c5Choice ?\c2" ; getchar ; command = upper(result)
call CARRIER
if command = 'Q' then call MAINMENU
if command = 'D' then do
   if money < 1 then do
      transmit "\n2You are broke!"
      transmit "\n2\c1Press any key...\g1"
      call BANK
   end
   query "\n2\c1How much money do you wish to deposit (Money = $"money") ?\c2";amount=result
   if amount > money then do
      transmit "\n2You don't HAVE that much!"
      transmit "\n2\c1Press any key...\g1"
      call BANK
   end
   if amount='' then call bank
   if amount = ' ' then call bank
   bankmon=bankmon+amount
   money = money - amount
   transmit "\n1\c1$"amount" deposited.  You now have $"bankmon" in the bank."
   transmit "\n2\c1Press any key...\g1"
end
if command = 'W' then do
   if bankmon < 0 then do
      transmit "\n2\c1You have no money in the bank!"
      transmit "\n2\c1Press any key...\g1"
      call BANK
   end
   transmit "\n2\c1You currently have $"bankmon" in the bank"
   query "\n1\c1How much money do you wish to withdraw ?\c2" ; withdraw = upper(result)
   if withdraw = '' then call BANK
   if withdraw = ' ' then call BANK
   if withdraw < 0 then do
      transmit "\n1\c2You must enter a positive amount!"
      transmit "\n2\c1Press any key...\g1" ; call BANK
   end
   if withdraw > bankmon then do
      transmit "\n2You don't have that much in the bank!"
      transmit "\n2\c1Press any key...\g1"
      call BANK
   end
   bankmon = bankmon - withdraw
   money = money + withdraw  
   transmit "\n1\c1You now have $"money" in hand and $"bankmon" in the bank."
   transmit "\n2Press any key...\g1"
end
if command = '' then call BANK
call BANK
/* Send other user message */
MESSAGE:
turns = turns + 1
query "\n2\c1Who do you wish to send a message to (L=List) ?" ; command = upper(result)
call totpl
if command = 'L' then do
   call LIST
   call MESSAGE
end
if command = 'Q' | goahead=1 then call MAINMENU
if command = '' then call MESSAGE
call open(file,('pfiles:botz/players'),'R')
do i = 1 to (command-1) * 2                
 puke = readln(file)                       
end                                        
player = readln(file)                      
oname = readln(file)                       
call close file
if EXISTS('Pfiles:botz/'player'.mes') then do
   transmit "\n1\c2His mailbox is full\c1.  Sorry!"
