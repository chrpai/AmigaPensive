olosses = olosses + 1
if omoney < 0 then omoney = 0
if money < 0 then money = 0
bleah = money*.5
sprag = bleah % 1
transmit "\n1\c1You take $"sprag" of his cash."
otake = sprag
money = money + otake
omoney = omoney - otake
if ofix = 1 then do         
   odamage*10 = cost       
   if omoney > cost then do 
