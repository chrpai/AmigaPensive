      odamage = 0           
   end                      
end
if oweaponstrength > 0 then do
   sendstring "\n1\c1Would you like to take his "oweaponname"? (y/\c2N\c1)\c2 ";getchar;command = upper(result)
   call CARRIER
   if command = 'Y' then do
      transmit 'Yes'
      temp=oweaponname;oweaponname=weaponname;weaponname = temp
      temp=oweaponstrength;oweaponstrength = weaponstrength;weaponstrength=temp
   end
if computer = 1 then do
   call open file, ('PFiles:botz/'oname'.compubot'),'R'
