call writeln(file,omoney)                          
call writeln(file,ostamina)                        
call writeln(file,obankmon)                        
call writeln(file,oweaponstrength)                 
call writeln(file,oweaponname)                     
call writeln(file,odamage)                         
call writeln(file,obotname)                        
call writeln(file,owins)                           
call writeln(file,olosses)
call writeln(file,orunaway)
call writeln(file,osurrender)
call writeln(file,ofixme)                         
call close(file)
qwerty = botname' fought 'obotname' and won!'
call open file, ('pfiles:botz/last'), 'R'
do i = 1 to 10
   poof.i = readln(file)
end
call close(file)
