/* ATTACK SCREENS */
ATTACK:
lastattack = obotname
snarf = 0
if oweaponstrength = 0 then do
   transmit "\n2\c2He has no weapon\c1!"
call WIN                               
end 
oscuba = ostamina - odamage
odorfus = oscuba - 1
