    call writeln(file,olosses)                                               
    call writeln(file,orunaway)                                              
    call writeln(file,osurrender)                                            
    call writeln(file,ofixme)                                                
    call close (file)                                                        
    call MAINMENU;end                                                        
   else transmit '\n1\c2He tries to escape, but you easily catch him!'
   snarf = 1
end                                                                          
BLEAH:
if command = '1' then do
   numeric digits 3
   tempa=randu(time('S'));tempa=tempa*weaponstrength
   tempb=randu(time('S'));tempb=tempb*oweaponstrength
   hit = tempa % 1
   ohit = tempb % 1
   if ohit > stamina then ohit=stamina
   numeric digits 10
   transmit "\n1\c1You hit him with your "weaponname" and do "hit" points of damage!"
   odamage = odamage + hit
   if odamage >= ostamina then do
      transmit "His robot has been smashed to a pile of microchips!" ; call WIN
   end
   if snarf = 1 then do
      call FRED
   end
   transmit "\n1\c1He hits you with his "oweaponname" and does "ohit" points of damage!"
   damage = damage + ohit
   if damage >= stamina then do
      transmit "\n1\c2Your robot has been destroyed!" ; call LOSE
   end
end
FRED:
if command = '2' then do
   if stamina < ostamina then do                                      
      run=random(0,10,time('s'))                                      
      if run > 9 then do                                              
         transmit '\n1\c2You BARELY get away!\n1\w2'                         
         call open(file,('pfiles:botz/'oname'.bot'),'W')
         call writeln(file,omoney)                      
         call writeln(file,ostamina)                    
         call writeln(file,obankmon)                    
         call writeln(file,oweaponstrength)             
