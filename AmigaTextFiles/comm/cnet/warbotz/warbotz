   else transmit '\n1\c2You fail to escape\c1! 'obotname' quickly catches back up to you!'
end

end
if command = '3' then do
   sendstring "\n2Do you really want to surrender?" ; getchar ; command = upper(result)
   if command = 'Y' then do
