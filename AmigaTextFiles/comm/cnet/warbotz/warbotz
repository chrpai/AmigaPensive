         call writeln(file,orunaway)                    
         call writeln(file,osurrender)                  
         call writeln(file,ofixme)                      
         call close(file)
         call SAVESTATS
         call MAINMENU
      end                                            
   else transmit '\n1\c2You try to escape, but he easily catches up to you!'
end
if stamina >= ostamina then do
   run=random(0,10,time('s'))
