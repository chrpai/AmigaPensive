; Poll-Script2
;
stack 80000
echo "Restarting Log Files..."
delete sysdata:log/poll
rx fido:Poll.rexx Restarting Log Files...

delete sysdata:log/traplist
delete sysdata:log/toss
delete sysdata:log/JamMail.log

echo ""
echo "Clearing temp directories..."
rx fido:Poll.rexx Clearing temp directories...

delete mail:temp/outbound/#?
delete mail:temp/inbound/#?
delete mail:temp/netmail/#?

echo ""
echo "Backing up outbound & netmail..."
rx fido:Poll.rexx Backing up outbound & netmail...

copy outbound:#? mail:temp/outbound/
copy netmail:#? mail:temp/netmail/

echo ""
echo "Tossing outbound packets..."
rx fido:Poll.rexx Tossing outbound packets...

cnet:toss verbosity 0

echo ""
echo "JamScanning outbound packets..."
rx fido:Poll.rexx JamScanning outbound packets...

jammail:jamscan

echo ""
echo "Calling the Boss..."
rx fido:Poll.rexx Calling the Boss...

rx mail:JamCall.rexx 1:260/20.0 99 50

echo ""
echo "Finished polling..."
rx fido:Poll.rexx Finished polling...

echo ""
echo "Backing up inbound & netmail..."
rx fido:Poll.rexx Backing up inbound & netmail...

copy inbound:#? mail:temp/inbound/
copy netmail:#? mail:temp/netmail/

echo ""
echo "Checking for new NODEDIFF files..."
rx fido:Poll.rexx Checking for new NODEDIFF files...

cd nodelist:
rx fido:NodeDiff.rexx

echo ""
echo "Checking for new TIC files..."
rx fido:Poll.rexx Checking for new TIC files...

rx fido:DoTick.rexx

echo ""
echo "Tossing inbound packets..."
rx fido:Poll.rexx Tossing inbound packets...

cnet:toss verbosity 0

echo ""
echo "Poller finished."
rx fido:Poll.rexx Poller finished.

endcli
