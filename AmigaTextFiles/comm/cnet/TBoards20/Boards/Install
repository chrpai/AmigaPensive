;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;                                Board Info                                 
;                             V2.oo (o7.o9.96)                              
;                              by Enigma/indy                               
;                 support +49-(0)911-746218 toxic waste bbs                 
;                 support +49-(0)911-746450 toxic waste bbs                 
;                                                                          
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;$VER: Toxic Boards Installer 2.00 (7.9.96)

(message (cat "\n\nToxic Boards V2.oo\n~~~~~~~~~~~~~~~~~~\n\n"
              "The Expansionsboard Diagnostic Tool\n\nfor\n\n"
              "CNet Bulletin Board Systems"
         )
)

(welcome)

(complete 0)

(set @default-dest "PFiles:")

(message (cat "\n\nWelcome to Toxic Board V2.00\n"
              "Hard Disk Install Script\n\n\n\n"
              "This script has been generated by Sascha 'Enigma' Reissner"
         )
)

(message (cat "\n\n\nToxic Board V2.00 requires 0.1 MB free on your disk \n\n"
              "It is only usefull for CNet BBS Sysops..."
         )
)

(set #Path-Txt (cat "Select the target directory. A directory called 'Boards' will "
                    "be created there."
               )
)

(set #Path-Help (cat "\nThis section lets you choose the "
                     "target directory to install Toxic Board V2.00. \n\n"
                     "A directory Boards will be created there.\n\n"
                     "Default is Pfiles:"
                )
)

(set target (askdir 
            (prompt #Path-Txt)
            (help #Path-Help)
            (default @default-dest)
            (newpath)
            )
)

(complete 30)

(set @default-dest target)

(copyfiles (prompt "Copying to " #target)
           (help @copy-files-help)
           (source "")
           (dest (tackon target "Boards"))
           (pattern "#?")
)

(complete 90)

(set vernum1 (getversion (tackon "libs:" "identify.library")) )
(set ver1 (/ vernum1 65536))
(set rev1 (- vernum1 (* ver1 65536) ) )

(set vernum2 (getversion (cat "identify.library")) )
(set ver2 (/ vernum2 65536))
(set rev2 (- vernum2 (* ver2 65536) ) )

(set #text2  (cat "'identify.library'\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
                  "Version Currently Installed   : " ver1 "." rev1 "\n\n"
                  "Version From Update Disk/File : " ver2 "." rev2 "\n\n"
                  "Do you wish to install Version " ver2 "." rev2 " of the "
                  "'identify.library' by Richard Koerber from the Disk?"
             )
)

(set pick (askchoice
		(choices "Yes" "No")
		(prompt #text2)
		(help #text2)
                (default pick)
	  )
)

(if (= pick 0) (copyfiles (source "identify.library") (dest "LIBS:" )) )

(delete (tackon target "Boards/install"))
(delete (tackon target "Boards/install.info"))
(delete (tackon target "Boards/identify.library"))

(complete 100)
