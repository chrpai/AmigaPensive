/**************** Top of SysOp-settable variables ************************/

pri    = (-1)     /* Run task at this priority */
useRam = 3000     /* Do repairs in "RAM:" if data-file is less than n Kbytes  */
pfile  = "Pfiles:Maintenance/Repair_Sub" /* Full path & name of your RR pfile */

c3 = '19'x || "c3"     /* \c3 for yellow logs */
c7 = '19'x || "c7"     /* \c7 to reset color  */

/***************** End of SysOp-settable variables ***********************/

signal ON error
signal ON syntax
signal ON ioerr
signal ON halt
signal ON break_c; signal ON break_d; signal ON break_e; signal ON break_f;

parse arg opts
options results
opts=upper(opts)

LF = '0a'x; BELL = '07'x

if( opts="" ) then
do
   say LF "RR_Check.rexx by Bill Beogelein, 1-810-473-2020, 1:2410/207"
   say " Usage: rx RR_Check.rexx   BASE UDBASE   minH=# maxH=#   minK=# maxK=#   MinB=# maxB=# maxR=#   Outp=[1|2]   TEST" LF
   exit
end

call pragma('PRIORITY', pri)

minH=1; maxH=999999              /* The defaults... */
minK=0; maxK=999999
minB=0; maxB=999999
maxR=0; test=0; output=1
base=0; udbase=0
w=words(opts)
do i=1 to w                         /* minH=47 */
   o =   left(word(opts, i), 4)     /* minH=   */
   v = substr(word(opts, i), 6)     /* 47      */
   if( o="OUTP" ) then output=v

   if( o="MINH" ) then minH=v
   if( o="MAXH" ) then maxH=v

   if( o="MINK" ) then minK=v
   if( o="MAXK" ) then maxK=v

   if( o="MINB" ) then minB=v
   if( o="MAXB" ) then maxB=v

   if( o="MAXR" ) then maxR=v
   if( o="TEST" ) then test=1

   if( o="BASE" ) then   base=1
   if( o="UDBA" ) then udbase=1
end
/* say XXX minH XXX maxH XXXXXX minK XXX maxK XXXXXX maxR XXXXXX */

if( maxR>0 ) then
   'changeWhere' "RR_Check.rexx" /* If run as event with "MaxR=#" opt */

if(~show(l, "rexxsupport.library")) then
   if(~addlib('rexxsupport.library', 0, -30)) then     /* add to library list */
   do
      call prt(LF "*** libs:rexxsupport.library is unavailable.")
      exit
   end

dat = compress(date('NORMAL'))     /* 31Dec1994 */
dat = left(dat,5) || right(dat,2)  /* 31Dec94   */

if(output==1) then header="Phys# Holes Type Path               Title                                Size"
if(output==2) then header="Threads Resps Full KBytes Byte/Msg Del-Day High-# Name"
call prt(LF center("RR_Check.rexx by Bill Beogelein...",75) LF LF || header)

 /* Threads Resps Full KBytes Byte/Msg Del-Day High-# Name       */
 /*  12345  12345 100% 12345K  12345     9999  123467 AMIGA_PROG */

if( open(fp, "sysData:subboards3", 'READ') ) then
do
   phys= -1
   totalH=0; totalK=0
   count=1
   do forever
      buf  = readCH(fp, 488)
      if(eof(fp)) then leave
      phys=phys+1

      desc = Chop(substr(buf,   1, 31))
      path = Chop(substr(buf,  53, 40))

      type =  c2d(substr(buf, 270,  1))
      sub  =  c2d(substr(buf, 161,  1))
      exch =  c2d(substr(buf, 157,  1))

      if( type>1 | sub>0 | exch>0 ) then
         iterate     /* Skip killed subs, subdirs, and direct-exchange subs */

      if(type=0) then type="BASE"     /* Msg bases  */
      if(type=1) then type="UD  "     /* File areas */

      sizeH = word(statef(path || "data/_free"), 2)
      if( sizeH="" ) then sizeH=0      /* Not fragmented at all */
      sizeH = sizeH/8

      sizeB = word(statef(path || "data/_text"), 2)
      if(sizeB="") then sizeB=0        /* No _text file at all */
      sizeK = trunc(sizeB/1024)

      if( sizeH<minH    |  sizeH>maxH      ) then iterate  /* User said to skip these */
      if( sizeK<minK    |  sizeK>maxK      ) then iterate
      if((sizeK*2)<minB | (sizeK*2)>maxB   ) then iterate
      if(   base=1 & type="UD  " & ~udbase ) then iterate
      if( udbase=1 & type="BASE" & ~base   ) then iterate

      totalH=totalH+sizeH
      totalK=totalK+sizeK

      if(output==1) then call prt(right(phys,4) || ")" right(sizeH,5) type left(path,18) left(desc,34) right(sizeK,5) || "K")
      if(output==2) then
      do
         thr     = c2d(substr(buf, 465, 2))
         resps   = c2d(substr(buf, 461, 4)) -thr
         max_thr = c2d(substr(buf, 441, 2))
         perc    = 100; if(max_thr  >0) then perc = trunc((thr/max_thr)*100)
         bpm     =   0; if(thr+resps>0) then bpm  = sizeB%(thr+resps)  /* Bytes per msg */
         days    = c2d(substr(buf, 235, 2))
         high    = c2d(substr(buf, 287, 4))
         call prt(right(thr,6) right(resps,6) right(perc,3) || "%" right(sizeK,5) || "K" right(bpm,6) right(days,7) right(high,8) left(desc,28))
      end

      if( maxR>0 ) then       /* If run as event with "MaxR=#" opt */
      do
         count=count+1

         if( sizeK<=useRam ) then rrOpt="RAM"; else rrOpt="   "
         'transmit' "@4Running pfile:" pfile phys rrOpt "..."
         call time('RESET')
         if(~test) then 'transmit' "#3" pfile phys rrOpt "}"
         secs=time('ELAPSED')
         mins=secs%60
         secs=trunc(secs//60)       /* Drop decimal */

         newK = word(statef(path || "data/_text"), 2)
         if(newK="") then newK=0        /* No _text file at all */
         newK = trunc(newK/1024)
         'LogEntry' "RR_Check.rexx" right(phys,4) rrOpt || ";" c3 || right(sizeK-newK, 4) || "K" || c7 "gain;" right(mins,2) || ":" || right(secs,2,'0') || ";" dat

         if( count>maxR ) then
         do
            'transmit' " (Only RR'ing first" maxR "matches.)" BELL
            leave
         end
      end
   end
end
else
   call prt(LF "*** Can't open CNet-BBS SysData:subboards3 for reading." LF)

if(output==1) then call prt("Total" right(totalH,5) "Holes                (" || dat || ")" right(totalK,33) || "K")
if(output==2) then call prt(header)

exit  /********** End of main **********/

Chop:                               /* Chop string-var to 1st \0 */
   parse arg str
   p=index(str, '0'x)
   if(p<2) then return "[none]"     /* If null-string, make "[none]" */
   if(p>1) then p=p-1
return left(str, p)

Error:
IOerr:
Syntax:
   call prt(LF "*** Err #" || RC || " on line #" || SIGL "(" || errortext(RC) || ")")
   call prt("See:" strip(sourceLine(SIGL)))
exit

Halt:
Break_C:
Break_D:
Break_E:
Break_F:
   if(output==1) then call prt("Total" right(totalH,5) "Holes                (" || dat || ")" right(totalK,33) || "K")
   if(output==2) then call prt(header)
   call prt(LF "*** Halted:  Err #" || RC || " on line #" || SIGL "(" || errortext(RC) || ")")
   /* call prt("See:" strip(sourceLine(SIGL))) */
exit

Prt:
   parse arg str
   if( maxR>0 ) then
      'transmit' str
   else
      say str
return

