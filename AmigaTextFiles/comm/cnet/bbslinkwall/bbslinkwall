/*                CNet BBSLink Wall  Version 1.0.0                   */
/*  Written by Link of CheckSum Acknowledged BBS on 3 Feb 2018       */
/*  Used to seamlessly connect a CNet Amiga BBS to the BBSLink.Net   */
/*  door game server WALL.  It is public domain software.            */

/*  Use at your own risk.                                            */

options results;signal on SYNTAX;signal on ERROR;signal on IOERR
PARSE ARG Arguments

/*  Installation Instructions:

1.  Create a folder called 'BBSLink' in your PFiles: directory.   
    Copy this file there.
2.  Download the 'httpj200.lha' archive from aminet.net.  You will 
    find it in the comm/net section.
3.  Extract the file named 'httpj' from that archive and copy it 
    to System:. 
5.  Register on bbslink.net as a sysop.  If you have already done 
    so when you registered for the door game server, you will need
	to use the information you got from that time you registered.
4.  You will receive an email from them with the following info.  
    Put your information from that email into these fields:   */

SystemCode='yoursystemcode'
AuthorizationCode='yourauthcode'
SchemeCode='yourschemecode'

/*
6.  Add a line to your SYSTEXT:sys.welcome file like this:
    
	#0pfiles:bbslink/bbslinkwall}
	
7.  That's it!  
	
*/

changewhere "BBSLink Wall" 

tr=transmit;se=sendstring;gc=getchar;gu=getuser;cls='f1'
a="rexxsupport.library";if ~show("l",a) then if ~addlib(a,0,-30) then exit

gu 1;Name = Result;Zname = Space(Name,0)    
gu 40;UDI = space(result ,0)

/* Show the wall! */
body=getwall()
se cls
sendfile body


/* Ask user if they want to write to the wall themselves */
prompt 5 YESNO "c6Write on the wall [Y,n]?"

/* If they answered no, quit. */
if (RESULT='No') then
	exit

/* Find out if user already has a registered user name */
	tr "  Looking for your pen - it's around here somewhere..."
	
xkey=randomString()
ktoken=GetToken(xkey)
username=SendToServer("username",'')

/* Check for username error and display as appropriate */
if (substr(username, 1, 3) = "*xx") then
	do
		tr "  Sorry, I looked everywhere. Can't find it. Oh, and this happened:  " || substr(username, 3)
		gc
		exit
	end

if (username = "*notexist") then
	do
		/* Not registered */

		se "  So you're new here! "
		do while(1)
			se "Choose a name (max 12 characters):"
			receive
			getnewusername=result
			if checkabort=1 then exit
			if result="###PANIC" then exit
			if result="q" then exit
			xkey=randomString()
			ktoken=GetToken(xkey)
			nuresult = SendToServer("newuser", getnewusername)
			if (nuresult = "*created") then
				do
					tr "  Welcome to the wall, " || getnewusername
					exit while
				end 
			if (nuresult = "*inuse") then
				do 
					tr "  That user name is already in use, choose another!"
				end
			if (nuresult = "*inval") then
				do
					tr "  That user name is invalid, choose another!"
				end 
		end 
	end

/* Even if they didn't before, they should have a user name now. If they still
   don't for some reason, show an error and quit. This will also catch
   authentication errors. */
username = SendToServer("username",'')
if (substr(username, 1, 1) = '*') then
	do
		tr "  Sorry, I can't find it :-(    (An error occurred [" || username || "])"
		gc
		exit
	end

/* Get the user's thoughts - in 64 characters or less! */
tr "  What's on your mind, " || username || "?  (max 64 characters)"
se ":"

/* Take the wall post */
	prompt 64 NORMAL ""
	getwallpost=result 
	if result="###PANIC" then exit
	if result="q" then exit

/* If input is more than 2 characters, submit it */
if length(getwallpost) > 2 then
	do
		postresult = SendToServer("post", getwallpost)
		/* Check result of post attempt */
		if (postresult = "*post") then 
			do 
				/* Successful */
				tr "  Post successful!"
			end 
		else 
			do
				if (postresult = "*int") then 
					do
						/* Last post < 10 minutes ago */
						tr "  Sorry, you have to wait 10 minutes between posts."
						gc
						exit
					end 
				else 
					do
						if (postresult = "*inval") then 
							do
								/* Post contained > 64 characters */
								tr "  Your post contained too many characters (max length 64 chars)."
								gc
								exit
							end
						else
							do 
								/* Post failed, unknown reason */
								tr "post result: '" || postresult || "'"
								tr "  Post failed :-("
								gc
								exit
							end 
					end 
			end 
    end
else 
	do
		tr "  Your post was too short!"
		gc
		exit
	end

/* Show the wall! */
body=getwall()
se cls
sendfile body
gc
exit



/* Show the wall! */
getwall: procedure
	
	getuser 40
	lUDI = space(result ,0)
	
	/* Delete the last results file in case it wasn't deleted last time */
	delcommand = 'run >nil: delete ' || 'pfiles:bbslink/user' || lUDI 
	address command delcommand

	rcd="http://games.bbslink.net/wall.php?action=show"
	/* Fetch the token from BBSLink */
	httpcmd = 'run >nil: httpj URL "' || rcd || '" TO pfiles:bbslink/user' || lUDI 
	address command httpcmd

	/* need a short delay to allow our httpj program to fetch the results */
	call delay(50) 

	/* return the wall html page filename and path */
	lfilein = 'pfiles:bbslink/user' || lUDI 
return lfilein


	

/* Send data to the server */
sendtoserver: procedure expose SystemCode AuthorizationCode SchemeCode xkey ktoken
	parse arg val,val2
	
	getuser 40
	lUDI = space(result ,0)
	
	/*  Assemble the Authentication Request URL */
	xUser='user=' || lUDI 
	xSystem='system=' || SystemCode
	xAuth='auth=' || MD5(AuthorizationCode || ktoken)
	xCode='scheme=' || MD5(SchemeCode || ktoken)
	
	xToken='token=' || ktoken
	xType='type=amiga'
	xVersion='version=1.0.0'
	
	tval=SPACE(val2,1,"+")
	
	and = '&'
	rcd = 'http://games.bbslink.net/wall.php?action=' || val || and || 'key=' || xkey || and || xuser || and || xSystem || and || xAuth || and || xCode || and || xToken || and || xType || and || xVersion
	if length(val2) > 0 then 
		rcd=rcd || '&data=' || tval   

	/* Delete the last results file in case it wasn't deleted last time */
	delcommand = 'run >nil: delete ' || 'pfiles:bbslink/user' || lUDI 
	address command delcommand

	/* Fetch the authorization request */
	httpcmd = 'run >nil: httpj "' || rcd || '" TO pfiles:bbslink/user' || lUDI
	address command httpcmd

	/* need a short delay to allow our httpj program to fetch the results */
	call delay(50)

	/* Read the Authentication Request html file */
	filein = 'pfiles:bbslink/user' || lUDI 
	body=''
	if open(temp,filein,R) then
		do
			body = readln(temp)
			call close(temp)
		end

	/* Delete the results file */
	delcommand = 'run >nil: delete pfiles:bbslink/user' || lUDI 
	address command delcommand

    return body




/* Retrieve a token from the server */
GetToken: procedure 
	parse arg k
	
	getuser 40
	lUDI = space(result ,0)

	
	rcd='http://games.bbslink.net/token.php?key=' || k

	/* Delete the last results file in case it wasn't deleted last time */
	delcommand = 'run >nil: delete ' || 'pfiles:bbslink/user' || lUDI 
	address command delcommand

	/* Fetch the token from BBSLink */
	httpcmd = 'run >nil: httpj URL "' || rcd || '" TO ' || 'pfiles:bbslink/user' || lUDI 
	address command httpcmd

	/* need a short delay to allow our httpj program to fetch the results */
	call delay(50) 

	/* Read the token html page */
	filein = 'pfiles:bbslink/user' || lUDI 
	ktoken=''

	if open(temp,filein,R) then
		do
			do while ~eof(temp)
				data = readln(temp)
				if data ~= '' then 
					do 
						ktoken=data
					end 
			end
			call close(temp)
		end
	else
		do
			transmit 'Unable to open token file. Exiting.'
			exit 
		end 
		
	return ktoken
	


BREAK_C:
	do f=1 to 5
		if show(p,"HTTPJ." || f) then call closeport("HTTPJ." || f)
		say "PORT HTTPJ." || f "closed."
	end
exit

/* This function makes a MD5 digest checksum from a given string */
/*                                                               */
/* ARexxMD5.rexx by AmigaPhil  Well, almost, as I wrote it from  */
/*                             examples I found on Internet. :-) */
/*                                                               */
/* A big thanks to Bernd Gollesch (on AmigaWorld.net) for having */
/* helped me to fix the script (signed integer issue) !!!        */
/*                                                               */
/* Do what you want with this script, but be warned that it can  */
/* be very slow (especially with long strings) !  If you need a  */
/* faster MD5 message digest algorithm, pick one of the binary   */
/* executable available on Aminet (http://www.aminet.net).       */

md5: procedure

   parse arg stuff

   numeric digits 11
   lenstuff=length(stuff)

   c0=myd2c(0)
   c1=myd2c(128)
   c1a=myd2c(255)
   c1111=c1a||c1a||c1a||c1a
   slen=length(stuff)*8
   slen512=slen//512

   /* pad message to multiple of 512 bits.  Last 2 words are 64 bit # bits in message*/
   if slen512=448 then  addme=512
   if slen512<448 then addme=448-slen512
   if slen512>448 then addme=960-slen512
   addwords=addme/8

   apad=c1||copies(c0,addwords-1)

   xlen=reverse(right(myd2c(lenstuff*8),4,c0))||c0||c0||c0||c0  /* 2**32 max bytes in message */

   /* NEWSTUFF is the message to be md5'ed */
   newstuff=stuff||apad||xlen

   /* starting values of registers */
   a ='67452301'x;
   b ='efcdab89'x;
   c ='98badcfe'x;
   d ='10325476'x;

   lennews=length(newstuff)/4

   /* loop through entire message */
   do i1 = 0 to ((lennews/16)-1)
   i16=i1*64
   do j=1 to 16
       j4=((j-1)*4)+1
       jj=i16+j4
       m.j=reverse(substr(newstuff,jj,4))
   end /* do */

   /* transform this block of 16 chars to 4 values. Save prior values first */
   aa=a;bb=b;cc=c;dd=d

   /* do 4 rounds, 16 operations per round (rounds differ in bit'ing functions */
   S11=7
   S12=12
   S13=17
   S14=22
   a=round1( a, b, c, d,   0 , S11, 3614090360); /* 1 */
   d=round1( d, a, b, c,   1 , S12, 3905402710); /* 2 */
   c=round1( c, d, a, b,   2 , S13,  606105819); /* 3 */
   b=round1( b, c, d, a,   3 , S14, 3250441966); /* 4 */
   a=round1( a, b, c, d,   4 , S11, 4118548399); /* 5 */
   d=round1( d, a, b, c,   5 , S12, 1200080426); /* 6 */
   c=round1( c, d, a, b,   6 , S13, 2821735955); /* 7 */
   b=round1( b, c, d, a,   7 , S14, 4249261313); /* 8 */
   a=round1( a, b, c, d,   8 , S11, 1770035416); /* 9 */
   d=round1( d, a, b, c,   9 , S12, 2336552879); /* 10 */
   c=round1( c, d, a, b,  10 , S13, 4294925233); /* 11 */
   b=round1( b, c, d, a,  11 , S14, 2304563134); /* 12 */
   a=round1( a, b, c, d,  12 , S11, 1804603682); /* 13 */
   d=round1( d, a, b, c,  13 , S12, 4254626195); /* 14 */
   c=round1( c, d, a, b,  14 , S13, 2792965006); /* 15 */
   b=round1( b, c, d, a,  15 , S14, 1236535329); /* 16 */

   /* Round 2 */
   S21=5
   S22=9
   S23=14
   S24=20
   a= round2( a, b, c, d,   1 , S21, 4129170786); /* 17 */
