; script to install CNetMultiPort
; Should be run from WorkBench by double-clicking on the icon
; Requires a stack of 10000 bytes or more

(set @default-dest "Work:")

(set dest2 (askdir  (prompt " Selected the location to install the CNMP directory")
                       (default @default-dest)
                       (help "Choose a destination partition or directory " 
                             "to contain the CNMP/EasyRexx docs files.\n"
                             "The install program will create a directory called 'CNMP' "
                             "in the location you choose and copy the "
                             "CNMP files there."
                             )
                       )
                     )
              (set dest1 (tackon dest2 "cnmp"))

     (set @default-dest dest1)
     (message "CNMP/EasyRexx documents will be installed in " dest1)

     (if dest2
	     (makedir dest2 (infos))
        )
     (makedir dest1 (infos))

  (copylib (source "easyrexx.library")
	    (dest "libs:")
  		 )

  (copyfiles (source "cnmp.o")
             (dest "lib:")
             )

  (set protodest "include:clib")
  (copyfiles (source "cnmp_protos.h")
             (dest protodest)
             )

  (set hdest "include:cnmp")
  (makedir hdest (infos))
  (copyfiles (source "cnmp.h")
             (dest hdest)
             )

  (copyfiles (source "cnmp.guide")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "easyrexx.doc")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "easyrexx.lib")
             (dest "lib:")
             )

  (copyfiles (source "easyrexx_protos.h")
             (dest "include:clib")
             )

  (copyfiles (source "EasyRexxGuide")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "easyrexx.h")
             (dest "include:libraries")
             )

  (copyfiles (source "files.readme")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "CNMP_empty.c")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "CNMPConf.c")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "CNMPConf.h")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "CNMPConfFuncs.h")
             (dest dest1)
             (infos)
             )

  (copyfiles (source "ExecMe_CNMPConf.exe")
             (dest dest1)
             (infos)
             )
